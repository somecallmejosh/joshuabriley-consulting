---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import ScorecardEngine from '~/components/islands/ScorecardEngine.astro';

const description =
  'An interactive self-assessment covering the five dimensions of a healthy design system: component consistency, accessibility, token architecture, documentation, and handoff process.';

const howSteps = [
  { n: '01', title: 'Answer honestly', body: 'For each prompt, pick No, Partial, or Yes. Nobody is grading you.' },
  { n: '02', title: 'Watch the score', body: 'Subject grades appear live. The running total tracks as you go.' },
  { n: '03', title: 'Read the report', body: 'Finish every row and a written report appears with what to tackle first, and what to leave alone.' },
];

const gradingKey = [
  { value: '0', title: 'No', body: 'Not addressed yet.' },
  { value: '1', title: 'Partial', body: 'Partially in place.' },
  { value: '2', title: 'Yes', body: 'Working well.' },
];

const dimensions = [
  '01 · Component Consistency',
  '02 · Accessibility',
  '03 · Token Architecture',
  '04 · Documentation',
  '05 · Handoff Process',
];
---

<BaseLayout
  title="Design System Scorecard — Joshua Briley | UX Engineer & Design Systems Consultant"
  description={description}
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Tools / Self-assessment</span>
        <span class="hidden sm:inline text-ink-muted">Scorecard 01</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[16ch]">
            Grade your design system <em class="ink-wink font-normal italic">like a report card</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Ten minutes, five subjects, thirty-two questions. An honest snapshot of where your system
            shines and where it is quietly burning your team out.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="#scorecard" iconRight="ph:arrow-right" class="js-magnetic">
              Start scoring
            </Button>
            <Button variant="ghost" size="lg" href="#how">
              How it works
            </Button>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            {['~10 minutes', 'No signup', 'Stays on your device'].map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>

        {/* Preview of the report the engine fills in — static, editorial. */}
        <div class="lg:col-span-5" aria-hidden="true">
          <figure class="rounded-lg border border-line bg-raised p-5 md:p-6">
            <figcaption class="flex items-center justify-between mono-label">
              <span>Report card</span><span>—/64</span>
            </figcaption>
            <ul class="mt-4 divide-y divide-line">
              {dimensions.map((d) => (
                <li class="flex items-center justify-between py-3 first:pt-0">
                  <span class="font-mono text-[0.75rem] uppercase tracking-[0.1em] text-ink-muted">{d}</span>
                  <span class="font-display text-sm font-semibold text-ink-faint">—</span>
                </li>
              ))}
            </ul>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── HOW IT WORKS ───────────────────────── */}
  <Section id="how" tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">How it works / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">The rules of the game.</Heading>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3">
        {howSteps.map((step) => (
          <div class="bg-paper p-7 md:p-9">
            <span class="font-mono text-[0.75rem] text-accent">{step.n}</span>
            <Heading level={3} visual="h3" class="mt-3">{step.title}</Heading>
            <Text tone="muted" class="mt-2">{step.body}</Text>
          </div>
        ))}
      </div>

      <div class="mt-8 rounded-lg border border-line bg-raised p-7 md:p-9">
        <p class="mono-label">The grading key</p>
        <div class="mt-6 grid gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-3">
          {gradingKey.map((g) => (
            <div class="flex items-start gap-3 bg-paper p-5">
              <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-md border border-line-strong font-display font-semibold text-ink">
                {g.value}
              </span>
              <div>
                <p class="font-display font-semibold tracking-tight text-ink">{g.title}</p>
                <p class="mt-0.5 text-sm text-ink-muted">{g.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── THE TOOL (island, intact) ───────────────────────── */}
  <Section id="scorecard" tone="paper" padding="default" class="border-t border-line">
    <Container width="narrow">
      <ScorecardEngine />
    </Container>
  </Section>

  {/* ───────────────────────── CTA (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">A work sample / 02</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4 max-w-[22ch]">
            This scorecard is also a work sample.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            It is built like everything else here: accessible radio groups, live scoring, no
            frameworks, the same tokens. Whatever your number says, if you want to compare notes — or
            you are hiring someone who builds tools like this — get in touch.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right">Get in touch</Button>
            <a
              href="https://www.linkedin.com/in/joshuabriley/"
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Connect on LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
