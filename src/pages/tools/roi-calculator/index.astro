---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import RoiCalculator from '~/components/islands/RoiCalculator.astro';
import { WEEKS_PER_YEAR } from '~/lib/roi';

const assumptions = [
  {
    icon: 'ph:calendar-blank',
    title: `${WEEKS_PER_YEAR} working weeks`,
    body: 'A year minus holidays, PTO, and ramp — so the annual figure reflects time actually worked, not a flat 52.',
  },
  {
    icon: 'ph:scales',
    title: 'Conservative reclaim',
    body: 'A structured system is modelled to remove only a fraction of today’s rework — 20–60% by how much drift you carry — never all of it.',
  },
  {
    icon: 'ph:stack',
    title: 'Surface drag',
    body: 'Each extra product nudges the reclaimable share up a little: keeping N surfaces in sync is where inconsistency compounds.',
  },
  {
    icon: 'ph:eye',
    title: 'Nothing hidden',
    body: 'Every output traces back to an input you set. No black box, no stored data, no email — the link you copy is the whole state.',
  },
];

// Third-party research backing the premise: drift and rework carry real cost,
// and structured design recovers it. Figures quoted verbatim from each source.
const references = [
  {
    stat: '17+ hrs',
    statLabel: 'per developer, per week',
    source: 'Stripe — The Developer Coefficient',
    year: '2018',
    body: 'Developers lose more than 17 hours a week to maintenance, debugging, and refactoring — about a quarter of it on bad code. Stripe pegs the global drag at $85 billion a year.',
    href: 'https://stripe.com/files/reports/the-developer-coefficient.pdf',
  },
  {
    stat: '+32 pts',
    statLabel: 'revenue growth vs. peers',
    source: 'McKinsey — The Business Value of Design',
    year: '2018',
    body: 'Across 300 companies tracked over five years, top-quartile design performers grew revenue 32 points faster and returns to shareholders 56 points higher than their industry rivals.',
    href: 'https://www.mckinsey.com/capabilities/tech-and-ai/our-insights/the-business-value-of-design',
  },
  {
    stat: 'Efficiency',
    statLabel: 'the core payoff',
    source: 'Nielsen Norman Group — Design Systems 101',
    year: '2021',
    body: 'A design system lets work be “created and replicated quickly and at scale,” reducing the need to reinvent the wheel and the unintended inconsistency that comes with it.',
    href: 'https://www.nngroup.com/articles/design-systems-101/',
  },
  {
    stat: 'Consistency',
    statLabel: 'what practitioners report',
    source: 'Sparkbox — Design Systems Survey',
    year: '2019',
    body: 'Surveying 250+ teams that run design systems, the two payoffs reported most often were consistency and efficiency — the exact drag this calculator prices.',
    href: 'https://sparkbox.com/foundry/2019_design_systems_survey_results',
  },
];
---

<BaseLayout
  title="What inconsistency costs — ROI Calculator — Tools — Joshua Briley"
  description="An interactive calculator that turns UI inconsistency into a number: the engineer and designer hours — and dollars — a structured design system reclaims each year."
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Tools / The business case</span>
        <span class="hidden sm:inline text-ink-muted">ROI 04</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[16ch]">
            What inconsistency <em class="ink-wink font-normal italic">actually costs</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Drift never lands on a single invoice, so it stays invisible — a few hours here, a rebuilt
            component there. Add it up across a team and a year and it is a salary. Set your numbers
            below and see the figure stakeholders actually respond to.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="#calculator" iconRight="ph:arrow-right" class="js-magnetic">
              Run the numbers
            </Button>
            <Button variant="ghost" size="lg" href="/tools/scorecard/">
              Score your system
            </Button>
          </div>
        </div>

        {/* Static receipt — the thesis: small scraps compound into one figure. */}
        <div class="lg:col-span-5" aria-hidden="true">
          <figure class="rounded-lg border border-line bg-raised p-5 md:p-6">
            <figcaption class="flex items-center justify-between mono-label">
              <span>Drift · one team · one year</span>
            </figcaption>
            <ul class="mt-4 divide-y divide-line">
              {[
                { label: 'Modal rebuilt', cost: '+3h' },
                { label: 'Color drift in review', cost: '+1h' },
                { label: 'Spacing one-off', cost: '+2h' },
              ].map((r) => (
                <li class="flex items-center justify-between py-2.5 first:pt-0">
                  <span class="text-sm text-ink-muted">{r.label}</span>
                  <span class="font-mono text-[0.8rem] font-medium text-accent">{r.cost}</span>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex items-end justify-between border-t border-line pt-4">
              <span class="mono-label">≈ a salary</span>
              <span class="font-display text-3xl font-semibold tracking-[-0.03em] text-ink">$140k</span>
            </div>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── THE TOOL (island, intact) ───────────────────────── */}
  <Section id="calculator" tone="paper" padding="default">
    <Container width="default">
      <div class="mb-10 max-w-[65ch]">
        <p class="mono-label">The calculator / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">Turn drift into a number.</Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Five inputs about your team and the rework you live with. The panel shows what a structured
          system is modelled to reclaim — in hours and dollars, every year.
        </Text>
      </div>
      <RoiCalculator />
    </Container>
  </Section>

  {/* ───────────────────────── HOW IT'S CALCULATED (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">The assumptions / 02</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-4">Defensible beats dramatic.</Heading>
        <Text size="lg" tone="whiteMuted" class="mt-5">
          A number you cannot explain is a number a stakeholder ignores. Here is every assumption
          behind the figure.
        </Text>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-paper/10 bg-paper/10 sm:grid-cols-2">
        {assumptions.map((a) => (
          <div class="flex gap-4 bg-ink p-7 md:p-8">
            <Icon name={a.icon} size={22} class="mt-0.5 flex-shrink-0 text-accent" />
            <div>
              <Heading level={3} visual="h3" tone="paper">{a.title}</Heading>
              <p class="mt-2 text-sm leading-relaxed text-paper/65">{a.body}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm italic text-paper/55">
        This is an estimate to start a conversation, not an audit. The real number comes from looking
        at your actual components, tokens, and workflow.
      </p>
    </Container>
  </Section>

  {/* ───────────────────────── THE RESEARCH (paper) ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">The research / 03</p>
        <Heading level={2} visual="display-md" class="mt-4">Not just my opinion.</Heading>
        <Text size="lg" tone="muted" class="mt-5">
          The premise behind the math — that drift and rework quietly drain real money, and structure
          wins it back — is well-trodden ground. A few sources worth keeping in your back pocket.
        </Text>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
        {references.map((r) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col bg-paper p-7 transition-colors hover:bg-ink/[0.02] md:p-8"
          >
            <div class="flex items-baseline gap-3">
              <span class="font-display text-2xl font-semibold tracking-[-0.03em] text-accent">{r.stat}</span>
              <span class="mono-label">{r.statLabel}</span>
            </div>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-muted">{r.body}</p>
            <div class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4">
              <span class="font-display text-sm font-medium tracking-tight text-ink">
                {r.source} <span class="font-normal text-ink-muted">· {r.year}</span>
              </span>
              <span class="inline-flex items-center gap-1.5 whitespace-nowrap font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-muted transition-colors group-hover:text-accent">
                Source <Icon name="ph:arrow-up-right" size={13} class="transition-transform duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-6 text-sm italic text-ink-muted">
        These studies measure the broad pattern, not your team specifically — they are here to show
        the direction is real, not to set your exact number. That still comes from looking at your
        actual system.
      </p>
    </Container>
  </Section>

  {/* ───────────────────────── CTA (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">Make it real / 04</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4 max-w-[20ch]">
            Put a real number behind it.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            The estimate above is the rough shape. A design system audit replaces it with specifics —
            which patterns drift, what it costs, and the order to fix them in. I take a handful of
            engagements a year.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right">Talk about an audit</Button>
            <a
              href="/tools/scorecard/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Score your system first <Icon name="ph:arrow-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
