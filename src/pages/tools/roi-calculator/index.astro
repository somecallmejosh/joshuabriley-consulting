---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import SquiggleDivider from '~/components/decorative/SquiggleDivider.astro';
import Blob from '~/components/decorative/Blob.astro';
import WavyUnderline from '~/components/decorative/WavyUnderline.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Badge from '~/components/primitives/Badge.astro';
import Button from '~/components/primitives/Button.astro';
import Hero from '~/components/patterns/Hero.astro';
import SectionHeader from '~/components/patterns/SectionHeader.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';
import RoiCalculator from '~/components/islands/RoiCalculator.astro';
import { WEEKS_PER_YEAR } from '~/lib/roi';

const assumptions = [
  {
    icon: 'ph:calendar-blank-duotone',
    title: `${WEEKS_PER_YEAR} working weeks`,
    body: 'A year minus holidays, PTO, and ramp — so the annual figure reflects time actually worked, not a flat 52.',
  },
  {
    icon: 'ph:scales-duotone',
    title: 'Conservative reclaim',
    body: 'A structured system is modelled to remove only a fraction of today’s rework — 20–60% by how much drift you carry — never all of it.',
  },
  {
    icon: 'ph:stack-duotone',
    title: 'Surface drag',
    body: 'Each extra product nudges the reclaimable share up a little: keeping N surfaces in sync is where inconsistency compounds.',
  },
  {
    icon: 'ph:eye-duotone',
    title: 'Nothing hidden',
    body: 'Every output traces back to an input you set. No black box, no stored data, no email — the link you copy is the whole state.',
  },
];

// Third-party research backing the premise: drift and rework carry real cost,
// and structured design recovers it. Figures quoted verbatim from each source.
const references = [
  {
    stat: '17+ hrs',
    statLabel: 'per developer, per week',
    source: 'Stripe — The Developer Coefficient',
    year: '2018',
    body: 'Developers lose more than 17 hours a week to maintenance, debugging, and refactoring — about a quarter of it on bad code. Stripe pegs the global drag at $85 billion a year.',
    href: 'https://stripe.com/files/reports/the-developer-coefficient.pdf',
    tone: 'coral',
  },
  {
    stat: '+32 pts',
    statLabel: 'revenue growth vs. peers',
    source: 'McKinsey — The Business Value of Design',
    year: '2018',
    body: 'Across 300 companies tracked over five years, top-quartile design performers grew revenue 32 points faster and returns to shareholders 56 points higher than their industry rivals.',
    href: 'https://www.mckinsey.com/capabilities/tech-and-ai/our-insights/the-business-value-of-design',
    tone: 'sky',
  },
  {
    stat: 'Efficiency',
    statLabel: 'the core payoff',
    source: 'Nielsen Norman Group — Design Systems 101',
    year: '2021',
    body: 'A design system lets work be “created and replicated quickly and at scale,” reducing the need to reinvent the wheel and the unintended inconsistency that comes with it.',
    href: 'https://www.nngroup.com/articles/design-systems-101/',
    tone: 'plum',
  },
  {
    stat: 'Consistency',
    statLabel: 'what practitioners report',
    source: 'Sparkbox — Design Systems Survey',
    year: '2019',
    body: 'Surveying 250+ teams that run design systems, the two payoffs reported most often were consistency and efficiency — the exact drag this calculator prices.',
    href: 'https://sparkbox.com/foundry/2019_design_systems_survey_results',
    tone: 'sage',
  },
];

// Arbitrary hex (not named tokens) so the utilities survive this project's
// per-route CSS split; text shades are the AA-legible -deep variants.
const refToneMap: Record<string, { chip: string; text: string }> = {
  coral: { chip: 'bg-[#E8573D]/12', text: 'text-[#C13A22]' },
  sky: { chip: 'bg-[#5DADE2]/15', text: 'text-[#1B6FA1]' },
  plum: { chip: 'bg-[#6C4AB6]/12', text: 'text-[#6C4AB6]' },
  sage: { chip: 'bg-[#7BB47A]/18', text: 'text-[#3E6E3D]' },
};
---

<BaseLayout
  title="What inconsistency costs — ROI Calculator — Tools — Joshua Briley"
  description="An interactive calculator that turns UI inconsistency into a number: the engineer and designer hours — and dollars — a structured design system reclaims each year."
>
  {/* ====== HERO ====== */}
  <Hero tone="cream" align="left" split>
    <Blob slot="decorations" tone="sunset" size="md" class="absolute top-16 right-[12%]" opacity="opacity-30" />
    <Blob slot="decorations" tone="lemon" size="sm" class="absolute top-28 left-[10%] rounded-full" animate="float-delay" />
    <Blob slot="decorations" tone="coral" size="sm" class="absolute bottom-12 right-[18%]" animate="float-slow" opacity="opacity-40" />

    <Badge slot="eyebrow" tone="peach" icon="ph:calculator-duotone">Interactive tool &middot; the business case</Badge>
    <Heading slot="title" level={1} visual="display-xl">
      What inconsistency <WavyUnderline>actually costs</WavyUnderline>.
    </Heading>
    <Text slot="lead" size="xl" tone="muted">
      Drift never lands on a single invoice, so it stays invisible — a few hours here, a rebuilt component there.
      Add it up across a team and a year and it&rsquo;s a salary. Set your numbers below and see the figure
      stakeholders actually respond to.
    </Text>

    {/* The page's thesis, drawn: small, easy-to-ignore scraps of rework — an hour
        here, a rebuilt component there — funnel down and compound into one
        salary-sized number a year. Decorative. */}
    <div slot="media" class="relative mx-auto h-[470px] w-full max-w-[420px] hidden lg:block" aria-hidden="true">
      {/* Soft spinning ring for depth */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 rounded-full border-2 border-dashed border-sunset/15 animate-spin-slow"></div>

      {/* Floating accent dots */}
      <span class="absolute top-[3%] right-[5%] w-4 h-4 rounded-full bg-lemon animate-float-delay"></span>
      <span class="absolute bottom-[10%] left-[1%] w-3 h-3 rounded-full bg-coral/60 animate-float-slow"></span>

      {/* Converging flow lines: each small rework cost drains into the annual total */}
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 470" fill="none">
        <path d="M 80 100 C 100 196, 158 252, 196 308" stroke="#E8573D" stroke-width="2.5" stroke-linecap="round" style="stroke-dasharray: 9 7; animation: dash-flow 1.6s linear infinite" />
        <path d="M 200 156 C 200 216, 200 262, 200 308" stroke="#E8573D" stroke-width="2.5" stroke-linecap="round" style="stroke-dasharray: 9 7; animation: dash-flow 1.6s linear infinite; animation-delay: 0.5s" />
        <path d="M 322 124 C 304 210, 244 258, 204 308" stroke="#E8573D" stroke-width="2.5" stroke-linecap="round" style="stroke-dasharray: 9 7; animation: dash-flow 1.6s linear infinite; animation-delay: 0.8s" />
      </svg>

      {/* Three small, easy-to-ignore rework line items */}
      <div class="absolute top-[2%] left-0 w-40 bg-white rounded-2xl shadow-xl border border-charcoal/5 px-4 py-3 -rotate-3 animate-float">
        <span class="block font-heading text-[10px] font-bold uppercase tracking-wider text-charcoal/70 mb-1.5">This sprint</span>
        <div class="flex items-center justify-between gap-2">
          <span class="font-heading text-xs font-semibold text-navy">Modal rebuilt</span>
          <span class="font-mono text-xs font-bold text-[#C13A22]">+3h</span>
        </div>
      </div>

      <div class="absolute top-[19%] right-0 w-40 bg-white rounded-2xl shadow-xl border border-charcoal/5 px-4 py-3 rotate-2 animate-float-delay">
        <span class="block font-heading text-[10px] font-bold uppercase tracking-wider text-charcoal/70 mb-1.5">Code review</span>
        <div class="flex items-center justify-between gap-2">
          <span class="font-heading text-xs font-semibold text-navy">Color drift</span>
          <span class="font-mono text-xs font-bold text-[#C13A22]">+1h</span>
        </div>
      </div>

      <div class="absolute top-[30%] left-1/2 -translate-x-1/2 w-40 bg-white rounded-2xl shadow-xl border border-charcoal/5 px-4 py-3 -rotate-1 animate-float-slow">
        <span class="block font-heading text-[10px] font-bold uppercase tracking-wider text-charcoal/70 mb-1.5">Handoff</span>
        <div class="flex items-center justify-between gap-2">
          <span class="font-heading text-xs font-semibold text-navy">Spacing one-off</span>
          <span class="font-mono text-xs font-bold text-[#C13A22]">+2h</span>
        </div>
      </div>

      {/* The total: the same scraps, compounded across a team and a year */}
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-64 bg-white rounded-2xl shadow-2xl border border-charcoal/5 px-5 py-4 rotate-1 animate-float">
        <div class="flex items-center justify-between border-b border-dashed border-sunset/25 pb-2 mb-3">
          <span class="font-heading text-[10px] font-bold uppercase tracking-wider text-charcoal/70">Drift &middot; one team &middot; one year</span>
          <iconify-icon icon="ph:receipt-duotone" width="16" height="16" class="text-sunset"></iconify-icon>
        </div>
        <p class="font-display font-extrabold text-4xl text-[#a24818] leading-none tracking-tight">$140k</p>
        <div class="mt-3 flex items-center gap-2.5">
          <div class="flex-1 h-2.5 rounded-full bg-charcoal/8 overflow-hidden">
            <div class="h-full rounded-full" style="width:100%; background:linear-gradient(90deg,#e8573d,#ff8e53)"></div>
          </div>
          <span class="font-mono text-[11px] font-semibold text-navy whitespace-nowrap">&asymp; a salary</span>
        </div>
      </div>

      {/* hand-drawn aside */}
      <span class="absolute bottom-[1%] right-[1%] font-hand text-sunset text-xl rotate-[-5deg]">it adds up.</span>
    </div>
  </Hero>

  <SquiggleDivider />

  {/* ====== THE CALCULATOR ====== */}
  <Section padding="default">
    <Container width="default">
      <SectionHeader
        align="left"
        eyebrowIcon="ph:calculator-duotone"
        eyebrowTone="coral"
        title="Turn drift into a number"
        lead="Five inputs about your team and the rework you live with. The panel shows what a structured system is modelled to reclaim &mdash; in hours and dollars, every year."
        class="mb-10 max-w-[65ch]"
      />
      <RoiCalculator />
    </Container>
  </Section>

  {/* ====== HOW IT'S CALCULATED ====== */}
  <Section tone="cream" padding="default" class="bg-charcoal/[0.03]">
    <Container width="default">
      <SectionHeader
        align="left"
        eyebrowIcon="ph:function-duotone"
        eyebrowTone="sky"
        title="Defensible beats dramatic"
        lead="A number you can&rsquo;t explain is a number a stakeholder ignores. Here&rsquo;s every assumption behind the figure."
        class="mb-10 max-w-[65ch]"
      />
      <div class="grid sm:grid-cols-2 gap-5">
        {assumptions.map((a) => (
          <div class="flex gap-4 bg-white/70 border border-charcoal/8 rounded-2xl p-5">
            <div class="shrink-0 w-11 h-11 rounded-xl bg-sunset/10 flex items-center justify-center">
              <iconify-icon icon={a.icon} width="22" height="22" class="text-sunset" aria-hidden="true"></iconify-icon>
            </div>
            <div>
              <h3 class="font-heading font-bold text-navy mb-1">{a.title}</h3>
              <p class="text-sm text-charcoal/70 leading-relaxed">{a.body}</p>
            </div>
          </div>
        ))}
      </div>
      <Text size="sm" tone="muted" class="mt-6 italic">
        This is an estimate to start a conversation, not an audit. The real number comes from looking at your
        actual components, tokens, and workflow.
      </Text>
    </Container>
  </Section>

  {/* ====== THE RESEARCH ====== */}
  <Section padding="default" decorated>
    <Blob tone="sky" size="sm" class="absolute top-20 right-[8%] rounded-full" animate="float-slow" opacity="opacity-30" />
    <Blob tone="lemon" size="sm" class="absolute bottom-16 left-[6%] rounded-full" animate="float-delay" opacity="opacity-40" />
    <Container width="default" class="relative z-10">
      <SectionHeader
        align="left"
        eyebrow="The research"
        eyebrowIcon="ph:books-duotone"
        eyebrowTone="sage"
        title="Not just my opinion"
        lead="The premise behind the math &mdash; that drift and rework quietly drain real money, and structure wins it back &mdash; is well-trodden ground. A few sources worth keeping in your back pocket."
        class="mb-10 max-w-[65ch]"
      />
      <div class="grid sm:grid-cols-2 gap-5">
        {references.map((r) => {
          const t = refToneMap[r.tone];
          return (
            <a
              href={r.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col bg-white/70 border border-charcoal/8 rounded-2xl p-6 transition hover:-translate-y-0.5 hover:border-charcoal/15 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#A24818]"
            >
              <div class="flex items-baseline gap-3 mb-3">
                <span class={`inline-flex items-center rounded-lg px-2.5 py-1 font-display font-extrabold text-xl leading-none ${t.chip} ${t.text}`}>
                  {r.stat}
                </span>
                <span class="font-heading text-[11px] font-semibold uppercase tracking-wider text-charcoal/70">
                  {r.statLabel}
                </span>
              </div>
              <p class="text-sm text-charcoal/75 leading-relaxed mb-4 flex-1">{r.body}</p>
              <div class="flex items-center justify-between gap-3 pt-3 border-t border-charcoal/8">
                <span class="font-heading text-xs font-semibold text-navy">
                  {r.source} <span class="text-charcoal/70 font-normal">&middot; {r.year}</span>
                </span>
                <span class={`inline-flex items-center gap-1 text-xs font-semibold whitespace-nowrap ${t.text}`}>
                  Source
                  <iconify-icon icon="ph:arrow-up-right-duotone" width="14" height="14" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></iconify-icon>
                </span>
              </div>
            </a>
          );
        })}
      </div>
      <Text size="sm" tone="muted" class="mt-6 italic">
        These studies measure the broad pattern, not your team specifically &mdash; they&rsquo;re here to show the
        direction is real, not to set your exact number. That still comes from looking at your actual system.
      </Text>
    </Container>
  </Section>

  {/* ====== FINAL CTA ====== */}
  <CTABanner
    title="Put a real number behind it"
    lead="The estimate above is the rough shape. A design system audit replaces it with specifics — which patterns drift, what it costs, and the order to fix them in. I take a handful of engagements a year."
    align="left"
  >
    <Button variant="primary" size="lg" iconLeft="ph:envelope-duotone" href="/contact/">
      Talk about an audit
    </Button>
    <Button class="hover:underline" variant="text" size="lg" iconLeft="ph:clipboard-text-duotone" href="/tools/scorecard/">
      Score your system first
    </Button>
  </CTABanner>
</BaseLayout>
