---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Button from '~/components/primitives/Button.astro';
import Diagnostic from '~/components/islands/Diagnostic.astro';
---

<BaseLayout
  title="What an audit actually finds — Tools — Joshua Briley"
  description="A working sample of the design system audit deliverable: inspect a specimen of drifted UI, then read findings ranked by severity, each paired with a specific remediation."
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Tools / Interactive demo</span>
        <span class="hidden sm:inline text-ink-muted">Audit 02</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[16ch]">
            What an audit <em class="ink-wink font-normal italic">actually finds</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Every audit ends in a report: every finding ranked by severity, each with a specific,
            actionable recommendation. This page is a working sample. Run the inspection on the
            specimen, then read the findings the way you would read the real report.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="#diagnostic" iconRight="ph:arrow-right" class="js-magnetic">
              Inspect the specimen
            </Button>
            <Button variant="ghost" size="lg" href="/tools/scorecard/">
              Score your system
            </Button>
          </div>
        </div>

        {/* Static severity legend — the report's three ranks. */}
        <div class="lg:col-span-5" aria-hidden="true">
          <figure class="rounded-lg border border-line bg-raised p-5 md:p-6">
            <figcaption class="flex items-center justify-between mono-label">
              <span>Findings</span><span>by severity</span>
            </figcaption>
            <ul class="mt-4 divide-y divide-line">
              {[
                { rank: 'High', note: 'Breaks accessibility or trust' },
                { rank: 'Med', note: 'Drift that compounds over time' },
                { rank: 'Low', note: 'Polish and consistency' },
              ].map((f) => (
                <li class="flex items-center justify-between gap-4 py-3 first:pt-0">
                  <span class="flex items-center gap-3">
                    <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                    <span class="font-display text-sm font-medium tracking-tight text-ink">{f.rank}</span>
                  </span>
                  <span class="text-sm text-ink-muted">{f.note}</span>
                </li>
              ))}
            </ul>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── THE TOOL (island, intact) ───────────────────────── */}
  <Section id="diagnostic" tone="paper" padding="default">
    <Container width="default">
      <div class="mb-10 max-w-[65ch]">
        <p class="mono-label">The specimen / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">This is what drift looks like up close.</Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Each exhibit shipped to production. Toggle “show issues” to reveal the inconsistencies a
          quick audit pass would flag — the kind that quietly cost your team sprint velocity.
        </Text>
      </div>
      <Diagnostic />
    </Container>
  </Section>

  {/* ───────────────────────── DELIVERABLE (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label !text-paper/65">The deliverable / 02</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4 max-w-[16ch]">
            What you walk away with.
          </Heading>
        </div>
        <div class="lg:col-span-7 space-y-6">
          <Text size="lg" tone="whiteMuted">
            The Design System Audit reviews your library across all five dimensions in five business
            days. You receive a PDF report with every finding ranked by severity and a specific
            remediation recommendation for each, followed by a 60-minute debrief call to map what to
            fix first and why.
          </Text>
          <div class="inline-flex items-start gap-3 rounded-lg border border-paper/15 bg-paper/[0.03] px-5 py-4">
            <Icon name="ph:paper-plane-tilt" size={20} class="mt-0.5 flex-shrink-0 text-accent" />
            <p class="text-[0.95rem] text-paper/80">
              Send a Storybook URL, Figma file, or GitHub repo. No specific format required.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CTA (paper) ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label">The standard / 03</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[22ch]">
            This is the checklist I build against.
          </Heading>
          <Text size="lg" tone="muted" class="mt-6 max-w-xl">
            The audit exists as a service, but these five dimensions are also the standard my own work
            is held to — every system I ship gets reviewed against the same list. Questions about
            either, send a note.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right">Get in touch</Button>
            <a
              href="/tools/scorecard/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted transition-colors hover:text-accent"
            >Try the scorecard <Icon name="ph:arrow-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
