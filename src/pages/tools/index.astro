---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import SquiggleDivider from '~/components/decorative/SquiggleDivider.astro';
import Blob from '~/components/decorative/Blob.astro';
import WavyUnderline from '~/components/decorative/WavyUnderline.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Badge from '~/components/primitives/Badge.astro';
import Button from '~/components/primitives/Button.astro';
import Hero from '~/components/patterns/Hero.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';
import Card from '~/components/card/Card.astro';
import CardNumber from '~/components/card/CardNumber.astro';

const accentMap: Record<string, { text: string; bg: string }> = {
  coral: { text: 'text-[#C13A22]', bg: 'bg-coral/10' },
  plum: { text: 'text-plum', bg: 'bg-plum/10' },
  sky: { text: 'text-sky-deep', bg: 'bg-sky/10' },
  sunset: { text: 'text-sunset-deep', bg: 'bg-sunset/10' },
};

const cardNumberTones: Record<string, 'coral' | 'plum' | 'sky' | 'sunset'> = {
  coral: 'coral',
  plum: 'plum',
  sky: 'sky',
  sunset: 'sunset',
};

const tools = [
  {
    accent: 'coral',
    icon: 'ph:clipboard-text-duotone',
    eyebrow: 'Self-assessment',
    title: 'Design System Scorecard',
    body: 'Score your own system across the five dimensions of a healthy design system: component consistency, accessibility, token architecture, documentation, and handoff process. Walk away with a clear picture of your biggest gaps.',
    tags: ['32 items', '64 points', '~10 minutes'],
    href: '/tools/scorecard/',
    cta: 'Open tool',
    tilt: -1 as const,
  },
  {
    accent: 'plum',
    icon: 'ph:magnifying-glass-duotone',
    eyebrow: 'Interactive demo',
    title: 'What an audit actually finds',
    body: 'A working sample of the audit deliverable. Inspect a specimen of drifted UI to see what gets flagged, then filter real-shaped findings ranked by severity, each paired with its remediation.',
    tags: ['Annotated specimen', '8 sample findings', 'Filter by dimension'],
    href: '/tools/audit-findings/',
    cta: 'Open tool',
    tilt: 1 as const,
  },
  {
    accent: 'sky',
    icon: 'ph:sliders-horizontal-duotone',
    eyebrow: 'Interactive demo',
    title: 'What a design token actually does',
    body: 'Change one primitive and watch it propagate through every component at once. Brand, radius, and mode are all decisions in a token chain — this playground makes the indirection visible.',
    tags: ['3-tier tokens', 'Live theming', 'Chain readout'],
    href: '/tools/token-playground/',
    cta: 'Open tool',
    tilt: -1 as const,
  },
  {
    accent: 'sunset',
    icon: 'ph:calculator-duotone',
    eyebrow: 'The business case',
    title: 'What inconsistency actually costs',
    body: 'Drift never lands on one invoice, so it stays invisible. Set your team size, rate, and the rework you live with, and watch it add up to the annual figure — in hours and dollars — a structured system reclaims.',
    tags: ['5 inputs', 'Live estimate', 'Shareable link'],
    href: '/tools/roi-calculator/',
    cta: 'Open tool',
    tilt: 1 as const,
  },
];
---

<BaseLayout
  title="Tools — Joshua Briley"
  description="Four free, interactive tools built with the same design system as the rest of this site: a design system scorecard, an audit-findings demo, a token playground, and a UI-debt ROI calculator."
>

  <Hero tone="cream" align="left" split>
    <Blob slot="decorations" tone="lemon" size="sm" class="absolute top-28 left-[8%] rounded-full" animate="float-delay" />
    <Blob slot="decorations" tone="sage" size="sm" class="absolute bottom-10 right-[8%]" animate="float-slow" opacity="opacity-40" />
    <Blob slot="decorations" tone="sky" size="sm" class="absolute bottom-24 left-[12%] rounded-full" animate="float" opacity="opacity-40" />

    <Badge slot="eyebrow" tone="peach" icon="ph:wrench-duotone">Tools &middot; free &amp; interactive</Badge>
    <Heading slot="title" level={1} visual="display-xl">
      Tools that <WavyUnderline>show how I think</WavyUnderline>.
    </Heading>
    <Text slot="lead" size="xl" tone="muted">
      Four interactive pieces, free to use, built with the same design system as the rest of this site.
      They're useful on their own, and they double as work samples: every one is accessible by construction
      and token-driven.
    </Text>

    <!-- One system in the middle; each tool reads it from orbit. The four cards
         map 1:1 to the four tools below, in their accent colors. Decorative. -->
    <div slot="media" data-ti-illo class="relative h-[380px] md:h-[460px] hidden lg:block" aria-hidden="true">
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-72 h-72 rounded-full border-2 border-dashed border-plum/20 animate-spin-slow"></div>
      </div>

      {/* Connectors drawn by hero-motion.ts, anchored to the live tool-card positions;
          an accent pulse travels outward from the hub to each tool. */}
      <svg data-ti-conn class="absolute inset-0 w-full h-full"></svg>

      <!-- Center: the system every tool plugs into -->
      <div data-ti-hub class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-2xl shadow-xl border border-charcoal/5 px-5 py-4 w-40 animate-float">
        <div class="flex items-center gap-2 mb-2.5">
          <div class="w-8 h-8 rounded-lg bg-navy/10 flex items-center justify-center">
            <Icon name="ph:stack-duotone" size={20} class="text-navy" />
          </div>
          <span class="font-heading text-sm font-bold text-navy leading-none">Your system</span>
        </div>
        <div class="flex gap-1.5">
          <span class="w-5 h-5 rounded-md bg-coral/70"></span>
          <span class="w-5 h-5 rounded-md bg-plum/70"></span>
          <span class="w-5 h-5 rounded-md bg-sky/70"></span>
          <span class="w-5 h-5 rounded-md bg-sunset/70"></span>
        </div>
      </div>

      <!-- Scorecard (coral) -->
      <div data-ti-tool data-ti-color="#E8573D" class="absolute top-[2%] left-[2%] bg-white rounded-2xl shadow-xl border border-charcoal/5 p-4 w-36 animate-float -rotate-3">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-7 h-7 rounded-lg bg-coral/15 flex items-center justify-center">
            <Icon name="ph:clipboard-text-duotone" size={18} class="text-coral" />
          </div>
          <span class="font-heading text-xs font-semibold text-navy">Scorecard</span>
        </div>
        <div class="flex items-baseline gap-1">
          <span class="font-display text-xl text-[#C13A22] leading-none">48</span>
          <span class="font-heading text-[11px] text-charcoal/70">/ 64</span>
        </div>
      </div>

      <!-- Audit (plum) -->
      <div data-ti-tool data-ti-color="#6C4AB6" class="absolute top-[4%] right-[2%] bg-white rounded-2xl shadow-xl border border-charcoal/5 p-4 w-36 animate-float-delay rotate-3">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-7 h-7 rounded-lg bg-plum/15 flex items-center justify-center">
            <Icon name="ph:magnifying-glass-duotone" size={18} class="text-plum" />
          </div>
          <span class="font-heading text-xs font-semibold text-navy">Audit</span>
        </div>
        <div class="space-y-1.5">
          <div class="h-1.5 rounded-full bg-plum/40 w-full"></div>
          <div class="h-1.5 rounded-full bg-charcoal/10 w-3/5"></div>
        </div>
      </div>

      <!-- Tokens (sky) -->
      <div data-ti-tool data-ti-color="#5DADE2" class="absolute bottom-[3%] left-[1%] bg-white rounded-2xl shadow-xl border border-charcoal/5 p-4 w-36 animate-float-slow rotate-2">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-7 h-7 rounded-lg bg-sky/15 flex items-center justify-center">
            <Icon name="ph:sliders-horizontal-duotone" size={18} class="text-sky-deep" />
          </div>
          <span class="font-heading text-xs font-semibold text-navy">Tokens</span>
        </div>
        <div class="flex gap-1.5">
          <span class="w-4 h-4 rounded-full bg-sky/70"></span>
          <span class="w-4 h-4 rounded-full bg-plum/60"></span>
          <span class="w-4 h-4 rounded-full bg-sunset/70"></span>
        </div>
      </div>

      <!-- ROI (sunset) -->
      <div data-ti-tool data-ti-color="#FF8E53" class="absolute bottom-[2%] right-[2%] bg-white rounded-2xl shadow-xl border border-charcoal/5 p-4 w-36 animate-float -rotate-2">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-7 h-7 rounded-lg bg-sunset/15 flex items-center justify-center">
            <Icon name="ph:calculator-duotone" size={18} class="text-sunset-deep" />
          </div>
          <span class="font-heading text-xs font-semibold text-navy">ROI</span>
        </div>
        <div class="flex items-baseline gap-0.5">
          <span class="font-display text-lg text-sunset-deep leading-none">$</span>
          <span class="font-display text-xl text-sunset-deep leading-none">214k</span>
        </div>
      </div>
    </div>
  </Hero>

  <SquiggleDivider />


  <Section padding="default">
    <Container>
      <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-6">
        {tools.map((t, idx) => {
          const a = accentMap[t.accent];
          return (
            <Card variant="paper" tilt={t.tilt} padding="loose" class="flex flex-col">
              <CardNumber slot="corner" n={idx + 1} tone={cardNumberTones[t.accent] ?? 'coral'} announce />
              <div class="relative flex flex-col flex-1">
                <div class={`w-14 h-14 ${a.bg} rounded-2xl flex items-center justify-center mb-5`}>
                  <Icon name={t.icon} size={28} class={a.text} />
                </div>
                <span class={`inline-block text-xs font-heading font-semibold ${a.text} uppercase tracking-wider mb-2`}>
                  {t.eyebrow}
                </span>
                <Heading level={2} visual="h2" class="mb-3 leading-tight">{t.title}</Heading>
                <Text tone="muted" class="mb-5">{t.body}</Text>
                <ul class="flex flex-wrap gap-2 mb-6 mt-auto">
                  {t.tags.map((tag) => (
                    <li class="font-heading text-xs font-medium text-charcoal/70 bg-charcoal/5 rounded-full px-3 py-1">{tag}</li>
                  ))}
                </ul>
                <a href={t.href} class={`inline-flex items-center gap-1.5 font-heading font-semibold ${a.text} text-sm hover:gap-3 transition-all`}>
                  {t.cta}
                  <Icon name="ph:arrow-right-bold" size={16} />
                </a>
              </div>
            </Card>
          );
        })}
      </div>
    </Container>
  </Section>


  <Section tone="cream" padding="default" decorated class="bg-charcoal/[0.03]">
    <Blob tone="peach" size="lg" animate="float-slow" opacity="opacity-40" class="absolute -top-8 right-[6%]" />
    <Container width="narrow" class="relative z-10">
      <div class="flex flex-col items-start">
        <Icon name="ph:quotes-duotone" size={48} class="text-[#C13A22] mb-4" />
        <p class="font-display text-2xl md:text-3xl text-navy italic leading-snug mb-4">
          The portfolio claim is the tool itself. If it says accessible, tab through it. If it says
          token-driven, open dev tools.
        </p>
        <p class="font-heading text-sm text-charcoal/70 uppercase tracking-wider mb-8">— why these exist</p>
        <Text size="lg" tone="muted" class="max-w-2xl">
          The scorecard covers the same five dimensions I use when auditing real systems. If it surfaces gaps you
          want a second opinion on, I still take a handful of engagements each year.
        </Text>
      </div>
    </Container>
  </Section>


  <CTABanner
    title="Want to talk about any of this?"
    lead="Roles, systems, or the tools themselves — I read everything."
    align="left"
  >
    <Button variant="primary" size="lg" iconLeft="ph:envelope-duotone" href="/contact/">
      Get in touch
    </Button>
    <Button class="hover:underline" variant="text" size="lg" iconLeft="ph:linkedin-logo-duotone" href="https://www.linkedin.com/in/joshuabriley/">
      Connect on LinkedIn
    </Button>
  </CTABanner>

  {/* Hero illustration motion: each tool reads from the one system — an accent pulse
      travels out from the hub to each tool card, in turn. */}
  <script>
    import { connect, gsap } from '~/scripts/hero-motion';

    const illo = document.querySelector<HTMLElement>('[data-ti-illo]');
    const svg = illo?.querySelector<SVGSVGElement>('[data-ti-conn]');
    const hub = illo?.querySelector('[data-ti-hub]');
    const tools = illo ? Array.from(illo.querySelectorAll<HTMLElement>('[data-ti-tool]')) : [];

    if (svg && hub && tools.length) {
      const colors = tools.map((t) => t.dataset.tiColor || '#6C4AB6');
      const c = connect(
        svg,
        tools.map((t, i) => ({
          from: hub,
          to: t,
          color: colors[i],
          curve: i % 2 ? 0.16 : -0.16,
          opacity: 0.85,
        })),
      );

      if (!c.reduce) {
        const cycle = 2.6;
        c.links.forEach((link, i) => {
          link.addPulse({ duration: 1.4, delay: i * 0.4, repeatDelay: cycle - 1.4, size: 5, color: colors[i] });
          // tool lights up as its pulse lands (filter only — cards already run CSS float)
          gsap.fromTo(
            tools[i],
            { filter: 'brightness(1)' },
            {
              filter: 'brightness(1.06)',
              duration: 0.22,
              yoyo: true,
              repeat: 1,
              ease: 'power1.inOut',
              delay: i * 0.4 + 1.25,
              repeatDelay: cycle - 0.44,
            },
          );
        });
      }
    }
  </script>
</BaseLayout>
