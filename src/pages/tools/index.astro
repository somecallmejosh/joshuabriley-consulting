---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Button from '~/components/primitives/Button.astro';

const tools = [
  {
    index: '01',
    eyebrow: 'Self-assessment',
    title: 'Design System Scorecard',
    body: 'Score your own system across the five dimensions of a healthy design system: component consistency, accessibility, token architecture, documentation, and handoff process. Walk away with a clear picture of your biggest gaps.',
    tags: ['32 items', '64 points', '~10 minutes'],
    href: '/tools/scorecard/',
  },
  {
    index: '02',
    eyebrow: 'Interactive demo',
    title: 'What an audit actually finds',
    body: 'A working sample of the audit deliverable. Inspect a specimen of drifted UI to see what gets flagged, then filter real-shaped findings ranked by severity, each paired with its remediation.',
    tags: ['Annotated specimen', '8 sample findings', 'Filter by dimension'],
    href: '/tools/audit-findings/',
  },
  {
    index: '03',
    eyebrow: 'Interactive demo',
    title: 'What a design token actually does',
    body: 'Change one primitive and watch it propagate through every component at once. Brand, radius, and mode are all decisions in a token chain — this playground makes the indirection visible.',
    tags: ['3-tier tokens', 'Live theming', 'Chain readout'],
    href: '/tools/token-playground/',
  },
  {
    index: '04',
    eyebrow: 'The business case',
    title: 'What inconsistency actually costs',
    body: 'Drift never lands on one invoice, so it stays invisible. Set your team size, rate, and the rework you live with, and watch it add up to the annual figure — in hours and dollars — a structured system reclaims.',
    tags: ['5 inputs', 'Live estimate', 'Shareable link'],
    href: '/tools/roi-calculator/',
  },
];
---

<BaseLayout
  title="Tools — Joshua Briley"
  description="Four free, interactive tools built with the same design system as the rest of this site: a design system scorecard, an audit-findings demo, a token playground, and a UI-debt ROI calculator."
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Tools / Free &amp; interactive</span>
        <span class="hidden sm:inline text-ink-muted">Index 01</span>
      </div>

      <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-8">
          <Heading level={1} visual="display-xl" class="max-w-[18ch]">
            Tools that show <em class="ink-wink font-normal italic">how I think</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Four interactive pieces, free to use, built with the same design system as the rest of
            this site. They are useful on their own, and they double as work samples: every one is
            accessible by construction and token-driven.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <Button variant="ghost" size="lg" href="/contact/">Talk about your system</Button>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── TOOL LIST ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <p class="mono-label">The tools / 01</p>
      <ul class="mt-8 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
        {tools.map((t) => (
          <li class="bg-paper">
            <a href={t.href} class="group flex h-full flex-col p-7 transition-colors hover:bg-ink/[0.02] md:p-9">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-mono text-[0.75rem] text-accent">{t.index}</span>
                <span class="mono-label">{t.eyebrow}</span>
              </div>
              <Heading level={2} visual="h2" class="mt-5">{t.title}</Heading>
              <Text tone="muted" class="mt-3">{t.body}</Text>
              <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
                {t.tags.map((tag) => (
                  <li class="flex items-center gap-2">
                    <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{tag}
                  </li>
                ))}
              </ul>
              <span class="mt-7 inline-flex items-center gap-2 font-sans text-[0.9rem] font-medium text-ink transition-colors group-hover:text-accent">
                Open tool
                <Icon name="ph:arrow-right" size={16} class="transition-transform duration-300 ease-out group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── WHY (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <p class="mono-label !text-paper/65">Why these exist / 02</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4 max-w-[18ch]">
            The portfolio claim is the tool itself.
          </Heading>
        </div>
        <div class="lg:col-span-6 space-y-5 text-paper/70 leading-relaxed">
          <p>
            If it says accessible, tab through it. If it says token-driven, open dev tools. Every tool
            here is built the way I build production work — accessible by construction, token-driven,
            no frameworks under the hood.
          </p>
          <p>
            The scorecard covers the same five dimensions I use when auditing real systems. If it
            surfaces gaps you want a second opinion on, I still take a handful of engagements each year.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (paper) ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label">Start a conversation / 03</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[20ch]">
            Want to talk about any of this?
          </Heading>
          <Text size="lg" tone="muted" class="mt-6 max-w-xl">
            Roles, systems, or the tools themselves — I read everything and reply within one business day.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">Get in touch</Button>
            <a
              href="https://www.linkedin.com/in/joshuabriley/"
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted transition-colors hover:text-accent"
            >Connect on LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
