---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import TokenPlayground from '~/components/islands/TokenPlayground.astro';
---

<BaseLayout
  title="What a design token actually does — Tools — Joshua Briley"
  description="An interactive demo of token architecture: change one primitive and watch it propagate through every component at once. Semantic tokens reference primitives, names describe intent."
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Tools / Token architecture</span>
        <span class="hidden sm:inline text-ink-muted">Tokens 03</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[16ch]">
            What a design token <em class="ink-wink font-normal italic">actually does</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Tokens live in a single source of truth. Semantic tokens reference primitives, not raw
            values, and names describe intent, not value. That is abstract until you move one. Change
            a decision below and watch it propagate through every component at once.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="#playground" iconRight="ph:arrow-right" class="js-magnetic">
              Open the playground
            </Button>
            <Button variant="ghost" size="lg" href="/tools/scorecard/">
              Score your system
            </Button>
          </div>
        </div>

        {/* Static three-tier chain — the page's thesis, drawn editorially. */}
        <div class="lg:col-span-5" aria-hidden="true">
          <figure class="rounded-lg border border-line bg-raised p-5 md:p-6">
            <figcaption class="flex items-center justify-between mono-label">
              <span>token chain</span><span>live</span>
            </figcaption>
            <ul class="mt-4 space-y-1">
              <li class="flex items-center justify-between rounded-[6px] border border-line bg-paper px-3.5 py-2.5">
                <span class="font-mono text-[0.75rem] uppercase tracking-[0.1em] text-ink-muted">Primitive</span>
                <span class="font-mono text-[0.8rem] text-accent">#A8412A</span>
              </li>
              <li class="ml-4 h-4 w-px bg-line"></li>
              <li class="flex items-center justify-between rounded-[6px] border border-line bg-paper px-3.5 py-2.5">
                <span class="font-mono text-[0.75rem] uppercase tracking-[0.1em] text-ink-muted">Semantic</span>
                <span class="font-mono text-[0.8rem] text-ink">action.primary</span>
              </li>
              <li class="ml-4 h-4 w-px bg-line"></li>
              <li class="grid grid-cols-3 gap-1">
                {['Button', 'Badge', 'Link'].map((c) => (
                  <span class="rounded-[6px] border border-line bg-paper px-2 py-3 text-center font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-muted">{c}</span>
                ))}
              </li>
            </ul>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── THE TOOL (island, intact) ───────────────────────── */}
  <Section id="playground" tone="paper" padding="default">
    <Container width="default">
      <div class="mb-10 max-w-[65ch]">
        <p class="mono-label">The playground / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">One change, everywhere at once.</Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Drag a knob, change the whole card. That is the leverage a real system gives a team — every
          component pulls from the same vocabulary.
        </Text>
      </div>
      <TokenPlayground />
    </Container>
  </Section>

  {/* ───────────────────────── WHY THE MIDDLE LAYER (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label !text-paper/65">The trick, explained / 02</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4 max-w-[16ch]">
            Intent in the middle, value at the edge.
          </Heading>
        </div>
        <div class="lg:col-span-7 space-y-5 text-paper/70 leading-relaxed">
          <p>
            The brand picker above changes exactly one value: the primitive. Every component updates
            because they reference intent (<code class="font-mono text-sm text-accent">action-primary</code>) and
            intent references the primitive. That indirection is the entire trick.
          </p>
          <p>
            It is why a rebrand becomes an afternoon instead of a quarter, why a dark mode is a remap
            instead of a rewrite, and why no component ever redefines a value instead of referencing
            it. When the mode toggle flips this demo to ink, the components do not change — the
            semantic layer re-points to different primitives underneath them.
          </p>
          <p>
            It is also why the audit checks token names as carefully as token values. A token called
            <code class="font-mono text-sm text-accent">color.blue</code> can never survive the day the brand
            stops being blue. A token called <code class="font-mono text-sm text-accent">color.action.primary</code> can.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CTA (paper) ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label">Measure yours / 03</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[20ch]">
            Curious how yours measures up?
          </Heading>
          <Text size="lg" tone="muted" class="mt-6 max-w-xl">
            Token architecture is one of five audit dimensions. The free scorecard has six questions on
            exactly this. Ten minutes, and you will know whether your tokens are load-bearing or decorative.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="primary" size="lg" href="/tools/scorecard/" iconRight="ph:arrow-right">Try the scorecard</Button>
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted transition-colors hover:text-accent"
            >Get in touch <Icon name="ph:arrow-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
