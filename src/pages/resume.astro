---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

const updated = 'July 2026';

const description =
  'Product design engineer and front-end UI developer with 20+ years shipping accessible, high-performance interfaces, design systems, and data-rich tools for insurance platforms and consumer products.';

const summary =
  'Product design engineer and front-end UI developer with 20+ years shipping production interfaces for insurance platforms, design systems, data-rich tools, and consumer products. Strongest where product judgment, accessible interaction design, and hands-on front-end implementation meet: framing ambiguous problems, prototyping directly in code, validating with real users and behavioral data, and carrying the strong ideas through to production without losing intent in a handoff. Current work builds and automates an enterprise design system used by thousands of engineers and designers, with AI tooling running the full loop from research to build to test and real judgment applied to what it produces.';

const experience = [
  {
    period: '2025 - Present',
    company: 'Travelers',
    role: 'Software Engineer II, Design System',
    stack: 'Stencil Web Components · React',
    bullets: [
      'Build and maintain enterprise design-system components used by roughly 3,500 software engineers and designers across the organization.',
      'Work in Stencil Web Components, React wrappers, Storybook, Gatsby documentation, Playwright, Jest, Figma Code Connect, and Node automation to improve design-to-code adoption.',
      'Automated Storybook story development, saving more than 10 hours per component story and cutting repetitive setup for the team.',
      'Automated Figma Code Connect mapping so design and engineering artifacts stay closer together with less manual translation.',
      'Contribute to documentation, accessibility expectations, implementation guidance, and cross-framework usage for teams consuming the system.',
    ],
  },
  {
    period: '2023 - 2024',
    company: 'LogATot, Inc.',
    role: 'Senior UI Developer',
    stack: 'Rails · ViewComponents',
    bullets: [
      'Owned UI and UX delivery for a Rails platform supporting attendance, CACFP workflows, timeclock features, voice logging, Stripe billing, and bilingual English and Spanish interfaces.',
      'Designed and developed modular, accessible ViewComponent patterns with Hotwire, HTMX, and Alpine.js: forms, navigation, status states, tables, and admin flows that kept behavior clear and consistent for daily operators.',
      'Read real usage through Hotjar, Google Analytics, and HubSpot, then reworked the flows and forms where the data showed people getting stuck.',
      'Partnered with product and engineering to turn workflow needs into production interfaces, balancing speed, usability, accessibility, and implementation cost.',
    ],
  },
  {
    period: '2022 - 2023',
    company: "America's Test Kitchen",
    role: 'Senior Software Engineer',
    stack: 'React · Next.js',
    bullets: [
      'Built and documented React, Next.js, and Storybook components during migration from a legacy Rails experience to a modern front-end platform.',
      'Improved accessibility, responsive behavior, and front-end quality across consumer-facing digital experiences used by a large editorial audience.',
      'Worked closely with editorial, product, design, and engineering partners to preserve content intent while shipping maintainable production UI.',
      "Settled design questions with Optimizely A/B tests and the site's analytics stack instead of opinion, and weighed each third-party script against its cost to performance, accessibility, and security.",
    ],
  },
  {
    period: '2018 - 2022',
    company: 'Berkshire Hathaway Specialty Insurance',
    role: 'Principal Design Engineer',
    stack: 'Vue.js · Nuxt.js',
    bullets: [
      'Designed and built a custom Vue.js, Nuxt.js, and Hugo-based UI library for specialty-insurance portals, standardizing front-end work across internal, agent, and customer surfaces with shared components, documentation, and accessibility guidance.',
      'Created data-heavy interfaces for underwriting, administration, customer service, and agent workflows, including tables, filters, forms, dashboards, and task-oriented screens.',
      'Instrumented the portals with Segment and Heap so real underwriter and agent behavior drove which workflows and screens to prioritize, rather than guessing at what mattered.',
      'Translated complex insurance processes into clear, accessible, production-ready UI patterns while working with stakeholders, engineers, and subject-matter experts.',
    ],
  },
  {
    period: '2016 - 2018',
    company: "America's Test Kitchen",
    role: 'Lead UI Developer',
    stack: 'UI Systems',
    bullets: [
      'Designed and implemented a scalable UI utility system that improved consistency, development speed, accessibility, SEO, and performance across digital properties.',
      'Trained team members on accessible markup, front-end performance, responsive behavior, and durable UI implementation practices.',
      "Received the Breaking Bread Award for user-friendly, innovative content solutions that strengthened the brand's digital engagement.",
    ],
  },
  {
    period: '2010 - Present',
    company: 'Independent',
    role: 'Freelance UI Developer',
    stack: 'Contract',
    bullets: [
      'Design and build focused web applications, component systems, and front-end experiences for clients with an emphasis on clarity, accessibility, and practical delivery.',
      'Built data-intensive user and admin portal work for Berkshire Hathaway Specialty Insurance, and designed a web application for IVFCRYO supporting customer shipping and real-time monitoring workflows.',
      'Create full-stack prototypes and production applications in Rails, Hotwire, Vue, Nuxt, React, and modern CSS when direct product exploration is faster than static design.',
    ],
  },
];

const education = [
  {
    title: 'B.S. Biology',
    org: 'Troy University',
    note: 'Built analytical and technical-writing habits through research-based projects.',
  },
];

const continuingEd = [
  { title: 'Web Accessibility', org: 'Deque University' },
  { title: 'Personal learning projects', org: 'Ongoing' },
];

const certFocus = 'IAAP CPACC and WAS accessibility exams';

const skills = [
  {
    group: 'Front end',
    items: ['HTML', 'CSS', 'Sass', 'Tailwind', 'JavaScript', 'TypeScript', 'React', 'Next.js', 'Vue', 'Nuxt', 'Astro', 'Stencil Web Components', 'Storybook', 'Alpine.js', 'HTMX', 'Hotwire', 'Stimulus'],
  },
  {
    group: 'Systems & testing',
    items: ['Design systems', 'Component libraries', 'Design tokens', 'Figma Code Connect', 'Playwright', 'Jest', 'Vitest', 'Cypress', 'Lighthouse', 'Node scripts', 'Git', 'CI workflows'],
  },
  {
    group: 'Data & experimentation',
    items: ['Segment', 'Heap', 'Hotjar', 'Google Analytics', 'HubSpot', 'Optimizely', 'Core Web Vitals'],
  },
  {
    group: 'Design & craft',
    items: ['Figma', 'Adobe CS', 'Accessible UI', 'WCAG 2.1 / 2.2', 'Responsive design', 'Workflow design', 'Prototyping', 'Design-to-code'],
  },
];
---

<BaseLayout title="Resume | Joshua Briley | Product Design Engineer" description={description}>

  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="hero-in hero-in-1 flex items-center justify-between gap-4 mono-label">
        <span>Résumé · Product Design Engineer</span>
        <span class="hidden sm:inline text-ink-muted">Updated {updated}</span>
      </div>

      <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-8">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[19ch]">
            Twenty years building the parts of the product people actually <em class="ink-wink font-normal italic">touch</em>.
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
            {summary}
          </Text>
        </div>

        <div class="hero-in hero-in-4 lg:col-span-4 lg:flex lg:flex-col lg:items-end">
          <div class="flex flex-wrap items-center gap-3 lg:justify-end">
            <Button variant="primary" size="lg" href="/resume.pdf" target="_blank" rel="noopener" iconRight="ph:download-simple" class="js-magnetic">
              Download PDF
            </Button>
            <Button variant="ghost" size="lg" href="/contact/">
              Get in touch
            </Button>
          </div>
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted lg:justify-end">
            {['20 yrs in production UI', 'Accessibility-first', 'Design systems'].map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── EXPERIENCE ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">Experience</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Products in production, across frameworks and brands.
        </Heading>
      </div>

      <ul class="mt-14 border-t border-line" data-reveal-stagger>
        {experience.map((job) => (
          <li>
            <div class="grid grid-cols-12 gap-x-4 gap-y-3 border-b border-line py-8 md:gap-x-8 md:py-9">
              <div class="col-span-12 md:col-span-3">
                <span class="block font-mono text-[0.7rem] uppercase tracking-[0.12em] text-accent">{job.period}</span>
                <span class="mt-2 block font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-muted">{job.stack}</span>
              </div>
              <div class="col-span-12 md:col-span-9">
                <h3 class="font-display text-lg font-semibold tracking-tight text-ink">
                  {job.role}
                  <span class="font-normal text-ink-muted"> · {job.company}</span>
                </h3>
                <ul class="mt-4 space-y-2.5 max-w-2xl">
                  {job.bullets.map((b) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-ink-muted">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-[1px] bg-accent" aria-hidden="true"></span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── EDUCATION · LEARNING · SKILLS ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">

        {/* Education + continuing ed */}
        <div class="lg:col-span-5">
          <Heading level={2} visual="h2" tone="paper">Education</Heading>
          <div class="mt-6 border-t border-paper/10">
            {education.map((e) => (
              <div class="border-b border-paper/10 py-5">
                <p class="font-display text-base font-medium tracking-tight text-paper">{e.title}</p>
                <p class="mt-0.5 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{e.org}</p>
                <p class="mt-2 text-sm text-paper/55 max-w-md">{e.note}</p>
              </div>
            ))}
          </div>

          <p class="mt-10 mono-label text-paper/45">Recent continuing education</p>
          <ul class="mt-5 border-t border-paper/10">
            {continuingEd.map((c) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-paper/10 py-3.5">
                <span class="font-display text-sm font-medium tracking-tight text-paper">{c.title}</span>
                <span class="shrink-0 text-right text-xs text-paper/45">{c.org}</span>
              </li>
            ))}
          </ul>

          <p class="mt-10 mono-label text-paper/45">Current certification focus</p>
          <p class="mt-3 text-sm text-paper/70">{certFocus}</p>
        </div>

        {/* Skills */}
        <div class="lg:col-span-7">
          <Heading level={2} visual="h2" tone="paper">Tools of the trade</Heading>
          <div class="mt-6 space-y-8" data-reveal-stagger>
            {skills.map((s) => (
              <div class="grid grid-cols-12 items-baseline gap-4 border-t border-paper/10 pt-5">
                <p class="col-span-12 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent sm:col-span-4">{s.group}</p>
                <ul class="col-span-12 flex flex-wrap gap-2 sm:col-span-8">
                  {s.items.map((item) => (
                    <li class="rounded-[5px] border border-paper/15 px-2.5 py-1 text-[0.8rem] text-paper/80">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT ───────────────────────── */}
  <Section tone="paper" padding="loose" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <Heading level={2} visual="display-lg" class="max-w-[20ch]">
            Looks like a fit? Let's talk.
          </Heading>
          <Text size="lg" tone="muted" class="mt-6 max-w-xl">
            If you're hiring a product design engineer who builds the whole thing and sweats the finish,
            send a note. I'll tell you honestly whether I'm the right fit, and if not, I probably
            know who is.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right">Get in touch</Button>
            <a
              href="/resume.pdf"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted transition-colors hover:text-ink"
            >Download PDF <Icon name="ph:download-simple" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
