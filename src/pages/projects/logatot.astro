---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Link from '~/components/primitives/Link.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';
import CodeBlock from '~/components/patterns/CodeBlock.astro';
import FidelityPlate from '~/components/patterns/FidelityPlate.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const title = 'Logatot | Joshua Briley';
const description =
  "Case study: designing a voice-first operations platform for home-based child care providers, and building the front end and much of the Rails domain underneath it, from the wake word running on-device to a repair queue that teaches the parser a child's name.";

const meta = [
  { role: 'Role', value: 'Product Design Engineer' },
  { role: 'Domain', value: 'Home-based child care' },
  { role: 'Scope', value: 'Design system + platform' },
  { role: 'Build', value: 'Rails 7.1 · Postgres' },
  { role: 'Dates', value: 'Sept 2023 - June 2025' },
];

const proof = [
  { label: 'Product design', items: ['Voice-first interaction design', 'Two-sided information architecture', 'Failure and repair flows', 'Print-first compliance documents', 'Fifteen annotated design sheets'] },
  { label: 'Engineering', items: ['21-module design-system helper layer', '21 ViewComponents, 9 namespaces', 'HTMX + 74 Alpine islands', 'Rails 7.1 domain, 51 tables', 'Deterministic voice parser'] },
  { label: 'Platform', items: ['Picovoice Porcupine (on-device)', 'Web Speech API', 'OpenAI phonetic aliases', 'Pusher real-time', 'Stripe + association billing'] },
  { label: 'Contribution', items: ['Lead front-end on a 3-dev team', '~1,100 of 1,939 commits', 'English + Spanish at parity', 'Shipped as a paid product', 'Sold direct and via associations'] },
];

const docket = [
  { href: '#hands', icon: 'ph:hand-waving', label: 'Designing for a user with no free hands' },
  { href: '#shapes', icon: 'ph:squares-four', label: 'Two shapes for the same day' },
  { href: '#failure', icon: 'ph:arrow-counter-clockwise', label: 'Making failure a normal state' },
  { href: '#pipeline', icon: 'ph:microphone', label: 'The voice pipeline, and where the model goes' },
  { href: '#outcomes', icon: 'ph:trend-up', label: 'What shipping it changed' },
];

// Three separate regulatory regimes, all of which are visible in the data model.
const regimes = [
  { icon: 'ph:fork-knife', title: 'CACFP', body: 'The federal food program reimburses a meal only if it met component requirements for the child’s age group, and only if you can prove it.' },
  { icon: 'ph:certificate', title: 'State licensing', body: 'Signed attendance records, fire drill and shelter-in-place logs, allergy and medication rosters.' },
  { icon: 'ph:calculator', title: 'Tax', body: 'The IRS home-daycare time-space percentage, which needs both business hours and the square footage used for them.' },
];

// Why 8pm-from-memory is a product problem and not a habit problem.
const problems = [
  { icon: 'ph:brain', title: 'Recall degrades', body: 'A nap logged from memory at 8pm is an estimate. A diaper change is a guess. The records that matter most legally are the ones reconstructed with the least accuracy.' },
  { icon: 'ph:door-open', title: 'The burden is a career problem', body: 'Providers leave this profession over the paperwork, which is why the mission statement talks about sustainability rather than efficiency. The goal was giving evenings back, not a tidier form.' },
  { icon: 'ph:clock-countdown', title: 'Failures surface too late', body: 'Finding out at month end that a Wednesday lunch was short a vegetable means the food is eaten, the money is spent, and nothing can be done.' },
];

// The four roles that share one Devise user table and one polymorphic meta association.
const users = [
  { icon: 'ph:user-focus', name: 'The provider', role: 'Primary user, and the hardest to design for. Mobile, interrupted, often one-handed, twelve-hour day.' },
  { icon: 'ph:users', name: 'Parents', role: 'A dozen sessions a year at most. Mobile-first, passwordless by necessity, usually in a car park at 5pm.' },
  { icon: 'ph:identification-badge', name: 'Authorized pickups', role: 'A first-class record with its own PIN and its own permitted children, because custody rules belong in an auditable model.' },
  { icon: 'ph:clock-user', name: 'Employees', role: 'In multi-staff accounts, clocking shifts through the same event pipeline as everything else.' },
];

// The design decisions that only hold because they were built once, in the system.
const structural = [
  { icon: 'ph:arrows-left-right', label: 'Rows scroll horizontally in sync' },
  { icon: 'ph:function', label: 'Attendance derived, never stored' },
  { icon: 'ph:calendar-check', label: 'Enrolment status derived from dates' },
  { icon: 'ph:trash-simple', label: 'Soft delete: removal is a display decision' },
  { icon: 'ph:columns', label: 'Column visibility per device, persistent' },
  { icon: 'ph:placeholder', label: 'Empty rows pre-rendered for live updates' },
];

// The real service boundaries behind the voice product.
const integrations = [
  { icon: 'ph:waveform', name: 'Picovoice Porcupine', role: 'Custom wake word, WebAssembly, on-device' },
  { icon: 'ph:microphone', name: 'Web Speech API', role: 'Transcription, silence-timer endpointing' },
  { icon: 'ph:sparkle', name: 'OpenAI', role: 'Phonetic name variants, at child creation' },
  { icon: 'ph:broadcast', name: 'Pusher', role: 'Per-account channels for live board updates' },
  { icon: 'ph:queue', name: 'Sidekiq', role: '29 jobs, 4 scheduled reminder workers' },
  { icon: 'ph:credit-card', name: 'Stripe + union API', role: 'Direct billing and association membership' },
];

const outcomes = [
  {
    icon: 'ph:moon-stars',
    title: 'The evenings came back',
    body: 'Documentation moved from after-the-fact and from memory to during the moment and hands-free. Providers reported saving over two hours a day on data entry.',
  },
  {
    icon: 'ph:files',
    title: 'Compliance stopped being separate work',
    body: 'Attendance records, signed releases, CACFP claims, and drill logs all generate from events captured for another reason. Month end became a review step.',
  },
  {
    icon: 'ph:storefront',
    title: 'It reached market',
    body: 'Shipped as a paid subscription, sold direct and through child care associations, with landing pages tuned per channel.',
  },
];

const quotes = [
  {
    body: 'It is truly remarkable to be completing a physical task and talking to the voice assistant to record it simultaneously! Now I do not have to do my data entry outside of business hours. Each day I am saving over 2 hours on data entry!!!',
    name: 'President',
    role: 'CSEA/VOICE Local 100A',
  },
  {
    body: 'I never realized how much time I had to spend filling in paperwork until I didn’t have to. Logatot has given me my evenings back.',
    name: 'Margaret Balko',
    role: 'Home-based provider',
  },
];

// The edges, stated plainly. A case study that only lists wins is a brochure.
const edges = [
  { icon: 'ph:list-magnifying-glass', title: 'ARIA on the densest screen', body: 'The Voiceboard’s expand/collapse and column controls drive state without aria-expanded. The pattern was established correctly in the component layer and then not carried into the hardest screen. First thing I would fix.' },
  { icon: 'ph:device-tablet', title: 'A two-state responsive strategy', body: '783 lg: utilities against a single hinge at 1024px, which under-serves the 640-1024px tablet band. That matters here more than elsewhere, because the kiosk is a tablet.' },
  { icon: 'ph:globe-hemisphere-west', title: 'Timezones were contained, not solved', body: 'Five of the last six commits on the project are timezone churn. The oscillation is the honest record of a problem I bounded rather than closed.' },
  { icon: 'ph:cloud-slash', title: 'No offline queue', body: 'A web manifest exists but is never linked, with no service worker. For tablets in homes with unreliable WiFi, offline capture is the highest-value thing that is not built.' },
];

// The event log as the thing every write path already agrees on: voice, kiosk,
// board, and API. Attendance is read from it rather than stored beside it, and a
// failed parse is written with its diagnostics rather than dropped.
const modelSnippet = `# app/models/logged_event.rb
# Voice, kiosk, board, and API all write here, so this is the only
# record all four already agree on. Attendance is read, not stored.
class LoggedEvent < ApplicationRecord
  enum status: { processed: 0, pending: 1, failed: 2, unknown: 3 }

  belongs_to :child, optional: true   # a failed parse may match no one
  has_one_attached :audio             # kept, so a human can repair it

  # A parse that fails is written, not dropped. The diagnostics say
  # which half broke; the raw utterance is what the repair screen
  # renders as tappable word chips.
  scope :needs_repair, -> { where(status: :failed) }

  # occurred_at is the SPOKEN time, not the processed time, so a
  # batch logged at 3pm still reads accurately in a parent's feed.
  def self.attendance_for(child, date)
    where(child:, occurred_on: date)
      .where(event_type: %i[check_in check_out absent])
      .order(:occurred_at)
      .last&.event_type || :expected
  end
end`;

// The sheets render from src/ so Astro can actually process them (anything under
// public/ is copied verbatim, never optimized). Sources are 2x headless-Chrome
// PNGs; `<Image>` emits sized WebP from these at build time.
const sheets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/logatot/wires-and-flows/*.png',
  { eager: true },
);
const sheet = (slug: string) =>
  sheets[`../../assets/projects/logatot/wires-and-flows/${slug}.png`].default;

// Sketch and clean-wireframe passes live in public/ because they are SVG and
// need no processing. The sketch is generated from the wireframe by
// src/assets/projects/logatot/wires-and-flows/sketchify.mjs.
const art = (file: string) => `/images/projects/logatot/wires-and-flows/${file}`;

// Four screens carry the argument, so they get full mounts. The note is the
// claim the sheet is making, not a fresh gloss on the picture.
const keyScreens = [
  {
    slug: '01-voiceboard',
    index: '01',
    title: 'Voiceboard',
    note: 'One row per child, one column per event type, one day. A grid, because the provider is scanning twelve children at once.',
    alt: 'Annotated wireframe of the Voiceboard: live attendance tiles across the top, reminder rails for diaper changes and health checks, then a child-by-event-type grid, with callouts explaining synchronised horizontal row scrolling, per-device column visibility, and pre-rendered empty rows.',
  },
  {
    slug: '04-logged-events',
    index: '04',
    title: 'Logged events: review and repair',
    note: 'Where the product’s honesty lives. A failed parse renders as clickable word chips that write back into the name vocabulary.',
    alt: 'Annotated wireframe of the logged-events review screen: a queue of failed voice captures, each showing the raw utterance as selectable word chips, the partially understood fields, and the retained audio, with callouts explaining the two diagnostic flags and how a correction improves recognition permanently.',
  },
  {
    slug: '05-checkin-kiosk',
    index: '05',
    title: 'Check-in kiosk',
    note: 'Handing over the tablet signs the provider out entirely. There is nowhere to go because there should be nowhere to go.',
    alt: 'Annotated wireframe of the parent-facing check-in kiosk: a 96-pixel PIN field with no submit button, a filtered child list, and an inline signature canvas, on a dark full-bleed card with no navigation, with callouts on session teardown and per-PIN child filtering.',
  },
  {
    slug: '06-parent-portal',
    index: '06',
    title: 'Parent portal',
    note: 'The same events as the Voiceboard, as a timeline. Same data, opposite affordance, and exactly one write surface.',
    alt: 'Annotated wireframe of the parent portal in desktop and mobile widths: a chronological day timeline for one child with photos and milestones weighted heavier than counts, and a single message-the-provider action, with callouts on why the portal is read-mostly.',
  },
];

// The rest of the system, at a glance, without repeating the device.
const restOfSystem = [
  { slug: '02-children-roster', title: 'Children roster' },
  { slug: '03-child-form', title: 'Child record' },
  { slug: '07-cacfp-menu', title: 'CACFP menu planner' },
  { slug: '08-calendar', title: 'Calendar and drills' },
  { slug: '09-reports', title: 'Reports' },
  { slug: '10-dashboard-lat5', title: 'Manual-entry dashboard' },
];

const flows = [
  {
    slug: '11-flow-voice-logging',
    title: 'Voice event logging',
    note: 'Utterance to structured event, including the failure and repair path. The branch that fails is drawn at the same weight as the one that works.',
    alt: 'Flow diagram of voice event logging. An on-device wake word opens transcription, which runs through a ladder of phrase matchers and roster name matching, forking into a single-child inline write, a multi-child background job, or a failed parse that lands in the repair queue with its audio attached.',
  },
  {
    slug: '12-flow-onboarding',
    title: 'Provider onboarding',
    note: 'The empty board is the real churn risk, not the signup form. Which is why CSV import sits beside "Add child" rather than in settings.',
    alt: 'Flow diagram of provider onboarding, from first visit through account creation, roster population by manual entry or CSV import, and first voice capture, with the empty-board drop-off marked as the critical failure point.',
  },
  {
    slug: '13-flow-checkin',
    title: 'Check in and out',
    note: 'Handing the tablet to a parent and taking it back, with the session torn down in between.',
    alt: 'Flow diagram of the kiosk check-in and check-out path: provider enters kiosk mode, the session is destroyed leaving only the account id, a parent enters a PIN, selects their children, signs on canvas, and the provider signs back in with one tap.',
  },
  {
    slug: '14-flow-parent-access',
    title: 'Parent access',
    note: 'Passwordless entry and the daily loop. The email is the product; the portal is the destination.',
    alt: 'Flow diagram of parent access: a passwordless magic-link request that returns an identical screen for known and unknown addresses, a fifteen-minute single-use token, role resolution at the shared sign-in, and the automatic end-of-day summary email that drives the daily loop.',
  },
  {
    slug: '15-flow-food-program',
    title: 'Food program',
    note: 'Plan a compliant menu, serve it, claim it. Validation moves to plan time, where a mistake is still an edit.',
    alt: 'Flow diagram of the CACFP food program: building a menu validated per meal against the age-group component matrix, duplicating a week, generating a shopping list, serving meals through the shared event pipeline, and reconciling the month-end claim from records that already exist.',
  },
];

// Screens and flows are placed beside the argument they support rather than
// collected into one gallery, so these look them up by slug at the point of use.
const screen = (slug: string) => keyScreens.find((s) => s.slug === slug)!;
const flowSet = (...slugs: string[]) => slugs.map((s) => flows.find((f) => f.slug === s)!);
---

<BaseLayout title={title} description={description}>

  <!-- HERO -->
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav
        class="hero-in hero-in-1 mb-12 flex items-center gap-2 text-sm text-ink-muted"
        aria-label="Breadcrumb"
      >
        <a href="/projects/" class="transition-colors hover:text-accent">Projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">Logatot</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-main">
          <div class="hero-in hero-in-2 mb-7 flex items-center gap-3">
            <p class="font-display text-2xl font-semibold tracking-tight text-ink">Logatot</p>
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <p class="mono-label">Case study</p>
          </div>

          <Heading level={1} visual="display-xl" class="hero-in hero-in-3">
            The interface has to work when nobody can <em class="ink-wink font-normal italic">look at it</em>.
          </Heading>

          <Text size="lg" tone="muted" class="hero-in hero-in-4 mt-8 max-w-xl">
            A voice-controlled operations platform for home-based child care providers,
            built so a provider holding a toddler can log a nap, a meal, or a diaper
            change without touching a device, and have the licensing and reimbursement
            paperwork fall out of that record instead of costing an evening.
          </Text>
        </div>

        <aside class="hero-in hero-in-5 hero-rail" aria-label="Project details">
          <dl>
            {meta.map((m) => (
              <div>
                <dt>{m.role}</dt>
                <dd set:html={m.value.replace(/·/g, '&middot;')}></dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  <!-- RECEIPTS -->
  <Section tone="paper" padding="tight" aria-label="Project receipts">
    <Container width="content">
      <p class="mono-label mb-8">Receipts</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <!-- ON THE DOCKET -->
  <Section tone="paper" padding="tight">
    <Container width="content">
      <p class="mono-label mb-5">On the docket</p>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {docket.map((item, i) => (
          <li>
            <a href={item.href} class="group inline-flex items-center gap-3 text-ink transition-colors hover:text-accent">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              {item.icon && (
                <Icon name={item.icon} size={16} class="shrink-0 text-ink-muted transition-colors group-hover:text-accent" />
              )}
              <span class="font-medium">{item.label}</span>
              <Icon name="ph:arrow-right" size={15} class="shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <Text size="lg" tone="muted" class="mt-10 measure">
        Logatot shipped as &ldquo;child care&rsquo;s only voice-controlled assistant.&rdquo;
        The user underneath that line is one person running a licensed daycare out of a
        private home: caregiver, cook, janitor, bookkeeper, and compliance officer, caring
        for six to twelve children alone and legally required to document everything that
        happens to each of them. I was the lead front-end contributor on a three-developer
        team, responsible for the design system, the interface and flow design, and a
        substantial share of the Rails domain, across roughly 1,100 of the project&rsquo;s
        1,939 commits.
      </Text>
    </Container>
  </Section>

  <!-- STEP 01 — THE USER WITH NO FREE HANDS -->
  <Section tone="paper" padding="default" id="hands" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 01</p>
          <Heading level={2} visual="display-md" tone="ink">Designing for a user with no free hands</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Most software assumes a user with free hands and spare attention. This user
              has neither. The provider is holding a toddler, and answers to three separate
              regulatory regimes, all of which are visible in the product&rsquo;s data
              model.
            </p>
            <p>
              Every one of those obligations produces paperwork, and none of them happen at
              a desk. So the paperwork happens <em>after</em>: at 8pm, from memory, on
              paper. The whole product exists to move documentation from
              <strong class="text-ink font-semibold">after the fact and from memory</strong>
              to <strong class="text-ink font-semibold">during the moment and hands-free</strong>,
              and to make the compliance artifacts fall out of that record rather than being
              assembled separately.
            </p>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Three regimes, all of them in the schema</p>
            <ol class="grid gap-x-8 gap-y-8 sm:grid-cols-3">
              {regimes.map((r, i) => (
                <li class="border-t border-line pt-5">
                  <div class="mb-3 flex items-center gap-3">
                    <span class="font-mono text-sm text-accent">0{i + 1}</span>
                    <Icon name={r.icon} size={20} class="text-ink-muted" />
                  </div>
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{r.title}</Heading>
                  <Text size="sm" tone="muted">{r.body}</Text>
                </li>
              ))}
            </ol>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Why that is a product problem, not a habit problem</p>
            <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-3">
              {problems.map((p) => (
                <li class="border-t border-line pt-5">
                  <Icon name={p.icon} size={24} class="mb-3 text-ink-muted" />
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{p.title}</Heading>
                  <Text size="sm" tone="muted">{p.body}</Text>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Four roles, one authentication surface</p>
            <ul class="grid gap-x-10 gap-y-1 md:grid-cols-2">
              {users.map((u) => (
                <li class="flex gap-3.5 border-b border-line py-4">
                  <Icon name={u.icon} size={22} class="mt-0.5 shrink-0 text-ink-muted" />
                  <div>
                    <p class="font-medium text-ink leading-snug">{u.name}</p>
                    <p class="mt-0.5 text-sm text-ink-muted leading-snug">{u.role}</p>
                  </div>
                </li>
              ))}
            </ul>
            <Text size="sm" tone="muted" class="mt-5 measure">
              All four are one Devise <code>User</code> table with a polymorphic
              <code>meta</code> association pointing at <code>Employee</code>,
              <code>Caregiver</code>, or <code>AuthorizedPickup</code>. One authentication
              surface, three role shapes.
            </Text>
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
              Error recovery was a first-class goal, not a polish item. In a voice product
              recognition <em>will</em> fail, and a design that treats failure as
              exceptional silently loses a nap the parent later asks about.
            </blockquote>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <!-- STEP 02 — TWO SHAPES FOR THE SAME DAY -->
  <Section tone="paper" padding="default" id="shapes" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 02</p>
          <Heading level={2} visual="display-md" tone="ink">Two shapes for the same day</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The signature screen is the Voiceboard: one row per child, one column per
              event type, for a single day. Live attendance tiles across the top, reminder
              rails for diaper changes and health checks, then the grid. The interaction
              detail that took longest to get right is the least visible.
              <strong class="text-ink font-semibold">Rows scroll horizontally in sync</strong>,
              so a provider scanning right stays on the same time axis across all twelve
              children. Without it, the grid is twelve unrelated timelines that happen to
              be stacked.
            </p>
          </div>

          {/* First sheet on the page, so the reading instructions live here rather
              than in a gallery preamble the reader meets before any artwork. */}
          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-4">How to read the sheets</p>
            <div class="space-y-4 text-ink-muted leading-relaxed">
              <p>
                Every screen went through three passes: a crude sketch to argue about the
                shape, a clean wireframe to fix it, and that same wireframe with the
                reasoning written onto it. The third pass is the one that did the work.
                Writing down <em>why</em> the grid scrolls in sync, or why a failed parse
                keeps its audio, is what turned a picture of a screen into a decision
                someone could push back on. Switch any plate to walk the three passes.
              </p>
              <p>
                One caveat worth stating plainly: the annotated sheets are retrospective.
                The decisions they record are real and verifiable in the shipped code,
                including derived enrolment status, kiosk session teardown, the
                failed-event queue, and the phonetic name vocabulary. The sheets were
                drawn after the build to document that reasoning rather than to drive it.
              </p>
            </div>
          </div>

          <div class="mt-12">
            <FidelityPlate
              index={screen('01-voiceboard').index}
              title={screen('01-voiceboard').title}
              caption={screen('01-voiceboard').note}
              sketch={art('01-voiceboard-sketch.svg')}
              wire={art('01-voiceboard.svg')}
              annotated={sheet('01-voiceboard')}
              annotatedAlt={screen('01-voiceboard').alt}
            />
          </div>

          <div class="mt-12 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The parent portal shows exactly the same events as a
              <strong class="text-ink font-semibold">timeline</strong>: time down the left,
              one child at a time. The provider is scanning twelve children at once, so the
              provider gets a grid. A parent is reading about one child in order, so the
              parent gets a chronology. Same data, opposite affordance. The portal is
              read-mostly with exactly one write, messaging the provider, because every
              extra write surface becomes one more thing to triage during the day.
            </p>
          </div>

