<script>
  // Sheet mounts only claim "more below" when the artwork really is cut off.
  document.querySelectorAll<HTMLElement>('.sheet-plate__mount').forEach((mount) => {
    const stage = mount.querySelector<HTMLElement>('.sheet-plate__stage');
    if (!stage) return;
    const sync = () => {
      mount.dataset.overflow = String(stage.scrollHeight > stage.clientHeight + 4);
    };
    stage.querySelectorAll('img').forEach((img) => {
      if (img.complete) sync();
      else img.addEventListener('load', sync, { once: true });
    });
    new ResizeObserver(sync).observe(mount);
    sync();
  });
</script>

<style>
  /* Sheet plate — the same mounted-specimen language as ScrollShot and
     FidelityPlate, at half width. Logatot's sheets are a single annotated pass
     (no sketch/wireframe variants), so there is no tab rail: just the mount.
     The artwork is tall, so the mount is a scroll window. */
  /* Column layout so plates in a row share a height and the captions land on the
     same baseline, whatever the artwork's natural aspect ratio is. */
  .sheet-plate {
    margin: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .sheet-plate__mount { flex: 1; }

  .sheet-plate__index {
    margin: 0 0 0.75rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
