---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import CodeBlock from '~/components/patterns/CodeBlock.astro';
import Metric from '~/components/patterns/Metric.astro';
import ScrollShot from '~/components/patterns/ScrollShot.astro';

const title = "America's Test Kitchen | Joshua Briley";
const description =
  "Case study: building a shared React component library that serves multiple editorial brands at America's Test Kitchen without fragmenting or going rigid.";

const recipeMeta = [
  { label: 'Role', value: 'Product Engineer' },
  { label: 'Surfaces', value: 'Multiple brands' },
  { label: 'Stack', value: 'React, Next.js' },
  { label: 'Focus', value: 'A11y · Tokens' },
];

const onMenu = [
  { href: '#problem', label: 'The core architecture problem' },
  { href: '#decisions', label: 'Library decisions in practice' },
  { href: '#accessibility', label: 'Accessibility across every surface' },
  { href: '#scale', label: 'What it enables at scale' },
];

const decisions = [
  {
    icon: 'ph:plug',
    title: 'Brand-agnostic APIs',
  },
  {
    icon: 'ph:palette',
    title: 'Complete token coverage',
  },
  {
    icon: 'ph:books',
    title: 'Storybook as development + docs',
  },
];

const a11yChecklist = [
  { icon: 'ph:keyboard', label: 'Full keyboard operability' },
  { icon: 'ph:target', label: 'Focus management in overlays' },
  { icon: 'ph:megaphone', label: 'ARIA semantics on every component' },
  { icon: 'ph:eye', label: 'Contrast checked against tokens' },
];

const outcomes = [
  {
    icon: 'ph:rocket-launch',
    title: 'Faster brand launches',
    body: 'Behavioral foundation is already there: new surfaces mostly wire up tokens.',
  },
  {
    icon: 'ph:broadcast',
    title: 'Consistent feature shipping',
    body: 'The component API quietly enforces the right patterns for every team that uses it.',
  },
  {
    icon: 'ph:graduation-cap',
    title: 'Quicker onboarding',
    body: 'New engineers learn the system by reading it, because the docs are part of done.',
  },
];

// --- Technical-proof register ---
// Receipts drawn only from facts this case study already asserts. Stack/testing
// chips reflect what's described in the narrative; extend them with the real
// tooling list when you have it (TypeScript version, exact test stack, etc.).
const proof = [
  { label: 'Skills proven', items: ['Design systems', 'Accessible component APIs', 'Multi-brand theming', 'Frontend architecture', 'Design-to-code', 'Documentation'] },
  { label: 'Stack', items: ['React', 'Next.js', 'TypeScript', 'Storybook', 'Design tokens', 'CSS variables'] },
  { label: 'Quality', items: ['Keyboard operability', 'Focus management', 'ARIA semantics', 'Token contrast checks'] },
  { label: 'Outcomes', items: ['Faster brand launches', 'Consistent feature shipping', 'Quicker onboarding'] },
];

// Illustrates the architecture this study describes: one API, no `brand` prop,
// appearance resolved from the active token context.
const apiSnippet = `// Button.tsx — one API, every ATK brand.
// No \`brand\` prop. Appearance resolves from the active token context.
export function Button({ variant = 'primary', ...props }: ButtonProps) {
  return (
    <button
      className={styles[variant]}   // classes read CSS-variable tokens
      {...props}                    // behaviour + a11y pass straight through
    />
  );
}

// Cook's Country and Cook's Illustrated render the *same* Button.
// It looks different only because its tokens resolve differently.`;
---

<BaseLayout title={title} description={description}>
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="mb-12 flex items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
        <a href="/projects/" class="transition-colors hover:text-accent">Projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">America's Test Kitchen</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-main">
          <div class="mb-7 flex items-center gap-3">
            <img src="/images/logos/atk.svg" alt="America's Test Kitchen logo" class="hero-logo-img" />
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <p class="mono-label">Case study</p>
          </div>

          <Heading level={1} visual="display-xl" tone="ink">
            One component library, many brands, <em class="ink-wink font-normal italic">no fragmenting</em>.
          </Heading>

          <Text size="lg" tone="muted" class="mt-8 max-w-xl">
            Improving an inaccessible CMS and building a shared React + Next.js component library for one of the most recognized cooking brands in the US.
          </Text>
        </div>

        <aside class="hero-rail" aria-label="Project details">
          <dl>
            {recipeMeta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  {/* Live site — a framed look at what shipped, linking out to the real thing. */}
  <Section tone="paper" padding="tight">
    <Container width="wide">
      <ScrollShot
        src="/images/projects/atk-live.webp"
        alt="America's Test Kitchen: the full live homepage, top to bottom"
        label="americastestkitchen.com"
        href="https://www.americastestkitchen.com/"
        caption="The live site, full page: scroll the frame to walk it top to bottom, or open it in a new tab."
      />
    </Container>
  </Section>

  <Section tone="paper" padding="tight" aria-label="Project receipts">
    <Container width="content">
      <p class="mono-label mb-8">Receipts</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight">
    <Container width="content">
      <p class="mono-label mb-5">On the docket</p>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {onMenu.map((item, i) => (
          <li>
            <a href={item.href} class="group inline-flex items-center gap-3 text-ink transition-colors hover:text-accent">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              {item.icon && (
                <Icon name={item.icon} size={16} class="shrink-0 text-ink-muted transition-colors group-hover:text-accent" />
              )}
              <span class="font-medium">{item.label}</span>
              <Icon name="ph:arrow-right" size={15} class="shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <Text size="lg" tone="muted" class="mt-10 measure">
        America's Test Kitchen operates across multiple editorial brands, each with its own visual identity, its own product team,
        and its own publishing cadence. The challenge isn't unique to ATK: when a single component library needs to serve multiple
        products that look different but share behavior, the architecture has to be built for that from the start. Libraries
        designed for one brand and retrofitted for others quickly accumulate the wrong kind of complexity. At ATK, I built a
        shared component library in React and Next.js that could serve multiple brand surfaces without requiring separate
        implementations for each one.
      </Text>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="problem" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 01</p>
          <Heading level={2} visual="display-md" tone="ink">The core architecture problem</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5">
            <Text size="lg" tone="ink">
              A component library that serves multiple brands has two failure modes. The first is
              <strong class="text-ink font-semibold">rigidity</strong>: the library is built for one brand, and every other brand works around
              it, producing inconsistency and parallel implementations. The second is
              <strong class="text-ink font-semibold">fragmentation</strong>: the library tries to accommodate every brand's specifics directly,
              and the component API becomes so configurable that it stops enforcing anything.
            </Text>
            <Text size="lg" tone="ink">
              The solution to both is a clean separation between behavior and appearance. Components own their behavior: keyboard
              navigation, focus management, ARIA attributes, interaction patterns. Visual styling is supplied through the token
              system, which each brand can configure independently. A modal behaves the same way across every brand. It looks
              different because the tokens it references resolve to different values depending on which brand context it's rendered
              in.
            </Text>
            <Text size="lg" tone="ink">
              This isn't a novel approach. It's the approach that lets systems scale without fragmenting. The work is in executing
              it consistently across every component in the library.
            </Text>
          </div>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            <div class="border-t border-line pt-5">
              <p class="mono-label mb-3">Failure mode A</p>
              <Heading level={3} visual="h3" tone="ink">Too rigid</Heading>
              <Text tone="muted" class="mt-2">
                Built for one brand. Every other team works around it. Parallel implementations sprout in the margins.
              </Text>
            </div>
            <div class="border-t border-line pt-5">
              <p class="mono-label mb-3">Failure mode B</p>
              <Heading level={3} visual="h3" tone="ink">Too fragmented</Heading>
              <Text tone="muted" class="mt-2">
                Every brand's specifics baked into the API. The component stops enforcing anything and becomes a config soup.
              </Text>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="decisions" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 02</p>
          <Heading level={2} visual="display-md" tone="ink">Library decisions in practice</Heading>
        </div>
        <div class="case-layout__body">
          <Text size="lg" tone="ink" class="mt-8 measure">Building the library for this architecture meant making specific decisions at every layer.</Text>

          <ul class="mt-8 border-t border-line">
            <li class="flex gap-4 border-b border-line py-5 last:border-b-0">
              <Icon name="ph:plug" size={24} class="mt-0.5 flex-shrink-0 text-ink-muted" />
              <div>
                <Heading level={3} visual="h3" tone="ink">Brand-agnostic APIs</Heading>
                <Text tone="muted" class="mt-1">
                  Props controlled behavior and content, not visual style. No
                  <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 rounded-[4px]">brand</code>
                  prop forking the render tree. Visual differences flowed through the token system instead.
                </Text>
              </div>
            </li>
            <li class="flex gap-4 border-b border-line py-5 last:border-b-0">
              <Icon name="ph:palette" size={24} class="mt-0.5 flex-shrink-0 text-ink-muted" />
              <div>
                <Heading level={3} visual="h3" tone="ink">Complete token coverage</Heading>
                <Text tone="muted" class="mt-1">
                  Every brand difference had to be expressible as a token value rather than a one-off override. Gaps always surface
                  as CSS escape hatches, and that's how brand divergence accumulates.
                </Text>
              </div>
            </li>
            <li class="flex gap-4 border-b border-line py-5 last:border-b-0">
              <Icon name="ph:books" size={24} class="mt-0.5 flex-shrink-0 text-ink-muted" />
              <div>
                <Heading level={3} visual="h3" tone="ink">Storybook as development + docs</Heading>
                <Text tone="muted" class="mt-1">
                  Usage examples, variant coverage, and a11y notes were part of a component's definition of done, not something
                  added afterward. An undocumented component gets used incorrectly or rebuilt by a team who couldn't find it.
                </Text>
              </div>
            </li>
          </ul>

          <div class="mt-10">
            <CodeBlock
              filename="Button.tsx"
              lang="tsx"
              code={apiSnippet}
              caption="The decision in code: one brand-agnostic API, styled entirely through tokens, no render-tree forking."
            />
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
              A modal behaves the same way across every brand. It looks different because the tokens resolve differently depending
              on which brand context it's rendered in.
            </blockquote>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="accessibility" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 03</p>
          <Heading level={2} visual="display-md" tone="ink">Accessibility across every surface</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5">
            <Text size="lg" tone="ink">
              A multi-brand component library has a compounding relationship with accessibility. A keyboard navigation gap in a
              shared component isn't one violation: it's the same violation across every product that consumes the library. That
              made the case for treating accessibility as an architectural concern, not something addressed per-brand or per-feature.
            </Text>
            <Text size="lg" tone="ink">
              Keyboard operability, ARIA implementation, focus management in overlay components, and contrast against the token
              system's color values were requirements for every component, not optional enhancements. A developer using the library
              to build a feature got accessible behavior <em>without having to implement it</em>. That's the structural benefit of
              treating accessibility as a component-level concern.
            </Text>
          </div>

          <div class="mt-10 rounded-lg border border-line p-7">
            <p class="mono-label mb-5">Built-in, not bolted-on</p>
            <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
              {a11yChecklist.map((item) => (
                <li class="flex items-center gap-3 text-ink">
                  <Icon name={item.icon} size={20} class="flex-shrink-0 text-ink-muted" />
                  {item.label}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" id="scale" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 04</p>
          <Heading level={2} visual="display-md" tone="ink">What a shared library enables at scale</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5">
            <Text size="lg" tone="ink">
              The compounding return on a well-built shared component library shows up over time. New brand surfaces launch faster
              because the behavioral foundation already exists. The component API enforces the right patterns, so features ship
              consistently across brands. And because the documentation is accurate and the system is coherent, new engineers ramp
              up by reading it.
            </Text>
            <Text size="lg" tone="ink">
              A shared library built on a weak architectural foundation multiplies its problems at the same rate it multiplies its
              value. Every brand surface that consumes it inherits the same structural gaps.
            </Text>
          </div>

          <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-8 border-y border-line py-8">
            <Metric value="3" label="brands, one library" caption="Cook's Country, Cook's Illustrated, ATK" />
            <Metric value="0" label="brand-fork props" caption="divergence lives in tokens, not the API" />
            <Metric value="1" label="shared a11y baseline" caption="raised once, inherited by every surface" />
          </div>

          <div class="mt-12 grid gap-6 md:grid-cols-3">
            {outcomes.map((o) => (
              <div class="border-t border-line pt-5">
                <Icon name={o.icon} size={28} class="mb-3 text-ink-muted" />
                <Heading level={3} visual="h3" tone="ink">{o.title}</Heading>
                <Text size="sm" tone="muted" class="mt-1">{o.body}</Text>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="content">
      <figure class="grid gap-x-10 gap-y-10 md:grid-cols-12 md:items-start lg:gap-x-16">
        <figcaption class="md:col-span-4">
          <p class="mono-label mb-6">What Fran said</p>
          <div class="flex items-center gap-4 md:flex-col md:items-start md:gap-5">
            <img
              src="/images/testimonials/fran-middleton.jpeg"
              alt="Fran Middleton"
              class="h-14 w-14 rounded-full border border-line object-cover md:h-16 md:w-16"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="font-display font-semibold text-ink">Fran Middleton</p>
              <p class="mt-1 text-sm text-ink-muted leading-snug">Chief Digital Officer &middot; America's Test Kitchen</p>
            </div>
          </div>
        </figcaption>
        <blockquote class="md:col-span-8">
          <Icon name="ph:quotes" size={48} class="mb-5 text-accent opacity-25" />
          <p class="max-w-[46ch] font-display text-2xl md:text-3xl tracking-tight leading-snug text-ink">
            Josh built the component library that finally let our brands stop fighting in code. Cook's Country, Cook's
            Illustrated, and ATK all share the same primitives now: the visual difference comes from tokens, not parallel
            implementations. He raised the floor on accessibility for every team that touches the system.
          </p>
        </blockquote>
      </figure>
    </Container>
  </Section>

  <Section tone="ink" padding="loose">
    <Container width="wide">
      <p class="mono-label !text-paper/65 mb-6">Product engineering</p>
      <Heading level={2} visual="display-lg" tone="paper" class="max-w-3xl">When a product needs a system, I build that too.</Heading>
      <Text tone="whiteMuted" size="lg" class="mt-5 max-w-2xl">
        One component library, three brands, and one accessibility floor every team inherits.
        Sometimes building the whole product means building the system underneath it, so the
        right output becomes the default for teams I'll never sit next to.
      </Text>
      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <Button variant="navy" size="lg" iconLeft="ph:envelope" href="/contact/" class="js-magnetic">
          Get in touch
        </Button>
        <a
          href="/resume/"
          class="inline-flex items-center gap-2 font-sans text-sm font-medium text-paper/70 transition-colors hover:text-paper"
        >
          <Icon name="ph:file-text" size={18} />
          Résumé
        </a>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-paper/15 pt-8">
        <Link variant="arrow" href="/projects/vmspark/" class="!text-paper hover:!text-accent">Next: VMSpark</Link>
        <Link variant="arrow" href="/projects/" class="!text-paper hover:!text-accent">Back to all projects</Link>
      </div>
    </Container>
  </Section>
</BaseLayout>
