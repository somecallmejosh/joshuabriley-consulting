---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Link from '~/components/primitives/Link.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Metric from '~/components/patterns/Metric.astro';
import CodeBlock from '~/components/patterns/CodeBlock.astro';
import FidelityPlate from '~/components/patterns/FidelityPlate.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const title = 'IVFCRYO | Joshua Briley';
const description =
  'Case study: designing a self-service logistics platform for high-stakes fertility shipments, and building the full-stack system underneath it, from workflow modeling and two-sided user flows to a Rails 7.2 domain model wired to carrier, telemetry, and notification services.';

const meta = [
  { role: 'Role', value: 'Product Design Engineer' },
  { role: 'Domain', value: 'Fertility logistics' },
  { role: 'Scope', value: 'Product + platform' },
  { role: 'Build', value: 'Rails 7.2 · Postgres' },
];

const proof = [
  { label: 'Product design', items: ['Workflow & service modeling', 'Information architecture', 'Two-sided user flows', 'Forms as a recovery system', 'UI/UX design'] },
  { label: 'Engineering', items: ['Rails 7.2 + Postgres domain model', 'Enforced lifecycle state', 'Service-object integrations', 'Sidekiq background jobs', 'Front-end component system'] },
  { label: 'Integrations', items: ['SenseAware', 'ShipEngine', 'Airspace', 'SendGrid', 'Twilio', 'Devise 2FA'] },
  { label: 'Outcomes', items: ['75% fewer support calls', '55% fewer shipping errors', 'Faster onboarding', 'Reusable accessible base'] },
];

const docket = [
  { href: '#stakes', icon: 'ph:package', label: 'Modeling the workflow as a system' },
  { href: '#flows', icon: 'ph:squares-four', label: 'Designing both sides of the shipment' },
  { href: '#recovery', icon: 'ph:shield-check', label: 'Making the interface a recovery system' },
  { href: '#architecture', icon: 'ph:stack', label: 'Architecting the system underneath' },
  { href: '#outcomes', icon: 'ph:trend-up', label: 'What shipping it changed' },
];

// The physical chain of custody the software had to mirror, one leg at a time.
const custody = [
  { icon: 'ph:package', title: 'Outbound', body: 'IVFCryo FedExes the kit to the shipping customer two business days out, with a SenseAware cold-chain tracker inside.' },
  { icon: 'ph:airplane-tilt', title: 'Courier pickup', body: 'An Airspace medical courier collects the specimen and tracker from the shipping customer and hand-carries it.' },
  { icon: 'ph:map-pin', title: 'Delivery', body: 'The courier hands off to the receiving customer, who confirms the specimen and its temperature on arrival.' },
  { icon: 'ph:arrow-u-up-left', title: 'Return & close', body: 'The tracker FedExes back to IVFCryo, the excursion log is checked, and the shipment record closes.' },
];

// The information architecture forked by role off one shared home (the shipping list).
const customerFlow = [
  { label: 'Shipping list', note: 'Home. Active + past shipments, overdue alerts.' },
  { label: 'New shipment', note: 'Sender, receiver, specimen, live carrier pricing.' },
  { label: 'Payment', note: 'Confirmation, then routes into tracking.' },
  { label: 'Active shipment', note: 'Read-only tracking and sensor telemetry.' },
  { label: 'Receiving customers', note: 'Saved delivery contacts.' },
  { label: 'Profile', note: 'Billing, address, cancel account.' },
];

const adminFlow = [
  { label: 'Shipping list', note: 'Every active + past shipment across clients.' },
  { label: 'Active shipment', note: 'Edit, cancel, change status, notify.' },
  { label: 'Customer list', note: 'Filter, sort, open a client.' },
  { label: 'Customer detail', note: 'All orders for one client.' },
  { label: 'Add customer', note: 'Creates the account, emails credentials.' },
  { label: 'Profile', note: 'Account and billing.' },
];

// Design decisions that made the correct path easier than the incorrect one.
const recovery = [
  { icon: 'ph:list-checks', label: 'Structured records over free text' },
  { icon: 'ph:map-pin', label: 'Geocoded address validation' },
  { icon: 'ph:warning-circle', label: 'Inline validation, recoverable errors' },
  { icon: 'ph:eye', label: 'Text, icon, and shape, never color alone' },
  { icon: 'ph:target', label: 'Focus managed on visibility change' },
  { icon: 'ph:megaphone', label: 'Live-region status announcements' },
];

// The real integration boundaries, each isolated behind its own service object.
const integrations = [
  { icon: 'ph:thermometer-cold', name: 'SenseAware', role: 'Real-time temperature + GPS telemetry' },
  { icon: 'ph:barcode', name: 'ShipEngine', role: 'Multi-carrier rates and labels' },
  { icon: 'ph:airplane-tilt', name: 'Airspace', role: 'White-glove medical courier' },
  { icon: 'ph:envelope-simple', name: 'SendGrid', role: 'Email notifications' },
  { icon: 'ph:device-mobile', name: 'Twilio', role: 'SMS alerts, off-screen' },
  { icon: 'ph:lock-key', name: 'Devise + 2FA', role: 'Auth for medical logistics' },
];

const outcomes = [
  {
    icon: 'ph:phone-x',
    title: 'The call queue emptied',
    body: 'Self-service status and tracking answered the questions clients used to phone in for. Support calls fell by three quarters.',
  },
  {
    icon: 'ph:seal-check',
    title: 'Errors caught at the source',
    body: 'Structured records, geocoded addresses, and recoverable forms stopped mistakes at entry instead of downstream. Shipping errors fell by more than half.',
  },
  {
    icon: 'ph:stack',
    title: 'A foundation, not a finish',
    body: 'Accessible, reusable patterns became the baseline every future customer and admin workflow inherits.',
  },
];

// The shipment lifecycle as an enforced state model, grounded in the real domain:
// a shipment moves Pending -> Active -> Complete (Removed for cancellations), with
// the cold-chain records hanging off it. The data model IS the workflow, made durable.
const modelSnippet = `# app/models/shipment.rb
# Every screen, notification, and admin action is anchored to this state.
class Shipment < ApplicationRecord
  enum status: { pending: 0, active: 1, complete: 2, removed: 3 }

  has_many :shippable_packages
  has_one  :shipping_information
  has_one  :shipping_label
  has_one  :shipment_tracker     # SenseAware: temperature + GPS
  has_many :sensor_readings
  has_many :notifications

  # Cold-chain guarantee: a reading out of range pages the right
  # people off-screen (SendGrid + Twilio), not just inside the app.
  def record(reading)
    sensor_readings << reading
    TemperatureAlertJob.perform_async(id) if reading.out_of_range?
  end
end`;

// The annotated wireframe renders live in src/ so Astro can actually process
// them (anything under public/ is copied verbatim, never optimized). The source
// files are 3200px PNGs; `<Image>` emits sized WebP from these at build time.
const annotatedShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/ivfcryo/wires-and-flows/*.png',
  { eager: true },
);
const annotated = (slug: string) =>
  annotatedShots[`../../assets/projects/ivfcryo/wires-and-flows/${slug}.png`].default;

// The bare sketch + wireframe SVGs stay in public/: Astro passes SVGs through
// untransformed either way, so moving them would buy nothing.
const art = (slug: string) => `/images/projects/ivfcryo/wires-and-flows/${slug}`;

// Four screens carry the argument, so they get full plates. The `note` is the
// subtitle written on the artwork itself, not a fresh gloss on it.
const plates = [
  {
    slug: '03-shipments-index',
    index: '03',
    title: 'Shipments index',
    note: 'The primary workspace. Status is the top-level filter, not a column.',
    alt: 'Annotated wireframe of the shipments index: a filter bar, status tabs, and a list of shipment cards, with six numbered callouts explaining why status lives in the URL and why cards replaced table rows.',
  },
  {
    slug: '04-new-shipment',
    index: '04',
    title: 'New shipment',
    note: 'A forty-control form made survivable: numbered sections, live cost, and no dead ends.',
    alt: 'Annotated wireframe of the new-shipment form, broken into seven numbered sections from service selection to insurance, with a live price quote pinned beside it and six callouts covering quote recalculation, contact reuse, and notification defaults.',
  },
  {
    slug: '05-shipment-detail',
    index: '05',
    title: 'Shipment detail',
    note: 'One page that answers the only two questions anyone has: where is it, and is it still cold.',
    alt: 'Annotated wireframe of the shipment detail page: a live position map above sensor readings for temperature, humidity, and battery, then two parallel tracking timelines, with callouts explaining why telemetry outranks logistics and why the two legs stay unmerged.',
  },
  {
    slug: '06-public-tracking',
    index: '06',
    title: 'Public tracking',
    note: 'The unauthenticated view sent to recipients in notification email and SMS. No account, no sidebar, no telemetry.',
    alt: 'Annotated wireframe of the public tracking page: a plain-language status line, a four-step progress track, a live position map, and a staffed phone number in the footer, with callouts explaining why there is no login and why raw telemetry is withheld.',
  },
];

// The remaining screens round out the system without repeating the device.
const restOfSystem = [
  { slug: '01-landing', title: 'Landing' },
  { slug: '02-auth-two-factor', title: 'Auth + two-factor' },
  { slug: '07-address-book', title: 'Address book' },
  { slug: '08-users-admin', title: 'Users admin' },
  { slug: '09-equipment-inventory', title: 'Equipment inventory' },
  { slug: '10-admin-settings-feedback', title: 'Admin settings' },
];

const flows = [
  {
    slug: '11-flow-authentication',
    title: 'Authentication and account recovery',
    note: 'A security gate that must not become a support ticket. Every dead end has a way out.',
    alt: 'Flow diagram of authentication and account recovery. A visitor branches on whether they have an account, through sign-in, admin activation, a user-chosen email or SMS verification channel, and six-digit code entry. A failed code offers resend, backup code, or password reset, and a final admin check routes to either the admin or client view. Five numbered design notes sit alongside, and password recovery runs as a separate track underneath.',
  },
  {
    slug: '12-flow-create-shipment',
    title: 'Creating a shipment',
    note: 'The highest-consequence path in the product. Nine sections, one submit, no way to make an impossible booking.',
    alt: 'Flow diagram of the shipment creation path. Service selection resolves a live price quote or a contact-for-quote branch, then runs through date, package, pickup and delivery contacts, notification preferences, insurance, and agreement. Failed validation returns to the offending field with form state preserved, and a successful submit forks into a confirmation email and the admin fulfillment queue. Six numbered design notes sit alongside.',
  },
];

// Plates and flows are placed beside the argument they support rather than
// collected into one gallery, so these look them up by slug at the point of use.
const plate = (slug: string) => plates.find((p) => p.slug === slug)!;
const flow = (slug: string) => flows.find((f) => f.slug === slug)!;


---

<BaseLayout title={title} description={description}>

  <!-- HERO -->
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav
        class="hero-in hero-in-1 mb-12 flex items-center gap-2 text-sm text-ink-muted"
        aria-label="Breadcrumb"
      >
        <a href="/projects/" class="transition-colors hover:text-accent">Projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">IVFCRYO</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-main">
          <div class="hero-in hero-in-2 mb-7 flex items-center gap-3">
            <img src="/images/logos/ivfcryo.svg" alt="IVFCRYO logo" class="hero-logo-img" />
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <p class="mono-label">Case study</p>
          </div>

          <Heading level={1} visual="display-xl" class="hero-in hero-in-3">
            One shipment, two sides, and the whole <em class="ink-wink font-normal italic">system</em> underneath.
          </Heading>

          <Text size="lg" tone="muted" class="hero-in hero-in-4 mt-8 max-w-xl">
            A self-service platform for high-stakes fertility shipments that retired
            IVFCryo's paper-based process, from the customer and admin user flows down
            to the Rails domain model and the carrier, telemetry, and notification
            services wired beneath them.
          </Text>
        </div>

        <aside class="hero-in hero-in-5 hero-rail" aria-label="Project details">
          <dl>
            {meta.map((m) => (
              <div>
                <dt>{m.role}</dt>
                <dd set:html={m.value.replace(/·/g, '&middot;')}></dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  <!-- RECEIPTS -->
  <Section tone="paper" padding="tight" aria-label="Project receipts">
    <Container width="content">
      <p class="mono-label mb-8">Receipts</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <!-- ON THE DOCKET -->
  <Section tone="paper" padding="tight">
    <Container width="content">
      <p class="mono-label mb-5">On the docket</p>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {docket.map((item, i) => (
          <li>
            <a href={item.href} class="group inline-flex items-center gap-3 text-ink transition-colors hover:text-accent">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              {item.icon && (
                <Icon name={item.icon} size={16} class="shrink-0 text-ink-muted transition-colors group-hover:text-accent" />
              )}
              <span class="font-medium">{item.label}</span>
              <Icon name="ph:arrow-right" size={15} class="shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <Text size="lg" tone="muted" class="mt-10 measure">
        IVFCryo ships cryogenically preserved embryos and reproductive tissue:
        material that is, quite literally, irreplaceable. The process it replaced was
        manual and paper-based, spread across forms, phone calls, labels, and status
        updates where a single mistake could become a serious operational problem. The
        job was to design the product that replaced it and build the full-stack system
        underneath, so a clinician, a patient, or a courier could move a specimen
        across the country and always know exactly where it was, and that it was still
        cold.
      </Text>
    </Container>
  </Section>


  <!-- STEP 01 — MODEL THE WORKFLOW -->
  <Section tone="paper" padding="default" id="stakes" class="scroll-mt-24 border-t border-line space-y-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 01</p>
          <Heading level={2} visual="display-md" tone="ink">Modeling the workflow as a system</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Before a single screen, I mapped the shipping workflow as a system: a
              fragile, temperature-controlled specimen changing hands four times,
              across two carriers and a courier, on a fixed clinical timeline. A
              mislabeled box, a missed temperature excursion, or an ambiguous status
              isn't a workflow annoyance here. It can be irreversible for someone's
              family.
            </p>
            <p>
              So the first design artifact wasn't a wireframe. It was a map of the
              real-world chain of custody, because the software could only be as
              trustworthy as its model of what was actually happening to the box. Every
              leg below became a state the app had to hold, surface, and recover from.
              In the application that became an enforced lifecycle: a shipment moves
              from <strong class="text-ink font-semibold">Pending</strong> to
              <strong class="text-ink font-semibold">Active</strong> to
              <strong class="text-ink font-semibold">Complete</strong>, with a Removed
              state for cancellations.
            </p>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">The physical chain of custody</p>
            <ol class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
              {custody.map((node, i) => (
                <li class="relative border-t border-line pt-5">
                  <div class="mb-3 flex items-center gap-3">
                    <span class="font-mono text-sm text-accent">0{i + 1}</span>
                    <Icon name={node.icon} size={20} class="text-ink-muted" />
                  </div>
                  <Heading level={3} visual="h3" tone="ink" class="mb-1.5">{node.title}</Heading>
                  <Text size="sm" tone="muted">{node.body}</Text>
                </li>
              ))}
            </ol>
          </div>

          {/* First plate on the page, so the reading instructions live here rather
              than in a gallery preamble the reader meets before any artwork. */}
          <div class="mt-12 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-4">How to read the plates</p>
            <div class="space-y-4 text-ink-muted leading-relaxed">
              <p>
                Every screen went through the same three passes. A crude sketch to settle
                what the page is for, a clean wireframe to settle where things go, and then
                the same wireframe with the decisions written onto it.
              </p>
              <p>
                That third pass is the one that did the work. Writing down <em>why</em>
                status lives in the URL, or why a half-filled form is never abandoned, is
                what turned a picture of a screen into a decision anyone on the project
                could check. Switch any plate to walk the three passes.
              </p>
            </div>
          </div>

          <div class="mt-12">
            <FidelityPlate
              index={plate('05-shipment-detail').index}
              title={plate('05-shipment-detail').title}
              caption={plate('05-shipment-detail').note}
              sketch={art('05-shipment-detail-sketch.svg')}
              wire={art('05-shipment-detail.svg')}
              annotated={annotated('05-shipment-detail')}
              annotatedAlt={plate('05-shipment-detail').alt}
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- STEP 02 — TWO-SIDED PRODUCT DESIGN -->
  <Section tone="paper" padding="default" id="flows" class="scroll-mt-24 border-t border-line space-y-12">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 02</p>
          <Heading level={2} visual="display-md" tone="ink">Designing both sides of the shipment</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              One shipment has two very different users. The customer, often a clinic
              moving fast or a patient touching an emotionally loaded process for the
              first time, needs a short, reassuring path from request to tracking. The
              IVFCryo admin lives in the tool all day and needs range: every shipment,
              every client, and enough control to resolve the exceptions.
            </p>
            <p>
              Rather than build two apps, I mapped two sitemaps off one shared home,
              the shipping list, and let the information architecture fork from there.
              The page maps made the split explicit before a line of markup was written:
              which details belong in a focused customer experience, and which belong
              in a denser admin one. Same spine, different reach.
            </p>
          </div>

          <div class="mt-12">
            <p class="mono-label mb-6">Two roles, one shared home</p>
            <div class="grid gap-x-10 gap-y-10 md:grid-cols-2">
              <div>
                <div class="mb-5 flex items-center gap-3 border-b border-line-strong pb-3">
                  <Icon name="ph:user" size={18} class="text-accent" />
                  <p class="font-display font-semibold text-ink">Customer</p>
                </div>
                <ul>
                  {customerFlow.map((p, i) => (
                    <li class="flex gap-4 border-b border-line py-3.5 last:border-b-0">
                      <span class="mt-0.5 font-mono text-xs text-ink-faint">0{i + 1}</span>
                      <div>
                        <p class="font-medium text-ink leading-snug">{p.label}</p>
                        <p class="mt-0.5 text-sm text-ink-muted leading-snug">{p.note}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <div class="mb-5 flex items-center gap-3 border-b border-line-strong pb-3">
                  <Icon name="ph:users-three" size={18} class="text-accent" />
                  <p class="font-display font-semibold text-ink">Admin &middot; IVFCryo staff</p>
                </div>
                <ul>
                  {adminFlow.map((p, i) => (
                    <li class="flex gap-4 border-b border-line py-3.5 last:border-b-0">
                      <span class="mt-0.5 font-mono text-xs text-ink-faint">0{i + 1}</span>
                      <div>
                        <p class="font-medium text-ink leading-snug">{p.label}</p>
                        <p class="mt-0.5 text-sm text-ink-muted leading-snug">{p.note}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          {/* The shared home the two sitemaps fork off, then the flow that does
              the forking, then the third audience neither sitemap covers. */}
          <div class="mt-12">
            <FidelityPlate
              index={plate('03-shipments-index').index}
              title={plate('03-shipments-index').title}
              caption={plate('03-shipments-index').note}
              sketch={art('03-shipments-index-sketch.svg')}
              wire={art('03-shipments-index.svg')}
              annotated={annotated('03-shipments-index')}
              annotatedAlt={plate('03-shipments-index').alt}
            />
          </div>

          <div class="mt-14">
            <figure class="flow-plate">
              <p class="flow-plate__index">Flow <span aria-hidden="true">/</span> 11</p>
              <div class="flow-plate__mount">
                <div
                  class="flow-plate__stage"
                  tabindex="0"
                  role="group"
                  aria-label={`${flow('11-flow-authentication').title}: flow diagram, scrollable`}
                >
                  <Image
                    src={annotated('11-flow-authentication')}
                    alt={flow('11-flow-authentication').alt}
                    width={1400}
                    widths={[700, 1050, 1400]}
                    sizes="(min-width: 1024px) 720px, 100vw"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="flow-plate__fade" aria-hidden="true"></span>
              </div>
              <figcaption>
                <p class="flow-plate__title">{flow('11-flow-authentication').title}</p>
                <p class="flow-plate__note">{flow('11-flow-authentication').note}</p>
              </figcaption>
            </figure>
          </div>

          <div class="mt-14 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              A third audience never signs in at all. The receiving clinic or family
              gets a link by email and SMS, and needs one question answered without an
              account, a password, or a sidebar. That view withholds raw telemetry on
              purpose: a temperature graph is reassuring to an operator and alarming to
              someone waiting on a specimen, so the public page speaks in plain status
              and puts a staffed phone number in the footer.
            </p>
          </div>

          <div class="mt-12">
            <FidelityPlate
              index={plate('06-public-tracking').index}
              title={plate('06-public-tracking').title}
              caption={plate('06-public-tracking').note}
              sketch={art('06-public-tracking-sketch.svg')}
              wire={art('06-public-tracking.svg')}
              annotated={annotated('06-public-tracking')}
              annotatedAlt={plate('06-public-tracking').alt}
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- STEP 03 — RECOVERY SYSTEM + ACCESSIBILITY -->
  <Section tone="paper" padding="default" id="recovery" class="scroll-mt-24 border-t border-line">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 03</p>
          <Heading level={2} visual="display-md" tone="ink">Making the interface a recovery system</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The old process created too many chances for human error. So I treated the
              interface as a recovery system, not just a form system: it had to help
              users avoid errors, understand them when they happened, and move forward
              without calling support for every correction. Specimen and package details
              were captured as structured records instead of free text, addresses were
              geocoded and validated rather than trusted blindly, and critical actions
              got a confirmation point. The rule was simple:
