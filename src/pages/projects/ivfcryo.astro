<script>
  // Flow mounts only claim "more below" when the diagram really is cut off.
  document.querySelectorAll<HTMLElement>('.flow-plate__mount').forEach((mount) => {
    const stage = mount.querySelector<HTMLElement>('.flow-plate__stage');
    if (!stage) return;
    const sync = () => {
      mount.dataset.overflow = String(stage.scrollHeight > stage.clientHeight + 4);
    };
    stage.querySelectorAll('img').forEach((img) => {
      if (img.complete) sync();
      else img.addEventListener('load', sync, { once: true });
    });
    new ResizeObserver(sync).observe(mount);
    sync();
  });
</script>

