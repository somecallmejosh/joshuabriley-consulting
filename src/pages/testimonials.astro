---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  "Kind words from clients and colleagues I've had the pleasure of working with over 20 years of full-stack product engineering, accessibility, and design-systems work.";

const all = await getCollection('testimonials');
const sorted = all.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Testimonials | Joshua Briley | Product Engineer" description={description}>

  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="hero-in hero-in-1 flex items-center justify-between gap-4 mono-label">
        <span>Testimonials · {sorted.length} voices</span>
        <span class="hidden sm:inline text-ink-muted">20 yrs</span>
      </div>

      <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-8">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[16ch]">
            <em class="ink-wink font-normal italic">Kind words</em> from people I've worked with.
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
            These come from clients and colleagues I've had the pleasure of working with. Their
            words reflect what I care about most: collaboration, accessibility, and work that
            holds up over time.
          </Text>

          <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="#wall" iconRight="ph:arrow-down" class="js-magnetic">
              Read the wall
            </Button>
            <Button variant="ghost" size="lg" href="https://www.linkedin.com/in/joshuabriley/">
              Connect on LinkedIn
            </Button>
          </div>
        </div>
        <div class="hero-in hero-in-4 lg:col-span-4">
          <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted lg:flex-col lg:gap-y-3">
            {[`${sorted.length} voices`, '20 years', 'Apple · HubSpot · BHSI'].map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── THE WALL ───────────────────────── */}
  <Section id="wall" tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <Heading level={2} visual="display-md">
          Notes from collaborators.
        </Heading>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {sorted.map((t, i) => (
          <figure class="flex flex-col bg-paper p-7 md:p-8">
            <span aria-hidden="true" class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <blockquote class="mt-4 flex-1 shrink-0">

              <p class="font-display text-lg leading-snug tracking-[-0.01em] text-ink">
                {t.data.quote}
              </p>
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-line pt-5">
              {t.data.image ? (
                <img
                  src={t.data.image}
                  alt=""
                  loading="lazy"
                  class="h-9 w-9 rounded-full border border-line object-cover"
                />
              ) : (
                <span class="flex h-9 w-9 items-center justify-center rounded-full border border-line bg-raised font-mono text-[0.7rem] font-medium text-ink-muted" aria-hidden="true">
                  {t.data.initials}
                </span>
              )}
              <div class="">
                <p class="font-display text-sm font-medium tracking-tight text-ink">{t.data.name}</p>
                <p class="mt-0.5 font-mono text-[0.6rem] uppercase tracking-[0.1em] text-ink-muted">{t.data.role} · {t.data.company}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">References</p>
          <Heading level={2} visual="display-lg" tone="paper" class="mt-4 max-w-[22ch]">
            Most of these folks will take a call.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            If you're evaluating me for a role or a project and want to talk to someone I've
            worked with, just ask. I'm happy to make an introduction. Or reach out directly.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right">Get in touch</Button>
            <a
              href="https://www.linkedin.com/in/joshuabriley/"
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Connect on LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
