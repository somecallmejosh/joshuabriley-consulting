---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';

const description =
  'Design system audits, component library foundations, and design-to-code workflows that make shipping faster and reduce friction between design and engineering.';

const problems = [
  'Designers and engineers keep solving the same problems every single sprint.',
  'No shared source of truth, so features get restarted mid-build.',
  'Accessibility debt is quietly stacking up into real legal risk.',
  'A system exists, but no one uses it consistently.',
  "Documentation doesn't match reality, so teams fork components instead of extending them.",
];

const services = [
  {
    index: '01',
    eyebrow: 'Start here',
    title: 'Design System Audit',
    body: "A structured look at what's working, what's broken, and where the friction really lives. Before anything gets built or rebuilt, we need a map.",
    bullets: ['Component & token inventory', 'Accessibility & consistency review', 'Prioritized action plan you can run'],
    cta: 'Start with an audit',
    href: '/services/audit/',
  },
  {
    index: '02',
    eyebrow: 'Build the foundation',
    title: 'Component Library Starter',
    body: "A solid foundation your team can grow with. Designed for longevity, not a quick patch you'll rip out in six months.",
    bullets: ['Accessible, composable core components', 'Design tokens & theming architecture', 'Docs your team will actually read'],
    cta: 'Learn about the starter',
    href: '/services/starter/',
  },
  {
    index: '03',
    eyebrow: 'Fix the handoff',
    title: 'Design-to-Code Workflow',
    body: "The friction between design and engineering isn't a people problem, it's a process problem. I fix the process.",
    bullets: ['Figma ↔ code parity that holds up', "Handoff rituals that don't waste sprints", 'Shared language across design & eng'],
    cta: 'Learn about the workflow',
    href: '/services/workflow/',
  },
];

const process = [
  { n: '01', title: 'Intro call', body: "30 minutes. You tell me what's hurting, I ask the questions no one else has asked. We figure out if we're a fit. No pressure either way." },
  { n: '02', title: 'Audit & scope', body: "I dig into your system, your code, and the way your team actually works. You get a clear map of what's broken and a scoped plan to fix it." },
  { n: '03', title: 'Build & embed', body: "Whether it's a component library, workflow fixes, or both, I work alongside your team, not in a silo. Everything I build, your team owns." },
  { n: '04', title: 'Handoff & support', body: 'Your team runs with it. I stay close for questions, edge cases, and the occasional "wait, how should we do this?" moment.' },
];
---

<BaseLayout title="Services — Joshua Briley | Design Systems Consulting" description={description}>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Services &amp; Engagements</span>
        <span class="hidden sm:inline text-ink-muted">Index 01</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[18ch]">
            Your design system should make <em class="ink-wink font-normal italic">shipping faster</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Right now, it is probably making it slower — creating rework, accessibility risk, and
            friction between design and engineering. Let's fix that.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right" class="js-magnetic">
              Book an intro call
            </Button>
            <Button variant="ghost" size="lg" href="#services">
              See the services
            </Button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-lg border border-line bg-raised p-7 md:p-9">
            <p class="mono-label">Engagement ladder</p>
            <ol class="mt-5 divide-y divide-line">
              {services.map((s) => (
                <li class="flex items-baseline gap-4 py-4 first:pt-0 last:pb-0">
                  <span class="font-mono text-[0.75rem] text-accent">{s.index}</span>
                  <div>
                    <p class="font-display text-base font-medium tracking-tight text-ink">{s.title}</p>
                    <p class="mt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{s.eyebrow}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── PROBLEMS ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">Does any of this feel familiar / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">
          The patterns I see over and over.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          If two or three of these describe your team, you're probably leaving a lot of sprint
          velocity on the table.
        </Text>
      </div>

      <ul class="mt-12 divide-y divide-line border-y border-line">
        {problems.map((p, i) => (
          <li class="flex gap-5 py-5">
            <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-[1.05rem] leading-snug text-ink">{p}</p>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── SERVICES ───────────────────────── */}
  <Section id="services" tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">How I can help / 02</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Three ways to work together.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Every engagement starts with an audit. I won't build anything until I know what's actually
          broken.
        </Text>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3">
        {services.map((s) => (
          <div class="flex flex-col bg-paper p-7 md:p-9">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[0.75rem] text-accent">{s.index}</span>
              <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{s.eyebrow}</span>
            </div>
            <Heading level={3} visual="h2" class="mt-4">{s.title}</Heading>
            <Text tone="muted" class="mt-3">{s.body}</Text>
            <ul class="mt-6 divide-y divide-line border-t border-line">
              {s.bullets.map((b) => (
                <li class="flex items-start gap-3 py-3">
                  <Icon name="ph:check" size={16} class="mt-0.5 flex-shrink-0 text-accent" />
                  <span class="text-sm text-ink-muted">{b}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <Link href={s.href} variant="arrow">{s.cta}</Link>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-10 inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted">
        <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>
        I only take on a limited number of engagements at a time, so every client gets genuine attention.
      </p>
    </Container>
  </Section>

  {/* ───────────────────────── PROCESS (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">How engagements run / 03</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-4">
          A simple, honest process.
        </Heading>
        <Text size="lg" tone="whiteMuted" class="mt-5">
          No mystery, no theater, no month-long discovery deck.
        </Text>
      </div>

      <ol class="mt-14 grid gap-px overflow-hidden rounded-lg border border-paper/10 bg-paper/10 sm:grid-cols-2">
        {process.map((step) => (
          <li class="bg-ink p-7 md:p-9">
            <span class="font-mono text-[0.75rem] text-accent">{step.n}</span>
            <Heading level={3} visual="h3" tone="paper" class="mt-3">{step.title}</Heading>
            <p class="mt-2.5 text-sm leading-relaxed text-paper/70">{step.body}</p>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  {/* ───────────────────────── SCORECARD STRIP ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid items-center gap-8 rounded-lg border border-line bg-raised p-8 md:grid-cols-12 md:p-10">
        <div class="md:col-span-9">
          <p class="mono-label">Free tool / 04</p>
          <Heading level={2} visual="h2" class="mt-4">Not sure where to start?</Heading>
          <Text tone="muted" class="mt-3 max-w-xl">
            Take the free Design System Scorecard. Ten minutes. No fluff. You'll know exactly where
            your system stands.
          </Text>
        </div>
        <div class="md:col-span-3 md:flex md:justify-end">
          <Button variant="primary" href="/tools/scorecard/" iconRight="ph:arrow-right">
            Get the scorecard
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CTA ───────────────────────── */}
  <CTABanner
    eyebrow="Start a project / 05"
    title="Let's fix your system."
    lead="Book a 30-minute intro call. We'll talk about what's breaking down and whether an engagement would actually help."
  >
    <Button variant="primary" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right">
      Book an intro call
    </Button>
    <Button variant="text" href="/contact/">
      Or send a note
    </Button>
  </CTABanner>
</BaseLayout>
