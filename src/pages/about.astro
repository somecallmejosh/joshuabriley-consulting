---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  '20 years building UI systems where accessibility is architecture, documentation is delivery, and the right output is the natural result of using the system.';

const currentWork = [
  {
    company: 'Travelers',
    stack: 'Web Components · React',
    body:
      'An accessible component library that crosses framework boundaries — built so the right markup is the only markup you can ship.',
  },
  {
    company: 'Berkshire Hathaway Specialty',
    stack: 'Vue.js · Nuxt.js',
    body:
      "An enterprise-scale component library for an insurance platform where consistency isn't aesthetic — it's regulatory.",
  },
  {
    company: "America's Test Kitchen",
    stack: 'React · Next.js',
    body:
      'A shared component system unifying multiple editorial brands — where design tokens carry as much weight as the recipes.',
  },
];

const principles = [
  {
    index: '01',
    title: 'Accessibility as architecture',
    body:
      "Not an audit at the end. Not a ticket for later. A structural constraint, built into the foundation, so every component that leaves the library is accessible because it can't be any other way.",
  },
  {
    index: '02',
    title: 'Documentation is delivery',
    body:
      "A component without accurate docs isn't done. It's a riddle. I treat the written word as part of the shipped artifact — examples, rationale, edge cases, and all.",
  },
  {
    index: '03',
    title: 'Directness over diplomacy',
    body:
      "If your system is sick, I'll tell you exactly where and why — kindly, but without hedging. Then we'll map the shortest honest path to health. You're hiring me for the truth, not the comfort.",
  },
];

const learning = [
  { title: 'WAI-ARIA & APG', note: 'Authoring practices for patterns that truly work for assistive tech.' },
  { title: 'Design Tokens CG', note: 'The emerging standard for portable, multi-platform design decisions.' },
  { title: 'CSS Working Group', note: 'Container queries, anchor positioning, cascade layers — the good stuff.' },
  { title: 'Rudiment UI', note: 'My open-source sandbox for accessible component primitives.' },
];
---

<BaseLayout title="About — Joshua Briley | UX Engineer & Design Systems Consultant" description={description}>

  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>About · UX Engineer</span>
        <span class="hidden sm:inline text-ink-muted">20 yrs · Index 01</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[18ch]">
            I build the <em class="ink-wink font-normal italic">quiet parts</em> of great products.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            I'm a UX software engineer and design-systems consultant. For two decades I've
            lived at the seam between design and engineering — building the component
            libraries, tokens, and documentation that let teams ship faster without tripping
            over themselves.
          </Text>
          <Text tone="muted" class="mt-5 max-w-xl">
            My favorite question to sit with is a quiet one:
            <em class="text-ink not-italic font-medium"> how do you build a system where the
            right output is the natural result of using it</em> — not something individual
            developers have to remember to do correctly?
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">
              Get in touch
            </Button>
            <Button variant="ghost" size="lg" href="/projects/">
              See the work
            </Button>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            {['Design systems', 'Accessibility', 'Documentation', 'UX engineering'].map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-5">
          <figure class="overflow-hidden rounded-lg border border-line">
            <img
              src="/images/josh-biz-cazsh.jpg"
              alt="Joshua Briley, UX Engineer"
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
              width="640"
              height="800"
            />
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── PULL QUOTE ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-b border-line">
    <Container width="narrow">
      <p class="mono-label">The question / 02</p>
      <blockquote class="mt-5">
        <p class="font-display text-2xl md:text-3xl lg:text-[2.5rem] font-semibold leading-[1.15] tracking-[-0.025em] text-ink text-balance">
          How do you build a system that makes the
          <span class="text-accent">right output</span> the natural result of using it —
          rather than the result of individual developers making the right decisions?
        </p>
      </blockquote>
      <p class="mt-6 mono-label">The question I'm always chasing</p>
    </Container>
  </Section>

  {/* ───────────────────────── PRINCIPLES ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">How I work / 03</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Three things I hold on to.
        </Heading>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3">
        {principles.map((p) => (
          <div class="bg-paper p-7 md:p-9">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[0.75rem] text-accent">{p.index}</span>
              <Heading level={3} visual="h3">{p.title}</Heading>
            </div>
            <Text tone="muted" class="mt-3">{p.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CURRENT WORK (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">Where this lands / 04</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-4">
          Systems in production, not slideware.
        </Heading>
        <Text size="lg" tone="whiteMuted" class="mt-5">
          The work shows up in places where consistency carries weight — across frameworks,
          across brands, and under regulatory scrutiny.
        </Text>
      </div>

      <ul class="mt-14 border-t border-paper/10">
        {currentWork.map((w) => (
          <li>
            <div class="grid grid-cols-12 items-baseline gap-4 border-b border-paper/10 py-5">
              <span class="col-span-12 sm:col-span-4 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{w.stack}</span>
              <span class="col-span-12 sm:col-span-8">
                <span class="font-display text-lg font-medium tracking-tight text-paper">{w.company}</span>
                <span class="mt-1 block text-sm text-paper/55 max-w-2xl">{w.body}</span>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── ALWAYS LEARNING ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label">Always learning / 05</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[16ch]">
            Twenty years in, still reading the spec drafts.
          </Heading>
          <div class="mt-7 space-y-4 text-ink-muted leading-relaxed max-w-md">
            <p>
              I stay close to the sources: WAI-ARIA working drafts, the Design Tokens Community
              Group, CSS Working Group proposals. The platform moves — the best systems move
              with it.
            </p>
            <p>
              I also maintain <span class="text-ink font-medium">Rudiment UI</span>, an
              open-source library where I sharpen ideas in public before they land in client work.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7">
          <p class="mono-label">Currently on the nightstand</p>
          <ul class="mt-5 divide-y divide-line border-y border-line">
            {learning.map((item, i) => (
              <li class="flex items-baseline gap-4 py-4">
                <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p class="font-display text-base font-medium tracking-tight text-ink">{item.title}</p>
                  <p class="mt-0.5 text-sm text-ink-muted">{item.note}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">Work together / 06</p>
          <Heading level={2} visual="display-lg" tone="paper" class="mt-4 max-w-[20ch]">
            Think we'd work well together?
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            Whether you're hiring for a team or untangling a system, send a note. I'll tell you
            honestly whether I'm the right fit. If not, I probably know who is.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right">Get in touch</Button>
            <a
              href="https://www.linkedin.com/in/joshuabriley/"
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Connect on LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
