---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  'Design- and front-end-focused product design engineer. 20 years in production UI: design-grade, accessible interfaces with the judgment most teams have to hire a separate designer to get.';

// Same four chips as the home page, worded identically. Two pages rendering the
// same strip with different items read as two different claims.
const capabilities = [
  'Design-grade front-end',
  'React · TypeScript',
  'Accessibility built in',
  'Design systems',
];

const principles = [
  {
    index: '01',
    title: 'The UI is where the value is',
    body:
      "The interface is my strongest work: type, spacing, motion, the empty and error states most engineers leave blank. I build it design-grade myself, instead of handing a spec to someone who will approximate it.",
  },
  {
    index: '02',
    title: 'Design and accessibility, built in',
    body:
      "Not an audit at the end. Not a ticket for later. The keyboard paths, focus states, and empty screens are part of how I build, which is why the things I ship work for everyone and feel finished.",
  },
  {
    index: '03',
    title: 'Directness over diplomacy',
    body:
      "If a product is in trouble, I'll tell you exactly where and why. Kindly, but without hedging. Then we'll map the shortest honest path forward. You're hiring me for the truth, not the comfort.",
  },
];

const learning = [
  { title: 'WAI-ARIA & APG', note: 'Authoring practices for patterns that truly work for assistive tech.' },
  { title: 'Design Tokens CG', note: 'The emerging standard for portable, multi-platform design decisions.' },
  { title: 'CSS Working Group', note: 'Container queries, anchor positioning, cascade layers (the good stuff).' },
  { title: 'Rudiment UI', note: 'My open-source React component library, built with the reasoning left in.' },
];
---

<BaseLayout title="About | Joshua Briley | Product Design Engineer" description={description}>

  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="hero-in hero-in-1 flex items-center justify-between gap-4 mono-label">
        <span>About · Product Design Engineer</span>
        <span class="hidden sm:inline text-ink-muted">20 yrs</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[18ch]">
            I build the whole product, and I sweat the parts most engineers <em class="ink-wink font-normal italic">skip</em>.
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-xl">
            I'm a design- and front-end-focused product design engineer with 20 years in production UI. The
            interface is where I bring the most value: design-grade, accessible, with the judgment
            most teams have to hire a separate designer to get.
          </Text>
          {/* The empty-state/keyboard-path formulation is the pull quote's job
              one section down. Saying it twice on one page blunts it, so this
              paragraph carries the range instead. */}
          <Text tone="muted" class="hero-in hero-in-3 mt-5 max-w-xl">
            I work across the whole product, from the stakeholder interviews that decide what to
            build through to the <em class="text-ink not-italic font-medium">data model the
            interface has to keep its promises against</em>. But the surface is where I do my
            best work, and where I hold the highest standard.
          </Text>

          <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">
              Get in touch
            </Button>
            <Button variant="ghost" size="lg" href="/projects/">
              See the work
            </Button>
          </div>

          <ul class="hero-in hero-in-4 mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            {capabilities.map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>

        <div class="hero-in hero-in-5 lg:col-span-5">
          <figure class="overflow-hidden rounded-lg border border-line">
            <picture>
              <source srcset="/images/about/josh-biz-cazsh.webp" type="image/webp" />
              <img
                src="/images/about/josh-biz-cazsh.jpg"
                alt="Joshua Briley, product design engineer"
                class="aspect-[4/5] w-full object-cover"
                loading="lazy"
                width="640"
                height="800"
              />
            </picture>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── PULL QUOTE ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-b border-line">
    <Container width="narrow">
      <p class="mono-label">The standard</p>
      <blockquote class="mt-5">
        <p class="font-display text-2xl md:text-3xl lg:text-[2.5rem] font-semibold leading-[1.15] tracking-[-0.025em] text-ink text-balance">
          Most engineers ship the screen. I ship the empty state, the keyboard
          path, and the screen that shows when there's
          <span class="text-accent">nothing to show yet</span>.
        </p>
      </blockquote>
      <p class="mt-6 mono-label">The last 10% is the point</p>
    </Container>
  </Section>

  {/* ───────────────────────── PRINCIPLES ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">How I work</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Three things I hold on to.
        </Heading>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3"
        data-reveal-stagger
      >
        {principles.map((p) => (
          <div class={`bg-paper p-7 md:p-9 ${p.index === '01' ? 'lg:col-span-2 lg:row-span-2 lg:flex lg:flex-col lg:justify-center md:p-10' : ''}`}>
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[0.75rem] text-accent">{p.index}</span>
              <Heading level={3} visual={p.index === '01' ? 'h2' : 'h3'}>{p.title}</Heading>
            </div>
            <Text tone="muted" class={p.index === '01' ? 'mt-4 max-w-lg' : 'mt-3'} size={p.index === '01' ? undefined : 'sm'}>{p.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── ALWAYS LEARNING ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label">Always learning</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[16ch]">
            Twenty years in, still reading the spec drafts.
          </Heading>
          <div class="mt-7 space-y-4 text-ink-muted leading-relaxed max-w-md">
            <p>
              I stay close to the sources: WAI-ARIA working drafts, the Design Tokens Community
              Group, CSS Working Group proposals. The platform moves. The best systems move
              with it.
            </p>
            <p>
              I also maintain <span class="text-ink font-medium">Rudiment UI</span>, an
              open-source React component library where I sharpen ideas in public before they land
              in production systems.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7">
          <p class="mono-label">What I follow</p>
          <ul class="mt-5 divide-y divide-line border-y border-line" data-reveal-stagger>
            {learning.map((item, i) => (
              <li class="flex items-baseline gap-4 py-4">
                <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p class="font-display text-base font-medium tracking-tight text-ink">{item.title}</p>
                  <p class="mt-0.5 text-sm text-ink-muted">{item.note}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <Heading level={2} visual="display-lg" tone="paper" class="max-w-[20ch] text-balance">
            Think we'd work well together?
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            If you're hiring a product design engineer who builds the whole thing and sweats the finish,
            send a note. I'll tell you honestly whether I'm the right fit, and if not, I probably
            know who is.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">Get in touch</Button>
            <a
              href="/resume/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Résumé <Icon name="ph:file-text" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
