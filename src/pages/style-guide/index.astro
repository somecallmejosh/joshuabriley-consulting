---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Grid from '~/components/layout/Grid.astro';
import SectionHeader from '~/components/patterns/SectionHeader.astro';
import Metric from '~/components/patterns/Metric.astro';
import CodeBlock from '~/components/patterns/CodeBlock.astro';
import FAQ from '~/components/patterns/FAQ.astro';
import FAQItem from '~/components/patterns/FAQItem.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Logo from '~/components/primitives/Logo.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';
import Badge from '~/components/primitives/Badge.astro';
import Field from '~/components/form/Field.astro';
import Input from '~/components/form/Input.astro';
import Textarea from '~/components/form/Textarea.astro';
import Select from '~/components/form/Select.astro';
import ChoiceGroup from '~/components/form/ChoiceGroup.astro';
import Choice from '~/components/form/Choice.astro';
import FormAlert from '~/components/form/FormAlert.astro';
import SubmitButton from '~/components/form/SubmitButton.astro';

// ── Foundations: the constrained token set that drives the whole system.
// Hex values mirror :root in src/styles/site.css. Swatches are rendered as
// small hairline-bordered chips, not bright scrapbook tiles.
const tokens = [
  { name: 'paper',       token: '--paper',       hex: '#F5F4F1', note: 'Page background', fill: 'bg-paper', border: 'border-line-strong' },
  { name: 'raised',      token: '--raised',      hex: '#FFFFFF', note: 'Cards, inputs', fill: 'bg-raised', border: 'border-line-strong' },
  { name: 'ink',         token: '--ink',         hex: '#1B1A17', note: 'Headings, body, dark sections', fill: 'bg-ink', border: 'border-ink' },
  { name: 'ink-muted',   token: '--ink-muted',   hex: '#5C5B55', note: 'Body min on paper (AA)', fill: 'bg-[#5C5B55]', border: 'border-[#5C5B55]' },
  { name: 'ink-faint',   token: '--ink-faint',   hex: '#9A9892', note: 'Decorative only, never body text', fill: 'bg-[#9A9892]', border: 'border-[#9A9892]' },
  { name: 'line',        token: '--line',        hex: '#E5E3DC', note: 'Hairline borders, dividers', fill: 'bg-line', border: 'border-line-strong' },
  { name: 'line-strong', token: '--line-strong', hex: '#D6D3CA', note: 'Emphasised hairline', fill: 'bg-line-strong', border: 'border-line-strong' },
  { name: 'accent',      token: '--accent',      hex: '#A8412A', note: 'One clay accent, used sparingly', fill: 'bg-accent', border: 'border-accent' },
];

// Live in-section nav for the editorial rail.
const sections = [
  { id: 'foundations', label: 'Foundations' },
  { id: 'typography',  label: 'Typography' },
  { id: 'primitives',  label: 'Primitives' },
  { id: 'patterns',    label: 'Patterns' },
  { id: 'forms',       label: 'Forms' },
  { id: 'motion',      label: 'Motion & spacing' },
];

const apiSnippet = `// Field.astro — accessibility wired in by construction.
// label[for], input id, aria-describedby (hint + error),
// aria-invalid and aria-required are all derived, never hand-set.
const hintId = hint ? \`\${id}-hint\` : undefined;
const errorId = error ? \`\${id}-error\` : undefined;
const describedBy =
  [hintId, errorId].filter(Boolean).join(' ') || undefined;
// You cannot create a mislabeled input through this API.`;

// Illustrative metric figures — replace with real numbers in production.
const metrics = [
  { value: '8', label: 'colour tokens drive everything' },
  { value: '2', label: 'typefaces: Hanken + Geist Mono' },
  { value: '100%', label: 'components keyboard-operable' },
  { before: '6', value: '1', label: 'button implementations' },
];
---

<BaseLayout
  title="Design system: Editorial-Technical reference | Joshua Briley"
  description="The Editorial-Technical design system: warm paper, near-black ink, one clay accent, Hanken Grotesk and Geist Mono. Colour tokens, type scale, primitives, patterns, and accessible form components."
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Design system / Reference</span>
        <span class="hidden sm:inline text-ink-muted">Editorial-Technical · 2026</span>
      </div>

      <div class="mt-10 max-w-3xl lg:mt-14">
        <Heading level={1} visual="display-xl">
          The Editorial-Technical system.
        </Heading>
        <Text size="lg" tone="muted" class="mt-7">
          Warm paper, near-black ink, and a single clay accent. Hanken Grotesk for
          headings, Geist Mono for labels. Small radii, hairline borders, heavy
          whitespace. Every page on the site composes from the tokens and
          components documented here.
        </Text>
      </div>

      <nav aria-label="Reference sections" class="mt-10 flex flex-wrap items-center gap-2">
        {sections.map((s) => (
          <Button variant="ghost" size="sm" href={`#${s.id}`}>{s.label}</Button>
        ))}
      </nav>
    </Container>
  </Section>

  {/* ───────────────────────── 01 · FOUNDATIONS ───────────────────────── */}
  <Section id="foundations" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Foundations / 01</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">Colour tokens.</Heading>
        <Text tone="muted" class="mt-4">
          The full palette is eight tokens. There are no bright fills, no gradients.
          Contrast and rhythm come from ink on paper, with the clay accent reserved
          for one mark per view. Every value is a CSS custom property in
          <code class="font-mono text-[0.9em] text-accent"> :root</code>.
        </Text>
      </div>

      <Grid cols={4} gap="md" class="mt-12">
        {tokens.map((t) => (
          <div class="rounded-lg border border-line bg-raised p-4">
            <div class={`h-16 w-full rounded-[5px] border ${t.fill} ${t.border}`}></div>
            <div class="mt-4 flex items-baseline justify-between gap-2">
              <span class="font-sans text-sm font-semibold tracking-tight text-ink">{t.name}</span>
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.06em] text-ink-muted">{t.hex}</span>
            </div>
            <p class="mt-1 font-mono text-[0.65rem] text-accent">{t.token}</p>
            <p class="mt-2 text-xs leading-relaxed text-ink-muted">{t.note}</p>
          </div>
        ))}
      </Grid>

      <div class="mt-10 rounded-lg border border-line bg-raised p-6 md:p-7">
        <p class="mono-label">Contrast contract</p>
        <Text size="sm" tone="muted" class="mt-3 max-w-3xl">
          WCAG AA throughout. On paper, body copy never goes lighter than
          <code class="font-mono text-[0.9em] text-ink"> ink-muted</code>;
          <code class="font-mono text-[0.9em] text-ink"> ink-faint</code> is decorative only
          (rules, dividers, disabled marks). On ink surfaces, text stays at
          <code class="font-mono text-[0.9em] text-ink"> text-paper</code> or
          <code class="font-mono text-[0.9em] text-ink"> text-paper/70</code> and above.
        </Text>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── 02 · TYPOGRAPHY ───────────────────────── */}
  <Section id="typography" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Typography / 02</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">Two typefaces, one scale.</Heading>
        <Text tone="muted" class="mt-4">
          Hanken Grotesk carries display and body; Geist Mono carries every label,
          index, and eyebrow. The <code class="font-mono text-[0.9em] text-accent">Heading</code> primitive
          splits semantic level from visual size, so the document outline never breaks
          to satisfy a layout.
        </Text>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line">
        {[
          { spec: 'Heading · display-xl', visual: 'display-xl' as const, sample: 'Display extra-large' },
          { spec: 'Heading · display-lg', visual: 'display-lg' as const, sample: 'Display large' },
          { spec: 'Heading · display-md', visual: 'display-md' as const, sample: 'Display medium' },
          { spec: 'Heading · h2',         visual: 'h2' as const,         sample: 'Section heading (h2)' },
          { spec: 'Heading · h3',         visual: 'h3' as const,         sample: 'Subsection heading (h3)' },
          { spec: 'Heading · h4',         visual: 'h4' as const,         sample: 'Minor heading (h4)' },
        ].map((row) => (
          <div class="bg-paper px-6 py-7 md:px-8">
            <p class="mono-label mb-3">{row.spec}</p>
            <Heading level={3} visual={row.visual}>{row.sample}</Heading>
          </div>
        ))}
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Text · body sizes</p>
          <div class="mt-5 space-y-4">
            <Text size="xl">size xl: lead paragraph, comfortable and unhurried.</Text>
            <Text size="lg" tone="muted">size lg: secondary lead, muted ink.</Text>
            <Text size="base" tone="muted">size base: standard body copy at ink-muted.</Text>
            <Text size="sm" tone="muted">size sm: captions and supporting notes.</Text>
            <Text size="xs" tone="muted">size xs: fine print, still AA on paper.</Text>
          </div>
        </div>

        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Geist Mono · labels</p>
          <div class="mt-5 space-y-6">
            <div>
              <p class="mono-label">Foundations / 01</p>
              <Text size="sm" tone="muted" class="mt-2">
                The <code class="font-mono text-[0.9em] text-ink">.mono-label</code> eyebrow:
                uppercase, tracked, ink-muted. Numbered to anchor each section.
              </Text>
            </div>
            <div>
              <p class="font-mono text-sm text-ink">const tokens = await build();</p>
              <Text size="sm" tone="muted" class="mt-2">
                Inline mono for code, indices, and spec rails.
              </Text>
            </div>
            <div class="flex items-center gap-3">
              <Logo variant="wordmark" />
              <span class="mono-label">Wordmark · Hanken</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── 03 · PRIMITIVES ───────────────────────── */}
  <Section id="primitives" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Primitives / 03</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">The smallest reusable pieces.</Heading>
        <Text tone="muted" class="mt-4">
          Each primitive enforces accessibility through its API: semantic defaults,
          required labels, decoupled visual sizing. They render the same on every page.
        </Text>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        {/* Buttons */}
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Button: variants &amp; sizes</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Button variant="primary" iconRight="ph:arrow-right">Primary</Button>
            <Button variant="ghost">Ghost</Button>
            <Button variant="text">Text</Button>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="sm">Small</Button>
            <Button variant="primary" size="md">Medium</Button>
            <Button variant="primary" size="lg" iconLeft="ph:paper-plane-tilt">Large + icon</Button>
          </div>
          <Text size="xs" tone="muted" class="mt-4">
            <code class="font-mono text-ink">primary</code> and
            <code class="font-mono text-ink"> navy</code> are for dark surfaces (shown below);
            <code class="font-mono text-ink"> secondary</code> is the outlined action on ink.
          </Text>
        </div>

        {/* Buttons on ink */}
        <div class="rounded-lg border border-ink bg-ink p-6 md:p-8">
          <p class="mono-label !text-paper/65">Button: on ink surfaces</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Button variant="navy" iconRight="ph:arrow-right">Navy (inverse fill)</Button>
            <Button variant="secondary">Secondary (outlined)</Button>
          </div>
          <Text size="xs" tone="whiteMuted" class="mt-4">
            Reserved for ink sections: paper fill or a hairline outline, never the
            paper-surface primary.
          </Text>
        </div>

        {/* Links */}
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Link: inline / arrow / nav</p>
          <div class="mt-5 space-y-3 text-sm">
            <p class="text-ink-muted">
              Read <Link href="/about/" variant="inline">the approach</Link>. Inline links
              carry a quiet clay underline.
            </p>
            <p><Link href="/projects/" variant="arrow">Selected work</Link></p>
            <p class="flex gap-5">
              <Link href="/style-guide/" variant="nav" current>Active nav</Link>
              <Link href="/blog/" variant="nav">Inactive nav</Link>
            </p>
          </div>
        </div>

        {/* Badge */}
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Badge: mono label chip</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Badge>Default</Badge>
            <Badge icon="ph:package">With icon</Badge>
            <Badge tone="coral">Accent tick</Badge>
            <Badge solid>Solid ink</Badge>
            <Badge size="sm">Small</Badge>
          </div>
          <Text size="xs" tone="muted" class="mt-4">
            A hairline tile in Geist Mono with a small tick: accent on
            <code class="font-mono text-ink"> coral</code>/<code class="font-mono text-ink">sunset</code>,
            neutral otherwise.
          </Text>
        </div>

        {/* Logo */}
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Logo: lockup / monogram / wordmark</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-6">
            <Logo variant="lockup" />
            <Logo variant="monogram" />
            <Logo variant="wordmark" />
          </div>
          <Text size="xs" tone="muted" class="mt-5">
            A machined monogram plate plus a tight grotesk wordmark. The wordmark
            carries the accessible name; the monogram is decorative.
          </Text>
        </div>

        {/* Icon */}
        <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
          <p class="mono-label">Icon: Phosphor set</p>
          <div class="mt-6 flex flex-wrap items-center gap-6 text-ink">
            <Icon name="ph:arrow-right" size={26} />
            <Icon name="ph:check-circle" size={26} />
            <Icon name="ph:warning-circle" size={26} class="text-accent" />
            <Icon name="ph:terminal-window" size={26} />
            <Icon name="ph:package" size={26} />
          </div>
          <Text size="xs" tone="muted" class="mt-5">
            Decorative (aria-hidden) by default. Pass <code class="font-mono text-ink">label</code>
            to expose a meaningful icon to assistive tech.
          </Text>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── 04 · PATTERNS ───────────────────────── */}
  <Section id="patterns" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Patterns / 04</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">Compositions used across pages.</Heading>
        <Text tone="muted" class="mt-4">
          A small set of patterns built from the primitives above: a section header,
          a metrics row, a code window, and an FAQ. Every page draws from this set.
        </Text>
      </div>

      {/* SectionHeader */}
      <div class="mt-12 rounded-lg border border-line bg-raised p-7 md:p-10">
        <p class="mono-label mb-6">SectionHeader</p>
        <SectionHeader
          eyebrow="Pattern"
          eyebrowIcon="ph:columns"
          title="A centred section header."
          lead="Eyebrow Badge, balanced display heading, and an optional muted lead: the standard opener for a content section."
        />
      </div>

      {/* Metric */}
      <div class="mt-8 rounded-lg border border-line bg-raised p-7 md:p-10">
        <p class="mono-label mb-6">Metric: a row of measured outcomes</p>
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          {metrics.map((m) => (
            <Metric value={m.value} before={m.before} label={m.label} />
          ))}
        </div>
        <Text size="xs" tone="muted" class="mt-6">
          Oversized ink figure, sans label, optional before→after. Illustrative values
          shown. Use only real, defensible numbers in production.
        </Text>
      </div>

      {/* CodeBlock */}
      <div class="mt-8">
        <p class="mono-label mb-4">CodeBlock: framed code window</p>
        <CodeBlock
          filename="Field.astro"
          lang="ts"
          code={apiSnippet}
          caption="A real component API, shown (not asserted). Dependency-free chrome carries the polish."
        />
      </div>

      {/* FAQ */}
      <div class="mt-10 rounded-lg border border-line bg-raised p-7 md:p-10">
        <p class="mono-label mb-2">FAQ: native details/summary, zero JS</p>
        <FAQ class="mt-4">
          <FAQItem question="Why only one accent colour?" open>
            Restraint reads as deliberate. A single clay mark per view keeps attention
            where it belongs and never competes with content.
          </FAQItem>
          <FAQItem question="How is accessibility handled?">
            By construction. Primitives bake in semantic structure, required labels, and
            AA contrast, so misuse is hard to reach for in the first place.
          </FAQItem>
          <FAQItem question="What carries motion?">
            Two shared easings plus scroll-reveal: transform and opacity only, and it
            all pauses under prefers-reduced-motion.
          </FAQItem>
        </FAQ>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── 05 · FORMS ───────────────────────── */}
  <Section id="forms" tone="paper" padding="default" class="border-b border-line">
    <Container width="wide">
      <p class="mono-label">Forms / 05</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md">Accessibility wired in by default.</Heading>
        <Text tone="muted" class="mt-4">
          <code class="font-mono text-[0.9em] text-accent">Field</code> auto-generates ids and
          connects label, hint, error, aria-describedby, aria-invalid, and
          aria-required. You cannot create a mislabeled input through this API.
        </Text>
      </div>

      <Grid cols={2} gap="lg" class="mt-12">
        <form class="rounded-lg border border-line bg-raised p-6 md:p-8 flex flex-col gap-5">
          <Heading level={3} visual="h4">Field examples</Heading>

          <Field label="Full name" name="demo-name" required>
            <Input name="demo-name" autocomplete="name" required />
          </Field>

          <Field label="Email" name="demo-email" required hint="Only used to reply.">
            <Input name="demo-email" type="email" autocomplete="email" required />
          </Field>

          <Field label="What can I help with?" name="demo-service">
            <Select name="demo-service" placeholder="Pick one" options={[
              { value: 'audit', label: 'Design system audit' },
              { value: 'library', label: 'Component library' },
              { value: 'a11y', label: 'Accessibility review' },
            ]} />
          </Field>

          <Field label="Project notes" name="demo-message" hint="A few sentences is plenty.">
            <Textarea name="demo-message" rows={4} />
          </Field>

          <Field label="Phone" name="demo-phone" error="The phone number looks invalid.">
            <Input name="demo-phone" type="tel" invalid value="abc" />
          </Field>

          <SubmitButton label="Send message" />
        </form>

        <div class="flex flex-col gap-6">
          <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
            <p class="mono-label mb-4">ChoiceGroup: fieldset + legend</p>
            <ChoiceGroup legend="How healthy is your design system?" name="demo-rating" required>
              <Choice name="demo-rating" value="strong" label="Strong" />
              <Choice name="demo-rating" value="ok" label="Functional" checked />
              <Choice name="demo-rating" value="weak" label="Needs work" />
            </ChoiceGroup>
          </div>

          <div class="rounded-lg border border-line bg-raised p-6 md:p-8">
            <p class="mono-label mb-4">FormAlert: status &amp; alert</p>
            <div class="space-y-4">
              <FormAlert variant="success" hidden={false}>
                <p class="font-sans font-semibold text-ink">Thanks. Your message is on its way.</p>
                <p class="mt-1 text-ink-muted">I&rsquo;ll reply within one business day, usually sooner.</p>
              </FormAlert>
              <FormAlert variant="error" hidden={false}>
                <p class="font-sans font-semibold text-ink">We couldn&rsquo;t send your message.</p>
                <p class="mt-1 text-ink-muted">Please check the highlighted fields.</p>
              </FormAlert>
            </div>
          </div>
        </div>
      </Grid>
    </Container>
  </Section>

  {/* ───────────────────────── 06 · MOTION & SPACING ───────────────────────── */}
  <Section id="motion" tone="ink" padding="default">
    <Container width="wide">
      <p class="mono-label !text-paper/65">Motion &amp; spacing / 06</p>
      <div class="mt-4 max-w-2xl">
        <Heading level={2} visual="display-md" tone="paper">Quiet, deliberate motion.</Heading>
        <Text size="lg" tone="whiteMuted" class="mt-4">
          Animation is restrained and reversible. Transform and opacity only; nothing
          loops loudly, and everything yields to reduced-motion.
        </Text>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-paper/15 bg-paper/15 md:grid-cols-3">
        <div class="bg-ink p-7">
          <p class="mono-label !text-paper/65">Scroll reveal</p>
          <p class="mt-3 font-mono text-sm text-paper">.scroll-reveal</p>
          <Text size="sm" tone="whiteMuted" class="mt-3">
            Blocks fade up 18px on enter over 0.9s. Disabled entirely under
            prefers-reduced-motion.
          </Text>
        </div>
        <div class="bg-ink p-7">
          <p class="mono-label !text-paper/65">Easing: out</p>
          <p class="mt-3 font-mono text-sm text-paper">cubic-bezier(.22, 1, .36, 1)</p>
          <Text size="sm" tone="whiteMuted" class="mt-3">
            <code class="font-mono text-paper">--ease-out</code>: entrances, hovers, and
            arrow nudges.
          </Text>
        </div>
        <div class="bg-ink p-7">
          <p class="mono-label !text-paper/65">Easing: in/out</p>
          <p class="mt-3 font-mono text-sm text-paper">cubic-bezier(.65, 0, .35, 1)</p>
          <Text size="sm" tone="whiteMuted" class="mt-3">
            <code class="font-mono text-paper">--ease-inout</code>: looping or symmetric
            motion (e.g. the token-propagation demo).
          </Text>
        </div>
      </div>

      <div class="mt-8 rounded-lg border border-paper/15 p-7 md:p-8">
        <p class="mono-label !text-paper/65">Section padding scale</p>
        <Text size="sm" tone="whiteMuted" class="mt-3 max-w-3xl">
          <code class="font-mono text-paper">Section</code> exposes three vertical rhythms:
          <code class="font-mono text-paper"> tight</code> (py-14 / md:py-20),
          <code class="font-mono text-paper"> default</code> (py-20 / md:py-28), and
          <code class="font-mono text-paper"> loose</code> (py-24 / md:py-36).
          <code class="font-mono text-paper"> Container</code> caps line length at
          narrow / default / wide, and <code class="font-mono text-paper">Grid</code> handles
          1-4 responsive columns. Heavy whitespace does the spacing work. No
          decorative fills.
        </Text>
      </div>
