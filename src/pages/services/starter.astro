---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';

const description =
  'A component library starter that gives your team a consistent, accessible, scalable foundation — 20 foundational components, token architecture, WCAG 2.1 AA, and Storybook docs.';

const audience = [
  "You're starting from scratch and want it done right the first time.",
  'Your current library feels inconsistent, fragile, or hard to maintain.',
  'Your team rebuilds the same components instead of reusing them.',
  "Accessibility isn't baked in — it's something you keep meaning to get to.",
];

const deliverables = [
  {
    index: '01',
    title: '20 foundational components',
    body: 'Buttons, inputs, modals, cards, navigation, alerts, badges — the real working building blocks of a product UI.',
  },
  {
    index: '02',
    title: 'Token architecture',
    body: 'Color, spacing, typography, and border radius tokens structured so they scale instead of drift.',
  },
  {
    index: '03',
    title: 'WCAG 2.1 AA, built in',
    body: "Accessibility isn't a pass at the end — it's integrated into every component from the start.",
  },
  {
    index: '04',
    title: 'Storybook documentation',
    body: 'Every component with examples, variants, and usage guidance your team can actually read and trust.',
  },
  {
    index: '05',
    title: 'Built to scale',
    body: 'Clear naming, composable patterns, and structural decisions your team can extend without forking.',
  },
  {
    index: '06',
    title: 'One revision round included',
    body: "Once it's in your hands, we refine together. You shouldn't inherit a system you don't agree with.",
  },
];

const components = [
  {
    title: 'Buttons & actions',
    body: 'Primary, secondary, ghost, destructive, icon — with sizes, states, and focus handling that stay consistent everywhere.',
  },
  {
    title: 'Inputs & form controls',
    body: 'Text, select, checkbox, radio, toggle — with proper labels, errors, helper text, and accessible validation patterns.',
  },
  {
    title: 'Cards, surfaces & modals',
    body: 'Containers that compose cleanly — with consistent spacing, elevation, and focus management in dialogs.',
  },
  {
    title: 'Navigation patterns',
    body: 'Tabs, breadcrumbs, menus, links — with keyboard behavior and ARIA already handled.',
  },
  {
    title: 'Alerts, badges & feedback',
    body: 'The small-but-constant pieces — status messaging, notifications, labels — done with intent, not afterthoughts.',
  },
];

const process = [
  {
    n: '01',
    title: 'Kickoff',
    body: 'We align on tokens, styling direction, and the product needs the system has to serve. No guessing later — we set the anchors now.',
  },
  {
    n: '02',
    title: 'Build (2–3 weeks)',
    body: 'I build in the open — components, tokens, Storybook, all of it. You see progress as it happens, not in one big reveal at the end.',
  },
  {
    n: '03',
    title: 'Review & revise',
    body: 'You try it on. We collect feedback, integrate revisions, and make sure what ships is something your team genuinely wants to use.',
  },
  {
    n: '04',
    title: 'Handoff & walkthrough',
    body: 'Repository delivery with a live walk-through for your team — architecture, conventions, and how to extend it without breaking it.',
  },
];

const testimonials = [
  {
    quote:
      "Josh's accessibility expertise and front-end development discipline are in a class of their own. He builds systems that hold up — and teams learn from working with him.",
    name: 'Nicholas Dos Santos',
    role: "Engineer · America's Test Kitchen",
  },
  {
    quote:
      'Josh brings a rare combination of craft and rigor. The foundation he puts down is the kind you can build on for years without regretting it.',
    name: 'Welling LaGrone',
    role: 'Consultant · Triverus Consulting',
  },
];

const related = [
  {
    title: 'Design System Audit',
    body: "Already have a system that's drifting? Start with an honest, prioritized look at what's actually broken.",
    cta: 'Explore the audit',
    href: '/services/audit/',
  },
  {
    title: 'Design-to-Code Workflow',
    body: "Got components but the handoff between design and dev is leaking? Let's tighten the loop.",
    cta: 'Explore the workflow',
    href: '/services/workflow/',
  },
];
---

<BaseLayout
  title="Component Library Starter — Joshua Briley | Design Systems Consulting"
  description={description}
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="mono-label flex items-center gap-2" aria-label="Breadcrumb">
        <Link href="/services/" variant="unstyled" class="inline-flex items-center gap-1.5 text-ink-muted transition-colors hover:text-accent">
          <Icon name="ph:arrow-left" size={13} /> All services
        </Link>
        <span aria-hidden="true" class="text-ink-faint">/</span>
        <span>Component Library Starter</span>
      </nav>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <p class="mono-label">Build the foundation · Starter</p>
          <Heading level={1} visual="display-xl" class="mt-5 max-w-[16ch]">
            A component system your team <em class="ink-wink font-normal italic">can trust</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Most teams don't struggle because they lack components. They struggle because their
            components weren't designed as a system. Let's fix that at the foundation — consistent,
            accessible, and ready to scale from day one.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right" class="js-magnetic">
              Book an intro call
            </Button>
            <Button variant="ghost" size="lg" href="#deliverables">
              See what you get
            </Button>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>2–3 week build</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>20 components</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>Starting at $3,500</li>
          </ul>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-lg border border-line bg-raised p-7 md:p-9">
            <p class="mono-label">What's in the box</p>
            <ul class="mt-5 divide-y divide-line">
              {components.map((c, i) => (
                <li class="flex items-baseline gap-4 py-3.5 first:pt-0 last:pb-0">
                  <span class="font-mono text-[0.72rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-sm font-medium text-ink">{c.title}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── AUDIENCE ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">This is for you if / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">
          You need a real foundation.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Whether you're starting fresh or replacing something fragile, these are the teams this is
          built for.
        </Text>
      </div>

      <ul class="mt-12 divide-y divide-line border-y border-line">
        {audience.map((a, i) => (
          <li class="flex gap-5 py-5">
            <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-[1.05rem] leading-snug text-ink">{a}</p>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── PULL QUOTE (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">The thesis / 02</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-5 max-w-[22ch]">
          A component library isn't a pile of components. It's a system.
        </Heading>
        <Text size="lg" tone="whiteMuted" class="mt-5 max-w-xl">
          Shared decisions, shared names, shared guarantees. That's what we build here.
        </Text>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── DELIVERABLES ───────────────────────── */}
  <Section id="deliverables" tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">What you walk away with / 03</p>
        <Heading level={2} visual="display-md" class="mt-4">
          A foundation that's ready to build on.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Real components, real tokens, real docs — shipped as a clean starting point your team can
          own.
        </Text>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {deliverables.map((d) => (
          <div class="bg-paper p-7 md:p-8">
            <span class="font-mono text-[0.75rem] text-accent">{d.index}</span>
            <Heading level={3} visual="h3" class="mt-3">{d.title}</Heading>
            <Text size="sm" tone="muted" class="mt-2.5">{d.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── COMPONENTS ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="default">
      <div class="max-w-3xl">
        <p class="mono-label">The 20 components / 04</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Everything a product UI leans on.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Not "hello world" components. The ones you reach for every day — designed to work together.
        </Text>
      </div>

      <ul class="mt-12 divide-y divide-line border-y border-line">
        {components.map((c, i) => (
          <li class="flex gap-5 py-6">
            <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <Heading level={3} visual="h3">{c.title}</Heading>
              <Text size="sm" tone="muted" class="mt-1.5">{c.body}</Text>
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── PROCESS (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">How it works / 05</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-4">
          Four phases, full visibility.
        </Heading>
      </div>

      <ol class="mt-14 grid gap-px overflow-hidden rounded-lg border border-paper/10 bg-paper/10 sm:grid-cols-2">
        {process.map((step) => (
          <li class="bg-ink p-7 md:p-9">
            <span class="font-mono text-[0.75rem] text-accent">{step.n}</span>
            <Heading level={3} visual="h3" tone="paper" class="mt-3">{step.title}</Heading>
            <p class="mt-2.5 text-sm leading-relaxed text-paper/70">{step.body}</p>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  {/* ───────────────────────── PRICING ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="default">
      <div class="rounded-lg border border-line bg-raised p-8 md:p-12">
        <p class="mono-label">Flat-scope engagement / 06</p>
        <div class="mt-6 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <Heading level={2} visual="h2">Component Library Starter</Heading>
            <div class="mt-4 flex items-baseline gap-2">
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted">Starting at</span>
              <span class="font-display text-5xl font-semibold tracking-[-0.03em] text-ink">$3,500</span>
            </div>
            <Text tone="muted" class="mt-4 max-w-lg">
              Final scope depends on product needs and styling complexity — we'll sort it out on the
              intro call. No retainers, no surprises.
            </Text>
          </div>
          <Button variant="primary" size="lg" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right">
            Book an intro call
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── TESTIMONIALS ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <p class="mono-label">Kind words / 07</p>
      <Heading level={2} visual="display-md" class="mt-4">
        From folks who've worked with me.
      </Heading>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-2">
        {testimonials.map((t) => (
          <figure class="bg-paper p-7 md:p-9">
            <blockquote class="font-display text-lg leading-snug tracking-tight text-ink">"{t.quote}"</blockquote>
            <figcaption class="mt-6">
              <p class="text-sm font-medium text-ink">{t.name}</p>
              <p class="mt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{t.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── RELATED ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">Not quite right? / 08</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Start somewhere else.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          A starter isn't always the right first move. Here's where else people begin.
        </Text>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-2">
        {related.map((r) => (
          <div class="flex flex-col bg-paper p-7 md:p-9">
            <Heading level={3} visual="h3">{r.title}</Heading>
            <Text size="sm" tone="muted" class="mt-2.5">{r.body}</Text>
            <div class="mt-6">
              <Link href={r.href} variant="arrow">{r.cta}</Link>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CTA ───────────────────────── */}
  <CTABanner
    eyebrow="Start a project / 09"
    title="Let's build the foundation."
    lead="Book a 30-minute intro call. Tell me what you're building (or rebuilding) and I'll tell you whether a starter is the right move — honestly."
  >
    <Button variant="primary" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right">
      Book an intro call
    </Button>
    <Button variant="text" href="/tools/scorecard/">
      Take the free scorecard
    </Button>
  </CTABanner>
</BaseLayout>
