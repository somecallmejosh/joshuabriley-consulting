---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';

const description =
  "A structured design system audit that finds what's actually broken — component inconsistency, accessibility risk, token drift, and documentation gaps — with a prioritized roadmap your team can run.";

const signals = [
  'Your component library has become inconsistent or hard to trust.',
  'Designers and developers are solving the same UI problems differently.',
  'Accessibility issues keep surfacing late — in QA, in audits, in production.',
  "Your system exists, but it isn't working the way it should.",
];

const deliverables = [
  {
    index: '01',
    title: "Where it's inconsistent — and why",
    body: "A clear view of what's drifting visually, structurally, and in code — plus the reasons it keeps happening.",
  },
  {
    index: '02',
    title: 'Accessibility risk, component-by-component',
    body: 'A WCAG 2.1 AA breakdown that tells you exactly where your risk lives — not just a score.',
  },
  {
    index: '03',
    title: 'A prioritized list of issues',
    body: "Not everything is equally broken. You'll know what to fix first, what to defer, and what to ignore.",
  },
  {
    index: '04',
    title: 'Specific recommendations for each fix',
    body: '"Refactor your button API" isn\'t advice. I give you the actual approach, tradeoffs, and what "done" looks like.',
  },
  {
    index: '05',
    title: 'A roadmap your team can actually follow',
    body: 'Sequenced, scoped, and honest about effort. Something you can run without me if you want to.',
  },
  {
    index: '06',
    title: 'A debrief with your team',
    body: "A live walk-through so findings don't just land in a doc and die. Your team asks questions; I push back on mine.",
  },
];

const scope = [
  {
    title: 'Component consistency analysis',
    body: 'Visual and code-level. Where components diverge from the spec, each other, and themselves.',
  },
  {
    title: 'Accessibility risk assessment',
    body: 'WCAG 2.1 AA scored at the component level, with the real risks called out in plain language.',
  },
  {
    title: 'Design token structure & naming review',
    body: 'Are your tokens doing the work they should? Do the names tell the truth? Where are the leaks?',
  },
  {
    title: 'Documentation quality & coverage',
    body: 'Does your documentation match the code people actually ship? Where are the gaps driving forks?',
  },
  {
    title: 'Prioritized remediation roadmap',
    body: 'Ranked, sequenced, and sized. The thing your team can point to when someone asks "what\'s next?"',
  },
];

const process = [
  {
    n: '01',
    title: 'Share access',
    body: 'Storybook, Figma, repo — whatever represents the actual state of your system. We start by looking at the real thing, not what you wish existed.',
  },
  {
    n: '02',
    title: 'Audit review',
    body: 'I work through consistency, accessibility, tokens, and documentation — one track at a time, with notes and evidence as I go.',
  },
  {
    n: '03',
    title: 'Structured report',
    body: 'You get a ranked set of findings with recommendations, tradeoffs, and a roadmap — written for humans, not for a pitch deck.',
  },
  {
    n: '04',
    title: 'Debrief walk-through',
    body: "We meet, I walk your team through it, answer questions, and make sure the recommendations actually land somewhere they'll get used.",
  },
];

const testimonials = [
  {
    quote:
      'Josh has an unusual ability to hold the big picture and the details at the same time. He brings clarity to messy systems and the kind of structure that actually holds up under delivery pressure.',
    name: 'Rebecca Cachia, PMP',
    role: 'Project Manager · Publicis Sapient',
  },
  {
    quote:
      "Josh sees the real problem quickly and knows how to articulate it in a way that gets teams moving. That's rare — and genuinely valuable.",
    name: 'Drew DiPasquale',
    role: 'Principal Researcher · HubSpot',
  },
];
---

<BaseLayout
  title="Design System Audit — Joshua Briley | Design Systems Consulting"
  description={description}
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="mono-label flex items-center gap-2" aria-label="Breadcrumb">
        <Link href="/services/" variant="unstyled" class="inline-flex items-center gap-1.5 text-ink-muted transition-colors hover:text-accent">
          <Icon name="ph:arrow-left" size={13} /> All services
        </Link>
        <span aria-hidden="true" class="text-ink-faint">/</span>
        <span>Design System Audit</span>
      </nav>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <p class="mono-label">Start here · Audit</p>
          <Heading level={1} visual="display-xl" class="mt-5 max-w-[16ch]">
            Find what's <em class="ink-wink font-normal italic">actually broken</em> in your design system.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            If your components feel inconsistent, your system is hard to maintain, or your team is
            solving the same problems differently every sprint — this is where to start.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right" class="js-magnetic">
              Book an intro call
            </Button>
            <Button variant="ghost" size="lg" href="#deliverables">
              See what you get
            </Button>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>~2 week turnaround</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>Starting at $2,000</li>
          </ul>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-lg border border-line bg-raised p-7 md:p-9">
            <p class="mono-label">Audit tracks</p>
            <ul class="mt-5 divide-y divide-line">
              {scope.map((s, i) => (
                <li class="flex items-baseline gap-4 py-3.5 first:pt-0 last:pb-0">
                  <span class="font-mono text-[0.72rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-sm font-medium text-ink">{s.title}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── SIGNALS ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">This is for you if / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">
          You're stuck in the same loops.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Not every team needs an audit. But if one of these sounds painfully familiar, it's probably
          time for an honest look.
        </Text>
      </div>

      <ul class="mt-12 divide-y divide-line border-y border-line">
        {signals.map((s, i) => (
          <li class="flex gap-5 py-5">
            <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-[1.05rem] leading-snug text-ink">{s}</p>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── PULL QUOTE (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">The pattern / 02</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-5 max-w-[20ch]">
          Most teams try to fix their system by adding more.
        </Heading>
        <Text size="lg" tone="whiteMuted" class="mt-5 max-w-xl">
          More components. More documentation. More rules. That usually makes things worse. An audit
          finds what to remove, not just what to add.
        </Text>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── DELIVERABLES ───────────────────────── */}
  <Section id="deliverables" tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">What you walk away with / 03</p>
        <Heading level={2} visual="display-md" class="mt-4">
          A clear view of what's actually going on.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          No vague "here are some ideas" deck. You get a structured, honest, prioritized plan.
        </Text>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {deliverables.map((d) => (
          <div class="bg-paper p-7 md:p-8">
            <span class="font-mono text-[0.75rem] text-accent">{d.index}</span>
            <Heading level={3} visual="h3" class="mt-3">{d.title}</Heading>
            <Text size="sm" tone="muted" class="mt-2.5">{d.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── SCOPE ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="default">
      <div class="max-w-3xl">
        <p class="mono-label">Inside the audit / 04</p>
        <Heading level={2} visual="display-md" class="mt-4">
          The full scope.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Five focused tracks across your system, your code, and your documentation.
        </Text>
      </div>

      <ul class="mt-12 divide-y divide-line border-y border-line">
        {scope.map((s, i) => (
          <li class="flex gap-5 py-6">
            <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <Heading level={3} visual="h3">{s.title}</Heading>
              <Text size="sm" tone="muted" class="mt-1.5">{s.body}</Text>
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── PROCESS (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">How it works / 05</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-4">
          Four steps, no surprises.
        </Heading>
      </div>

      <ol class="mt-14 grid gap-px overflow-hidden rounded-lg border border-paper/10 bg-paper/10 sm:grid-cols-2">
        {process.map((step) => (
          <li class="bg-ink p-7 md:p-9">
            <span class="font-mono text-[0.75rem] text-accent">{step.n}</span>
            <Heading level={3} visual="h3" tone="paper" class="mt-3">{step.title}</Heading>
            <p class="mt-2.5 text-sm leading-relaxed text-paper/70">{step.body}</p>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  {/* ───────────────────────── PRICING ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="default">
      <div class="rounded-lg border border-line bg-raised p-8 md:p-12">
        <p class="mono-label">Flat-scope engagement / 06</p>
        <div class="mt-6 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <Heading level={2} visual="h2">Design System Audit</Heading>
            <div class="mt-4 flex items-baseline gap-2">
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted">Starting at</span>
              <span class="font-display text-5xl font-semibold tracking-[-0.03em] text-ink">$2,000</span>
            </div>
            <Text tone="muted" class="mt-4 max-w-lg">
              Final scope depends on system size and surface area — we'll sort that out on the intro
              call. No retainers, no surprises.
            </Text>
          </div>
          <Button variant="primary" size="lg" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right">
            Book an intro call
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── TESTIMONIALS ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <p class="mono-label">Kind words / 07</p>
      <Heading level={2} visual="display-md" class="mt-4">
        From folks who've worked with me.
      </Heading>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-2">
        {testimonials.map((t) => (
          <figure class="bg-paper p-7 md:p-9">
            <blockquote class="font-display text-lg leading-snug tracking-tight text-ink">"{t.quote}"</blockquote>
            <figcaption class="mt-6">
              <p class="text-sm font-medium text-ink">{t.name}</p>
              <p class="mt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{t.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CTA ───────────────────────── */}
  <CTABanner
    eyebrow="Start a project / 08"
    title="Let's find what's actually broken."
    lead="Book a 30-minute intro call. Tell me what's frustrating about your system and I'll tell you whether an audit is the right next step — honestly."
  >
    <Button variant="primary" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right">
      Book an intro call
    </Button>
    <Button variant="text" href="/tools/scorecard/">
      Take the free scorecard
    </Button>
  </CTABanner>
</BaseLayout>
