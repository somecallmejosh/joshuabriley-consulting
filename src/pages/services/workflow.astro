---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';

const description =
  "A custom design-to-code workflow for product teams. Stop losing sprints to handoff friction, rebuilt UI, and 'is this right?' — get a repeatable process your designers and engineers will actually follow.";

const forYouSignals = [
  'Figma-to-code handoff creates friction every single sprint.',
  "What gets built doesn't match what was designed.",
  'Design tokens exist — but nobody uses them consistently.',
  'Designers and engineers are out of sync more often than not.',
  "The same UI questions come up sprint after sprint — and you're tired of answering them.",
];

const deliverables = [
  {
    index: '01',
    title: "A clear view of where it's breaking",
    body: 'An honest assessment of your current workflow — the handoffs, the gaps, and the moments where trust falls apart.',
  },
  {
    index: '02',
    title: 'A custom design-to-code process',
    body: 'Not a generic template. A flow designed around your tools, your people, and the way your team already works.',
  },
  {
    index: '03',
    title: 'Defined team expectations',
    body: "Who owns what, when, and to what standard — so nobody's guessing whose job it is to catch the gap.",
  },
  {
    index: '04',
    title: 'A repeatable sprint rhythm',
    body: 'A cadence your team can run every sprint — without reinventing handoff rituals each time.',
  },
  {
    index: '05',
    title: 'A shared definition of "done"',
    body: 'One that designers and engineers actually agree on — before the ticket ever hits QA.',
  },
  {
    index: '06',
    title: 'A live implementation session',
    body: 'A 60-minute working session with your team. We roll the new workflow out live so it lands in muscle memory, not a forgotten doc.',
  },
];

const included = [
  {
    title: 'Process audit',
    body: 'A grounded look at how your team actually hands work from design to code today — not the version on the wiki.',
  },
  {
    title: 'Figma structure review',
    body: 'How your files, components, and variables are set up — and where that structure is fighting the engineers downstream.',
  },
  {
    title: 'Breakdown point identification',
    body: 'The exact moments in your sprint where things go sideways — named, mapped, and tied back to root cause.',
  },
  {
    title: 'Code Connect setup',
    body: 'Wire your Figma components to the real ones in your codebase so what designers place is what engineers ship.',
  },
  {
    title: 'Custom workflow guide',
    body: 'A written playbook of your new design-to-code flow — short, specific, and built to be used by your whole team.',
  },
  {
    title: '60-minute implementation session',
    body: 'A live working session where we roll the workflow out with your team, answer questions, and make sure it sticks.',
  },
];

const process = [
  {
    n: '01',
    title: 'Kickoff discussion',
    body: "We talk about what's really happening in your sprints — the friction, the frustrations, the workarounds your team has quietly invented.",
  },
  {
    n: '02',
    title: 'Audit review',
    body: "I dig into your Figma, your repo, and your process. I come back with what's working, what's breaking, and where the real leverage is.",
  },
  {
    n: '03',
    title: 'Workflow guide creation',
    body: 'I write the new process — specific to your tools, your team, and your cadence. Not a theoretical framework; a thing you can run on Monday.',
  },
  {
    n: '04',
    title: 'Implementation session',
    body: 'We meet live, walk the team through the new flow, and run it together on real work — so it lands in practice, not just in a doc.',
  },
];

const testimonials = [
  {
    quote:
      "Josh sees the real problem quickly and knows how to articulate it in a way that gets teams moving. That's rare — and genuinely valuable.",
    name: 'Drew DiPasquale',
    role: 'Principal Researcher · HubSpot',
  },
  {
    quote:
      "Josh turned our messy handoff into a process the whole team actually follows. Fewer rebuilds, fewer 'is this right?' pings, more shipping.",
    name: 'Michael Pertiore',
    role: 'Designer · Apple',
  },
];
---

<BaseLayout
  title="Design-to-Code Workflow — Joshua Briley | Design Systems Consulting"
  description={description}
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="mono-label flex items-center gap-2" aria-label="Breadcrumb">
        <Link href="/services/" variant="unstyled" class="inline-flex items-center gap-1.5 text-ink-muted transition-colors hover:text-accent">
          <Icon name="ph:arrow-left" size={13} /> All services
        </Link>
        <span aria-hidden="true" class="text-ink-faint">/</span>
        <span>Design-to-Code Workflow</span>
      </nav>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <p class="mono-label">Fix the handoff · Workflow</p>
          <Heading level={1} visual="display-xl" class="mt-5 max-w-[18ch]">
            Stop <em class="ink-wink font-normal italic">losing sprints</em> to design-to-code friction.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            If every sprint feels like rebuilding UI, rechecking Figma, and second-guessing
            decisions — the problem isn't people, it's process. Let's fix that with a custom workflow
            your designers and engineers will actually run.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right" class="js-magnetic">
              Book an intro call
            </Button>
            <Button variant="ghost" size="lg" href="#deliverables">
              See what you get
            </Button>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>~3 week engagement</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>Starting at $2,500</li>
          </ul>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-lg border border-line bg-raised p-7 md:p-9">
            <p class="mono-label">What's included</p>
            <ul class="mt-5 divide-y divide-line">
              {included.map((item, i) => (
                <li class="flex items-baseline gap-4 py-3.5 first:pt-0 last:pb-0">
                  <span class="font-mono text-[0.72rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-sm font-medium text-ink">{item.title}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── SIGNALS ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">This is for you if / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Handoff keeps eating your sprint.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Adding more annotations, specs, and comments hasn't fixed it. It's not an information
          problem — it's a workflow one.
        </Text>
      </div>

      <ul class="mt-12 divide-y divide-line border-y border-line">
        {forYouSignals.map((s, i) => (
          <li class="flex gap-5 py-5">
            <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-[1.05rem] leading-snug text-ink">{s}</p>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── PULL QUOTE (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">The reframe / 02</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-5 max-w-[22ch]">
          More annotations. More specs. More comments. That doesn't solve the problem.
        </Heading>
        <Text size="lg" tone="whiteMuted" class="mt-5 max-w-xl">
          The fix isn't more information — it's a workflow you can actually run.
        </Text>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── DELIVERABLES ───────────────────────── */}
  <Section id="deliverables" tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">What you walk away with / 03</p>
        <Heading level={2} visual="display-md" class="mt-4">
          A process your team will actually use.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Not a theoretical framework. A working, repeatable handoff flow tailored to how your team
          already ships.
        </Text>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {deliverables.map((d) => (
          <div class="bg-paper p-7 md:p-8">
            <span class="font-mono text-[0.75rem] text-accent">{d.index}</span>
            <Heading level={3} visual="h3" class="mt-3">{d.title}</Heading>
            <Text size="sm" tone="muted" class="mt-2.5">{d.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── SCOPE ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="default">
      <div class="max-w-3xl">
        <p class="mono-label">Inside the engagement / 04</p>
        <Heading level={2} visual="display-md" class="mt-4">
          The full scope.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Six focused pieces across your process, your Figma, and your codebase.
        </Text>
      </div>

      <ul class="mt-12 divide-y divide-line border-y border-line">
        {included.map((item, i) => (
          <li class="flex gap-5 py-6">
            <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <Heading level={3} visual="h3">{item.title}</Heading>
              <Text size="sm" tone="muted" class="mt-1.5">{item.body}</Text>
            </div>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── PROCESS (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label !text-paper/65">How it works / 05</p>
        <Heading level={2} visual="display-md" tone="paper" class="mt-4">
          Four steps, no hand-wavy theory.
        </Heading>
      </div>

      <ol class="mt-14 grid gap-px overflow-hidden rounded-lg border border-paper/10 bg-paper/10 sm:grid-cols-2">
        {process.map((step) => (
          <li class="bg-ink p-7 md:p-9">
            <span class="font-mono text-[0.75rem] text-accent">{step.n}</span>
            <Heading level={3} visual="h3" tone="paper" class="mt-3">{step.title}</Heading>
            <p class="mt-2.5 text-sm leading-relaxed text-paper/70">{step.body}</p>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  {/* ───────────────────────── PRICING ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="default">
      <div class="rounded-lg border border-line bg-raised p-8 md:p-12">
        <p class="mono-label">Flat-scope engagement / 06</p>
        <div class="mt-6 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <Heading level={2} visual="h2">Design-to-Code Workflow</Heading>
            <div class="mt-4 flex items-baseline gap-2">
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted">Starting at</span>
              <span class="font-display text-5xl font-semibold tracking-[-0.03em] text-ink">$2,500</span>
            </div>
            <Text tone="muted" class="mt-4 max-w-lg">
              Final scope depends on team size, tooling, and how deep we go on Code Connect — we'll
              sort that out on the intro call. No retainers, no surprises.
            </Text>
          </div>
          <Button variant="primary" size="lg" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right">
            Book an intro call
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── TESTIMONIALS ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <p class="mono-label">Kind words / 07</p>
      <Heading level={2} visual="display-md" class="mt-4">
        From folks who've worked with me.
      </Heading>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-2">
        {testimonials.map((t) => (
          <figure class="bg-paper p-7 md:p-9">
            <blockquote class="font-display text-lg leading-snug tracking-tight text-ink">"{t.quote}"</blockquote>
            <figcaption class="mt-6">
              <p class="text-sm font-medium text-ink">{t.name}</p>
              <p class="mt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{t.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CTA ───────────────────────── */}
  <CTABanner
    eyebrow="Start a project / 08"
    title="Give your team a handoff they can trust."
    lead="Book a 30-minute intro call. Tell me where your sprint keeps snagging — I'll tell you honestly whether a workflow engagement is the right next step."
  >
    <Button variant="primary" href="https://calendly.com/josh-thebrileys/30min/" iconRight="ph:arrow-right">
      Book an intro call
    </Button>
    <Button variant="text" href="/tools/scorecard/">
      Take the free scorecard
    </Button>
  </CTABanner>
</BaseLayout>
