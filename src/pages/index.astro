---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';

// ── Content (substance carried over from the prior build; every claim is backed
// by the site itself or a real case study) ──────────────────────────────────
const clients = ['Travelers', 'Berkshire Hathaway', "America's Test Kitchen", 'NASCAR', 'NFL'];

const heroProof = [
  '20 yrs production UI',
  'WCAG 2.2, AT-tested',
  'Tokens + docs that scale',
  'Tuned to convert & rank',
];

const capabilities = [
  {
    index: '01',
    title: 'It looks excellent',
    body:
      'Type, spacing, motion, and restraint that read as deliberate — the polish you are looking at now. The same eye behind brand-grade UI for America’s Test Kitchen, NASCAR, and the NFL.',
  },
  {
    index: '02',
    title: 'It is built correctly',
    body:
      'Semantic HTML, WCAG 2.2 accessibility, keyboard and screen-reader testing, real performance budgets. Built the way it looks — production-grade, not a shell over brittle markup.',
  },
  {
    index: '03',
    title: 'It scales as a system',
    body:
      'Tokens, components, and documentation so one decision lands on every surface at once — the backbone behind Rudiment UI and the multi-brand library at America’s Test Kitchen.',
  },
  {
    index: '04',
    title: 'It moves the business',
    body:
      'Interfaces tuned for conversion and retention, technical SEO that helps pages rank, and campaign surfaces marketing can move on their own — like the design system that unblocked Berxi.',
  },
];

const metrics = [
  { value: '75%', label: 'fewer support calls', note: 'IVFCRYO — clearer, recoverable flows' },
  { value: '55%', label: 'fewer shipping errors', note: 'IVFCRYO — accessible forms at the source' },
  { value: '3 → 1', label: 'brands, one library', note: "America’s Test Kitchen — divergence lives in tokens" },
];

const work = [
  {
    href: '/projects/americas-test-kitchen/',
    client: "America’s Test Kitchen",
    kind: 'Design system',
    line: 'One component library serving three brands — divergence isolated to tokens.',
  },
  {
    href: '/projects/berxi-insurance/',
    client: 'Berxi',
    kind: 'Campaign surfaces',
    line: 'A system that unblocked marketing to ship campaigns without an engineering queue.',
  },
  {
    href: '/projects/vmspark/',
    client: 'VMSpark',
    kind: 'Conversion',
    line: 'Rebuilt a multi-tenant admin shell — lifted conversion and retention, pipeline untouched.',
  },
  {
    href: '/projects/ivfcryo/',
    client: 'IVFCRYO',
    kind: 'Accessible flows',
    line: 'Recoverable, accessible forms that cut support load and shipping errors at the source.',
  },
  {
    href: '/projects/rudiment-ui/',
    client: 'Rudiment UI',
    kind: 'Component system',
    line: 'An accessible-by-construction component set built around semantic structure.',
  },
];

const questions = [
  'Is this interaction clear to the person using it?',
  'Does the interface behave the way people expect?',
  'Can teams reuse this pattern without misusing it?',
  'Are we solving the experience problem, or only making the screen look better?',
  'Will this still make sense when another team builds on it in six months?',
];

const tools = [
  { href: '/tools/scorecard/', title: 'Design System Scorecard', line: 'Score your system across five dimensions in ~10 minutes.' },
  { href: '/tools/audit-findings/', title: 'What an audit finds', line: 'Inspect drifted UI; read findings ranked by severity.' },
  { href: '/tools/token-playground/', title: 'What a token does', line: 'Change one primitive; watch it propagate everywhere.' },
];
---

<BaseLayout
  title="Joshua Briley — UX Engineer: interfaces that look right, build right & convert"
  description="UX engineer with 20 years in production UI. Product interfaces that look excellent, are built correctly (accessibility, semantic HTML, performance), scale as design systems, and move the business — conversion, retention, technical SEO, and campaign surfaces."
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span><span class="sr-only">My role is </span>UX Engineer · <span class="sr-only">My focus is on </span>Design Systems</span>
        <span class="hidden sm:inline text-ink-muted"> <span class="sr-only">My location is </span>N 41.7°  ·  <span class="sr-only">Welcome to </span> Index 01</span>
      </div>

      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-center">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[16ch]">
            Interfaces that look right, build right, and <em class="ink-wink font-normal italic">pull their weight</em>.
          </Heading>
          <Text size="lg" tone="muted" class="mt-7 max-w-xl">
            Twenty years at the seam between design and engineering — building product UI,
            component libraries, and design systems that survive contact with real teams.
          </Text>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/projects/" iconRight="ph:arrow-right" class="js-magnetic">
              Selected work
            </Button>
            <Button variant="ghost" size="lg" href="/about/">
              Read the approach
            </Button>
          </div>

          <ul aria-label="Hero proof points" class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
            {heroProof.map((p) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p}
              </li>
            ))}
          </ul>
        </div>

        {/* Illustrative motion: one token propagating to every component.
            The literal thesis of systems work — a single decision lands on
            three surfaces at once. Pure transform/opacity; pauses on reduced-motion. */}
        <div class="lg:col-span-5" aria-hidden="true">
          <figure class="prop rounded-lg border border-line bg-raised p-5 md:p-6">
            <figcaption class="flex items-center justify-between mono-label">
              <span>tokens.css</span><span>live</span>
            </figcaption>

            <div class="prop-token mt-4 flex items-center justify-between rounded-[6px] border border-ink/15 bg-paper px-3.5 py-2.5">
              <span class="font-mono text-[0.8rem] text-ink">--radius: <span class="text-accent">6px</span></span>
              <span class="prop-pulse h-2 w-2 rounded-full bg-accent"></span>
            </div>

            <div class="prop-wire mt-1 ml-4 h-6 w-px bg-line"></div>

            <ul class="space-y-2.5">
              {['Button', 'Field', 'Card'].map((c, i) => (
                <li class={`prop-node prop-node-${i} flex items-center gap-3 rounded-[6px] border border-line bg-paper px-3.5 py-3`}>
                  <span class="prop-bar h-7 w-1 rounded-full bg-line"></span>
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-ink-muted">{c}</span>
                  <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-muted">
                    <span class="prop-dot h-1.5 w-1.5 rounded-full bg-line"></span>synced
                  </span>
                </li>
              ))}
            </ul>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CLIENTS ───────────────────────── */}
  <Section tone="paper" padding="tight" class="!py-8 border-b border-line">
    <Container width="wide">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-10">
        <span class="mono-label whitespace-nowrap"><span class="sr-only">My work has been </span>Trusted by</span>
        <ul class="flex flex-wrap items-center gap-x-8 gap-y-3">
          {clients.map((c) => (
            <li class="font-display text-[0.95rem] font-medium tracking-tight text-ink-muted">{c}</li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CAPABILITIES ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <p class="mono-label">What you get / 01</p>
        <Heading level={2} visual="display-md" class="mt-4">
          Excellent, correct, systematic — and good for the business.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Most of the work lives in the gap between an idea and a shipped interface: designs that
          drift in code, components nobody reuses correctly, accessibility raised too late,
          performance left to chance. I close that gap on four axes at once.
        </Text>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
        {capabilities.map((c) => (
          <div class="bg-paper p-7 md:p-9">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[0.75rem] text-accent">{c.index}</span>
              <Heading level={3} visual="h3">{c.title}</Heading>
            </div>
            <Text tone="muted" class="mt-3">{c.body}</Text>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── SELECTED WORK (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="mono-label !text-paper/65">Selected work / 02</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4">Receipts, not adjectives.</Heading>
        </div>
        <div class="lg:col-span-6 grid grid-cols-3 gap-6">
          {metrics.map((m) => (
            <div>
              <p class="font-serif text-4xl md:text-5xl font-semibold tracking-[-0.02em] text-paper">{m.value}</p>
              <p class="mt-1 text-sm text-paper/70">{m.label}</p>
              <p class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.1em] leading-relaxed text-paper/60">{m.note}</p>
            </div>
          ))}
        </div>
      </div>

      <ul class="mt-14 border-t border-paper/10">
        {work.map((w) => (
          <li>
            <a href={w.href} class="group grid grid-cols-12 items-center gap-4 border-b border-paper/10 py-5 transition-colors hover:bg-paper/[0.03]">
              <span class="col-span-12 flex items-center gap-3 sm:col-span-4">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{w.kind}</span>
              </span>
              <span class="col-span-10 sm:col-span-7">
                <span class="font-display text-lg font-medium tracking-tight text-paper">{w.client}</span>
                <span class="mt-0.5 block text-sm text-paper/55">{w.line}</span>
              </span>
              <span class="col-span-2 flex justify-end sm:col-span-1">
                <Icon name="ph:arrow-right" size={18} class="text-paper/50 transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-paper" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <a href="/projects/" class="inline-flex items-center gap-2 font-sans text-[0.9rem] font-medium text-paper transition-colors hover:text-accent">
          View all projects <Icon name="ph:arrow-right" size={15} />
        </a>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── APPROACH ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <p class="mono-label">How I think / 03</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[14ch]">
            I work in the space between people, patterns, and code.
          </Heading>
          <div class="mt-7 space-y-4 text-ink-muted leading-relaxed">
            <p>
              I started as a designer who learned to code. Over time that turned into twenty years
              of building interfaces, component libraries, and design systems for real product teams.
            </p>
            <p>
              Experience problems are rarely just design problems or engineering problems. They live
              in the handoff, the assumptions, the unclear patterns — the places where teams
              <em class="text-ink not-italic font-medium"> think</em> they agree but don’t.
            </p>
            <p class="text-ink font-medium">That is the work I want to keep doing.</p>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-lg border border-line bg-raised p-7 md:p-9">
            <p class="mono-label">Questions I ask</p>
            <ol class="mt-5 divide-y divide-line">
              {questions.map((q, i) => (
                <li class="flex gap-4 py-4 first:pt-0 last:pb-0">
                  <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                  <p class="text-[1.05rem] leading-snug text-ink">{q}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── WRITING + TOOLS ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label">Writing / 04</p>
          <Heading level={2} visual="h2" class="mt-4">
            Notes on UX engineering, accessibility, and design systems.
          </Heading>
          <Text tone="muted" class="mt-4">
            The parts of front-end work closest to the user — accessible components, interface
            patterns, AI-assisted development, and the changing role of the front-end developer.
          </Text>
          <div class="mt-6">
            <Link href="/blog/" variant="arrow">Read the blog</Link>
          </div>
        </div>

        <div class="lg:col-span-7">
          <p class="mono-label">Free tools / 05</p>
          <ul class="mt-5 divide-y divide-line border-y border-line">
            {tools.map((t) => (
              <li>
                <a href={t.href} class="group flex items-center gap-5 py-4 transition-colors hover:bg-ink/[0.02]">
                  <span class="flex-1">
                    <span class="font-display text-base font-medium tracking-tight text-ink">{t.title}</span>
                    <span class="mt-0.5 block text-sm text-ink-muted">{t.line}</span>
                  </span>
                  <Icon name="ph:arrow-up-right" size={17} class="text-ink-faint transition-all duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── ABOUT STRIP ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid items-start gap-10 md:grid-cols-12 md:gap-14">
        <div class="md:col-span-4">
          <div class="overflow-hidden rounded-lg border border-line">
            <img src="/images/josh-biz-cazsh.jpg" alt="Joshua Briley, UX Engineer" class="aspect-[4/5] w-full object-cover" loading="lazy" width="640" height="800" />
          </div>
        </div>
        <div class="md:col-span-8">
          <p class="mono-label">The person behind the systems / 06</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[18ch]">
            Designer by origin. Engineer by practice.
          </Heading>
          <div class="mt-6 space-y-4 text-ink-muted leading-relaxed max-w-2xl">
            <p>
              I have spent my career between design and engineering — conversion-focused marketing
              sites, product interfaces, design systems, component libraries, and internal tools
              across a range of teams and industries.
            </p>
            <p>
              The thread is simple: I make interfaces clearer, more accessible, and easier for teams
              to use well — the kind of structure that helps people move through software with more
              confidence and less friction.
            </p>
          </div>
          <div class="mt-7">
            <Link href="/about/" variant="arrow">More about me</Link>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">Start a project / 07</p>
          <Heading level={2} visual="display-lg" tone="paper" class="mt-4 max-w-[20ch]">
            Need an interface that looks right, works right, and pulls its weight?
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            Hiring for design systems or UX engineering, shipping a surface that has to convert, or
            want a second pair of eyes on a component library — send a note. I reply within one
            business day.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right">Get in touch</Button>
            <a
              href="https://www.linkedin.com/in/joshuabriley/"
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Connect on LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* Illustrative hero motion — one token propagates to three components.
     Transform/opacity only. A pulse travels the wire; each node lights as it
     arrives, then a synced dot confirms. Loops calmly; pauses on reduced-motion. */
  .prop-pulse {
    animation: prop-emit 5s var(--ease-inout) infinite;
  }
  .prop-bar { transition: background-color 0.4s var(--ease-out); }
  .prop-dot { transition: background-color 0.4s var(--ease-out); }

  .prop-node-0 { animation: prop-light 5s var(--ease-out) infinite; animation-delay: 0.6s; }
  .prop-node-1 { animation: prop-light 5s var(--ease-out) infinite; animation-delay: 1.0s; }
  .prop-node-2 { animation: prop-light 5s var(--ease-out) infinite; animation-delay: 1.4s; }
  .prop-node-0 .prop-bar { animation: prop-bar 5s steps(1) infinite; animation-delay: 0.6s; }
  .prop-node-1 .prop-bar { animation: prop-bar 5s steps(1) infinite; animation-delay: 1.0s; }
  .prop-node-2 .prop-bar { animation: prop-bar 5s steps(1) infinite; animation-delay: 1.4s; }
  .prop-node-0 .prop-dot { animation: prop-bar 5s steps(1) infinite; animation-delay: 0.8s; }
  .prop-node-1 .prop-dot { animation: prop-bar 5s steps(1) infinite; animation-delay: 1.2s; }
  .prop-node-2 .prop-dot { animation: prop-bar 5s steps(1) infinite; animation-delay: 1.6s; }

  @keyframes prop-emit {
    0%, 12% { transform: scale(1); opacity: 1; }
    6% { transform: scale(1.7); opacity: 0.5; }
    100% { transform: scale(1); opacity: 1; }
  }
  @keyframes prop-light {
    0%, 100% { border-color: var(--line); }
    8%, 30% { border-color: rgba(168, 65, 42, 0.4); }
  }
  @keyframes prop-bar {
    0%, 100% { background-color: var(--line); }
    8%, 34% { background-color: var(--accent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .prop-pulse, .prop-node-0, .prop-node-1, .prop-node-2,
    .prop-bar, .prop-dot { animation: none !important; }
    .prop-node-0 .prop-bar, .prop-node-1 .prop-bar, .prop-node-2 .prop-bar { background-color: var(--accent); }
    .prop-node-0 .prop-dot, .prop-node-1 .prop-dot, .prop-node-2 .prop-dot { background-color: var(--accent); }
  }
</style>
