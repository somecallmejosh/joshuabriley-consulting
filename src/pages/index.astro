---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';

// ── Content (every claim is backed by the site itself or a real case study) ──
const clients = ['Travelers', 'Berkshire Hathaway', "America's Test Kitchen", 'NASCAR', 'NFL'];

const capabilities = [
  'Design-grade front-end',
  'React · TypeScript · 20 yrs',
  'Accessibility built in',
  'Design systems',
];

// The differentiator band. Why these products feel finished. The lead facet (UI)
// is the featured cell; the rest are the front-end disciplines behind the finish.
const facets = [
  {
    title: 'The UI is where I bring the most value',
    body:
      'Twenty years in design systems taught me where interfaces break: type, spacing, motion, the empty and error states most engineers leave blank. I build it myself, design-grade, instead of handing a spec to someone who will approximate it.',
    featured: true,
  },
  {
    title: 'Accessible by construction',
    body:
      'Keyboard paths, focus management, and screen-reader behavior built in from the start. Accessibility is the mechanism that makes a product work for everyone, not a checkbox.',
  },
  {
    title: 'I sweat the last 10%',
    body:
      'Empty states, recoverable forms, the screen that shows when there is nothing to show yet. Those are the parts that decide whether a product feels finished, and whether it holds up after launch.',
  },
  {
    title: 'I bring the system, not just the screen',
    body:
      'When a product needs a real design system, I build that too: one library, one accessibility floor, every brand held to the same standard. It is how the UI stays consistent as the team and the surface area grow.',
  },
];

const metrics = [
  { value: '75%', label: 'fewer support calls', note: 'IVFCRYO: clearer, recoverable flows' },
  { value: '55%', label: 'fewer shipping errors', note: 'IVFCRYO: accessible forms at the source' },
  { value: '3 → 1', label: 'brands, one library', note: "America's Test Kitchen: one system, three brands" },
];

// Client products where I owned the interface. Order follows the positioning doc.
const work = [
  {
    href: '/projects/americas-test-kitchen/',
    client: "America's Test Kitchen",
    kind: 'Design system',
    line: 'When a product needs a real design system, I build that too: one library serving three editorial brands, one accessibility floor.',
  },
  {
    href: '/projects/berxi-insurance/',
    client: 'Berxi',
    kind: 'Design system',
    line: 'A design system for a growing insurance platform, from stakeholder alignment through component library, documentation, and cross-team adoption.',
  },
  {
    href: '/projects/ivfcryo/',
    client: 'IVFCRYO',
    kind: 'Accessible flows',
    line: 'Recoverable specimen-shipping flows for a fertility logistics product. Accessibility was the mechanism that moved the numbers.',
  },
  {
    href: '/projects/vmspark/',
    client: 'VMSpark',
    kind: 'Admin platform',
    line: 'A multi-tenant admin platform rebuilt and shipped in four phases: the operator-facing UI and workflows, delivered with zero pipeline regressions.',
  },
];
---

<BaseLayout
  title="Joshua Briley | Design & front-end focused Product Engineer"
  description="Design- and front-end-focused product engineer with 20 years in production UI. The interface is where I bring the most value: design-grade, accessible, and finished to the last detail."
>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <p class="hero-in hero-in-1 mono-label">
        <span class="sr-only">My role is </span>Product Engineer
        <span class="text-ink-faint"> · </span>
        <span class="sr-only">I focus on </span>Design &amp; front-end
      </p>

      {/* Editorial hero on the shared 12-col grid, so its measure matches the
          about/resume heroes. No illustration: the "Shipped at" credentials strip
          directly below carries the proof. */}
      <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[19ch]">
            My best work lives at the <em class="ink-wink font-normal italic">interface</em>, down to the last detail.
          </Heading>
          <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
            I'm a design- and front-end-focused product engineer with 20 years in production UI. The
            interface is where I bring the most value: design-grade, accessible, and finished to the
            last detail.
          </Text>

          <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-3">
            <Button variant="primary" size="lg" href="/projects/" iconRight="ph:arrow-right" class="js-magnetic">
              See what I've built
            </Button>
            <Button variant="ghost" size="lg" href="/about/">
              Read how I work
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CREDENTIALS STRIP ───────────────────────── */}
  <Section tone="paper" padding="tight" class="!py-9 border-b border-line">
    <Container width="wide">
      <div class="grid gap-x-10 gap-y-6 lg:grid-cols-12 lg:items-center">
        <ul class="lg:col-span-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
          {capabilities.map((c) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{c}
            </li>
          ))}
        </ul>
        <div class="lg:col-span-6 flex flex-wrap items-center gap-x-7 gap-y-2 lg:justify-end">
          <span class="mono-label whitespace-nowrap"><span class="sr-only">My work has shipped at </span>Shipped at</span>
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
            {clients.map((c) => (
              <li class="font-display text-[0.92rem] font-medium tracking-tight text-ink-muted">{c}</li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── DIFFERENTIATOR (asymmetric bento) ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="max-w-3xl">
        <Heading level={2} visual="display-md">
          Why my products feel finished.
        </Heading>
        <Text size="lg" tone="muted" class="mt-5">
          Most engineers treat design and accessibility as someone else's job, or the first thing
          cut when a deadline closes in. I build them in. That's why the things I ship work for
          everyone, not just the average user on a fast laptop, and why they hold up after launch.
        </Text>
      </div>

      <div
        class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3"
        data-reveal-stagger
      >
        {facets.map((c) => (
          <div class={`bg-paper p-7 md:p-9 ${c.featured ? 'lg:col-span-2 lg:row-span-3 lg:flex lg:flex-col lg:justify-center md:p-10' : ''}`}>
            {c.featured ? (
              <>
                <span class="mono-label text-accent">Where the value is</span>
                <Heading level={3} visual="h2" class="mt-4 max-w-[16ch]">{c.title}</Heading>
                <Text tone="muted" class="mt-4 max-w-lg">{c.body}</Text>
              </>
            ) : (
              <>
                <Heading level={3} visual="h3">{c.title}</Heading>
                <Text tone="muted" size="sm" class="mt-3">{c.body}</Text>
              </>
            )}
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── SELECTED WORK (ink) ───────────────────────── */}
  <Section tone="ink" padding="default">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="mono-label !text-paper/65">Selected work</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4">Products where I owned the interface.</Heading>
        </div>
        <div class="lg:col-span-6 grid grid-cols-3 gap-6">
          {metrics.map((m) => (
            <div>
              <p class="font-serif text-4xl md:text-5xl font-semibold tracking-[-0.02em] text-paper">{m.value}</p>
              <p class="mt-1 text-sm text-paper/70">{m.label}</p>
              <p class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.1em] leading-relaxed text-paper/60">{m.note}</p>
            </div>
          ))}
        </div>
      </div>

      <ul class="mt-14 border-t border-paper/10" data-reveal-stagger>
        {work.map((w) => (
          <li>
            <a href={w.href} class="group grid grid-cols-12 items-center gap-4 border-b border-paper/10 py-5 transition-colors hover:bg-paper/[0.03]">
              <span class="col-span-12 flex items-center gap-3 sm:col-span-4">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{w.kind}</span>
              </span>
              <span class="col-span-10 sm:col-span-7">
                <span class="font-display text-lg font-medium tracking-tight text-paper">{w.client}</span>
                <span class="mt-0.5 block text-sm text-paper/55">{w.line}</span>
              </span>
              <span class="col-span-2 flex justify-end sm:col-span-1">
                <Icon name="ph:arrow-right" size={18} class="text-paper/50 transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-paper" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a href="/projects/" class="inline-flex items-center gap-2 font-sans text-[0.9rem] font-medium text-paper transition-colors hover:text-accent">
          View all projects <Icon name="ph:arrow-right" size={15} />
        </a>
        <p class="text-sm text-paper/55 max-w-xl">
          And the tooling that enforces the quality: a
          <a href="/blog/what-an-audit-finds/" class="text-paper/80 underline decoration-paper/30 underline-offset-2 transition-colors hover:text-paper hover:decoration-paper">design-system drift auditor</a>
          that measures UI debt in counts and hours, plus a decision guide for accessible interface patterns.
        </p>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── ABOUT STRIP ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="grid items-start gap-10 md:grid-cols-12 md:gap-14">
        <div class="md:col-span-4">
          <div class="overflow-hidden rounded-lg border border-line">
            <picture>
              <source srcset="/images/josh-biz-cazsh.webp" type="image/webp" />
              <img src="/images/josh-biz-cazsh.jpg" alt="Joshua Briley, product engineer" class="aspect-[4/5] w-full object-cover" loading="lazy" width="640" height="800" />
            </picture>
          </div>
        </div>
        <div class="md:col-span-8">
          <Heading level={2} visual="display-md" class="max-w-[18ch]">
            Designer by origin. Engineer by practice.
          </Heading>
          <div class="mt-6 space-y-4 text-ink-muted leading-relaxed max-w-2xl">
            <p>
              I started in design and moved into engineering because I wanted to build the things I
              drew, not hand them off. Twenty years later, the front end is where I do my best work:
              design-grade, accessible UI with the judgment most engineering teams have to hire a
              separate designer to get.
            </p>
            <p>
              I build by feel, fast, and I sweat the finish. Away from the screen, I play bass and
              gig regularly, which is its own lesson in getting the details right in real time.
            </p>
          </div>
          <div class="mt-7">
            <Link href="/about/" variant="arrow">Read more about how I work</Link>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── WRITING + CLOSING CTA (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-7">
          <Heading level={2} visual="display-lg" tone="paper" class="max-w-[20ch]">
            Looking for a team that cares about the finish.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            I want to build complete, accessible products on a team that treats the last 10% as the
            point, not the afterthought. If that's the work, let's talk.
          </Text>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">Get in touch</Button>
            <a
              href="/resume/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Résumé <Icon name="ph:file-text" size={12} /></a>
          </div>
        </div>

        <div class="lg:col-span-5 lg:border-l lg:border-paper/15 lg:pl-12">
          <p class="mono-label !text-paper/55">Latest writing</p>
          <Heading level={3} visual="h3" tone="paper" class="mt-3 max-w-[24ch]">
            Notes on building complete products.
          </Heading>
          <Text size="sm" tone="whiteMuted" class="mt-3 max-w-md">
            Accessible interfaces, the details that make software feel finished, AI-assisted
            development, and the changing shape of the front-end engineer.
          </Text>
          <div class="mt-5">
            <a href="/blog/" class="inline-flex items-center gap-2 font-sans text-[0.9rem] font-medium text-paper transition-colors hover:text-accent">
              Read the blog <Icon name="ph:arrow-right" size={15} />
            </a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* ── Hero load-in. A calm staggered rise on first paint. Transform/opacity only. */
  .hero-in {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-in 0.7s var(--ease-out) forwards;
  }
  .hero-in-1 { animation-delay: 0.04s; }
  .hero-in-2 { animation-delay: 0.11s; }
  .hero-in-3 { animation-delay: 0.19s; }
  .hero-in-4 { animation-delay: 0.28s; }
  @keyframes hero-in {
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in { animation: none; opacity: 1; transform: none; }
  }
</style>
