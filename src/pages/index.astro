---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Grid from '~/components/layout/Grid.astro';
import SquiggleDivider from '~/components/decorative/SquiggleDivider.astro';
import Blob from '~/components/decorative/Blob.astro';
import WavyUnderline from '~/components/decorative/WavyUnderline.astro';
import Pin from '~/components/decorative/Pin.astro';
import Tape from '~/components/decorative/Tape.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';
import Badge from '~/components/primitives/Badge.astro';
import Button from '~/components/primitives/Button.astro';
import Link from '~/components/primitives/Link.astro';
import SectionHeader from '~/components/patterns/SectionHeader.astro';
import CTABanner from '~/components/patterns/CTABanner.astro';
import Card from '~/components/card/Card.astro';
import Metric from '~/components/patterns/Metric.astro';

// The four proofs the homepage exists to make unmistakable: it looks excellent,
// it is built correctly, it scales as a system, and it earns its place in the
// business. Every claim below is backed by the site itself or a real case study.
const pillars = [
  {
    icon: 'ph:sparkle-duotone',
    accent: 'coral',
    eyebrow: 'Craft',
    title: 'It looks excellent',
    body: "Type, spacing, motion, and restraint that read as deliberate — the polish you're looking at right now. The same eye goes into brand-grade UI for teams like America's Test Kitchen, NASCAR, and the NFL.",
    tilt: -1 as const,
  },
  {
    icon: 'ph:seal-check-duotone',
    accent: 'plum',
    eyebrow: 'Correctness',
    title: "It's built correctly",
    body: 'Semantic HTML, WCAG 2.2 accessibility, keyboard and screen-reader testing, and a real eye on performance. Built the way it looks — production-grade, not a pretty shell over brittle markup.',
    tilt: 1 as const,
  },
  {
    icon: 'ph:stack-duotone',
    accent: 'sky',
    eyebrow: 'Systems',
    title: 'It scales as a system',
    body: 'Tokens, components, and documentation so one decision lands on every surface at once. The backbone behind Rudiment UI and the multi-brand component library at America\'s Test Kitchen.',
    tilt: -1 as const,
  },
  {
    icon: 'ph:trend-up-duotone',
    accent: 'sunset',
    eyebrow: 'Business surfaces',
    title: 'It moves the business',
    body: 'Interfaces tuned for conversion and retention, technical SEO that helps pages rank, and campaign and landing surfaces marketing can actually move — like the design system that unblocked campaigns at Berxi.',
    tilt: 1 as const,
  },
];

const accentMap: Record<string, { text: string; bg: string; ring: string }> = {
  coral: { text: 'text-[#C13A22]', bg: 'bg-coral/10', ring: 'ring-coral/20' },
  plum: { text: 'text-plum', bg: 'bg-plum/10', ring: 'ring-plum/20' },
  sky: { text: 'text-sky-deep', bg: 'bg-sky/10', ring: 'ring-sky/30' },
  sunset: { text: 'text-sunset-deep', bg: 'bg-sunset/10', ring: 'ring-sunset/20' },
};

const questions = [
  'Is this interaction clear to the user?',
  'Does the interface behave the way people expect?',
  'Can teams reuse this pattern without misusing it?',
  'Are we solving the actual experience problem, or only making the screen look better?',
  'Will this still make sense when another team has to build on it six months from now?',
];

const work = [
  {
    href: '/projects/',
    label: 'Component systems',
    labelTone: 'sage' as const,
    labelIcon: 'ph:wheelchair-duotone',
    marker: '01',
    title: 'Accessible component systems',
    summary:
      'Reusable interface components built around semantic structure, keyboard support, focus management, responsive behavior, and practical usage guidance.',
    cta: 'See the work',
    tilt: '-1.8deg',
    decoration: 'pin' as const,
    pinTone: undefined,
    collage: {
      bgFrom: 'from-sage/30',
      bgTo: 'to-lemon/30',
      icon: 'ph:cube-transparent-duotone',
      iconClass: 'text-sage',
    },
  },
  {
    href: '/projects/',
    label: 'Design ↔ code',
    labelTone: 'plum' as const,
    labelIcon: 'ph:flow-arrow-duotone',
    marker: '02',
    title: 'Design-to-code alignment',
    summary:
      'Reducing friction between design tools, component libraries, documentation, and shipped product UI so design decisions survive implementation.',
    cta: 'See the work',
    tilt: '1.5deg',
    decoration: 'tape-both' as const,
    pinTone: undefined,
    collage: {
      bgFrom: 'from-plum/25',
      bgTo: 'to-sky/30',
      icon: 'ph:arrows-left-right-duotone',
      iconClass: 'text-plum',
    },
  },
  {
    href: '/projects/',
    label: 'Experience audits',
    labelTone: 'coral' as const,
    labelIcon: 'ph:binoculars-duotone',
    marker: '03',
    title: 'Experience audits & reviews',
    summary:
      'Reviewing product interfaces for clarity, accessibility, consistency, and usability — turning findings into practical recommendations teams can act on.',
    cta: 'See the work',
    tilt: '-1.2deg',
    decoration: 'pin' as const,
    pinTone: 'plum' as const,
    collage: {
      bgFrom: 'from-coral/25',
      bgTo: 'to-sunset/30',
      icon: 'ph:magnifying-glass-duotone',
      iconClass: 'text-coral',
    },
  },
];

const toolsPreview = [
  {
    icon: 'ph:clipboard-text-duotone',
    accent: 'coral',
    title: 'Design System Scorecard',
    body:
      'Score your system across the five dimensions of a healthy design system in about ten minutes. Walk away with a clear picture of your biggest gaps.',
    href: '/tools/scorecard/',
    cta: 'Take the scorecard',
  },
  {
    icon: 'ph:magnifying-glass-duotone',
    accent: 'plum',
    title: 'What an audit finds',
    body:
      'A working sample of the audit deliverable: inspect a specimen of drifted UI and read findings ranked by severity, each paired with its remediation.',
    href: '/tools/audit-findings/',
    cta: 'Open the demo',
  },
  {
    icon: 'ph:sliders-horizontal-duotone',
    accent: 'sky',
    title: 'What a token does',
    body:
      'Change one primitive and watch it propagate through every component at once. The playground makes token indirection visible.',
    href: '/tools/token-playground/',
    cta: 'Open the demo',
  },
];
---

<BaseLayout
  title="Joshua Briley — UX Engineer: interfaces that look right, build right & convert"
  description="UX engineer with 20 years in production UI. I make product interfaces that look excellent, are built correctly (accessibility, semantic HTML, performance), scale as design systems, and move the business — conversion, retention, technical SEO, and campaign surfaces."
>
  <Fragment slot="head">
    <style>
      @keyframes dash-flow {
        to { stroke-dashoffset: -40; }
      }
    </style>
  </Fragment>


  <Section tone="cream" padding="loose" decorated class="pt-16 md:pt-24">
    <div class="absolute inset-0 grid-paper opacity-60" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-cream via-cream to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-cream to-transparent" aria-hidden="true"></div>

    <Blob tone="plum" size="md" animate="float" opacity="opacity-30" class="absolute top-24 right-[10%]" />
    <Blob tone="lemon" size="sm" animate="float-delay" class="absolute top-40 left-[6%] w-10 h-10 rounded-full" />
    <Blob tone="sage" size="sm" animate="float-slow" opacity="opacity-50" class="absolute bottom-20 right-[16%]" />
    <Blob tone="sky" size="sm" animate="float" opacity="opacity-50" class="absolute bottom-32 left-[14%] w-8 h-8 rounded-full" />

    <Container class="relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-7">
          <Badge tone="lemon" icon="ph:sparkle-duotone" class="mb-8">
            Design · Engineering · Systems · Growth
          </Badge>

          <Heading level={1} visual="display-xl" class="mb-6">
            Interfaces that <WavyUnderline>look excellent</WavyUnderline> — and prove it.
          </Heading>

          <Text size="lg" tone="muted" class="max-w-xl mb-8">
            Twenty years at the seam between design and engineering. Not just polished in Figma — built correctly in code, coherent as a system, and tuned to perform for the business.
          </Text>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <Button variant="primary" size="lg" iconLeft="ph:folder-open-duotone" href="/projects/">
              View selected work
            </Button>
            <Button variant="ghost" size="lg" iconLeft="ph:linkedin-logo-duotone" href="https://www.linkedin.com/in/joshuabriley/">
              Connect on LinkedIn
            </Button>
          </div>

          <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-charcoal/70 font-body">
            <li class="flex items-center gap-1.5"><Icon name="ph:check-circle-duotone" size={16} class="text-sage" />20 yrs in production UI</li>
            <li class="flex items-center gap-1.5"><Icon name="ph:check-circle-duotone" size={16} class="text-sage" />WCAG 2.2, keyboard &amp; screen-reader tested</li>
            <li class="flex items-center gap-1.5"><Icon name="ph:check-circle-duotone" size={16} class="text-sage" />Tokens &amp; docs that scale</li>
            <li class="flex items-center gap-1.5"><Icon name="ph:check-circle-duotone" size={16} class="text-sage" />Tuned to convert &amp; to rank</li>
          </ul>
        </div>


        <div class="lg:col-span-5 relative h-[360px] md:h-[440px] hidden lg:block" aria-hidden="true">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-80 h-80 rounded-full border-2 border-dashed border-plum/25 animate-spin-slow"></div>
          </div>

          <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 440" fill="none">
            <path d="M 130 120 C 170 180, 180 200, 200 220" stroke="#6C4AB6" stroke-width="2.5" stroke-linecap="round" style="stroke-dasharray: 10 8; animation: dash-flow 1.6s linear infinite" />
            <path d="M 200 220 C 220 250, 250 280, 270 320" stroke="#E8573D" stroke-width="2.5" stroke-linecap="round" style="stroke-dasharray: 10 8; animation: dash-flow 1.6s linear infinite; animation-delay: 0.5s" />
          </svg>

          <div class="absolute top-[8%] left-[6%] bg-white rounded-2xl shadow-xl border border-charcoal/5 p-4 w-36 animate-float -rotate-3">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-7 h-7 rounded-lg bg-coral/15 flex items-center justify-center">
                <Icon name="ph:sparkle-duotone" size={18} class="text-coral" />
              </div>
              <span class="font-heading text-xs font-semibold text-navy">Excellent</span>
            </div>
            <div class="space-y-1.5">
              <div class="h-1.5 rounded-full bg-charcoal/10"></div>
              <div class="h-1.5 rounded-full bg-coral/40 w-3/5"></div>
            </div>
          </div>

          <div class="absolute top-[38%] left-[30%] bg-white rounded-2xl shadow-xl border border-charcoal/5 p-4 w-36 animate-float-delay rotate-2">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-7 h-7 rounded-lg bg-plum/15 flex items-center justify-center">
                <Icon name="ph:seal-check-duotone" size={18} class="text-plum" />
              </div>
              <span class="font-heading text-xs font-semibold text-navy">Correct</span>
            </div>
            <div class="space-y-1.5">
              <div class="h-1.5 rounded-full bg-charcoal/10"></div>
              <div class="h-1.5 rounded-full bg-plum/40 w-4/5"></div>
            </div>
          </div>

          <div class="absolute bottom-[12%] right-[4%] bg-white rounded-2xl shadow-xl border border-charcoal/5 p-4 w-36 animate-float-slow -rotate-2">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-7 h-7 rounded-lg bg-sky/15 flex items-center justify-center">
                <Icon name="ph:stack-duotone" size={18} class="text-sky" />
              </div>
              <span class="font-heading text-xs font-semibold text-navy">Systems</span>
            </div>
            <div class="space-y-1.5">
              <div class="h-1.5 rounded-full bg-charcoal/10"></div>
              <div class="h-1.5 rounded-full bg-sky/40 w-2/3"></div>
            </div>
          </div>

          <div class="absolute top-[22%] right-[8%] bg-white rounded-full shadow-lg border border-charcoal/5 px-3 py-1.5 flex items-center gap-1.5 animate-float rotate-3">
            <Icon name="ph:trend-up-duotone" size={14} class="text-sage" />
            <span class="font-heading text-[11px] font-semibold text-navy">Converts</span>
          </div>

          <div class="absolute bottom-[32%] left-[4%] bg-white rounded-full shadow-lg border border-charcoal/5 px-3 py-1.5 flex items-center gap-1.5 animate-float-delay -rotate-3">
            <Icon name="ph:magnifying-glass-duotone" size={14} class="text-plum" />
            <span class="font-heading text-[11px] font-semibold text-navy">Ranks</span>
          </div>
        </div>
      </div>
    </Container>
  </Section>




  <Section id="what-i-do" tone="white" padding="default">
    <Container>
      <SectionHeader
        eyebrow="What you actually get"
        eyebrowIcon="ph:squares-four-duotone"
        eyebrowTone="plum"
        title="Excellent, correct, systematic — and good for business."
        lead="Most of the work lives in the gap between an idea and a shipped interface: designs that look great in Figma but drift in code, components nobody knows how to reuse, accessibility raised late, performance and search left to chance. I close that gap on four axes at once."
        align="left"
        class="mb-14 max-w-4xl"
      />

      <div class="grid gap-6 md:grid-cols-2 lg:gap-8 lg:items-start" data-reveal-stagger>
        {pillars.map((p, idx) => {
          const a = accentMap[p.accent];
          // Nudge the second column down so the 2×2 reads as a hand-placed
          // collage rather than a rigid quadrant grid.
          const offset = ['lg:mt-0', 'lg:mt-10', 'lg:mt-0', 'lg:mt-10'][idx];
          return (
            <Card variant="paper" tilt={p.tilt} padding="loose" class={`relative overflow-hidden ${a.ring} ${offset}`}>
              <div class={`absolute -top-10 -right-10 w-32 h-32 ${a.bg} rounded-full pointer-events-none`} aria-hidden="true"></div>
              <div class="relative">
                <div class="flex items-center gap-2 mb-2">
                  <span class={`flex-shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full ${a.bg} font-heading text-xs font-bold ${a.text}`} aria-hidden="true">
                    {idx + 1}
                  </span>
                  <span class={`inline-block text-xs font-heading font-semibold ${a.text} uppercase tracking-wider`}>
                    {p.eyebrow}
                  </span>
                </div>
                <div class={`w-14 h-14 ${a.bg} rounded-2xl flex items-center justify-center mb-5`}>
                  <Icon name={p.icon} size={28} class={a.text} />
                </div>
                <Heading level={3} visual="h2" class="mb-3 leading-tight">{p.title}</Heading>
                <Text tone="muted">{p.body}</Text>
              </div>
            </Card>
          );
        })}
      </div>

      <div class="mt-16">
        <p class="font-heading text-sm font-semibold text-charcoal/70 uppercase tracking-wider mb-6 flex items-center gap-2">
          <Icon name="ph:seal-check-duotone" size={18} class="text-plum" />
          Receipts, not adjectives
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 bg-white rounded-2xl p-7 md:p-9 border border-charcoal/5 shadow-sm">
          <Metric value="75%" label="fewer support calls" caption="IVFCRYO — clearer, recoverable flows" tone="sage" />
          <Metric value="55%" label="fewer shipping errors" caption="IVFCRYO — accessible forms at the source" tone="plum" />
          <Metric value="3" label="brands, one library" caption="America's Test Kitchen — divergence lives in tokens" tone="coral" />
        </div>
      </div>
    </Container>
  </Section>


  <Section tone="navy" padding="default" decorated>
    <Blob tone="plum" size="lg" animate="float-slow" opacity="opacity-50" class="absolute top-8 left-[5%]" />
    <Blob tone="coral" size="md" shape="alt" animate="float" opacity="opacity-30" class="absolute bottom-12 right-[8%] !rounded-full" />
    <Blob tone="lemon" size="sm" animate="float-delay" opacity="opacity-40" class="absolute top-1/2 right-[14%]" />

    <Container class="relative z-10">
                <Badge tone="lemon" icon="ph:lightning-duotone" class="mb-6 rotate-1 !bg-lemon !border-lemon">
            Why this work matters
          </Badge>
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start lg:items-center">
        <ul class="lg:col-span-6 grid sm:grid-cols-2 gap-4">
          <li class="flex items-start gap-3 bg-white/5 border border-white/10 rounded-2xl p-5">
            <Icon name="ph:text-aa-duotone" size={22} class="text-lemon flex-shrink-0 mt-0.5" />
            <Text size="base" tone="whiteMuted">A button label can reduce confusion.</Text>
          </li>
          <li class="flex items-start gap-3 bg-white/5 border border-white/10 rounded-2xl p-5">
            <Icon name="ph:textbox-duotone" size={22} class="text-coral flex-shrink-0 mt-0.5" />
            <Text size="base" tone="whiteMuted">A form pattern can prevent errors.</Text>
          </li>
          <li class="flex items-start gap-3 bg-white/5 border border-white/10 rounded-2xl p-5">
            <Icon name="ph:cursor-duotone" size={22} class="text-sky flex-shrink-0 mt-0.5" />
            <Text size="base" tone="whiteMuted">A focus state can make a workflow usable.</Text>
          </li>
          <li class="flex items-start gap-3 bg-white/5 border border-white/10 rounded-2xl p-5">
            <Icon name="ph:stack-duotone" size={22} class="text-sage flex-shrink-0 mt-0.5" />
            <Text size="base" tone="whiteMuted">One system decision can save dozens of teams from re-solving the same problem.</Text>
          </li>
        </ul>
        <div class="lg:col-span-6">

          <Heading level={2} visual="display-md" tone="white" balance class="mb-6">
            The interface is where <span class="text-lemon">strategy</span> becomes real.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mb-8">
            A product can have a smart roadmap, strong research, and talented teams — but users only experience what makes it to the screen. The screen is where trust is won, where a flow converts or stalls, where a page earns its ranking. Small details, real consequences.
          </Text>
          <Text size="base" tone="whiteMuted" class="italic max-w-md border-l-2 border-lemon/60 pl-4">
            So I treat the interface as a business surface, not just a canvas — the place where craft, correctness, and system decisions show up as outcomes.
          </Text>
        </div>


      </div>
    </Container>
  </Section>


  <Section id="business" tone="peach" padding="default" decorated>
    <Blob tone="coral" size="lg" animate="float-slow" opacity="opacity-25" class="absolute -top-6 right-[6%]" />
    <Blob tone="lemon" size="sm" animate="float-delay" opacity="opacity-50" class="absolute bottom-12 left-[8%] rounded-full" />

    <Container class="relative z-10">
      <SectionHeader
        eyebrow="Business surfaces"
        eyebrowIcon="ph:chart-line-up-duotone"
        eyebrowTone="coral"
        title="Design that has to perform, not just please."
        lead="The interface is where conversion, retention, and search visibility actually happen. I build the surfaces the business leans on — and the front-end quality that makes them fast, findable, and easy for marketing to move."
        align="left"
        class="mb-14 max-w-3xl"
      />

      <div class="grid gap-6 md:grid-cols-3 lg:gap-8" data-reveal-stagger>
        <Card variant="paper" tilt={-1} padding="loose" class="flex flex-col">
          <div class="w-12 h-12 rounded-2xl bg-coral/10 flex items-center justify-center mb-4">
            <Icon name="ph:trend-up-duotone" size={26} class="text-[#C13A22]" />
          </div>
          <Heading level={3} visual="h3" class="mb-2 leading-tight">Conversion &amp; retention</Heading>
          <Text tone="muted" class="text-[0.95rem] flex-1">
            Flows tuned to convert and to keep people. At VMSpark I rebuilt a multi-tenant admin shell that lifted sales conversion and customer retention — without touching the pipeline underneath.
          </Text>
          <a href="/projects/vmspark/" class="mt-4 inline-flex items-center gap-1.5 font-heading font-semibold text-[#C13A22] text-sm hover:gap-3 transition-all">
            Read the VMSpark story
            <Icon name="ph:arrow-right-bold" size={16} />
          </a>
        </Card>

        <Card variant="paper" tilt={1} padding="loose" class="flex flex-col">
          <div class="w-12 h-12 rounded-2xl bg-plum/10 flex items-center justify-center mb-4">
            <Icon name="ph:magnifying-glass-duotone" size={26} class="text-plum" />
          </div>
          <Heading level={3} visual="h3" class="mb-2 leading-tight">Technical SEO</Heading>
          <Text tone="muted" class="text-[0.95rem] flex-1">
            Semantic HTML, clean document structure, structured data, and the Core Web Vitals performance that helps pages rank. The same correctness that serves screen readers serves search engines.
          </Text>
        </Card>

        <Card variant="paper" tilt={-1} padding="loose" class="flex flex-col">
          <div class="w-12 h-12 rounded-2xl bg-sunset/10 flex items-center justify-center mb-4">
            <Icon name="ph:megaphone-duotone" size={26} class="text-sunset-deep" />
          </div>
          <Heading level={3} visual="h3" class="mb-2 leading-tight">Campaigns &amp; landing pages</Heading>
          <Text tone="muted" class="text-[0.95rem] flex-1">
            Campaign and landing surfaces marketing can move without an engineering bottleneck. At Berxi, the design system I built unblocked the marketing team to ship campaigns and landing-page variations on their own.
          </Text>
          <a href="/projects/berxi-insurance/" class="mt-4 inline-flex items-center gap-1.5 font-heading font-semibold text-sunset-deep text-sm hover:gap-3 transition-all">
            Read the Berxi story
            <Icon name="ph:arrow-right-bold" size={16} />
          </a>
        </Card>
      </div>
    </Container>
  </Section>


  <Section id="how-i-think" tone="cream" padding="default" decorated>
    <Blob tone="peach" size="lg" animate="float-slow" opacity="opacity-40" class="absolute -top-8 right-[6%]" />
    <Blob tone="sky" size="sm" animate="float-delay" opacity="opacity-40" class="absolute bottom-12 left-[8%] rounded-full" />

    <Container class="relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7">
          <Badge tone="sage" icon="ph:brain-duotone" class="mb-6 -rotate-1">How I think</Badge>
          <Heading level={2} visual="display-md" balance class="mb-6">
            I care about the space between <WavyUnderline>people, patterns, and code</WavyUnderline>.
          </Heading>
          <div class="space-y-4 text-charcoal/75 text-base md:text-lg leading-relaxed">
            <p>
              I started as a designer who learned to code. Over time, that turned into 20 years of building interfaces, component libraries, and design systems for real product teams.
            </p>
            <p>
              That background taught me something important: experience problems are rarely just design problems or engineering problems. They usually live in the handoff, the assumptions, the missing details, the unclear patterns — the places where teams <em class="text-charcoal font-medium not-italic">think</em> they agree but don't.
            </p>
            <p class="font-display italic text-navy text-xl">
              I like working in that space.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-white/70 backdrop-blur rounded-3xl border border-charcoal/10 p-6 md:p-8 shadow-sm relative">
            <span class="absolute -top-3 left-8 inline-flex items-center gap-1.5 bg-[#C13A22] text-white text-xs font-heading font-semibold uppercase tracking-wider px-3 py-1 rounded-full shadow-md -rotate-2">
              <Icon name="ph:question-duotone" size={14} />
              Questions I ask
            </span>
            <ol class="space-y-4 mt-3">
              {questions.map((q, i) => (
