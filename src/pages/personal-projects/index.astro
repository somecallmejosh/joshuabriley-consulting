---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  'Personal projects Joshua Briley built for himself: a multi-tenant personal-finance app, a bass-practice tool wiring live audio and an LLM into one product, and an arcade game that teaches the W3C design-tokens spec. No client, no brief, just the finish for its own sake.';

const projects = [
  {
    index: '01',
    href: '/personal-projects/clempo/',
    client: 'Clempo',
    kind: 'Full-stack product',
    title: 'A personal-finance app, owned end to end',
    summary:
      'A multi-tenant personal-finance app with real households using it: authentication, tenancy, data modeling, and the interface, all mine. Built to keep more than one household’s data correct and private at once.',
    note: 'Multi-tenant in production',
  },
  {
    index: '02',
    href: '/personal-projects/bass-face/',
    client: 'Bass Face',
    kind: 'React · live services',
    title: 'Live audio and an LLM in one product',
    summary:
      'A bass-practice tool I built for myself in React: generative backing tracks synthesized with Tone.js and reflective feedback wired in through the Claude API. Creative range and comfort wiring live services into a real product.',
    note: 'Tone.js + Claude API',
  },
  {
    index: '03',
    href: '/personal-projects/token-galaga/',
    client: 'Token Adventure',
    kind: 'Arcade game · Teaching tool',
    title: 'A Galaga-style arcade that teaches design tokens',
    summary:
      'A playable coding arcade that teaches the W3C Design Tokens Format spec across eight sectors, from why tokens exist to auditing a broken library. A hard spec turned into something you actually want to finish.',
    note: 'Companion to Rudiment UI',
  },
  {
    index: '04',
    href: '/personal-projects/west-baton-rouge-presbyterian/',
    client: 'West Baton Rouge Presbyterian',
    kind: 'Rails CMS',
    title: 'A full CMS',
    summary:
      'A custom Rails CMS built end to end: content models for events, galleries, and pages, a Cloudinary media pipeline, staff authentication, and an accessible public site. Proof of range and speed.',
    note: 'Shipped in a weekend',
  },
];
---

<BaseLayout title="Personal projects | Joshua Briley" description={description}>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="mb-12 flex items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
        <a href="/projects/" class="transition-colors hover:text-accent">Projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">Personal projects</span>
      </nav>

      <p class="hero-in hero-in-1 mono-label">Personal work · Built for myself</p>

      <div class="mt-10 max-w-4xl lg:mt-14">
        <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[20ch]">
          What I build when <em class="ink-wink font-normal italic">no one's asking</em>.
        </Heading>
        <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
          No client, no brief, no deadline to cut against. These are the projects where the only
          bar is whether I actually want to use the thing, which turns out to be a higher bar than
          most briefs set. The same finish I bring to the work I ship for teams.
        </Text>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── PROJECT LIST ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <ul class="border-t border-line" data-reveal-stagger>
        {projects.map((p) => (
          <li>
            <a
              href={p.href}
              class="group grid grid-cols-12 items-start gap-x-4 gap-y-3 border-b border-line py-8 transition-colors hover:bg-ink/[0.02] md:gap-y-0 md:py-10"
            >
              <span class="col-span-2 flex items-baseline gap-3 sm:col-span-1">
                <span class="font-mono text-[0.8rem] text-accent">{p.index}</span>
              </span>

              <span class="col-span-10 sm:col-span-4 md:col-span-3">
                <span class="font-display text-xl font-medium tracking-tight text-ink md:text-2xl">{p.client}</span>
                <span class="mt-1 block font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{p.kind}</span>
              </span>

              <span class="col-span-12 sm:col-span-7 md:col-span-7">
                <span class="font-display text-base font-medium tracking-tight text-ink">{p.title}</span>
                <span class="mt-1.5 block text-sm leading-relaxed text-ink-muted">{p.summary}</span>
                <span class="mt-3 inline-flex items-center gap-2 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-muted">
                  <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p.note}
                </span>
              </span>

              <span class="col-span-12 flex justify-end sm:col-span-12 md:col-span-1 md:justify-end">
                <Icon
                  name="ph:arrow-right"
                  size={18}
                  class="text-ink-faint transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── THROUGH-LINE ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label">Why these are here</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[16ch]">
            Side projects are where the finish shows.
          </Heading>
        </div>
        <div class="lg:col-span-7">
          <div class="space-y-4 text-ink-muted leading-relaxed">
            <p class="text-[1.15rem] leading-snug text-ink">
              When nobody is asking for it,
              <span class="text-accent">nobody is around to talk you out of sweating the last ten percent.</span>
            </p>
            <p>
              The empty states, the play/stop interaction, the tenancy boundary that has to hold for
              real households. That last ten percent is the work most people skip, and it is exactly
              the part I bring to the products I ship for teams. Want the professional case studies
              instead? They live on the <a href="/projects/" class="hero-link">projects page</a>.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">Open to roles</p>
          <Heading level={2} visual="display-lg" tone="paper" class="mt-4 max-w-[20ch]">
            The same instinct, on the clock.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            What I do for fun is what I do for teams: own the whole thing, wire the live services,
            and ship it finished. If that's the engineer you need, send a note.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">Get in touch</Button>
            <a
              href="/resume/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Résumé <Icon name="ph:file-text" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
