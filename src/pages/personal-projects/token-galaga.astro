---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import LiveEmbed from '~/components/patterns/LiveEmbed.astro';

const title = 'Token Adventure | Joshua Briley';
const description =
  'Case study: Token Adventure, a playable coding arcade that teaches the W3C Design Tokens Format (2025.10). Real CodeMirror editor, sandboxed iframe, and a serializable assertion engine that grades your code across 20 sectors. Companion to Rudiment UI.';

const proof = [
  {
    label: 'Skills proven',
    items: [
      'Interactive learning & curriculum design',
      'In-browser code execution & sandboxing',
      'Test-harness engineering',
      'Deep W3C design-token expertise',
      'Accessibility engineering',
      'Motion design',
    ],
  },
  {
    label: 'Stack',
    items: ['Astro 5', 'React island', 'CodeMirror', 'Sandboxed iframe', 'axe-core', 'Netlify'],
  },
  {
    label: 'Quality',
    items: [
      'Faithful to the stable 2025.10 spec',
      'Spec-semantic grading, not pattern-matching',
      'Reduced-motion honored on every effect',
      'astro check + a clean build, every ship',
    ],
  },
  {
    label: 'Outcomes',
    items: ['20 sectors across three arcs', 'A serializable assertion engine', 'Companion to Rudiment UI'],
  },
];

const docket = [
  { href: '#why', icon: 'ph:game-controller', label: 'Why teach a spec as an arcade' },
  { href: '#what', icon: 'ph:browsers', label: 'What it actually is' },
  { href: '#engine', icon: 'ph:test-tube', label: 'The assertion engine' },
  { href: '#curriculum', icon: 'ph:path', label: 'Twenty sectors, three arcs' },
  { href: '#a11y', icon: 'ph:heart', label: 'Accessibility, taught and practiced' },
  { href: '#craft', icon: 'ph:sparkle', label: 'Game feel without a game engine' },
];

// The arc colors describe the product's own difficulty coding (cyan / yellow /
// magenta in the game). Darkened here so they clear WCAG AA on the paper surface.
const arcs = [
  {
    label: 'Arc I',
    rank: 'Beginner',
    blurb: 'The foundations: why tokens exist, the file, naming, color, groups, consuming.',
    color: '#0E7490',
    sectors: [
      { num: '01', title: 'The Hardcoded Hellscape', teaches: 'Why tokens exist: a named decision gets one home' },
      { num: '02', title: 'The Registry Awakens', teaches: 'tokens.json, $value and $type' },
      { num: '03', title: "The Cartographer's Codex", teaches: 'Naming and path rules' },
      { num: '04', title: 'Color the 2025 Way', teaches: 'Object-form color: colorSpace, components, alpha, hex' },
      { num: '05', title: 'Forge a Group', teaches: 'Groups and $type inheritance' },
      { num: '06', title: 'Self-Documenting Tokens', teaches: '$description' },
      { num: '07', title: 'Reading the Registry', teaches: 'Consuming semantic tokens' },
    ],
  },
  {
    label: 'Arc II',
    rank: 'Intermediate',
    blurb: 'Relationships and composites: aliases, layering, types, and the composite shapes.',
    color: '#B45309',
    sectors: [
      { num: '08', title: 'Echoes and Aliases', teaches: 'Alias references' },
      { num: '09', title: 'Three-Tier Architecture', teaches: 'Global, semantic, and component layers' },
      { num: '10', title: 'Types of the Realm', teaches: 'Token types and their canonical value shapes' },
      { num: '11', title: 'Composite Constructs', teaches: 'The typography composite' },
      { num: '12', title: 'Border Composite', teaches: 'The border composite' },
      { num: '13', title: 'Shadow Composite', teaches: 'Shadow, including multi-shadow arrays' },
      { num: '14', title: 'Gradient and Transition', teaches: 'The gradient and transition composites' },
    ],
  },
  {
    label: 'Arc III',
    rank: 'Expert',
    blurb: 'Production, theming, and audit: the pipeline, integrity, color spaces, migration, the boss.',
    color: '#A21CAF',
    sectors: [
      { num: '15', title: 'The Translation Pipeline', teaches: 'tokens.json to CSS custom properties' },
      { num: '16', title: 'Alias Integrity', teaches: 'Detecting dangling and circular references' },
      { num: '17', title: 'Color Spaces', teaches: 'Color spaces and wide-gamut output' },
      { num: '18', title: 'Theming and Modes', teaches: 'Modes as a tooling convention, flagged as not in the spec' },
      { num: '19', title: 'The Great Reformation', teaches: 'Migrating a legacy file to 2025.10' },
      { num: '20', title: 'Audit the Library', teaches: 'The final audit boss' },
    ],
  },
];

const loop = [
  { icon: 'ph:chat-circle-text', title: 'An NPC frames the problem', text: 'A story panel states the real failure the concept prevents: a brand color hardcoded in five places, a dangling alias that locks a team out of a build.' },
  { icon: 'ph:code', title: 'You write real code', text: 'A CodeMirror editor with the right language modes (JSON for tokens.json, plus CSS, HTML, and JS where the sector calls for it). Only the tabs a sector needs are shown.' },
  { icon: 'ph:browsers', title: 'It runs in a sandbox', text: 'The host builds an srcdoc document from your editor and loads it with sandbox="allow-scripts" and no same-origin access, so player code is genuinely isolated.' },
  { icon: 'ph:test-tube', title: 'A test runner grades it', text: 'Assertions are posted into the iframe over postMessage, evaluated against the live DOM and your parsed token tree, then posted back. Pass them all and the wave clears.' },
  { icon: 'ph:medal', title: 'You are rewarded', text: 'XP, a badge, and a pilot-log entry that distills the lesson into a reusable snippet. Clear a full arc and a celebration interstitial fires.' },
];

const architecture = [
  { icon: 'ph:lightning', text: 'Astro 5 renders the static surfaces (star chart, story panels, one route per sector). No client JS ships for these.' },
  { icon: 'ph:cube', text: 'One React island carries the sector runner: editor, sandbox, and test list. It loads only on quest pages.' },
  { icon: 'ph:shield-check', text: 'The sandbox is an iframe srcdoc with sandbox="allow-scripts". Player code cannot reach the host page.' },
  { icon: 'ph:arrows-left-right', text: 'The test runtime speaks to the host over postMessage, with a request-id handshake and a timeout so a broken script cannot hang the grader.' },
  { icon: 'ph:eye', text: 'axe-core is pulled into the sandbox to run real accessibility audits against the player’s rendered output.' },
  { icon: 'ph:database', text: 'Progress lives in localStorage. No backend, no account, no server.' },
];

const domChecks = [
  { name: 'selectorExists · tagName · notTagName', text: 'Structure and semantics' },
  { name: 'computedStyle', text: 'Resolved CSS values: exact, regex, or one-of a set' },
  { name: 'contrast', text: 'WCAG contrast ratios (AA normal, AA large, AAA)' },
  { name: 'axe', text: 'Runs axe-core, optionally scoped to specific rule ids' },
  { name: 'keyboardReachable', text: 'Tab-order reachability' },
  { name: 'hasAttribute · textMatches', text: 'ARIA and content' },
];

const tokenChecks = [
  { name: 'tokenJsonValid', text: 'Confirms it parses at all' },
  { name: 'tokenHasPath · tokenFieldEquals', text: 'Structure and field values' },
  { name: 'tokenTypeMatches', text: 'Honors $type inheritance from ancestor groups' },
  { name: 'tokenAliasResolves', text: 'Follows {alias} reference chains to a final value' },
  { name: 'cssVarFromToken', text: 'Reads a CSS custom property to confirm a token wired through' },
];

const a11yBuilt = [
  { icon: 'ph:person-simple-run', text: 'Every motion effect gated behind prefers-reduced-motion' },
  { icon: 'ph:app-window', text: 'Celebration modal: role="dialog", aria-modal, focus management' },
  { icon: 'ph:keyboard', text: 'Escape and backdrop dismissal, background scroll lock' },
  { icon: 'ph:cursor', text: 'Parallax disables itself on coarse and touch pointers' },
  { icon: 'ph:eye', text: 'Sectors grade output with the same contrast math the app holds itself to' },
  { icon: 'ph:check-square', text: 'Sectors run axe and keyboardReachable against the player’s UI' },
];

const feel = [
  { icon: 'ph:television-simple', title: 'A CRT boot sequence', text: 'A one-shot scanline sweep across the cabinet plus a marquee-title power-on flicker, built in CSS and the Web Animations API.' },
  { icon: 'ph:sun', title: 'Dual-layer neon glow', text: 'A tight tube core plus a soft bloom, over a corner-vignetted field, so lit elements read like real neon rather than a flat drop shadow.' },
  { icon: 'ph:rocket-launch', title: 'A world map you fly', text: 'A scout ship follows the mission route via CSS offset-path while a nebula drifts opposite the cursor through a transform-only, rAF-throttled handler.' },
];
---

<BaseLayout title={title} description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="mb-12 flex items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
        <a href="/personal-projects/" class="transition-colors hover:text-accent">Personal projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">Token Adventure</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-main">
          <div class="mb-7 flex items-center gap-3">
            <span class="hero-wordmark font-display text-ink">token<span class="text-accent">★</span>adventure</span>
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <p class="mono-label">Case study</p>
          </div>

          <Heading level={1} visual="display-xl" tone="ink" class="leading-[1.04]">
            I turned the design-token spec into a <em class="ink-wink font-normal italic">playable</em> coding arcade.
          </Heading>

          <p class="mt-8 max-w-xl">
            <Text as="span" size="lg" tone="muted">
              You don&rsquo;t read about aliases. You write one in a real editor, run it in a
              sandbox, and watch the wave clear. Twenty sectors of the
              <a href="https://www.designtokens.org/tr/drafts/format/" target="_blank" rel="noopener" class="hero-link">W3C Design Tokens Format</a>,
              graded against the stable 2025.10 spec.
            </Text>
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-3">
            <a href="https://token-galaga.netlify.app/" target="_blank" rel="noopener" class="hero-cta hero-cta--primary">
              <Icon name="ph:play-fill" size={18} />
              Play the game
              <Icon name="ph:arrow-up-right" size={13} class="hero-cta-arrow" />
            </a>
            <a href="/personal-projects/rudiment-ui/" class="hero-cta">
              <Icon name="ph:book-open" size={18} />
              See Rudiment UI
              <Icon name="ph:arrow-right" size={13} class="hero-cta-arrow" />
            </a>
          </div>
        </div>

        <aside class="hero-rail" aria-label="Project details">
          <dl>
            <div>
              <dt>Role</dt>
              <dd>Product Engineer</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd>Arcade &middot; 20 sectors</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>Astro &middot; React &middot; CodeMirror</dd>
            </div>
            <div>
              <dt>Teaches</dt>
              <dd>W3C tokens (2025.10)</dd>
            </div>
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="default" aria-label="The game, live">
    <Container width="wide">
      <p class="mono-label">Live site / The arcade</p>
      <Heading level={2} visual="h2" class="mt-4 max-w-[24ch]">
        Insert coin. The arcade is the skin; the engine underneath is real.
      </Heading>
      <Text tone="muted" class="mt-4 max-w-2xl">
        Pick a sector from the star chart, write your tokens, run them in the sandbox, and clear the
        wave when every assertion passes. Load the live game below and press start right here.
      </Text>
      <div class="mt-9">
        <LiveEmbed
          posterSrc="/images/projects/token-galaga.webp"
          posterAlt="Token Adventure: a retro arcade cabinet UI with a pilot dossier, a high score, and a 'Press Start' to begin the design-tokens curriculum"
          embedSrc="https://token-galaga.netlify.app/"
          href="https://token-galaga.netlify.app/"
          title="Token Adventure"
          ratio="1600 / 1005"
          ctaNote="the live, playable game"
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" aria-label="What changed since the prototype">
    <Container width="content">
      <p class="mono-label mb-5">What changed since the prototype</p>
      <Text size="lg" tone="muted" class="measure">
        An earlier version of this write-up called Token Adventure a Galaga-style canvas arcade with
        eight sectors. That described an early prototype, and it undersold the part that matters most:
        there is no shoot-em-up rendered to a canvas. The arcade is presentation. The engine underneath
        is a real in-browser coding environment that grades your actual code against the spec.
      </Text>
      <div class="mt-9 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3">
        <div class="bg-paper p-5">
          <p class="mono-label mb-2">Sectors</p>
          <p class="text-ink"><span class="text-ink-faint line-through">8</span> &rarr; <span class="font-semibold">20</span>, three arcs</p>
        </div>
        <div class="bg-paper p-5">
          <p class="mono-label mb-2">The gameplay</p>
          <p class="text-ink"><span class="text-ink-faint line-through">Canvas render</span> &rarr; real editor, sandbox, grader</p>
        </div>
        <div class="bg-paper p-5">
          <p class="mono-label mb-2">The spec</p>
          <p class="text-ink"><span class="text-ink-faint line-through">2024 draft</span> &rarr; stable 2025.10</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" aria-label="Project receipts">
    <Container width="content">
      <p class="mono-label mb-8">Receipts</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight">
    <Container width="content">
      <p class="mono-label mb-5">On the docket</p>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {docket.map((item, i) => (
          <li>
            <a href={item.href} class="group inline-flex items-center gap-3 text-ink transition-colors hover:text-accent">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              {item.icon && (
                <Icon name={item.icon} size={16} class="shrink-0 text-ink-muted transition-colors group-hover:text-accent" />
              )}
              <span class="font-medium">{item.label}</span>
              <Icon name="ph:arrow-right" size={15} class="shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <Text size="lg" tone="muted" class="mt-10 measure">
        Token Adventure is a personal project, and the whole point is the framing. The W3C Design
        Tokens Format is genuinely useful and a genuinely dry read. So instead of writing another
        explainer, I built the thing I&rsquo;d actually want to play: a coding arcade where every wave
        you clear is one more piece of the spec you can prove you understand, because your code had to
        satisfy it. Nobody asked for it, which meant nobody was around to talk me out of finishing it.
      </Text>
    </Container>
  </Section>

  <Section id="why" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 01</p>
          <Heading level={2} visual="display-md" tone="ink">Why teach a spec as an arcade</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Design tokens are table stakes for any serious design system, but the W3C format is hard
              to internalize from the source material. The spec is precise by necessity:
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">$value</code>,
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">$type</code>,
              group inheritance, aliases, composite types. Precision makes for an excellent reference and
              a poor teacher. You finish reading and you have a vocabulary, not judgment.
            </p>
            <p>
              A game changes the unit of learning from &ldquo;I read about aliases&rdquo; to
              <strong class="text-ink font-semibold">&ldquo;I used an alias to clear the wave.&rdquo;</strong>
              Every rule becomes a sector you cannot pass until your code actually applies it. Uncleared
              sectors create stakes, a fixed sequence creates a path, and pass-or-fail diagnostics create
              feedback. You leave with the muscle memory of having written spec-correct tokens.
            </p>
          </div>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            <div class="border-t border-line pt-5">
              <p class="mono-label mb-4">Read the reference</p>
              <Heading level={3} visual="h3" tone="ink" class="mb-2">You learn the vocabulary</Heading>
              <Text size="sm" tone="muted">
                Spec pages that are accurate, complete, and hard to retain. You skim them once and
                bookmark them.
              </Text>
            </div>
            <div class="border-t border-line pt-5">
              <p class="mono-label mb-4">Play the reference</p>
              <Heading level={3} visual="h3" tone="ink" class="mb-2">You build the judgment</Heading>
              <Text size="sm" tone="muted">
                Each rule is a clearable sector that requires you to apply it. You don&rsquo;t move on
                until your code has actually used the concept.
              </Text>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="what" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 02</p>
          <Heading level={2} visual="display-md" tone="ink">What it actually is</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Token Adventure looks like a deep-space arcade cabinet. You select sectors from a star
              chart, clear waves, log intel to a pilot log, and rank up from Recruit to Ace. Under that
              presentation, every sector is a small coding exercise running on real infrastructure.
              Nothing is faked: the preview is your code running, and a pass means your tokens actually
              satisfy the spec, not that you picked the right multiple-choice answer.
            </p>
          </div>

          <ol class="mt-10 space-y-4">
            {loop.map((s, i) => (
              <li class="flex gap-4 border-t border-line pt-4">
                <span class="font-mono text-[0.75rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex items-start gap-3">
                  <Icon name={s.icon} size={22} class="mt-0.5 shrink-0 text-ink-muted" />
                  <div>
                    <p class="font-medium text-ink">{s.title}</p>
                    <p class="mt-1 text-sm text-ink-muted leading-relaxed">{s.text}</p>
                  </div>
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-12 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-5">Architecture at a glance</p>
            <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
              {architecture.map((a) => (
                <li class="flex items-start gap-3 text-sm text-ink-muted leading-relaxed">
                  <Icon name={a.icon} size={18} class="mt-0.5 shrink-0 text-ink-muted" />
                  <span>{a.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="engine" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 03</p>
          <Heading level={2} visual="display-md" tone="ink">The assertion engine</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              This is the heart of the project. Grading a coding exercise means inspecting code that runs
              in an isolated context you deliberately cannot touch from the outside. The solution is a
              fully <strong class="text-ink font-semibold">serializable assertion DSL</strong>: every
              check is a plain data object, so it crosses the
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">postMessage</code>
              boundary into the sandbox, runs there against the live DOM and parsed token tree, and
              returns a plain result.
            </p>
          </div>

          <div class="mt-10 grid gap-7 md:grid-cols-2">
            <div class="rounded-lg border border-line p-6">
              <p class="mono-label mb-1">Family one</p>
              <Heading level={3} visual="h4" tone="ink" class="mb-4">DOM &amp; accessibility checks</Heading>
              <ul class="space-y-3">
                {domChecks.map((c) => (
                  <li class="border-t border-line pt-3 first:border-t-0 first:pt-0">
                    <code class="font-mono text-[0.78rem] text-ink">{c.name}</code>
                    <p class="mt-0.5 text-sm text-ink-muted">{c.text}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-lg border border-line p-6">
              <p class="mono-label mb-1">Family two</p>
              <Heading level={3} visual="h4" tone="ink" class="mb-4">Design-token checks</Heading>
              <ul class="space-y-3">
                {tokenChecks.map((c) => (
                  <li class="border-t border-line pt-3 first:border-t-0 first:pt-0">
                    <code class="font-mono text-[0.78rem] text-ink">{c.name}</code>
                    <p class="mt-0.5 text-sm text-ink-muted">{c.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-10 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              That second family is what makes the game spec-accurate rather than spec-flavored.
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">tokenAliasResolves</code>
              doesn&rsquo;t look for the string
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">{'{color.brand.primary}'}</code>
              in your file. It walks the reference chain the way a real translation tool would and
              asserts on the resolved value. The grader understands the spec&rsquo;s semantics, so the
              lessons cannot be gamed by pattern-matching.
            </p>
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl tracking-tight text-ink leading-snug md:text-3xl">
              The final sector is the boss: a broken tokens.json carrying four realistic 2025.10
              violations. Find and fix all four. It is the closest the game gets to the actual job.
            </blockquote>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="curriculum" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 04</p>
          <Heading level={2} visual="display-md" tone="ink">Twenty sectors, three arcs</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The sequence mirrors how the spec has to be learned: foundations first, then the relational
              and composite machinery, then the real-world build, theming, migration, and audit work. You
              can&rsquo;t reason about aliases until you can name a single token, and you can&rsquo;t audit
              a broken library until you understand the types it&rsquo;s supposed to honor.
            </p>
          </div>

          <div class="mt-10 space-y-10">
            {arcs.map((arc) => (
              <div>
                <div class="mb-4 flex items-center gap-3">
                  <span class="h-2.5 w-2.5 rounded-[2px]" style={`background:${arc.color}`} aria-hidden="true"></span>
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.16em]" style={`color:${arc.color}`}>{arc.label}</span>
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-ink-faint">{arc.rank}</span>
                </div>
                <p class="mb-4 max-w-2xl text-sm text-ink-muted leading-relaxed">{arc.blurb}</p>
                <ul class="rounded-lg border border-line">
                  {arc.sectors.map((s) => (
                    <li class="flex items-center gap-4 border-b border-line px-5 py-3 last:border-b-0">
                      <span class="font-mono text-[0.75rem] text-accent">{s.num}</span>
                      <span class="flex-1">
                        <span class="block text-sm font-medium text-ink">{s.title}</span>
                        <span class="block text-sm text-ink-muted">{s.teaches}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl tracking-tight text-ink leading-snug md:text-3xl">
              A spec read front to back gives you a reference. Clearing it sector by sector gives you the
              judgment to use it.
            </blockquote>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="a11y" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 05</p>
          <Heading level={2} visual="display-md" tone="ink">Accessibility, taught and practiced</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              Most learn-to-code games stop at the happy path. Token Adventure treats accessibility as a
              first-class concern in both directions. <strong class="text-ink font-semibold">It is built
              into the product:</strong> every motion effect collapses to a static state under
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">prefers-reduced-motion</code>,
              and the celebration interstitial is a real dialog with focus management, Escape and backdrop
              dismissal, and a scroll lock.
            </p>
            <p>
              <strong class="text-ink font-semibold">And it is taught by the product.</strong> Several
              sectors grade the player&rsquo;s rendered output with
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">axe</code>,
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">contrast</code>, and
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">keyboardReachable</code>
              assertions, holding the player to the same WCAG AA ratios and axe-core rules the app holds
              itself to. You learn to ship tokens that produce accessible interfaces.
            </p>
          </div>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-5">Built-in, not bolted-on</p>
            <ul class="grid gap-x-8 gap-y-3 text-ink-muted sm:grid-cols-2">
              {a11yBuilt.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed">
                  <Icon name={item.icon} size={18} class="mt-0.5 shrink-0 text-ink-muted" />
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="craft" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 06</p>
          <Heading level={2} visual="display-md" tone="ink">Game feel without a game engine</Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-8 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The arcade is built entirely from CSS and the Web Animations API, with no game loop and no
              canvas. The constraint was deliberate: keep the bundle small and the Core Web Vitals clean
              while still earning the word arcade. Difficulty is color-coded throughout, cyan for beginner,
              yellow for intermediate, magenta for expert, and the color encodes the arc rather than
              decorating it.
            </p>
          </div>

          <div class="mt-10 grid gap-6 md:grid-cols-3">
            {feel.map((f) => (
              <div class="border-t border-line pt-5">
                <Icon name={f.icon} size={28} class="mb-3 text-ink-muted" />
                <Heading level={3} visual="h4" tone="ink" class="mb-1">{f.title}</Heading>
                <Text size="sm" tone="muted">{f.text}</Text>
              </div>
            ))}
          </div>

          <div class="mt-12 measure space-y-5 leading-relaxed text-ink-muted text-lg">
            <p>
              The app also eats its own cooking. A game about design tokens is itself built on a real
              three-tier token system with light, dark, and high-contrast modes, so it practices the
              architecture sector 9 teaches. A tool that taught token discipline while ignoring it would
              not be credible.
            </p>
            <p>
              Because the refresh was motion-heavy, I built a precision feedback loop instead of eyeballing
              changes: a headless-Chrome screenshot harness captures every key screen at desktop and mobile
              for before-and-after diffing, and a
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">?nomotion</code>
              escape hatch freezes the reveal animations so full-page captures show the settled layout. I
              also held the source to zero em-dashes and en-dashes anywhere, verified by grep, and shipped
              only after <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">astro check</code>
              and a clean build pass.
            </p>
          </div>

          <div class="mt-12 grid gap-6 md:grid-cols-3">
            <div class="border-t border-line pt-5">
              <Icon name="ph:game-controller" size={28} class="mb-3 text-ink-muted" />
              <Heading level={3} visual="h4" tone="ink" class="mb-1">A complete product</Heading>
              <Text size="sm" tone="muted">
                Twenty sectors, three arcs, a full reward loop, and a finale. Finished end to end, not a
                demo.
              </Text>
            </div>
            <div class="border-t border-line pt-5">
              <Icon name="ph:test-tube" size={28} class="mb-3 text-ink-muted" />
              <Heading level={3} visual="h4" tone="ink" class="mb-1">A real test engine</Heading>
              <Text size="sm" tone="muted">
                A serializable assertion DSL that grades player code across a sandbox boundary, with both
                a11y and deep token-semantic checks.
              </Text>
            </div>
            <div class="border-t border-line pt-5">
              <Icon name="ph:link" size={28} class="mb-3 text-ink-muted" />
              <Heading level={3} visual="h4" tone="ink" class="mb-1">Part of a set</Heading>
              <Text size="sm" tone="muted">
                Token Adventure teaches the spec; <a href="/personal-projects/rudiment-ui/" class="hero-link">Rudiment UI</a>
                teaches building the library those tokens drive.
              </Text>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="ink" padding="loose">
    <Container width="wide">
      <p class="mono-label !text-paper/65 mb-6">Product engineering</p>
      <Heading level={2} visual="display-lg" tone="paper">
        I make hard things worth finishing.
      </Heading>
      <Text size="lg" tone="whiteMuted" class="mt-5 max-w-2xl">
        Token Adventure takes the formal text of a W3C spec, the material almost nobody wants to read, and
        turns it into something people play to the end. The same instinct carries into product work on a
        team: take the dry but necessary work, give it an interface worth using, hold it to a real
        accessibility bar, and ship it polished. Let&rsquo;s talk.
      </Text>
      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <Button variant="navy" size="lg" iconLeft="ph:envelope" href="/contact/">Get in touch</Button>
        <a href="/resume/" class="inline-flex items-center gap-2 font-sans text-sm font-medium text-paper/70 transition-colors hover:text-paper">
          <Icon name="ph:file-text" size={18} />
          Résumé
        </a>
      </div>
      <div class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-paper/15 pt-8">
        <Link variant="arrow" href="/personal-projects/rudiment-ui/" class="!text-paper hover:!text-paper/70">Companion: Rudiment UI</Link>
        <Link variant="arrow" href="/personal-projects/" class="!text-paper hover:!text-paper/70">Back to personal projects</Link>
      </div>
    </Container>
  </Section>

</BaseLayout>
