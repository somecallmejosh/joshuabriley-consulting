---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import LiveEmbed from '~/components/patterns/LiveEmbed.astro';
import SiteShot from '~/components/patterns/SiteShot.astro';

const description =
  'Case study: building Rudiment UI, an open-source React component library and 13-chapter guide that explains the why behind every architectural decision.';

const menu = [
  { href: '#problem', icon: 'ph:warning-circle', label: 'Why most libraries quietly fall apart' },
  { href: '#tokens', icon: 'ph:stack', label: 'A three-tier token system' },
  { href: '#accessibility', icon: 'ph:heart', label: 'Accessibility as a contract' },
  { href: '#chapters', icon: 'ph:book-open', label: 'The thirteen chapters' },
  { href: '#explore', icon: 'ph:cube', label: 'See it served: guide & Storybook' },
];

/**
 * The live Storybook stories, in order. `id` drives both URLs: the embed loads the
 * bare story (iframe.html), while "open" goes to the full Storybook so the sidebar
 * and docs come with it.
 */
const liveStories = [
  {
    id: 'examples-project-management-board--board',
    title: 'Project board',
    blurb:
      'A Kanban board of draggable issue cards across four sprint columns, with WIP-limit warnings. Drag works by keyboard, not just pointer.',
    poster: '/images/projects/rudiment-ui/rudiment-board.webp',
    posterAlt:
      'Rudiment UI project board story: a Kanban board with To Do, In Progress, In Review, and Done columns of issue cards showing priority and story points',
  },
  {
    id: 'examples-project-management-dashboard--dashboard',
    title: 'Sprint dashboard',
    blurb:
      'The analytics surface: stat tiles, a burndown line chart, a work-by-status donut, and team workload meters.',
    poster: '/images/projects/rudiment-ui/rudiment-dashboard.webp',
    posterAlt:
      'Rudiment UI sprint dashboard story: committed, completed, remaining, and velocity stat tiles above a sprint burndown chart, a work-by-status donut, and team workload meters',
  },
  {
    id: 'examples-ecommerce-landing-page--landing-page',
    title: 'Ecommerce landing page',
    blurb:
      'A marketing storefront: sticky navigation, a full-bleed hero, and a shop-by-room product grid.',
    poster: '/images/projects/rudiment-ui/rudiment-ecommerce-landing.webp',
    posterAlt:
      'Rudiment UI ecommerce landing page story: a furniture storefront with a navigation bar, full-bleed hero, and a shop-by-room product grid',
  },
];

const tokenTiers = [
  {
    icon: 'ph:paint-bucket',
    title: 'Global tokens · raw palette',
    desc: 'Unopinionated primitives. No meaning, just values.',
    code: 'color.blue.500 = #3B82F6',
  },
  {
    icon: 'ph:tag',
    title: 'Semantic tokens · assigned meaning',
    desc: 'Aliases that encode intent. A rebrand touches this layer, not every component.',
    code: 'color.brand.primary → color.blue.500',
  },
  {
    icon: 'ph:puzzle-piece',
    title: 'Component tokens · scoped values',
    desc: 'Narrow enough to tune one component without side effects elsewhere.',
    code: 'button.background.default → color.brand.primary',
  },
];

const a11yList = [
  { icon: 'ph:keyboard', text: 'Full keyboard operability via React Aria' },
  { icon: 'ph:target', text: 'Focus traps & restoration in overlays' },
  { icon: 'ph:megaphone', text: 'ARIA semantics on every component' },
  { icon: 'ph:magnifying-glass', text: 'vitest-axe guards every test run' },
  { icon: 'ph:squares-four', text: 'Eight intrinsic layout primitives' },
  { icon: 'ph:eye', text: 'Contrast verified against token values' },
];

const chapters = [
  { num: '01', title: 'Architectural decisions (no code)' },
  { num: '02', title: 'Token system design' },
  { num: '03', title: 'Styling strategy' },
  { num: '04', title: 'Accessibility primitives' },
  { num: '05', title: 'Layout primitives' },
  { num: '06', title: 'Component patterns' },
  { num: '07', title: 'Design tokens in DTCG format' },
  { num: '08', title: 'Style Dictionary configuration' },
  { num: '09', title: 'React Aria integration' },
  { num: '11', title: 'Testing accessibility contracts' },
  { num: '12', title: 'Build & packaging workflow' },
];

const guideChecks = [
  'Architecture, tokens, primitives, components, tests, publishing',
  'Companion GitHub repo with a complete working implementation',
];

const storybookChecks = [
  'Live components built on React Aria & Tailwind CSS 4',
  'Token-driven theming visible across every story',
  'a11y & interaction addons wired in out of the box',
];

const proof = [
  { label: 'Skills proven', items: ['CRUD Development', 'Accessible component APIs', 'Frontend architecture', 'UI/UX Design', 'Style Guide Documentation', 'Theming'] },
  { label: 'Stack', items: ['React', 'React Aria', 'Storybook', 'Design tokens', 'Tailwind CSS 4'] },
  { label: 'Quality', items: ['Keyboard operability', 'Focus management', 'ARIA semantics', 'Token contrast checks'] },
  { label: 'Outcomes', items: ['Personal project', 'Open source contribution', 'Community engagement'] },
];
---

<BaseLayout title="Rudiment UI | Joshua Briley" description={description}>

  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <nav class="mb-12 flex items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
        <a href="/personal-projects/" class="transition-colors hover:text-accent">Personal projects</a>
        <Icon name="ph:caret-right" size={12} />
        <span class="text-ink">Rudiment UI</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-main">
          <div class="mb-7 flex items-center gap-3">
            <span class="hero-wordmark font-display text-ink">rudiment<span class="text-accent">.ui</span></span>
            <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
            <p class="mono-label">Case study</p>
          </div>

          <Heading level={1} visual="display-xl" tone="ink" class="leading-[1.04]">
            A component library,<br />built to be <em class="ink-wink font-normal italic">understood</em>.
          </Heading>

          <p class="mt-8 max-w-xl">
            <Text as="span" size="lg" tone="muted">
              An open-source React component library paired with a
              <a href="https://rudiment-guide.netlify.app/" target="_blank" rel="noopener" class="hero-link">13-chapter guide</a>
              that explains <em>why</em> each architectural decision is made, and what happens later if you make a different one.
            </Text>
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-3">
            <a href="https://rudiment-guide.netlify.app/" target="_blank" rel="noopener" class="hero-cta hero-cta--primary">
              <Icon name="ph:book-open" size={18} />
              Read the guide
              <Icon name="ph:arrow-up-right" size={13} class="hero-cta-arrow" />
            </a>
            <a href="https://rudiment-ui.netlify.app/" target="_blank" rel="noopener" class="hero-cta">
              <Icon name="ph:squares-four" size={18} />
              Browse the Storybook
              <Icon name="ph:arrow-up-right" size={13} class="hero-cta-arrow" />
            </a>
          </div>
        </div>

        <aside class="hero-rail" aria-label="Project details">
          <dl>
            <div>
              <dt>Role</dt>
              <dd>Author &middot; Engineer</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd>Library + Guide</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>React 19, TS, Vite</dd>
            </div>
            <div>
              <dt>Focus</dt>
              <dd>Tokens &middot; A11y</dd>
            </div>
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  {/* Live stories — the library composing whole product surfaces, live & interactive. */}
  <Section tone="paper" padding="default" aria-label="Live Storybook examples">
    <Container width="wide">
      <p class="mono-label">Live stories / Storybook</p>
      <Heading level={2} visual="h2" class="mt-4 max-w-[24ch]">
        The whole library, composed into real product surfaces.
      </Heading>
      <Text tone="muted" class="mt-4 max-w-2xl">
        Three complete surfaces (a sprint board, an analytics dashboard, and a storefront)
        assembled entirely from Rudiment primitives. These are the real Storybook stories:
        load one and click around.
      </Text>

      <div class="mt-12 space-y-16">
        {liveStories.map((story, i) => (
          <div>
            <div class="mb-6 flex items-baseline gap-3 border-t border-line pt-4">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              <div>
                <p class="font-medium text-ink">{story.title}</p>
                <Text tone="muted" size="sm" class="mt-1 max-w-xl">{story.blurb}</Text>
              </div>
            </div>
            <LiveEmbed
              posterSrc={story.poster}
              posterAlt={story.posterAlt}
              href={`https://rudiment-ui.netlify.app/?path=/story/${story.id}`}
              title={story.title}
              embedSrc={`https://rudiment-ui.netlify.app/iframe.html?id=${story.id}&viewMode=story`}
            />
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* The field guide — the companion that explains every decision, chapter by chapter. */}
  <Section tone="paper" padding="default" aria-label="Field guide">
    <Container width="wide">
      <p class="mono-label">Live site / Field Guide</p>
      <Heading level={2} visual="h2" class="mt-4 max-w-[24ch]">
        And a field guide that explains every decision behind it.
      </Heading>
      <Text tone="muted" class="mt-4 max-w-2xl">
        Thirteen chapters, from an empty directory to a published, token-driven, accessible
        library, each choice shown next to the alternatives it ruled out.
      </Text>
      <div class="mt-9">
        <SiteShot
          src="/images/projects/rudiment-ui/rudiment-guide.webp"
          alt="The Rudiment field guide: a 13-chapter walkthrough to building a component library"
          href="https://rudiment-guide.netlify.app/"
          label="rudiment-guide.netlify.app"
          index="01"
        />
      </div>
    </Container>
  </Section>

  <Section tone="paper" padding="tight" aria-label="Project receipts">
    <Container width="content">
      <p class="mono-label mb-8">Receipts</p>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((group) => (
          <div class="border-t border-line pt-4">
            <dt class="mono-label mb-3">{group.label}</dt>
            <dd>
              <ul class="space-y-1.5">
                {group.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-ink-muted leading-relaxed">
                    <Icon name="ph:check" size={14} class="mt-0.5 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section tone="paper" padding="tight">
    <Container width="content">
      <p class="mono-label mb-5">On the docket</p>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {menu.map((item, i) => (
          <li>
            <a href={item.href} class="group inline-flex items-center gap-3 text-ink transition-colors hover:text-accent">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              {item.icon && (
                <Icon name={item.icon} size={16} class="shrink-0 text-ink-muted transition-colors group-hover:text-accent" />
              )}
              <span class="font-medium">{item.label}</span>
              <Icon name="ph:arrow-right" size={15} class="shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <Text size="lg" tone="muted" class="mt-10 measure">
        Rudiment UI is a personal reference project, not a client
        deliverable, and that's the point. It exists because most of the
        component libraries I've been brought in to fix share the same root
        cause: architectural decisions that nobody wrote down, made in the
        wrong order, and now cost a quarter to untangle. Rudiment UI is the
        library I wish every team had started with, built deliberately,
        chapter by chapter, with the reasoning left in.
      </Text>
    </Container>
  </Section>

  <Section id="problem" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 01</p>
          <Heading level={2} visual="display-md" tone="ink">
            Why most libraries quietly fall apart
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Component libraries rarely fail loudly. They accumulate a thousand
              small compromises until the thing that once felt like a system
              feels like a
              <strong class="text-ink font-semibold">patchwork</strong>. A missing semantic
              token layer turns a rebrand into hundreds of manual renames. An
              undecided styling strategy turns a refactor into a full rewrite.
              Accessibility bolted on after launch always costs more than
              accessibility designed in from day one.
            </p>
            <p>
              Most of these mistakes aren't expensive because they were hard to
              avoid. They're expensive because they were
              <strong class="text-ink font-semibold">made implicitly</strong>: in a stand-up,
              in a PR comment, in a hurried corner of someone's sprint. Rudiment
              UI starts from the opposite assumption: the structural decisions
              come first, with no code, and every choice gets written down
              alongside its consequences.
            </p>
            <p>
              That's what the guide is. Chapter 1 contains no code at all. It's
              the conversation a team should have had
              <em>before</em> picking a CSS strategy.
            </p>
          </div>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            <div class="border-t border-line pt-5">
              <p class="mono-label mb-3">The usual story</p>
              <Heading level={3} visual="h3" tone="ink">Drift, then debt</Heading>
              <p class="mt-2 text-ink-muted leading-relaxed">
                Tokens get added per-component. Styles leak into overrides.
                Documentation falls behind. The system stops being a system.
              </p>
            </div>
            <div class="border-t border-line pt-5">
              <p class="mono-label mb-3">Rudiment's bet</p>
              <Heading level={3} visual="h3" tone="ink">Sequence on purpose</Heading>
              <p class="mt-2 text-ink-muted leading-relaxed">
                Token architecture shapes components. Components shape tests.
                Tests shape what the docs have to explain. Get the order right
                and the rest stops fighting you.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="tokens" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 02</p>
          <Heading level={2} visual="display-md" tone="ink">
            A three-tier token system
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Most token systems collapse because they try to do two jobs in one
              layer: hold raw values <em>and</em> express design intent.
              Rudiment separates those jobs across three tiers, each referencing
              the one beneath it. A brand change touches one file. A component
              tweak doesn't cascade into the rest of the library.
            </p>
          </div>

          <div class="mt-10 border-t border-line">
            {tokenTiers.map((tier) => (
              <div class="border-b border-line py-5">
                <div class="flex items-start gap-4">
                  <Icon name={tier.icon} size={26} class="mt-1 flex-shrink-0 text-ink-muted" />
                  <div>
                    <Heading level={3} visual="h4" tone="ink">{tier.title}</Heading>
                    <p class="mb-3 mt-1 text-ink-muted leading-relaxed">{tier.desc}</p>
                    <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">{tier.code}</code>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
              Building a component library is as much an exercise in sequencing
              decisions as it is in writing components.
            </blockquote>
          </figure>

          <p class="measure text-ink-muted leading-relaxed text-lg">
            Token files use the Design Tokens Community Group format, flow
            through Style Dictionary v4, and land in Tailwind CSS 4 via
            <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">@theme inline</code>. Updating a single value propagates through every dependent
            component: no hunt-and-replace, no orphans.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="accessibility" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 03</p>
          <Heading level={2} visual="display-md" tone="ink">
            Accessibility as a contract, not a checklist
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              A single interactive component can carry an enormous accessibility
              surface. A modal alone needs focus trapping, scroll locking,
              escape-key handling, focus restoration, and
              <code class="font-mono text-[0.82rem] bg-ink/[0.04] text-ink px-1.5 py-0.5 rounded-[4px]">aria-modal</code>
              management. Rudiment doesn't rebuild that for every component. It
              leans on React Aria, maintained by Adobe's design system team, to
              carry the behavior layer.
            </p>
            <p>
              React Aria owns keyboard navigation, focus management, ARIA
              semantics, pointer normalization, and i18n. Tailwind CSS 4 handles
              the visuals. The two layers stay cleanly separated, which is what
              lets the library re-skin without touching any behavior.
            </p>
            <p>
              Tests then lock in that separation. Layout primitives are verified
              against the tokens and classes they emit. UI components are
              verified against their
              <em>accessibility contract</em>: keyboard activation, disabled and
              error states, focus behavior, loading-state ARIA, and zero
              axe-core violations. Tests query by role and text, never by class
              name, so refactors don't silently break coverage.
            </p>
          </div>

          <div class="mt-10 rounded-lg border border-line p-6 md:p-8">
            <p class="mono-label mb-5">Built-in, not bolted-on</p>
            <ul class="grid gap-x-8 gap-y-3 text-ink-muted sm:grid-cols-2">
              {a11yList.map((item) => (
                <li class="flex items-center gap-3">
                  <Icon name={item.icon} size={20} class="flex-shrink-0 text-ink-muted" />
                  {item.text}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="chapters" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 04</p>
          <Heading level={2} visual="display-md" tone="ink">
            Thirteen chapters, in order
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              The guide is sequenced deliberately. You can't make sensible
              component decisions until the token layer is settled. You can't
              write useful tests until the component API is stable. You can't
              publish confidently until the build workflow guarantees every tier
              stays in sync. Each chapter earns the next one.
            </p>
          </div>

          <ul class="mt-10 rounded-lg border border-line">
            {chapters.slice(0, 9).map((c) => (
              <li class="flex items-center gap-4 border-b border-line px-5 py-3.5">
                <span class="font-mono text-[0.75rem] text-accent">{c.num}</span>
                <span class="text-sm text-ink">{c.title}</span>
              </li>
            ))}
            <li class="border-b border-line">
              <a
                href="https://rudiment-ui.netlify.app/"
                target="_blank"
                rel="noopener"
                class="group flex items-center gap-4 px-5 py-3.5 text-ink transition-colors hover:text-accent"
              >
                <span class="font-mono text-[0.75rem] text-accent">10</span>
                <span class="flex-1 text-sm">Storybook documentation</span>
                <Icon name="ph:arrow-up-right" size={14} class="text-accent opacity-0 transition-opacity group-hover:opacity-100" />
              </a>
            </li>
            {chapters.slice(9).map((c) => (
              <li class="flex items-center gap-4 border-b border-line px-5 py-3.5">
                <span class="font-mono text-[0.75rem] text-accent">{c.num}</span>
                <span class="text-sm text-ink">{c.title}</span>
              </li>
            ))}
            <li class="flex items-center gap-4 px-5 py-3.5">
              <span class="font-mono text-[0.75rem] text-accent">13</span>
              <span class="text-sm text-ink">Publishing to npm</span>
            </li>
          </ul>

          <Heading level={3} visual="h3" tone="ink" class="mt-16 mb-6">
            What reading the guide leaves you with
          </Heading>
          <div class="grid gap-6 md:grid-cols-3">
            <div class="border-t border-line pt-5">
              <Icon name="ph:compass" size={28} class="mb-3 text-ink-muted" />
              <Heading level={4} visual="h4" tone="ink">Judgment, not a template</Heading>
              <p class="mt-1 text-sm text-ink-muted leading-relaxed">
                Every decision is explained alongside the alternatives it closes
                off, so you can extend the system instead of copying it.
              </p>
            </div>
            <div class="border-t border-line pt-5">
              <Icon name="ph:stack" size={28} class="mb-3 text-ink-muted" />
              <Heading level={4} visual="h4" tone="ink">A working reference</Heading>
              <p class="mt-1 text-sm text-ink-muted leading-relaxed">
                An end-to-end library you can run, read, and pull pieces from:
                tokens, primitives, tests, publishing pipeline.
              </p>
            </div>
            <div class="border-t border-line pt-5">
              <Icon name="ph:shield-check" size={28} class="mb-3 text-ink-muted" />
              <Heading level={4} visual="h4" tone="ink">Debt you don't pay later</Heading>
              <p class="mt-1 text-sm text-ink-muted leading-relaxed">
                The expensive mistakes (shallow tokens, retrofitted a11y,
                drifting docs) get made visible before they compound.
              </p>
            </div>
          </div>

          <figure class="my-12 border-l-2 border-accent pl-6">
            <blockquote class="font-display text-2xl md:text-3xl tracking-tight text-ink leading-snug">
              A repository without explanation gives you a working system.
              Explaining the trade-offs at each step gives you the judgment to
              extend it.
            </blockquote>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="explore" tone="paper" padding="default" class="scroll-mt-24">
    <Container width="content">
      <div class="case-layout">
        <div class="case-layout__head">
          <p class="mono-label mb-3">Step 05</p>
          <Heading level={2} visual="display-md" tone="ink">
            See it served: both halves, live
          </Heading>
        </div>
        <div class="case-layout__body">
          <div class="mt-6 measure space-y-5 text-ink-muted leading-relaxed text-lg">
            <p>
              Rudiment ships as two deployed sites, and you can open both right
              now. The guide walks through the
              architectural decisions and trade-offs, chapter by chapter. The
              Storybook is the working
              library those decisions produced: every primitive, every
              component, every variant, in your browser.
            </p>
          </div>

          <div class="mt-10 grid gap-7 md:grid-cols-2">
            <a
              href="https://rudiment-guide.netlify.app/"
              target="_blank"
              rel="noopener"
