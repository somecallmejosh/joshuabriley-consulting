---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  'Product design engineering by Joshua Briley: a fertility logistics platform, a multi-tenant Rails admin app rebuilt in place, a voice-controlled operations product for home-based child care, and an open-source accessible React component library. Each case study shows the reasoning behind the interface, not just the outcome.';

// Each teaser reads the same way: what it is, what I owned, and the number the
// case study actually substantiates. Kinds name the product type, not the craft.
const projects = [
    {
    index: '0',
    href: '/projects/rudiment-ui/',
    client: 'Rudiment UI',
    kind: 'Component library',
    title: 'Accessible component primitives, built in public',
    summary:
      'An open-source React component library and companion guide covering architectural decisions, a three-tier token system, intrinsic layout primitives, accessible components with React Aria, Storybook docs, testing, and npm distribution.',
    note: '3-tier token system',
  },
  {
    index: '01',
    href: '/projects/ivfcryo/',
    client: 'IVFCRYO',
    kind: 'Logistics platform',
    title: 'Shipping something irreplaceable, self-service',
    summary:
      'A self-service platform for cryogenic fertility shipments, replacing a paper process where a single mistake is unrecoverable. I led the design and owned the front end, then partnered with engineering on the Rails domain model and the carrier, telemetry, and alerting services underneath it.',
    note: '75% fewer support calls',
  },
  {
    index: '02',
    href: '/projects/vmspark/',
    client: 'VMSpark',
    kind: 'Admin platform',
    title: 'A multi-tenant Rails admin app, rebuilt in place',
    summary:
      'An audit of 350 ERB templates turned into a four-phase rebuild of the operator-facing app, shipped with no feature flags onto a live pipeline. I owned the inventory, the design direction, and the engineering.',
    note: 'Zero pipeline regressions',
  },
  {
    index: '03',
    href: '/projects/logatot/',
    client: 'Logatot',
    kind: 'Voice platform',
    title: 'An interface that works when nobody can look at it',
    summary:
      'A voice-controlled operations platform for home-based child care, where the user is holding a toddler and answers to three regulatory regimes. I led the front end on a three-developer team and built much of the Rails domain.',
    note: '~1,100 of 1,939 commits',
  },

];

// Personal work — surfaced as its own band so it reads as a distinct body of
// work, not a footnote to the client case studies. Names mirror the index page.
const personalProjects = [
  { href: '/personal-projects/token-galaga/', name: 'Token Adventure' },
];

/**
 * A trailing row that can't fill its tracks leaves visible holes beside the
 * stragglers, so each one stretches to absorb the leftover columns. Two tracks
 * at `sm`, three at `lg`, and the explicit `lg:col-span-1` is what stops an
 * `sm` span from carrying up into the wider grid.
 */
const spanFor = (i: number, total: number) => {
  const classes: string[] = [];
  if (total % 2 === 1 && i === total - 1) classes.push('sm:col-span-2');

  const trailing = total % 3;
  if (trailing !== 0 && i >= total - trailing) {
    classes.push(trailing === 1 ? 'lg:col-span-3' : i === total - 2 ? 'lg:col-span-2' : 'lg:col-span-1');
  } else {
    classes.push('lg:col-span-1');
  }
  return classes.join(' ');
};
---

<BaseLayout title="Projects | Joshua Briley" description={description}>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <p class="hero-in hero-in-1 mono-label">Selected work · Case studies</p>

      <div class="mt-10 max-w-4xl lg:mt-14">
        <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[20ch] text-balance">
          Products where I owned the <em class="ink-wink font-normal italic">interface</em>.
        </Heading>
        <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-2xl">
          Three products in production, built for teams with real constraints: messy timelines,
          mixed stacks, and people depending on the result. Plus the open-source component library
          I build in public. Each case study shows the reasoning, not just the outcome.
        </Text>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── PROJECT LIST ─────────────────────────
      Three case studies, three columns, no lead: unlike the blog index there is
      no recency to rank on, and promoting one of three client projects would
      imply an order the copy doesn't claim. Cell language matches the essay
      grid (hairline top rule, mono meta row, heading, summary, footer), so the
      two indexes read as the same system without being the same layout. */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <ul
        class="grid grid-cols-1 gap-x-10 gap-y-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-14"
        data-reveal-stagger
      >
        {projects.map((p, i) => (
          <li class={spanFor(i, projects.length)}>
            <a
              href={p.href}
              class="group flex h-full flex-col border-t border-line pb-9 pt-6 transition-colors hover:bg-ink/[0.02]"
            >
              <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{p.kind}</span>
              </span>

              {/* The client name stays the hero of the cell, as it was in the row
                  layout. It takes the serif display step (same move as the tools
                  bento) rather than the grotesk h3: at h3 it sat only 4px above
                  the title line beneath it and the two read as competing peers. */}
              <Heading level={2} visual="h2" class="mt-4 transition-colors group-hover:text-accent">
                {p.client}
              </Heading>

              {/* The measure caps only matter in a cell that spans two or three
                  tracks; inside a single 3-up column they never bind. */}
              <span class="mt-2.5 block max-w-xl font-display text-base font-medium leading-snug tracking-tight text-ink">
                {p.title}
              </span>

              <Text tone="muted" size="sm" class="mt-3 max-w-2xl">{p.summary}</Text>

              {/* mt-auto pins the outcome line to a shared baseline, so three
                  summaries of different lengths still end on one rule. */}
              <span class="mt-auto flex items-center gap-2 pt-6 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-muted">
                <span class="h-1 w-1 shrink-0 rounded-[1px] bg-accent" aria-hidden="true"></span>
                {p.note}
                <Icon
                  name="ph:arrow-right"
                  size={13}
                  class="shrink-0 transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── PERSONAL PROJECTS (warm band) ───────────────────────── */}
  <Section tone="surface-warm" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <Heading level={2} visual="display-md" class="max-w-[14ch]">
            Personal projects
          </Heading>
          <Text size="lg" tone="muted" class="mt-5 max-w-xl">
            What I build when no one is asking, like a playable teaching tool for the W3C
            design-tokens spec. Same finish as the client work.
          </Text>
        </div>
        <Button
          variant="ghost"
          href="/personal-projects/"
          iconRight="ph:arrow-right"
          class="shrink-0 self-start sm:self-auto"
        >All personal projects</Button>
      </div>

      <ul class="mt-10 flex flex-wrap gap-2.5" data-reveal-stagger>
        {personalProjects.map((p) => (
          <li>
            <a
              href={p.href}
              class="group inline-flex items-center gap-2 rounded-[5px] border border-line-strong bg-paper/60 px-4 py-2.5 font-display text-[0.95rem] font-medium tracking-tight text-ink transition-[background-color,border-color,transform] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-px hover:border-ink/40 hover:bg-paper"
            >
              {p.name}
              <Icon
                name="ph:arrow-up-right"
                size={14}
                class="text-ink-faint transition-colors duration-300 group-hover:text-accent"
              />
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── THROUGH-LINE ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label">The through-line</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[16ch]">
            The stack changes. The core work doesn't.
          </Heading>
        </div>
        <div class="lg:col-span-7">
          <div class="space-y-4 text-ink-muted leading-relaxed">
            <p class="text-[1.15rem] leading-snug text-ink">
              Every project comes back to the same instinct:
              <span class="text-accent">the interface is the product, so make it feel finished.</span>
            </p>
            <p>
              The stack changes (React, TypeScript, whatever the product runs on) but the core work
              stays the same: build the UI design-grade and accessible, and sweat the details most
              teams skip. If that sounds like the engineer you need, let's talk.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">Open to roles</p>
          <Heading level={2} visual="display-lg" tone="paper" class="mt-4 max-w-[20ch] text-balance">
            Every case study doubles as a work sample.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            If you're evaluating me for a product design engineering role, this is the level of craft
            and finish to expect at the interface. Questions about any of it, send a note.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">Get in touch</Button>
            <a
              href="/resume/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Résumé <Icon name="ph:file-text" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
