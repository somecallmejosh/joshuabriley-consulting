---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  'Recent work by Joshua Briley: design systems, component libraries, and accessible web applications built for teams with real constraints.';

const projects = [
  {
    index: '01',
    href: '/projects/rudiment-ui/',
    client: 'Rudiment UI',
    kind: 'Component library',
    title: 'Building a component library from scratch',
    summary:
      'An open-source React component library and companion guide covering architectural decisions, a three-tier token system, intrinsic layout primitives, accessible components with React Aria, Storybook docs, testing, and npm distribution.',
    note: '3-tier token system',
  },
  {
    index: '02',
    href: '/projects/americas-test-kitchen/',
    client: "America's Test Kitchen",
    kind: 'Multi-brand system',
    title: 'One library, multiple brands',
    summary:
      'Improving an inaccessible CMS and building a shared component library for one of the most recognized cooking brands in the US — three brands served without fragmenting or going rigid.',
    note: '60+ components',
  },
  {
    index: '03',
    href: '/projects/berxi-insurance/',
    client: 'Berxi',
    kind: 'Design system',
    title: 'A design system for a growing platform',
    summary:
      'Building a custom design system for a growing insurance platform — from stakeholder alignment through component library, documentation, and cross-team adoption.',
    note: 'Cross-team adoption',
  },
  {
    index: '04',
    href: '/projects/ivfcryo/',
    client: 'IVFCRYO',
    kind: 'Accessibility first',
    title: 'Accessibility built in from the start',
    summary:
      'A self-service shipping application for a fertility specimen logistics provider, with real-time environmental tracking, multi-carrier label printing, and accessibility built in from day one.',
    note: '75% fewer support calls',
  },
  {
    index: '05',
    href: '/projects/vmspark/',
    client: 'VMSpark',
    kind: 'Shell redesign',
    title: 'A Rails shell rebuilt for 2026',
    summary:
      'Redesigning the admin shell for a multi-tenant VMS-to-ATS pipeline — a 700-line inventory, three directions with one chosen for pattern familiarity, and a phased rollout that shipped without touching the product underneath.',
    note: '350 ERB templates',
  },
];
---

<BaseLayout title="Projects — Joshua Briley" description={description}>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="flex items-center justify-between gap-4 mono-label">
        <span>Selected work · Case studies</span>
        <span class="hidden sm:inline text-ink-muted">Index 01</span>
      </div>

      <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-8">
          <Heading level={1} visual="display-xl" class="max-w-[18ch]">
            Component libraries, design systems, and <em class="ink-wink font-normal italic">accessible web apps</em>.
          </Heading>
        </div>
        <div class="lg:col-span-4">
          <Text size="lg" tone="muted" class="max-w-md">
            Built for teams with real constraints — messy timelines, mixed stacks, and real humans
            using them on the other side. Each case study doubles as a work sample.
          </Text>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── PROJECT LIST ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <p class="mono-label">Case studies / 02</p>

      <ul class="mt-8 border-t border-line">
        {projects.map((p) => (
          <li>
            <a
              href={p.href}
              class="group grid grid-cols-12 items-start gap-x-4 gap-y-3 border-b border-line py-8 transition-colors hover:bg-ink/[0.02] md:gap-y-0 md:py-10"
            >
              <span class="col-span-2 flex items-baseline gap-3 sm:col-span-1">
                <span class="font-mono text-[0.8rem] text-accent">{p.index}</span>
              </span>

              <span class="col-span-10 sm:col-span-4 md:col-span-3">
                <span class="font-display text-xl font-medium tracking-tight text-ink md:text-2xl">{p.client}</span>
                <span class="mt-1 block font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-muted">{p.kind}</span>
              </span>

              <span class="col-span-12 sm:col-span-7 md:col-span-7">
                <span class="font-display text-base font-medium tracking-tight text-ink">{p.title}</span>
                <span class="mt-1.5 block text-sm leading-relaxed text-ink-muted">{p.summary}</span>
                <span class="mt-3 inline-flex items-center gap-2 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-muted">
                  <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{p.note}
                </span>
              </span>

              <span class="col-span-12 flex justify-end sm:col-span-12 md:col-span-1 md:justify-end">
                <Icon
                  name="ph:arrow-right"
                  size={18}
                  class="text-ink-faint transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── THROUGH-LINE ───────────────────────── */}
  <Section tone="paper" padding="default" class="border-t border-line">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="mono-label">The through-line / 03</p>
          <Heading level={2} visual="display-md" class="mt-4 max-w-[16ch]">
            The stack changes. The core work doesn't.
          </Heading>
        </div>
        <div class="lg:col-span-7">
          <div class="space-y-4 text-ink-muted leading-relaxed">
            <p class="text-[1.15rem] leading-snug text-ink">
              Every project starts with the same question:
              <span class="text-accent">how do we make this consistent without slowing everyone down?</span>
            </p>
            <p>
              The industry and the stack change, but the core work stays the same: replace scattered
              UI decisions with a shared system the whole team can trust. If that sounds like where
              you're stuck, let's talk.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">Start a project / 04</p>
          <Heading level={2} visual="display-lg" tone="paper" class="mt-4 max-w-[20ch]">
            Every case study doubles as a work sample.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            If you're evaluating me for a role or a project, this is the level of documentation to
            expect from my work. Questions about any of it — send a note. I reply within one
            business day.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">Get in touch</Button>
            <a
              href="https://www.linkedin.com/in/joshuabriley/"
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Connect on LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
