---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Badge from '~/components/primitives/Badge.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Card from '~/components/card/Card.astro';
import Blob from '~/components/decorative/Blob.astro';
import WavyUnderline from '~/components/decorative/WavyUnderline.astro';

const description =
  'Practical takes, honest opinions, and the occasional fictional UX engineer. Essays on design systems, accessibility, and front-end architecture.';

const all = await getCollection('posts', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
// Every essay renders as the same card; the latest just leads and wears a tag.
const posts = [featured, ...sorted.filter((p) => p !== featured)];

// Per-card accent (corner blob + icon chip + category) keyed off the post's
// sticker tone. All `text` values are AA on white.
const accentMap: Record<string, { text: string; bg: string; ring: string }> = {
  coral: { text: 'text-[#C13A22]', bg: 'bg-coral/10', ring: 'ring-coral/20' },
  plum: { text: 'text-plum', bg: 'bg-plum/10', ring: 'ring-plum/20' },
  sky: { text: 'text-sky-deep', bg: 'bg-sky/15', ring: 'ring-sky/30' },
  sunset: { text: 'text-sunset-deep', bg: 'bg-sunset/10', ring: 'ring-sunset/25' },
  sage: { text: 'text-sage-deep', bg: 'bg-sage/15', ring: 'ring-sage/30' },
  lemon: { text: 'text-navy', bg: 'bg-lemon/30', ring: 'ring-lemon/50' },
};

const topics = [
  { icon: 'ph:stack-duotone', label: 'Design systems' },
  { icon: 'ph:wheelchair-duotone', label: 'Accessibility' },
  { icon: 'ph:tree-structure-duotone', label: 'Front-end architecture' },
];
---

<BaseLayout title="Blog — Joshua Briley | UX Engineering, in Practice" description={description}>
  {/* ── Hero: identity (left) + field-notes illustration (right) ──────────── */}
  <Section padding="loose" decorated>
    <Blob tone="lemon" size="md" class="absolute top-16 left-[4%]" animate="float" opacity="opacity-40" />

    <Container class="relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <div class="lg:col-span-6">
          <Badge tone="coral" icon="ph:notebook-duotone">Field Notes</Badge>
          <Heading level={1} visual="display-xl" class="mt-6 mb-5">
            UX engineering, <WavyUnderline>in practice</WavyUnderline>
          </Heading>
          <Text size="xl" tone="muted" class="max-w-xl">
            Practical takes, honest opinions, and the occasional fictional UX engineer —
            written from 20 years of shipping systems teams actually use.
          </Text>

          <div class="mt-8 flex flex-wrap gap-2.5">
            {topics.map((t) => (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white border border-charcoal/10 px-3.5 py-1.5 text-xs font-heading font-medium text-navy/80 shadow-sm">
                <Icon name={t.icon} size={15} class="text-plum" />
                {t.label}
              </span>
            ))}
          </div>
        </div>

        {/* Field-notes scene — desktop only, decorative */}
        <div class="lg:col-span-6 relative h-[460px] hidden lg:block" aria-hidden="true">
          <Blob tone="coral" size="md" animate="float" opacity="opacity-20" class="absolute top-6 right-[14%]" />
          <Blob tone="sky" size="sm" animate="float-slow" opacity="opacity-30" class="absolute bottom-12 left-[8%] rounded-full" />

          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-72 h-72 rounded-full border-2 border-dashed border-plum/20 animate-spin-slow"></div>
          </div>

          {/* Notebook page centrepiece */}
          <div class="notebook-page absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-64 -rotate-[4deg] animate-float-slow bg-white rounded-2xl shadow-xl border border-charcoal/5 p-6 pl-11 overflow-hidden">
            <div class="relative z-10">
              <p class="font-display italic text-navy text-xl mb-2">Field notes</p>
              <div class="h-1.5 w-20 rounded-full bg-coral/50 mb-4"></div>
              <div class="space-y-2.5">
                <div class="h-2 rounded-full bg-charcoal/10"></div>
                <div class="h-2 rounded-full bg-charcoal/10 w-5/6"></div>
                <div class="h-2 rounded-full bg-coral/30 w-2/3"></div>
                <div class="h-2 rounded-full bg-charcoal/10 w-11/12"></div>
                <div class="h-2 rounded-full bg-charcoal/10 w-1/2"></div>
              </div>
              <div class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-plum/10 px-3 py-1.5">
                <Icon name="ph:pencil-line-duotone" size={14} class="text-plum" />
                <span class="font-heading text-[11px] font-semibold text-plum">Drafting…</span>
              </div>
            </div>
          </div>

          {/* Floating "new idea" sticky */}
          <div class="absolute top-[5%] right-[2%] bg-white rounded-2xl shadow-lg border border-charcoal/5 px-4 py-3 w-40 animate-float rotate-3">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-7 h-7 rounded-lg bg-lemon/50 flex items-center justify-center">
                <Icon name="ph:lightbulb-filament-duotone" size={16} class="text-[#A24818]" />
              </span>
              <span class="font-heading text-xs font-semibold text-navy">New idea</span>
            </div>
            <div class="space-y-1.5">
              <div class="h-1.5 rounded-full bg-charcoal/10"></div>
              <div class="h-1.5 rounded-full bg-lemon/60 w-3/5"></div>
            </div>
          </div>

          {/* Floating "published" pill */}
          <div class="absolute bottom-[8%] right-[10%] bg-white rounded-full shadow-lg border border-charcoal/5 px-3 py-1.5 flex items-center gap-1.5 animate-float-delay -rotate-3">
            <Icon name="ph:seal-check-duotone" size={14} class="text-sage-deep" />
            <span class="font-heading text-[11px] font-semibold text-navy">Published</span>
          </div>

          <Icon name="ph:star-four-duotone" size={22} class="text-coral absolute top-[22%] left-[6%] animate-wiggle" />
          <Icon name="ph:star-four-duotone" size={14} class="text-plum absolute bottom-[28%] left-[20%] animate-float" />
        </div>
      </div>
    </Container>
  </Section>

  {/* ── Essays: one card vocabulary, per-card accent for life ────────────── */}
  <Section padding="default">
    <Container>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-reveal-stagger>
        {posts.map((post, i) => {
          const a = accentMap[post.data.sticker] ?? accentMap.coral;
          return (
            <Card as="article" variant="paper" padding="none" class={`relative overflow-hidden ${a.ring}`}>
              <div class={`absolute -top-12 -right-12 w-32 h-32 ${a.bg} rounded-full pointer-events-none`} aria-hidden="true"></div>
              <a href={`/blog/${post.id}/`} class="relative flex flex-col h-full group p-6 md:p-7">
                <div class={`w-12 h-12 ${a.bg} rounded-2xl flex items-center justify-center mb-5`}>
                  <Icon name={post.data.icon} size={26} class={a.text} />
                </div>

                <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-heading text-xs uppercase tracking-wider mb-3">
                  {i === 0 && (
                    <>
                      <span class="inline-flex items-center gap-1 text-[#C13A22] font-semibold">
                        <Icon name="ph:star-four-duotone" size={12} />
                        Latest
                      </span>
                      <span class="text-charcoal/30" aria-hidden="true">·</span>
                    </>
                  )}
                  <span class={`${a.text} font-semibold`}>{post.data.category}</span>
                </p>

                <Heading level={3} visual="h3" class="mb-3 group-hover:text-coral transition-colors">
                  {post.data.title}
                </Heading>

                <Text size="sm" tone="muted" class="mb-6 line-clamp-3">
                  {post.data.description}
                </Text>

                <span class="mt-auto inline-flex items-center gap-2 text-sm text-charcoal/70 font-heading">
                  <span class="inline-flex items-center gap-1.5 text-[#C13A22] font-semibold">
                    Read essay
                    <Icon name="ph:arrow-right-bold" size={14} class="transition-transform duration-300 ease-out group-hover:translate-x-1" />
                  </span>
                  <span class="text-charcoal/25" aria-hidden="true">·</span>
                  <span class="inline-flex items-center gap-1">
                    <Icon name="ph:clock-duotone" size={15} />
                    {post.data.readMinutes} min
                  </span>
                </span>
              </a>
            </Card>
          );
        })}
      </div>
    </Container>
  </Section>

  {/* ── Newsletter ───────────────────────────────────────────────────────── */}
  <Section padding="default">
    <Container width="narrow">
      <div class="relative bg-navy text-white rounded-3xl p-10 md:p-16 overflow-hidden">
        <Blob tone="coral" size="xl" class="absolute -top-10 -right-10" animate="float-slow" opacity="opacity-30" />
        <Blob tone="plum" size="lg" shape="alt" class="absolute -bottom-12 -left-8" animate="float" opacity="opacity-50" />

        <div class="relative z-10 text-center">
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-lemon px-4 py-2 rounded-full mb-6 font-heading text-sm font-medium">
            <Icon name="ph:envelope-simple-duotone" size={18} />
            Field Notes, delivered
          </div>
          <Heading level={2} visual="display-md" tone="white" align="center" class="mb-5">
            Get new essays in your inbox
          </Heading>
          <Text size="lg" tone="whiteMuted" align="center" class="max-w-xl mx-auto mb-8">
            One honest essay at a time. No spam, no funnels — just the stuff I'd send a friend
            running into the same design system problems you are.
          </Text>
          <form class="flex flex-col sm:flex-row items-stretch gap-3 max-w-md mx-auto" onsubmit="event.preventDefault()">
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input
              id="newsletter-email"
              type="email"
              required
              placeholder="you@workmail.com"
              class="flex-1 px-5 py-3 rounded-full bg-white/10 border border-white/20 text-white placeholder-white/50 font-body focus:outline-none focus:border-coral focus:bg-white/15 transition-colors"
            />
            <Button variant="primary" size="sm" iconRight="ph:paper-plane-tilt-duotone" type="submit">
              Subscribe
            </Button>
          </form>
          <p class="text-xs text-white/50 mt-4 font-body">Unsubscribe any time. I'll respect the inbox.</p>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* Ruled-paper texture for the hero notebook illustration. */
  .notebook-page::before {
    content: '';
    position: absolute;
    left: 28px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(232, 87, 61, 0.3);
  }
  .notebook-page::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 27px,
      rgba(93, 173, 226, 0.16) 28px
    );
    pointer-events: none;
  }
</style>
