---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Icon from '~/components/primitives/Icon.astro';

const description =
  'Practical notes on front-end, design systems, and accessibility, from 20 years of building real products.';

const all = await getCollection('posts', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
// Every essay renders as the same row; the latest just leads and wears a tag.
const posts = [featured, ...sorted.filter((p) => p !== featured)];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog | Joshua Briley" description={description}>
  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="hero-in hero-in-1 flex items-center justify-between gap-4 mono-label">
        <span>Writing</span>
        <span class="hidden sm:inline text-ink-muted">{posts.length} essays</span>
      </div>

      <div class="mt-10 max-w-3xl lg:mt-14">
        <Heading level={1} visual="display-xl" class="hero-in hero-in-2 max-w-[18ch]">
          Writing on <em class="ink-wink font-normal italic">front-end</em> and design systems.
        </Heading>
        <Text size="lg" tone="muted" class="hero-in hero-in-3 mt-7 max-w-xl">
          Practical notes from 20 years of building accessible, design-grade products. No theory for its own sake.
        </Text>
        <ul class="hero-in hero-in-4 mt-9 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-muted">
          {['Design systems', 'Accessibility', 'Front-end architecture'].map((t) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-[1px] bg-accent" aria-hidden="true"></span>{t}
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── ESSAY LIST ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <p class="mono-label">All essays</p>

      <ul class="mt-8 border-t border-line">
        {posts.map((post, i) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              class="group grid grid-cols-12 items-baseline gap-4 border-b border-line py-7 transition-colors hover:bg-ink/[0.02]"
            >
              <div class="col-span-12 flex flex-wrap items-center gap-x-3 gap-y-1 sm:col-span-3 lg:col-span-3">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{post.data.category}</span>
                <time datetime={post.data.date.toISOString().slice(0, 10)} class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink-muted">
                  {fmtDate(post.data.date)}
                </time>
                {i === 0 && (
                  <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink-muted">· Latest</span>
                )}
              </div>

              <div class="col-span-10 sm:col-span-8 lg:col-span-8">
                <Heading level={2} visual="h3" class="transition-colors group-hover:text-accent">
                  {post.data.title}
                </Heading>
                <Text tone="muted" class="mt-2 max-w-2xl">
                  {post.data.description}
                </Text>
                <span class="mt-3 inline-flex items-center gap-1.5 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-muted">
                  <Icon name="ph:clock" size={13} />{post.data.readMinutes} min read
                </span>
              </div>

              <div class="col-span-2 flex justify-end sm:col-span-1 lg:col-span-1">
                <Icon name="ph:arrow-right" size={18} class="text-ink-faint transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:text-accent" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  {/* ───────────────────────── NEWSLETTER (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="mono-label !text-paper/65">Newsletter</p>
          <Heading level={2} visual="display-md" tone="paper" class="mt-4 max-w-[18ch] text-balance">
            Get new essays in your inbox.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            One honest essay at a time. No spam, no funnels: just the stuff I'd send a friend
            running into the same design system problems you are.
          </Text>
        </div>
        <div class="lg:col-span-5">
          <form class="flex flex-col gap-3 sm:flex-row sm:items-stretch" onsubmit="event.preventDefault()">
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input
              id="newsletter-email"
              type="email"
              required
              placeholder="you@workmail.com"
              class="flex-1 rounded-md border border-paper/20 bg-paper/10 px-4 py-3 font-sans text-paper placeholder-paper/45 transition-colors focus:border-accent focus:bg-paper/15 focus:outline-none"
            />
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 rounded-md bg-paper px-5 py-3 font-sans text-[0.9rem] font-medium tracking-tight text-ink transition-colors hover:bg-paper/90"
            >Subscribe <Icon name="ph:arrow-right" size={15} /></button>
          </form>
          <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-paper/55">
            Unsubscribe any time.
          </p>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
