---
import { getCollection, render } from 'astro:content';
import BlogPost from '~/layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Chronological neighbours for the footer pager. Newest-first ordering, so the
// older post (previous) sits one index later and the newer post (next) one earlier.
const orderedPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = orderedPosts.findIndex((p) => p.id === post.id);
const toLink = (p) => (p ? { id: p.id, title: p.data.title } : null);
const prevPost = toLink(orderedPosts[currentIndex + 1]);
const nextPost = toLink(orderedPosts[currentIndex - 1]);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  category={post.data.category}
  categoryIcon={post.data.icon}
  date={post.data.date}
  readMinutes={post.data.readMinutes}
  pathname={`/blog/${post.id}/`}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
  wide={post.data.interactive}
>
  <Content />
</BlogPost>
