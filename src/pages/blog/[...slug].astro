---
import { getCollection, render } from 'astro:content';
import BlogPost from '~/layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Sibling posts for the "keep reading" footer — most recent, excluding this one.
const morePosts = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    category: p.data.category,
    readMinutes: p.data.readMinutes,
  }));
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  category={post.data.category}
  categoryIcon={post.data.icon}
  date={post.data.date}
  readMinutes={post.data.readMinutes}
  pathname={`/blog/${post.id}/`}
  headings={headings}
  morePosts={morePosts}
  wide={post.data.interactive}
>
  <Content />
</BlogPost>
