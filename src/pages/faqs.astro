---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';
import FAQ from '~/components/patterns/FAQ.astro';
import FAQItem from '~/components/patterns/FAQItem.astro';

const description =
  "Answers to the questions clients and colleagues ask most about audits, component library builds, process, timelines, deliverables, and logistics.";

const allFaqs = await getCollection('faqs');
const sorted = allFaqs.sort((a, b) => a.data.order - b.data.order);

const categories = [
  { id: 'services-fit', n: '01', label: 'Services & Fit', heading: 'Is this the right kind of help?' },
  { id: 'process-timeline', n: '02', label: 'Process & Timeline', heading: 'What the engagement looks like.' },
  { id: 'deliverables', n: '03', label: 'Deliverables', heading: 'What you get at the end.' },
  { id: 'logistics', n: '04', label: 'Logistics', heading: 'The practical stuff.' },
] as const;

// Pre-render answer bodies (markdown) for each FAQ.
const rendered = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
const byCategory = (cat: string) => rendered.filter((r) => r.entry.data.category === cat);
---

<BaseLayout title="FAQs — Joshua Briley | UX Engineer & Design Systems Consultant" description={description}>

  {/* ───────────────────────── HERO ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <p class="mono-label">Questions / 01</p>
      <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:gap-16 lg:items-end">
        <div class="lg:col-span-7">
          <Heading level={1} visual="display-xl" class="max-w-[16ch]">
            Answers to the questions I get <em class="ink-wink font-normal italic">asked most</em>.
          </Heading>
        </div>
        <div class="lg:col-span-5">
          <Text size="lg" tone="muted" class="max-w-xl">
            These come from clients and colleagues over the years. Most concern consulting
            engagements; if you are here from the hiring side, everything below still describes how
            I work. If yours is not here,
            <Link href="/contact/" variant="inline">just ask</Link>.
          </Text>
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── BODY ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        {/* Sticky jump list */}
        <aside class="lg:col-span-4 xl:col-span-3">
          <div class="lg:sticky lg:top-28">
            <p class="mono-label">Jump to</p>
            <nav class="mt-5 flex flex-col" aria-label="FAQ sections">
              {categories.map((c) => (
                <a href={`#${c.id}`} class="jump-link group flex items-baseline gap-3 border-b border-line py-3 transition-colors hover:text-accent">
                  <span class="font-mono text-[0.7rem] text-accent">{c.n}</span>
                  <span class="font-display text-[0.95rem] font-medium tracking-tight text-ink transition-colors group-hover:text-accent">{c.label}</span>
                </a>
              ))}
            </nav>
          </div>
        </aside>

        {/* FAQ sections */}
        <div class="lg:col-span-8 xl:col-span-9 space-y-16">
          {categories.map((c) => (
            <section id={c.id} class="scroll-mt-28">
              <p class="mono-label">{c.n} / {c.label}</p>
              <Heading level={2} visual="display-md" class="mt-4 mb-7">{c.heading}</Heading>
              <FAQ>
                {byCategory(c.id).map(({ entry, Content }) => (
                  <FAQItem question={entry.data.question}>
                    <Content />
                  </FAQItem>
                ))}
              </FAQ>
            </section>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── CONTACT (ink) ───────────────────────── */}
  <Section tone="ink" padding="loose">
    <Container width="wide">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="mono-label !text-paper/65">Still wondering / 02</p>
          <Heading level={2} visual="display-lg" tone="paper" class="mt-4 max-w-[20ch]">
            Didn’t find your question? Ask it directly.
          </Heading>
          <Text size="lg" tone="whiteMuted" class="mt-6 max-w-xl">
            The fastest way to find out whether something is a fit — a role, a project, or just an
            idea — is a real conversation. No pressure, no sales pitch.
          </Text>
        </div>
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <div class="flex flex-col items-start gap-3">
            <Button variant="navy" size="lg" href="/contact/" iconRight="ph:arrow-right" class="js-magnetic">Get in touch</Button>
            <a
              href="/tools/scorecard/"
              class="inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 transition-colors hover:text-paper"
            >Grab the free scorecard <Icon name="ph:arrow-up-right" size={12} /></a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
