---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';
import Link from '~/components/primitives/Link.astro';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface MorePost {
  id: string;
  title: string;
  description: string;
  category: string;
  readMinutes: number;
}

interface Props {
  title: string;
  description: string;
  category: string;
  categoryIcon?: string;
  date: Date;
  readMinutes: number;
  pathname?: string;
  headings?: TocHeading[];
  morePosts?: MorePost[];
}

const {
  title,
  description,
  category,
  categoryIcon = 'ph:notebook',
  date,
  readMinutes,
  pathname,
  headings = [],
  morePosts = [],
} = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = date.toISOString().slice(0, 10);

// In-page table of contents — top-level sections only.
const toc = headings.filter((h) => h.depth === 2);

// Share targets.
const shareUrl = new URL(pathname ?? '/', Astro.site ?? 'https://joshuabriley.com').toString();
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`;
const liShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
---

<BaseLayout
  title={`${title} · Joshua Briley`}
  description={description}
  pathname={pathname}
  article={{
    publishedTime: date,
    section: category,
    author: 'Joshua Briley',
  }}
>
  <div class="reading-progress" aria-hidden="true">
    <span class="reading-progress-bar" data-progress-bar></span>
  </div>

  {/* ───────────────────────── POST HEADER ───────────────────────── */}
  <Section tone="paper" padding="default" class="pt-12 md:pt-16 border-b border-line">
    <Container width="wide">
      <div class="max-w-3xl">
        <Link href="/blog/" variant="arrow" iconRight="ph:arrow-left" class="flex-row-reverse">
          Back to blog
        </Link>

        <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.65rem] uppercase tracking-[0.12em]">
          <span class="text-accent">{category}</span>
          <span class="text-ink-faint" aria-hidden="true">·</span>
          <time datetime={isoDate} class="text-ink-muted">{formattedDate}</time>
          <span class="text-ink-faint" aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-1.5 text-ink-muted">
            <Icon name="ph:clock" size={13} />{readMinutes} min read
          </span>
        </div>

        <Heading level={1} visual="display-lg" balance class="mt-6">
          {title}
        </Heading>

        <Text size="lg" tone="muted" class="mt-6">
          {description}
        </Text>
      </div>
    </Container>
  </Section>

  {/* ───────────────────────── BODY ───────────────────────── */}
  <Section tone="paper" padding="default">
    <Container width="wide">
      <div class="lg:grid lg:grid-cols-[1fr_minmax(0,42rem)_1fr] lg:gap-x-10 xl:gap-x-14">
        {/* Margin rail: in-page contents + share (desktop only) */}
        <aside class="hidden lg:block lg:justify-self-end lg:w-56" aria-label="Article tools">
          <div class="sticky top-28">
            {toc.length >= 2 && (
              <nav class="mb-9" aria-label="On this page">
                <p class="mono-label mb-4">On this page</p>
                <ol class="toc-list">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="toc-link" data-toc-link={h.slug}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}

            <p class="mono-label mb-4">Share</p>
            <div class="flex items-center gap-2">
              <a href={xShare} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on X">
                <Icon name="ph:x-logo" size={17} />
              </a>
              <a href={liShare} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on LinkedIn">
                <Icon name="ph:linkedin-logo" size={17} />
              </a>
              <button type="button" class="share-btn" data-copy-link aria-label="Copy link">
                <Icon name="ph:link" size={17} />
              </button>
            </div>
          </div>
        </aside>

        {/* Reading column */}
        <div class="max-w-2xl mx-auto lg:max-w-none lg:mx-0">
          <article class="prose-whimsy">
            <slot />
          </article>

          {/* Author block */}
          <div class="mt-16 rounded-lg border border-line bg-raised p-7 md:p-9">
            <p class="mono-label">Written by</p>
            <Heading level={2} visual="h2" class="mt-3">Joshua Briley</Heading>
            <Text tone="muted" class="mt-3 max-w-xl">
              UX software engineer and consultant. I help product teams turn drifting UIs into design systems people actually use — and can defend in a budget meeting.
            </Text>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <Button variant="primary" size="sm" iconRight="ph:arrow-right" href="/contact/">
                Work with me
              </Button>
              <Button variant="ghost" size="sm" href="/blog/">
                More essays
              </Button>
            </div>
          </div>

          {/* Keep reading */}
          {morePosts.length > 0 && (
            <section class="mt-16 border-t border-line pt-10" aria-label="More essays">
              <p class="mono-label">Keep reading / next</p>
              <ul class="mt-6 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
                {morePosts.map((p) => (
                  <li class="bg-paper">
                    <a href={`/blog/${p.id}/`} class="group flex h-full flex-col p-6 transition-colors hover:bg-ink/[0.02]">
                      <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-accent">{p.category}</span>
                      <Heading level={3} visual="h3" class="mt-2 transition-colors group-hover:text-accent">
                        {p.title}
                      </Heading>
                      <Text size="sm" tone="muted" class="mt-2 line-clamp-2">
                        {p.description}
                      </Text>
                      <span class="mt-4 inline-flex items-center gap-1.5 font-sans text-[0.85rem] font-medium text-ink transition-colors group-hover:text-accent">
                        Read essay
                        <Icon name="ph:arrow-right" size={14} class="transition-transform duration-300 ease-out group-hover:translate-x-1" />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>

        {/* Right spacer keeps the reading column optically centred */}
        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style is:global>
  /* ── Reading chrome (progress + margin rail) ──────────────────────────── */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 50;
    background: var(--line);
    pointer-events: none;
  }
  .reading-progress-bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--accent);
    will-change: transform;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-link {
    display: block;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--ink-muted);
    padding: 0.4rem 0 0.4rem 0.85rem;
    border-left: 1.5px solid var(--line);
    transition:
      color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  .toc-link:hover {
    color: var(--accent);
  }
  .toc-link.is-active {
    color: var(--ink);
    border-left-color: var(--accent);
    font-weight: 500;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 6px;
    background: var(--raised);
    border: 1px solid var(--line);
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .share-btn:hover {
    color: var(--accent);
    border-color: var(--line-strong);
  }
  .share-btn.is-copied {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Anchor offset so deep-linked headings clear the sticky header. */
  .prose-whimsy :is(h2, h3)[id] {
    scroll-margin-top: 6rem;
  }
</style>

<script>
  // Reading progress — transform-only, passive scroll, rAF-throttled.
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  if (bar) {
    let max = 0;
    const measure = () => {
      max = document.documentElement.scrollHeight - window.innerHeight;
    };
    const update = () => {
      const p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      bar.style.transform = `scaleX(${p})`;
    };
    measure();
    update();
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', () => { measure(); update(); }, { passive: true });
  }

  // Table-of-contents scroll-spy.
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (tocLinks.length) {
    const byId = new Map([...tocLinks].map((l) => [l.dataset.tocLink, l]));
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          tocLinks.forEach((l) => l.classList.remove('is-active'));
          byId.get((entry.target as HTMLElement).id)?.classList.add('is-active');
        });
      },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 },
    );
    document.querySelectorAll('.prose-whimsy h2[id]').forEach((h) => spy.observe(h));
  }

  // Copy-link button.
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.classList.add('is-copied');
        copyBtn.setAttribute('aria-label', 'Link copied');
        window.setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          copyBtn.setAttribute('aria-label', 'Copy link');
        }, 1600);
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  }
</script>
