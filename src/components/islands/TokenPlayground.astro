---
import Button from '~/components/primitives/Button.astro';
import Icon from '~/components/primitives/Icon.astro';

/**
 * Interactive design-token playground. Visitors tweak radius, spacing,
 * hue, and density via sliders/chips and a sample component card responds
 * live. Demonstrates what a design system *actually does* in <60 seconds.
 *
 * All control state lives on a single wrapper as CSS custom properties.
 */

const palettes = [
  { id: 'plum',   label: 'Plum',   hex: '#6C4AB6' },
  { id: 'coral',  label: 'Coral',  hex: '#E8573D' },
  { id: 'sky',    label: 'Sky',    hex: '#1B6FA1' },
  { id: 'sage',   label: 'Sage',   hex: '#3E6E3D' },
  { id: 'sunset', label: 'Sunset', hex: '#A24818' },
] as const;

const densities = [
  { id: 'compact',    label: 'Compact'    },
  { id: 'default',    label: 'Default'    },
  { id: 'comfortable',label: 'Comfortable'},
] as const;
---

<section
  class="tp-root"
  data-token-playground
  data-density="default"
  style={`--tp-radius: 14px; --tp-spacing: 1; --tp-primary: ${palettes[0].hex};`}
  aria-labelledby="tp-title"
>
  <div class="tp-grid">
    <!-- ============ CONTROLS ============ -->
    <div class="tp-controls">
      <div class="mb-5">
        <span class="mono-label">Drag the knobs</span>
        <h3 id="tp-title" class="font-display text-2xl md:text-3xl font-bold text-ink leading-tight mt-2">
          A design token, made visible.
        </h3>
        <p class="text-sm text-ink-muted mt-2 leading-relaxed">
          One source of truth, many components in sync. Move a slider and the card on the right reacts. That&rsquo;s a design system in miniature.
        </p>
      </div>

      <div class="tp-field">
        <div class="tp-label-row">
          <label for="tp-radius" class="tp-label">Border radius</label>
          <output id="tp-radius-out" for="tp-radius" class="tp-output">14px</output>
        </div>
        <input
          id="tp-radius"
          type="range"
          min="0"
          max="32"
          step="1"
          value="14"
          data-tp-control="radius"
          aria-describedby="tp-radius-out"
        />
      </div>

      <div class="tp-field">
        <div class="tp-label-row">
          <label for="tp-spacing" class="tp-label">Spacing scale</label>
          <output id="tp-spacing-out" for="tp-spacing" class="tp-output">1.00&times;</output>
        </div>
        <input
          id="tp-spacing"
          type="range"
          min="0.75"
          max="1.5"
          step="0.05"
          value="1"
          data-tp-control="spacing"
          aria-describedby="tp-spacing-out"
        />
      </div>

      <div class="tp-field">
        <span class="tp-label" id="tp-palette-label">Primary color</span>
        <div class="tp-chip-row" role="radiogroup" aria-labelledby="tp-palette-label">
          {palettes.map((p, i) => (
            <label
              class="tp-chip"
              data-tp-chip="palette"
              data-value={p.hex}
              style={`--chip: ${p.hex};`}
            >
              <input
                type="radio"
                name="tp-palette"
                value={p.hex}
                checked={i === 0}
                data-tp-control="palette"
              />
              <span class="tp-chip-dot" aria-hidden="true"></span>
              <span class="tp-chip-label">{p.label}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="tp-field">
        <span class="tp-label" id="tp-density-label">Density</span>
        <div class="tp-chip-row" role="radiogroup" aria-labelledby="tp-density-label">
          {densities.map((d, i) => (
            <label class="tp-chip tp-chip--text" data-tp-chip="density" data-value={d.id}>
              <input
                type="radio"
                name="tp-density"
                value={d.id}
                checked={i === 1}
                data-tp-control="density"
              />
              <span class="tp-chip-label">{d.label}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="mt-2 flex items-center gap-3">
        <Button
          type="button"
          variant="ghost"
          size="sm"
          iconLeft="ph:arrow-counter-clockwise-duotone"
          id="tp-reset"
          class="!bg-white !border-charcoal/15 hover:!bg-white hover:!border-coral/40"
        >
          Reset tokens
        </Button>
        <p class="text-xs text-charcoal/70 font-body italic">
          No JavaScript per component. Just CSS variables.
        </p>
      </div>
    </div>

    <!-- ============ PREVIEW ============ -->
    <div class="tp-preview">
      <div class="tp-preview-frame" aria-hidden="false">
        <div class="tp-preview-rule">
          <span>preview</span>
          <span class="tp-preview-live"><i aria-hidden="true"></i>live</span>
        </div>

        <article class="tp-card">
          <header class="tp-card-head">
            <span class="tp-badge">
              <Icon name="ph:sparkle-duotone" size={14} />
              <span>New release</span>
            </span>
            <span class="tp-meta">v2.4 · today</span>
          </header>
          <h4 class="tp-card-title">Button &amp; Card components updated</h4>
          <p class="tp-card-body">
            Radius and spacing tokens now drive both. Change one number, two components agree.
          </p>
          <div class="tp-card-tags">
            <span class="tp-tag">tokens</span>
            <span class="tp-tag">a11y</span>
            <span class="tp-tag">v2</span>
          </div>
          <div class="tp-card-actions">
            <button type="button" class="tp-btn tp-btn--primary">
              <span>View changelog</span>
              <iconify-icon icon="ph:arrow-right-bold" aria-hidden="true"></iconify-icon>
            </button>
            <button type="button" class="tp-btn tp-btn--ghost">Dismiss</button>
          </div>
        </article>

        <!-- mini stat row to show shared tokens -->
        <div class="tp-stats">
          <div class="tp-stat">
            <span class="tp-stat-num">1</span>
            <span class="tp-stat-label">token</span>
          </div>
          <div class="tp-stat">
            <span class="tp-stat-num">7</span>
            <span class="tp-stat-label">elements</span>
          </div>
          <div class="tp-stat">
            <span class="tp-stat-num">0</span>
            <span class="tp-stat-label">overrides</span>
          </div>
        </div>
      </div>

      <p class="tp-foot-note" aria-live="polite" data-tp-callout>
        Try setting radius to <strong>0</strong> for a brutalist feel, or <strong>28+</strong> for friendly &amp; rounded.
      </p>
    </div>
  </div>
</section>

<script>
  type Control = 'radius' | 'spacing' | 'palette' | 'density';

  const root = document.querySelector<HTMLElement>('[data-token-playground]');
  if (root) {
    const radiusOut  = root.querySelector<HTMLOutputElement>('#tp-radius-out')!;
    const spacingOut = root.querySelector<HTMLOutputElement>('#tp-spacing-out')!;
    const callout    = root.querySelector<HTMLElement>('[data-tp-callout]')!;
    const previewFrame = root.querySelector<HTMLElement>('.tp-preview-frame')!;
    const card = root.querySelector<HTMLElement>('.tp-card')!;
    const radiusInput = root.querySelector<HTMLInputElement>('#tp-radius')!;
    const spacingInput = root.querySelector<HTMLInputElement>('#tp-spacing')!;

    const reduceMotion =
      typeof matchMedia === 'function' &&
      matchMedia('(prefers-reduced-motion: reduce)').matches;
    // gate flourishes so the first paint is calm and flash-free
    let primed = false;

    /** Restart a one-shot animation class and clear it when done. */
    function flash(el: HTMLElement, cls: string, ms: number) {
      if (reduceMotion || !primed) return;
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
      setTimeout(() => el.classList.remove(cls), ms);
    }

    /** Paint the filled portion of a range track up to the thumb. */
    function fillTrack(input: HTMLInputElement) {
      const min = parseFloat(input.min || '0');
      const max = parseFloat(input.max || '100');
      const pct = max > min ? ((parseFloat(input.value) - min) / (max - min)) * 100 : 0;
      input.style.setProperty('--tp-fill', `${pct}%`);
    }

    let calloutHtml = callout.innerHTML;
    function setCallout(html: string) {
      if (html === calloutHtml) return;
      calloutHtml = html;
      if (reduceMotion || !primed) {
        callout.innerHTML = html;
        return;
      }
      callout.classList.add('is-swapping');
      setTimeout(() => {
        callout.innerHTML = html;
        callout.classList.remove('is-swapping');
      }, 130);
    }

    const defaults = {
      radius: '14',
      spacing: '1',
      palette: '#6C4AB6',
      density: 'default',
    };

    function syncChipState(name: 'palette' | 'density', value: string) {
      root!.querySelectorAll<HTMLElement>(`[data-tp-chip="${name}"]`).forEach((chip) => {
        const on = chip.dataset.value === value;
        const was = chip.classList.contains('is-on');
        chip.classList.toggle('is-on', on);
        if (on && !was && primed && !reduceMotion) {
          chip.classList.remove('tp-pop');
          void chip.offsetWidth;
          chip.classList.add('tp-pop');
        }
      });
    }

    function apply(control: Control, value: string) {
      switch (control) {
        case 'radius':
          root!.style.setProperty('--tp-radius', `${value}px`);
          radiusOut.textContent = `${value}px`;
          break;
        case 'spacing':
          root!.style.setProperty('--tp-spacing', value);
          spacingOut.textContent = `${parseFloat(value).toFixed(2)}×`;
          break;
        case 'palette':
          root!.style.setProperty('--tp-primary', value);
          syncChipState('palette', value);
          break;
        case 'density':
          root!.dataset.density = value;
          syncChipState('density', value);
          break;
      }
      // Visual feedback for the change: a color burn for palette swaps,
      // a ring pulse on the card for geometry/spacing changes.
      if (control === 'palette') flash(previewFrame, 'tp-flash', 650);
      else flash(card, 'tp-pulse', 520);
      if (control === 'radius') fillTrack(radiusInput);
      if (control === 'spacing') fillTrack(spacingInput);
      updateCallout();
    }

    function updateCallout() {
      const r = parseInt(getComputedStyle(root!).getPropertyValue('--tp-radius'), 10);
      const s = parseFloat(getComputedStyle(root!).getPropertyValue('--tp-spacing'));
      let msg = 'Try setting radius to <strong>0</strong> for a brutalist feel, or <strong>28+</strong> for friendly &amp; rounded.';
      if (r <= 2)        msg = 'Brutalist energy. Sharp, technical, unmistakable.';
      else if (r >= 26)  msg = 'All friendliness, all softness. Pillowy.';
      else if (s >= 1.4) msg = 'Roomy spacing. Reads calmer; takes more vertical real estate.';
      else if (s <= 0.8) msg = 'Compressed. Dense interfaces: power-user dashboards live here.';
      setCallout(msg);
    }

    root.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      const ctrl = t.dataset.tpControl as Control | undefined;
      if (!ctrl) return;
      apply(ctrl, t.value);
    });

    root.querySelector('#tp-reset')?.addEventListener('click', () => {
      (root.querySelector<HTMLInputElement>('#tp-radius')!).value = defaults.radius;
      (root.querySelector<HTMLInputElement>('#tp-spacing')!).value = defaults.spacing;
      (root.querySelectorAll<HTMLInputElement>('input[name="tp-palette"]')).forEach(
        (r) => (r.checked = r.value === defaults.palette),
      );
      (root.querySelectorAll<HTMLInputElement>('input[name="tp-density"]')).forEach(
        (r) => (r.checked = r.value === defaults.density),
      );
      apply('radius', defaults.radius);
      apply('spacing', defaults.spacing);
      apply('palette', defaults.palette);
      apply('density', defaults.density);
    });

    // Initial paint (sync chip states + track fills)
    syncChipState('palette', defaults.palette);
    syncChipState('density', defaults.density);
    fillTrack(radiusInput);
    fillTrack(spacingInput);

    // Count the "shared token" stats up the first time they scroll into view.
    const statNums = Array.from(root.querySelectorAll<HTMLElement>('.tp-stat-num'));
    function countUpStats() {
      statNums.forEach((el) => {
        const to = parseInt(el.textContent || '0', 10);
        if (to === 0) return;
        const dur = 720;
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }
    if (!reduceMotion && 'IntersectionObserver' in window) {
      const statsEl = root.querySelector('.tp-stats');
      if (statsEl) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                countUpStats();
                obs.disconnect();
              }
            });
          },
          { threshold: 0.4 },
        );
        io.observe(statsEl);
      }
    }

    primed = true;
  }
</script>

<style>
  .tp-root {
    --tp-radius: 14px;
    --tp-spacing: 1;
    --tp-primary: #6c4ab6;
    /* density base — modulated by [data-density] below */
    --tp-pad: calc(1.25rem * var(--tp-spacing));
    --tp-gap: calc(0.75rem * var(--tp-spacing));
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(1.25rem, 2.4vw, 2.5rem);
  }
  .tp-root[data-density='compact']     { --tp-pad: calc(0.85rem * var(--tp-spacing)); --tp-gap: calc(0.5rem * var(--tp-spacing)); }
  .tp-root[data-density='comfortable'] { --tp-pad: calc(1.75rem * var(--tp-spacing)); --tp-gap: calc(1.1rem * var(--tp-spacing)); }

  .tp-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 880px) {
    .tp-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 2.5rem; align-items: start; }
  }

  /* ========== controls ========== */
  .tp-field { margin-bottom: 1.4rem; }
  .tp-label-row {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 0.45rem;
  }
  .tp-label {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    display: block;
    margin-bottom: 0.5rem;
  }
  .tp-output {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 2px 8px;
    border-radius: 6px;
  }
  .tp-root input[type='range'] {
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    border-radius: 999px;
    /* filled portion tracks the thumb via --tp-fill (set in JS) */
    background: linear-gradient(
      90deg,
      var(--tp-primary) 0%,
      var(--tp-primary) var(--tp-fill, 50%),
      var(--line) var(--tp-fill, 50%)
    );
    outline: none;
    cursor: pointer;
  }
  .tp-root input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--raised);
    border: 2.5px solid var(--tp-primary);
    cursor: grab;
    transition: transform 0.15s var(--ease-out);
  }
  .tp-root input[type='range']::-webkit-slider-thumb:active {
    transform: scale(1.14);
    cursor: grabbing;
  }
  .tp-root input[type='range']::-moz-range-thumb {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--raised);
    border: 2.5px solid var(--tp-primary);
    cursor: grab;
    transition: transform 0.15s var(--ease-out);
  }
  .tp-root input[type='range']::-moz-range-thumb:active {
    transform: scale(1.14);
    cursor: grabbing;
  }
  .tp-root input[type='range']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .tp-chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tp-chip {
    --chip: #6c4ab6;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.18s var(--ease-out);
  }
  .tp-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .tp-chip:hover { border-color: var(--line-strong); }
  .tp-chip:focus-within { outline: 2px solid var(--accent); outline-offset: 3px; }
  .tp-chip.is-on {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .tp-chip.tp-pop { animation: tp-chip-pop 0.34s var(--ease-out); }
  @keyframes tp-chip-pop {
    0% { transform: scale(1); }
    45% { transform: scale(1.1); }
    100% { transform: scale(1); }
  }
  .tp-chip-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--chip);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.4);
  }
  .tp-chip.is-on .tp-chip-dot { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.7); }
  .tp-chip--text { /* no dot variant */ }

  /* ========== preview ========== */
  .tp-preview-frame {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: calc(var(--tp-radius) + 6px);
    padding: var(--tp-pad);
  }
  .tp-preview-rule {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.65rem;
    margin-bottom: var(--tp-pad);
  }
  .tp-preview-live { display: inline-flex; align-items: center; gap: 0.4rem; }
  .tp-preview-live i {
    width: 5px; height: 5px; border-radius: 1px;
    background: var(--tp-primary);
    display: inline-block;
  }

  .tp-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--tp-radius);
    padding: var(--tp-pad);
    transition: border-radius 0.25s ease, padding 0.25s ease, gap 0.25s ease;
  }
  /* Ring pulse when a geometry/spacing token changes — the card "agrees" out loud. */
  .tp-card.tp-pulse { animation: tp-card-pulse 0.5s ease-out; }
  @keyframes tp-card-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--tp-primary) 38%, transparent); }
    100% { box-shadow: 0 0 0 13px color-mix(in srgb, var(--tp-primary) 0%, transparent); }
  }
  /* Color burn across every element bound to the primary token on palette swap. */
  .tp-preview-frame.tp-flash .tp-badge,
  .tp-preview-frame.tp-flash .tp-tag,
  .tp-preview-frame.tp-flash .tp-stat-num,
  .tp-preview-frame.tp-flash .tp-btn--primary {
    animation: tp-color-flash 0.6s ease-out;
  }
  @keyframes tp-color-flash {
    0% { filter: brightness(1.5) saturate(1.35); }
    100% { filter: brightness(1) saturate(1); }
  }
  .tp-card-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--tp-gap);
  }
  .tp-badge {
    display: inline-flex; align-items: center; gap: 0.35rem;
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--tp-primary);
    padding: 0.2rem 0.6rem;
    border-radius: calc(var(--tp-radius) * 0.6 + 4px);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .tp-meta {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--ink-muted);
  }
  .tp-card-title {
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 700;
    color: var(--ink);
    font-size: 1.25rem;
    line-height: 1.25;
    margin-bottom: calc(var(--tp-gap) * 0.5);
  }
  .tp-card-body {
    font-family: var(--font-hanken), system-ui, sans-serif;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: var(--tp-gap);
  }
  .tp-card-tags {
    display: flex; gap: calc(var(--tp-gap) * 0.5);
    flex-wrap: wrap;
    margin-bottom: var(--tp-gap);
  }
  .tp-tag {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border-radius: calc(var(--tp-radius) * 0.5 + 2px);
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--tp-primary);
  }
  .tp-card-actions {
    display: flex;
    gap: calc(var(--tp-gap) * 0.7);
    flex-wrap: wrap;
  }
  .tp-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: calc(var(--tp-pad) * 0.45) calc(var(--tp-pad) * 0.85);
    border-radius: var(--tp-radius);
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: transform 0.15s var(--ease-out), background 0.2s var(--ease-out);
  }
  .tp-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .tp-btn--primary {
    background: var(--tp-primary);
    color: #fff;
  }
  .tp-btn--primary:hover { transform: translateY(-1px); }
  .tp-btn--ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .tp-btn--ghost:hover { background: rgba(0, 0, 0, 0.03); }

  .tp-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--tp-gap);
    margin-top: var(--tp-pad);
  }
  .tp-stat {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--tp-radius);
    padding: calc(var(--tp-pad) * 0.6);
    text-align: center;
  }
  .tp-stat-num {
    display: block;
    font-family: var(--font-fraunces), Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.1rem, 5vw, 2.7rem);
