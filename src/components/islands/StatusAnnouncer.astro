---
import Icon from '~/components/primitives/Icon.astro';

/**
 * Live-region demo. Advancing a simulated shipment updates the visible status
 * *and* a real aria-live region — and mirrors each announcement into a visible
 * "what a screen reader hears" transcript, so sighted visitors can see the
 * normally-invisible accessibility behavior this case study is built on.
 *
 * Every status carries text + icon + colour (never colour alone). Single
 * instance, reduced-motion aware, dependency-free.
 */

const steps = [
  { icon: 'ph:clipboard-text-duotone', label: 'Requested',  tone: '#6C4AB6', sr: 'Shipment requested. Awaiting carrier pickup.' },
  { icon: 'ph:barcode-duotone',        label: 'Label made', tone: '#1B6FA1', sr: 'Shipping label created. Carrier set to overnight priority.' },
  { icon: 'ph:package-duotone',        label: 'Picked up',  tone: '#A24818', sr: 'Specimen picked up. Chain of custody confirmed.' },
  { icon: 'ph:truck-duotone',          label: 'In transit', tone: '#E8573D', sr: 'In transit. Temperature holding at minus 196 degrees Celsius.' },
  { icon: 'ph:map-pin-duotone',        label: 'Out for delivery', tone: '#3E6E3D', sr: 'Out for delivery. Recipient notified by text message.' },
  { icon: 'ph:seal-check-duotone',     label: 'Delivered',  tone: '#2D6A4F', sr: 'Delivered. Recipient signature captured.' },
];
---

<section class="sa" data-status-announcer data-step="0" style={`--sa-accent: ${steps[0].tone};`} aria-labelledby="sa-title">
  <header class="sa-head">
    <span class="mono-label">Press play</span>
    <h3 id="sa-title" class="font-display text-2xl md:text-3xl font-bold text-ink leading-tight mt-2">
      What a screen reader actually hears.
    </h3>
    <p class="text-sm text-ink-muted mt-2 leading-relaxed max-w-prose">
      Advance the shipment. The status updates on screen &mdash; and a live region announces it to
      assistive tech. That announcement is invisible to most people, so here it is, written out as
      it is spoken.
    </p>
  </header>

  <div class="sa-grid">
    <!-- ============ SHIPMENT UI ============ -->
    <div class="sa-app">
      <div class="sa-app-top">
        <span class="sa-app-id"><Icon name="ph:snowflake-duotone" size={15} /> Shipment IVF-2291</span>
        <span class="sa-pill" data-sa-pill>
          <span class="sa-pill-dot" aria-hidden="true"></span>
          <span data-sa-pill-label>Requested</span>
        </span>
      </div>

      <ol class="sa-steps" data-sa-steps>
        {steps.map((s, i) => (
          <li class="sa-step" data-sa-step={i} data-tone={s.tone} style={`--step-tone: ${s.tone};`} data-sr={s.sr}>
            <span class="sa-step-mark"><Icon name={s.icon} size={18} /></span>
            <span class="sa-step-label">{s.label}</span>
          </li>
        ))}
      </ol>

      <div class="sa-progress" aria-hidden="true"><span data-sa-progress-fill></span></div>
      <p class="sa-progress-text"><span data-sa-progress-text>Step 1 of 6</span></p>

      <div class="sa-actions">
        <button type="button" class="sa-btn sa-btn--primary" data-sa-advance>
          <iconify-icon icon="ph:arrow-right-bold" aria-hidden="true"></iconify-icon>
          <span data-sa-advance-label>Advance status</span>
        </button>
        <button type="button" class="sa-btn sa-btn--ghost" data-sa-reset>Reset</button>
      </div>
    </div>

    <!-- ============ SCREEN-READER OUTPUT ============ -->
    <div class="sa-sr">
      <div class="sa-sr-rule">
        <Icon name="ph:speaker-high-duotone" size={16} class="text-paper" />
        <span>Screen reader output</span>
      </div>
      <ol class="sa-transcript" data-sa-transcript>
        <li class="sa-transcript-empty" data-sa-empty>
          Press <strong>Advance status</strong> &mdash; announcements appear here as a screen
          reader would speak them.
        </li>
        {steps.map((s, i) => (
          <li class="sa-transcript-line is-hidden" data-sa-line={i}>
            <span class="sa-transcript-tag">aria-live</span>
            <span class="sa-transcript-text">{s.sr}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- the real thing: an actual polite live region for assistive tech -->
  <div class="sr-only" aria-live="polite" role="status" data-sa-live></div>

  <p class="sa-foot">
    Text, icon, and colour &mdash; never colour alone. That rule is small, and it stops an enormous
    class of failures from shipping.
  </p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-status-announcer]');
  if (root) {
    const stepEls = Array.from(root.querySelectorAll<HTMLElement>('[data-sa-step]'));
    const lineEls = Array.from(root.querySelectorAll<HTMLElement>('[data-sa-line]'));
    const pill = root.querySelector<HTMLElement>('[data-sa-pill]')!;
    const pillLabel = root.querySelector<HTMLElement>('[data-sa-pill-label]')!;
    const progressFill = root.querySelector<HTMLElement>('[data-sa-progress-fill]')!;
    const progressText = root.querySelector<HTMLElement>('[data-sa-progress-text]')!;
    const transcript = root.querySelector<HTMLElement>('[data-sa-transcript]')!;
    const liveRegion = root.querySelector<HTMLElement>('[data-sa-live]')!;
    const advanceBtn = root.querySelector<HTMLButtonElement>('[data-sa-advance]')!;
    const advanceLabel = root.querySelector<HTMLElement>('[data-sa-advance-label]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-sa-reset]')!;
    const total = stepEls.length;
    const reduceMotion =
      typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = 0; // number of steps reached (0 = none announced yet)

    function paint() {
      const idx = Math.max(0, current - 1);
      const active = stepEls[idx];
      const tone = active?.dataset.tone ?? '#6C4AB6';
      root!.dataset.step = String(current);
      root!.style.setProperty('--sa-accent', tone);
      stepEls.forEach((el, i) => {
        el.classList.toggle('is-done', i < current);
        el.classList.toggle('is-current', i === current - 1);
      });
      pillLabel.textContent = current === 0 ? 'Awaiting start' : (active?.querySelector('.sa-step-label')?.textContent ?? '');
      pill.style.setProperty('--sa-accent', current === 0 ? '#9aa0ab' : tone);
      const pct = (current / total) * 100;
      progressFill.style.width = `${pct}%`;
      progressText.textContent = current === 0 ? 'Not started' : `Step ${current} of ${total}`;
      const done = current >= total;
      advanceLabel.textContent = done ? 'Delivered' : 'Advance status';
      advanceBtn.disabled = done;
    }

    advanceBtn.addEventListener('click', () => {
      if (current >= total) return;
      const line = lineEls[current];
      const sr = stepEls[current].dataset.sr ?? '';
      current += 1;
      paint();
      // reveal the pre-rendered (scoped) transcript line for this step
      line.classList.remove('is-hidden');
      if (!reduceMotion) {
        line.classList.add('sa-in');
        setTimeout(() => line.classList.remove('sa-in'), 420);
      }
      // the real thing: announce to assistive tech via the live region
      liveRegion.textContent = '';
      requestAnimationFrame(() => (liveRegion.textContent = sr));
      transcript.scrollTop = transcript.scrollHeight;
    });

    resetBtn.addEventListener('click', () => {
      current = 0;
      paint();
      lineEls.forEach((l) => {
        l.classList.add('is-hidden');
        l.classList.remove('sa-in');
      });
      liveRegion.textContent = '';
      transcript.scrollTop = 0;
    });

    paint();
  }
</script>

<style>
  .sa {
    --sa-accent: var(--accent);
    background: var(--paper);
    border: 1px solid var(--line); border-radius: 12px;
    padding: clamp(1.25rem, 2.4vw, 2.5rem);
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .sa-head { margin-bottom: 1.5rem; }

  .sa-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 880px) {
    .sa-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 2rem; align-items: stretch; }
  }

  /* ========== shipment app ========== */
  .sa-app {
    background: var(--raised); border: 1px solid var(--line); border-radius: 12px;
    padding: clamp(1.1rem, 2vw, 1.5rem);
  }
  .sa-app-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .sa-app-id {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.78rem; color: var(--ink-muted);
  }
  .sa-app-id :global(svg) { color: var(--accent); }
  .sa-pill {
    --sa-accent: var(--ink-faint); display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--ink); color: var(--paper);
    border: 1px solid var(--ink);
    padding: 0.25rem 0.7rem; border-radius: 8px;
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-weight: 700; font-size: 0.74rem;
    transition: color 0.3s var(--ease-out), background 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .sa-pill-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sa-accent); }

  .sa-steps {
    list-style: none; margin: 0 0 1.1rem; padding: 0;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.4rem;
  }
  /* "Not reached" is signalled by a dimmed icon mark, NOT a faded label —
     so every step label keeps a full-contrast ink-muted that passes AA. */
  .sa-step { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; text-align: center; }
  .sa-step-mark {
    width: 34px; height: 34px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--line); color: var(--ink-faint); opacity: 0.6;
    border: 1px solid transparent; transition: all 0.25s var(--ease-out);
  }
  .sa-step-label {
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.6rem; font-weight: 600;
    color: var(--ink-muted); line-height: 1.15;
  }
  .sa-step.is-done .sa-step-mark { background: color-mix(in srgb, var(--step-tone) 14%, transparent); color: var(--step-tone); opacity: 1; }
  .sa-step.is-current .sa-step-mark {
    background: var(--step-tone); color: var(--paper); border-color: var(--step-tone); opacity: 1;
  }

  .sa-progress { height: 7px; border-radius: 6px; background: var(--line); overflow: hidden; }
  .sa-progress span {
    display: block; height: 100%; width: 0; border-radius: 6px; background: var(--sa-accent);
    transition: width 0.4s var(--ease-out), background 0.3s var(--ease-out);
  }
  .sa-progress-text {
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.7rem;
    color: var(--ink-muted); margin: 0.5rem 0 1.1rem;
  }

  .sa-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .sa-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-hanken), system-ui, sans-serif; font-weight: 600; font-size: 0.85rem;
    padding: 0.55rem 1rem; border-radius: 8px; border: 1px solid transparent; cursor: pointer;
    transition: transform 0.15s var(--ease-out), background 0.2s var(--ease-out), opacity 0.2s var(--ease-out);
  }
  .sa-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .sa-btn--primary { background: var(--accent); color: var(--paper); }
  .sa-btn--primary:hover:not(:disabled) { transform: translateY(-1px); }
  .sa-btn--primary:disabled { opacity: 0.55; cursor: default; }
  .sa-btn--ghost { background: transparent; color: var(--ink); border-color: var(--line-strong); }
  .sa-btn--ghost:hover { background: var(--line); }

  /* ========== screen-reader output ========== */
  .sa-sr {
    background: var(--ink); border-radius: 12px; padding: 1.1rem 1.2rem;
    display: flex; flex-direction: column;
  }
  .sa-sr-rule {
    display: flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: rgba(246, 247, 249, 0.7);
    border-bottom: 1px solid rgba(246, 247, 249, 0.15); padding-bottom: 0.7rem; margin-bottom: 0.85rem;
  }
  .sa-transcript {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; align-content: start;
    overflow-y: auto; max-height: 260px; flex: 1;
  }
  .sa-transcript-empty {
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.82rem;
    color: rgba(246, 247, 249, 0.7); line-height: 1.5;
  }
  .sa-transcript-empty strong { color: var(--paper); }
  /* once the first status is announced, swap the prompt for the transcript */
  [data-status-announcer]:not([data-step='0']) .sa-transcript-empty { display: none; }
  .sa-transcript-line.is-hidden { display: none; }
  .sa-transcript-line {
    display: flex; gap: 0.6rem; align-items: flex-start;
    background: rgba(246, 247, 249, 0.05); border-left: 2px solid var(--sa-accent);
    border-radius: 6px; padding: 0.5rem 0.7rem;
  }
  .sa-transcript-line.sa-in { animation: sa-line-in 0.4s var(--ease-out); }
  @keyframes sa-line-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .sa-transcript-tag {
    flex-shrink: 0; font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.6rem;
    text-transform: uppercase; letter-spacing: 0.05em; color: var(--paper);
    background: rgba(246, 247, 249, 0.12); padding: 2px 6px; border-radius: 6px; margin-top: 1px;
  }
  .sa-transcript-text {
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.85rem; color: var(--paper); line-height: 1.45;
  }

  .sa-foot {
    margin-top: 1.25rem; text-align: center;
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.9rem; color: var(--ink-muted);
    max-width: 52ch; margin-left: auto; margin-right: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .sa-step, .sa-step-mark, .sa-progress span, .sa-pill, .sa-btn { transition: none; }
    .sa-transcript-line.sa-in { animation: none; }
  }
</style>
