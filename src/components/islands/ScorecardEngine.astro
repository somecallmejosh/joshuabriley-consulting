---
import Button from '~/components/primitives/Button.astro';
import { SECTIONS, TOTAL_ITEMS, TOTAL_MAX } from '~/lib/scorecard';

/**
 * Five subject cards with question rows, plus floating score badge and
 * results card. Sections + question text are rendered server-side from the
 * shared scorecard module; the inline script handles live scoring, reset,
 * and URL `?r=` prefill.
 */

const headlines: Record<string, { description: string }> = {
  s1: { description: 'Are the pieces of your UI actually the same pieces, or are there six buttons wearing the same trench coat?' },
  s2: { description: 'Not a feature, not a checklist. The subject that tells you whether your system is architecture or wallpaper.' },
  s3: { description: 'The quiet plumbing underneath everything. Good tokens make redesigns a rename, not a rewrite.' },
  s4: { description: 'The delivery, not the afterthought. If it isn’t documented, it doesn’t really exist for the next engineer.' },
  s5: { description: 'The seam between design and code. When it’s working, nobody talks about it. When it isn’t, nobody talks about anything else.' },
};

const labels = [
  { v: 0, label: 'No' },
  { v: 1, label: 'Partial' },
  { v: 2, label: 'Yes' },
];
---

<div
  class="rounded-lg border border-line p-6 md:p-7 mb-12"
  data-scorecard-totals
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mono-label mb-2">Total score so far</p>
      <p class="font-serif text-5xl md:text-6xl font-semibold tracking-[-0.03em] text-ink leading-[0.85]">
        <span data-total-score>0</span><span class="text-ink-faint">/{TOTAL_MAX}</span>
      </p>
    </div>
    <div class="sm:text-right">
      <p class="mono-label mb-2">Questions answered</p>
      <p class="font-mono text-xl font-medium tabular-nums text-ink">
        <span data-answered>0</span><span class="text-ink-faint">/{TOTAL_ITEMS}</span>
      </p>
    </div>
  </div>
  <div class="meter-track mt-6">
    <div class="meter-fill" data-meter></div>
  </div>
</div>

<form id="scorecardForm" class="space-y-10" onsubmit="return false">
  {SECTIONS.map((section, idx) => (
    <article
      class="subject-card"
      data-subject={section.id}
      data-total={section.max}
      data-count={section.items.length}
    >
      <div class="p-6 md:p-8">
        <header class="mb-7 flex items-start justify-between gap-5">
          <div class="max-w-md">
            <p class="mono-label mb-2">Subject {String(idx + 1).padStart(2, '0')}</p>
            <h3 class="font-serif text-2xl md:text-[1.75rem] font-semibold tracking-[-0.018em] text-ink leading-tight mb-2">
              {section.title}
            </h3>
            <p class="text-sm text-ink-muted leading-relaxed">
              {headlines[section.id].description}
            </p>
          </div>
          <div class="grade-stamp" data-grade-stamp aria-hidden="true">-</div>
        </header>
        <div class="q-list">
          {section.items.map((item, i) => (
            <div class="q-row">
              <p class="q-text">
                <span class="q-num">{String(i + 1).padStart(2, '0')}.</span>
                {item.label}
              </p>
              <div class="choice-group" role="radiogroup" aria-label={`Question ${i + 1}`}>
                {labels.map(({ v, label }) => (
                  <label class="choice" data-v={v}>
                    <input
                      type="radio"
                      name={item.id}
                      value={v}
                      data-subject={section.id}
                    />
                    {label}
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </article>
  ))}
</form>

<div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4">
  <Button
    type="button"
    id="resetBtn"
    variant="ghost"
    size="sm"
    iconLeft="ph:eraser-duotone"
  >
    Reset the card
  </Button>
  <p class="mono-label">Your final report is below</p>
</div>

<div class="mt-14">
  <div class="reveal-card">
    <div class="relative z-10">
      <p class="mono-label !text-paper/65 mb-2">Teacher's report</p>
      <h3 class="font-serif text-3xl md:text-4xl font-semibold tracking-[-0.018em] mb-4 leading-tight">
        <span data-result-headline>Keep going. Answer every question to unlock your report.</span>
      </h3>
      <div class="flex flex-wrap items-end gap-x-10 gap-y-5 mb-7">
        <div>
          <p class="mono-label !text-paper/60 mb-1">Overall grade</p>
          <p class="sc-final-grade font-serif font-semibold leading-[0.74] tracking-[-0.04em] text-paper" data-final-grade>-</p>
        </div>
        <div class="pb-1">
          <p class="mono-label !text-paper/60 mb-1">Final score</p>
          <p class="font-serif text-4xl md:text-5xl font-medium leading-none text-paper">
            <span data-final-score>0</span><span class="text-paper/45">/{TOTAL_MAX}</span>
          </p>
        </div>
      </div>
      <p data-result-body class="text-paper/80 leading-relaxed max-w-2xl font-sans">
        Pick a choice for every question and a personalized writeup will appear here with the two things I'd prioritize first.
      </p>
      <div data-result-actions class="mt-8 flex flex-col sm:flex-row gap-3" hidden>
        <Button
          id="results-link"
          variant="navy"
          size="md"
          iconLeft="ph:chart-bar-duotone"
          href="/tools/scorecard/results/"
        >
          See your detailed results
        </Button>
        <Button
          variant="secondary"
          size="md"
          iconLeft="ph:envelope-duotone"
          href="/contact/"
        >
          Talk through your results
        </Button>
      </div>
    </div>
  </div>
</div>

<!-- Floating score badge -->
<div class="score-float" aria-hidden="true">
  <div class="score-bubble" data-float-score>0</div>
  <div class="leading-tight">
    <p class="mono-label">So far</p>
    <p class="font-mono text-[0.7rem] text-paper/55 tracking-wide">
      <span data-float-answered>0</span> of {TOTAL_ITEMS} answered
    </p>
  </div>
</div>

<script>
  import { letterGrade, TOTAL_ITEMS, TOTAL_MAX, VALID_PARAM_RE, SECTIONS } from '~/lib/scorecard';

  const form = document.getElementById('scorecardForm') as HTMLFormElement | null;
  if (form) {
    const totalScoreEl = document.querySelector<HTMLElement>('[data-total-score]')!;
    const answeredEl = document.querySelector<HTMLElement>('[data-answered]')!;
    const meterEl = document.querySelector<HTMLElement>('[data-meter]')!;
    const floatScoreEl = document.querySelector<HTMLElement>('[data-float-score]')!;
    const floatAnsweredEl = document.querySelector<HTMLElement>('[data-float-answered]')!;
    const finalScoreEl = document.querySelector<HTMLElement>('[data-final-score]')!;
    const finalGradeEl = document.querySelector<HTMLElement>('[data-final-grade]')!;
    const resultHeadline = document.querySelector<HTMLElement>('[data-result-headline]')!;
    const resultBody = document.querySelector<HTMLElement>('[data-result-body]')!;
    const resultActions = document.querySelector<HTMLElement>('[data-result-actions]')!;
    const resultsLink = document.getElementById('results-link') as HTMLAnchorElement;

    const subjectCards = Array.from(document.querySelectorAll<HTMLElement>('.subject-card'));
    const revealCard = document.querySelector<HTMLElement>('.reveal-card');

    // The floating score chip must stay fixed to the VIEWPORT. An ancestor
    // (.scroll-reveal) keeps `will-change: transform`, which makes it a
    // containing block for `position: fixed` — pinning the chip to that
    // element instead of the viewport. Portal the chip to <body> to escape it.
    const scoreFloat = document.querySelector<HTMLElement>('.score-float');
    if (scoreFloat && scoreFloat.parentElement !== document.body) {
      document.body.appendChild(scoreFloat);
    }

    const reduceMotion =
      typeof matchMedia === 'function' &&
      matchMedia('(prefers-reduced-motion: reduce)').matches;
    // `primed` keeps the first paint / URL-prefill calm; flourishes start after.
    let primed = false;
    let wasComplete = false;
    const numRaf = new WeakMap<HTMLElement, number>();

    /** Roll a number toward its new value (easeOutCubic). */
    function countTo(el: HTMLElement, to: number) {
      const from = parseInt(el.dataset.n ?? el.textContent ?? '0', 10) || 0;
      el.dataset.n = String(to);
      const prev = numRaf.get(el);
      if (prev) cancelAnimationFrame(prev);
      if (reduceMotion || !primed || from === to) {
        el.textContent = String(to);
        return;
      }
      const dur = 420;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - t, 3))));
        if (t < 1) numRaf.set(el, requestAnimationFrame(step));
      };
      numRaf.set(el, requestAnimationFrame(step));
    }

    /** Replay a one-shot animation class. */
    function bump(el: HTMLElement | null, cls: string, ms: number) {
      if (reduceMotion || !primed || !el) return;
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
      setTimeout(() => el.classList.remove(cls), ms);
    }

    function encodeSelections(): string {
      let encoded = '';
      for (const section of SECTIONS) {
        for (const item of section.items) {
          const checked = form!.querySelector<HTMLInputElement>(`input[name="${item.id}"]:checked`);
          encoded += checked ? checked.value : '0';
        }
      }
      return encoded;
    }

    function updateScore() {
      let total = 0;
      let answered = 0;
      const subjectTotals: Record<string, number> = {};

      form!.querySelectorAll<HTMLInputElement>('input[type=radio]:checked').forEach((r) => {
        const v = parseInt(r.value, 10);
        total += v;
        answered += 1;
        const subject = r.dataset.subject!;
        subjectTotals[subject] = (subjectTotals[subject] ?? 0) + v;
      });

      countTo(totalScoreEl, total);
      answeredEl.textContent = String(answered);
      countTo(floatScoreEl, total);
      floatAnsweredEl.textContent = String(answered);
      const nextWidth = `${(answered / TOTAL_ITEMS) * 100}%`;
      if (meterEl.style.width !== nextWidth) {
        meterEl.style.width = nextWidth;
        bump(floatScoreEl, 'score-pop', 380);
        bump(meterEl, 'meter-bump', 600);
      }

      subjectCards.forEach((card) => {
        const subject = card.dataset.subject!;
        const max = parseInt(card.dataset.total!, 10);
        const totalQs = parseInt(card.dataset.count!, 10);
        const score = subjectTotals[subject] ?? 0;
        const stamp = card.querySelector<HTMLElement>('[data-grade-stamp]')!;
        const answeredInSubject = form!.querySelectorAll(
          `input[data-subject="${subject}"]:checked`,
        ).length;

        if (answeredInSubject === 0) {
          stamp.textContent = '-';
          stamp.removeAttribute('data-grade');
          stamp.removeAttribute('data-state');
          return;
        }

        if (answeredInSubject < totalQs) {
          const progressText = `${answeredInSubject}/${totalQs}`;
          if (stamp.textContent !== progressText) stamp.textContent = progressText;
          stamp.removeAttribute('data-grade');
          stamp.setAttribute('data-state', 'progress');
          return;
        }

        stamp.removeAttribute('data-state');
        const pct = (score / max) * 100;
        const g = letterGrade(pct);
        if (stamp.textContent !== g) {
          stamp.textContent = g;
          stamp.setAttribute('data-grade', g);
          stamp.style.animation = 'none';
          void stamp.offsetWidth;
          stamp.style.animation = '';
          // Celebrate a freshly-completed subject.
          bump(card, 'subject-complete', 700);
        }
      });

      countTo(finalScoreEl, total);

      if (answered === TOTAL_ITEMS) {
        const pct = (total / TOTAL_MAX) * 100;
        finalGradeEl.textContent = letterGrade(pct);

        const encoded = encodeSelections();
        resultsLink.href = `/tools/scorecard/results/?r=${encoded}`;
        resultActions.hidden = false;

        let headline: string;
        let body: string;
        if (pct >= 85) {
          headline = 'Gold stars all around.';
          body = 'Your system is doing its job. Click below for a detailed breakdown with your radar chart and personalized recommendation.';
        } else if (pct >= 70) {
          headline = 'Solid fundamentals, a few soft spots.';
          body = 'The bones are good. Click below for a detailed breakdown showing exactly where to focus first.';
        } else if (pct >= 55) {
          headline = 'A system in the making, not quite trusted yet.';
          body = 'The components exist but the system around them needs work. Click below for your radar chart and a prioritized recommendation.';
        } else if (pct >= 40) {
          headline = 'Quietly burning your team out.';
          body = 'Every new feature costs more than the last one. Click below for a detailed breakdown with a specific recommendation on where to start.';
        } else {
          headline = "You’re building on sand, and that’s okay to name.";
          body = "A low score isn’t a failing grade, it’s a starting map. Click below for your personalized report with exactly what to tackle first.";
        }
        resultHeadline.textContent = headline;
        resultBody.textContent = body;

        // Choreograph the unlock the first time the card fills.
        if (!wasComplete && primed) {
          bump(revealCard, 'just-unlocked', 1200);
          bump(finalGradeEl, 'grade-pop', 650);
          bump(resultActions, 'actions-in', 800);
        }
        wasComplete = true;
      } else {
        finalGradeEl.textContent = '-';
        resultActions.hidden = true;
        resultHeadline.textContent = 'Keep going. Answer every question to see your report.';
        resultBody.textContent = `You're ${answered} of ${TOTAL_ITEMS} questions in. A personalized writeup appears here once you've scored every row.`;
        wasComplete = false;
      }
    }

    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.type !== 'radio') return;
      form.querySelectorAll<HTMLInputElement>(`input[name="${target.name}"]`).forEach((input) => {
        const label = input.closest('.choice');
        label?.classList.toggle('is-on', input.checked);
        if (input.checked && label instanceof HTMLElement && !reduceMotion) {
          label.classList.remove('choice-pop');
          void label.offsetWidth;
          label.classList.add('choice-pop');
        }
      });
      updateScore();
    });

    document.getElementById('resetBtn')?.addEventListener('click', () => {
      form.reset();
      form.querySelectorAll('.choice.is-on').forEach((el) => el.classList.remove('is-on'));
      updateScore();
      document.getElementById('scorecard')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Pre-fill from URL ?r=...
    const params = new URLSearchParams(window.location.search);
    const r = params.get('r');
    if (r && VALID_PARAM_RE.test(r)) {
      let idx = 0;
      for (const section of SECTIONS) {
        for (const item of section.items) {
          const value = r[idx++];
          const radio = form.querySelector<HTMLInputElement>(`input[name="${item.id}"][value="${value}"]`);
          if (radio) {
            radio.checked = true;
            radio.closest('.choice')?.classList.add('is-on');
          }
        }
      }
    }

    updateScore();
    primed = true;
  }
</script>

<style>
  /* De-carded subject panel: paper surface + hairline, no white fill, no
     floating colored tab. Radius pulled to the site's 8px scale. */
  .subject-card {
    position: relative;
    background: transparent;
    border-radius: 8px;
    border: 1px solid var(--line);
    transition: border-color 0.35s var(--ease-out);
  }
  .subject-card:hover {
    border-color: var(--line-strong);
  }

  /* Card gives a little hop when its section earns a grade. */
  .subject-card.subject-complete { animation: sc-card-celebrate 0.7s ease-out; }
  @keyframes sc-card-celebrate {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-5px) scale(1.014); }
    100% { transform: translateY(0) scale(1); }
  }

  .q-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .q-row:first-of-type { border-top: none; }
  .q-text {
    font-family: var(--font-hanken), system-ui, sans-serif;
    color: var(--ink);
    line-height: 1.55;
  }
  .q-num {
    display: inline-block;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.4rem;
  }
  .choice-group {
    display: inline-flex;
    gap: 2px;
    background: var(--paper);
    border-radius: 7px;
    padding: 3px;
    border: 1px solid var(--line);
  }
  .choice {
    position: relative;
    padding: 0.5rem 1rem;
    border-radius: 5px;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-muted);
    cursor: pointer;
    user-select: none;
    transition: all 0.2s var(--ease-out);
    border: 1.5px solid transparent;
  }
  .choice:hover {
    color: var(--ink);
    background: rgba(0, 0, 0, 0.03);
  }
  .choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .choice.is-on {
    color: var(--paper);
    transform: translateY(-1px);
  }
  .choice[data-v='0'].is-on,
  .choice[data-v='1'].is-on,
  .choice[data-v='2'].is-on { background: var(--ink); color: var(--paper); }
  .choice:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* Springy settle when an answer is chosen. Lands on the is-on resting transform. */
  .choice.choice-pop { animation: sc-choice-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes sc-choice-pop {
    0% { transform: translateY(-1px) scale(0.9); }
    55% { transform: translateY(-1px) scale(1.09); }
    100% { transform: translateY(-1px) scale(1); }
  }

  /* Compact ink chip — clearly floats above the editorial page without a white
     card or a heavy radius. Soft, hue-tinted shadow, not pure black. */
  .score-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 45;
    background: var(--ink);
    color: var(--paper);
    border-radius: 8px;
    border: 1px solid var(--ink);
    padding: 0.7rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-hanken), system-ui, sans-serif;
    box-shadow: 0 10px 30px -12px rgba(26, 27, 30, 0.35);
  }
  .score-float::before {
    content: none;
  }
  .score-float .mono-label {
    color: rgba(246, 247, 249, 0.6);
  }
  .score-bubble {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    background: var(--paper);
    color: var(--ink);
  }
  .score-bubble.score-pop { animation: sc-bubble-pop 0.38s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes sc-bubble-pop {
    0% { transform: scale(1); }
    45% { transform: scale(1.17); }
    100% { transform: scale(1); }
  }

  /* Quick brightness lift on the progress meter each time it advances. */
  [data-meter].meter-bump { animation: sc-meter-bump 0.6s ease-out; }
  @keyframes sc-meter-bump {
    0% { filter: brightness(1); }
    30% { filter: brightness(1.32) saturate(1.1); }
    100% { filter: brightness(1); }
  }

  /* ===== final report reveal choreography ===== */
  .reveal-card { position: relative; }
  .reveal-card.just-unlocked::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(246, 247, 249, 0.18) 50%,
      transparent 70%
    );
    transform: translateX(-110%);
    animation: sc-sheen 1s ease-out;
  }
  @keyframes sc-sheen { to { transform: translateX(110%); } }

  .sc-final-grade {
    font-size: clamp(4.5rem, 13vw, 7rem);
  }
  [data-final-grade].grade-pop {
    display: inline-block;
    animation: sc-grade-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes sc-grade-pop {
    0% { transform: scale(0.4); opacity: 0; }
    60% { transform: scale(1.14); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  [data-result-actions].actions-in > * {
    animation: sc-action-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  [data-result-actions].actions-in > *:nth-child(1) { animation-delay: 0.16s; }
  [data-result-actions].actions-in > *:nth-child(2) { animation-delay: 0.3s; }
  @keyframes sc-action-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .choice,
    .subject-card { transition: none; }
    .choice.choice-pop,
    .score-bubble.score-pop,
    [data-meter].meter-bump,
    .subject-card.subject-complete,
    .reveal-card.just-unlocked::after,
    [data-final-grade].grade-pop,
    [data-result-actions].actions-in > * { animation: none; }
  }

  @media (max-width: 640px) {
    .q-row { grid-template-columns: 1fr; }
    .choice-group {
      display: flex;
      width: 100%;
    }
    .choice {
      flex: 1;
      text-align: center;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
</style>
