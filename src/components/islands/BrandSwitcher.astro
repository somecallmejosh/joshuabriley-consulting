---
import Icon from '~/components/primitives/Icon.astro';

/**
 * Brand switcher. One sample component, three brand contexts. Switching a tab
 * swaps only the token layer (color, radius, display font) as CSS custom
 * properties — the markup and props never change. It is the live proof of this
 * case study's claim: "looks different because the tokens resolve differently."
 *
 * Token sets live in a JS map keyed by brand id; single-instance, reduced-motion
 * aware, dependency-free.
 */

const brands = [
  { id: 'cc', name: "Cook's Country", note: 'Rustic, warm' },
  { id: 'ci', name: "Cook's Illustrated", note: 'Classic, exacting' },
  { id: 'atk', name: "America's Test Kitchen", note: 'Modern, friendly' },
] as const;
---

<section class="bs" data-brand-switcher data-brand="cc" aria-labelledby="bs-title">
  <header class="bs-head">
    <span class="mono-label">Same component</span>
    <h3 id="bs-title" class="font-display text-2xl md:text-3xl font-bold text-ink leading-tight mt-2">
      One component, every brand.
    </h3>
    <p class="text-sm text-ink-muted mt-2 leading-relaxed max-w-prose">
      Switch the brand context. The card&rsquo;s markup and props never change &mdash; only the
      tokens it reads. No <code>brand</code> prop, no forked render tree.
    </p>
  </header>

  <div class="bs-tabs" role="tablist" aria-label="Brand context">
    {brands.map((b, i) => (
      <button
        type="button"
        class="bs-tab"
        role="tab"
        id={`bs-tab-${b.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-bs-tab={b.id}
      >
        <span class="bs-tab-name">{b.name}</span>
        <span class="bs-tab-note">{b.note}</span>
      </button>
    ))}
  </div>

  <div class="bs-grid">
    <!-- ============ TOKEN READOUT ============ -->
    <div class="bs-tokens" aria-hidden="true">
      <p class="bs-tokens-rule">resolved tokens</p>
      <dl class="bs-token-list">
        <div><dt>--color-primary</dt><dd data-bs-out="primary">#B5532E</dd></div>
        <div><dt>--color-accent</dt><dd data-bs-out="accent">#3E6E3D</dd></div>
        <div><dt>--radius-card</dt><dd data-bs-out="radius">6px</dd></div>
        <div><dt>--font-display</dt><dd data-bs-out="font">Georgia</dd></div>
      </dl>
      <p class="bs-tokens-foot">
        <code>&lt;RecipeCard /&gt;</code> &mdash; one component, no <code>brand</code> prop.
      </p>
    </div>

    <!-- ============ LIVE SAMPLE COMPONENT ============ -->
    <div class="bs-preview">
      <article class="bs-card" data-bs-card>
        <div class="bs-card-cover">
          <span class="bs-card-badge">Weeknight</span>
          <Icon name="ph:cooking-pot-duotone" size={40} class="bs-card-coveric text-white" />
        </div>
        <div class="bs-card-body">
          <p class="bs-card-kicker">30-minute supper</p>
          <h4 class="bs-card-title">Skillet Cornbread</h4>
          <div class="bs-card-meta">
            <span><Icon name="ph:clock-duotone" size={15} /> 35 min</span>
            <span><Icon name="ph:gauge-duotone" size={15} /> Easy</span>
            <span><Icon name="ph:star-duotone" size={15} /> 4.8</span>
          </div>
          <div class="bs-card-actions">
            <button type="button" class="bs-card-btn" tabindex="-1" aria-hidden="true">Save recipe</button>
            <button type="button" class="bs-card-btn bs-card-btn--ghost" tabindex="-1" aria-hidden="true">Share</button>
          </div>
        </div>
      </article>
      <p class="bs-caption" data-bs-caption>
        Cook&rsquo;s Country renders this exact card with rustic, warm tokens.
      </p>
    </div>
  </div>
</section>

<script>
  type Brand = {
    primary: string; accent: string; surface: string; ink: string;
    radius: string; font: string; fontLabel: string; caption: string;
  };
  const BRANDS: Record<string, Brand> = {
    cc: {
      primary: '#B5532E', accent: '#3E6E3D', surface: '#FBF6EE', ink: '#3A2A20',
      radius: '6px', font: 'Georgia, "Times New Roman", serif', fontLabel: 'Georgia',
      caption: 'Cook’s Country renders this exact card with rustic, warm tokens.',
    },
    ci: {
      primary: '#1F3A5F', accent: '#8C6A3F', surface: '#F6F4EF', ink: '#22303F',
      radius: '3px', font: 'Georgia, "Times New Roman", serif', fontLabel: 'Georgia',
      caption: 'Cook’s Illustrated: the same card, squared off and authoritative.',
    },
    atk: {
      primary: '#E8573D', accent: '#6C4AB6', surface: '#FFFBF5', ink: '#2D2B55',
      radius: '16px', font: 'var(--font-hanken), system-ui, sans-serif', fontLabel: 'Hanken',
      caption: 'America’s Test Kitchen: rounder, brighter — same component underneath.',
    },
  };

  const root = document.querySelector<HTMLElement>('[data-brand-switcher]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-bs-tab]'));
    const card = root.querySelector<HTMLElement>('[data-bs-card]')!;
    const caption = root.querySelector<HTMLElement>('[data-bs-caption]')!;
    const outs = {
      primary: root.querySelector<HTMLElement>('[data-bs-out="primary"]')!,
      accent: root.querySelector<HTMLElement>('[data-bs-out="accent"]')!,
      radius: root.querySelector<HTMLElement>('[data-bs-out="radius"]')!,
      font: root.querySelector<HTMLElement>('[data-bs-out="font"]')!,
    };
    const reduceMotion =
      typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches;
    let primed = false;

    function apply(id: string) {
      const b = BRANDS[id];
      if (!b) return;
      root!.dataset.brand = id;
      root!.style.setProperty('--bs-primary', b.primary);
      root!.style.setProperty('--bs-accent', b.accent);
      root!.style.setProperty('--bs-surface', b.surface);
      root!.style.setProperty('--bs-ink', b.ink);
      root!.style.setProperty('--bs-radius', b.radius);
      root!.style.setProperty('--bs-font', b.font);

      outs.primary.textContent = b.primary;
      outs.accent.textContent = b.accent;
      outs.radius.textContent = b.radius;
      outs.font.textContent = b.fontLabel;
      caption.textContent = b.caption;

      tabs.forEach((t) => t.setAttribute('aria-selected', t.dataset.bsTab === id ? 'true' : 'false'));

      if (primed && !reduceMotion) {
        card.classList.remove('bs-reskin');
        void card.offsetWidth;
        card.classList.add('bs-reskin');
      }
    }

    tabs.forEach((t) => t.addEventListener('click', () => apply(t.dataset.bsTab!)));
    apply('cc');
    primed = true;
  }
</script>

<style>
  .bs {
    --bs-primary: #b5532e; --bs-accent: #3e6e3d; --bs-surface: #fbf6ee; --bs-ink: #3a2a20;
    --bs-radius: 6px; --bs-font: Georgia, "Times New Roman", serif;
    background: var(--raised);
    border: 1px solid var(--line); border-radius: 12px;
    padding: clamp(1.25rem, 2.4vw, 2.5rem);
  }
  .bs-head { margin-bottom: 1.25rem; }
  .bs-head code {
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.9em; color: var(--accent);
  }

  .bs-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .bs-tab {
    display: flex; flex-direction: column; align-items: flex-start; gap: 1px;
    background: var(--paper); border: 1px solid var(--line); border-radius: 8px;
    padding: 0.55rem 0.95rem; cursor: pointer; text-align: left;
    transition: border-color 0.18s var(--ease-out), background 0.18s var(--ease-out);
  }
  .bs-tab-name {
    font-family: var(--font-hanken), system-ui, sans-serif; font-weight: 700; font-size: 0.85rem; color: var(--ink);
  }
  .bs-tab-note {
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.68rem; color: #5c5b55;
  }
  .bs-tab:hover { border-color: var(--line-strong); }
  .bs-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .bs-tab[aria-selected='true'] {
    background: var(--ink); border-color: var(--ink);
  }
  .bs-tab[aria-selected='true'] .bs-tab-name { color: var(--paper); }
  .bs-tab[aria-selected='true'] .bs-tab-note { color: rgba(245, 244, 241, 0.8); }

  .bs-grid { display: grid; gap: 1.75rem; }
  @media (min-width: 880px) {
    .bs-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2.25rem; align-items: center; }
  }

  /* ========== token readout ========== */
  .bs-tokens {
    background: var(--ink); border-radius: 12px; padding: 1.25rem 1.35rem;
  }
  .bs-tokens-rule {
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.12em; color: rgba(245, 244, 241, 0.6);
    border-bottom: 1px solid rgba(245, 244, 241, 0.15); padding-bottom: 0.6rem; margin-bottom: 0.85rem;
  }
  .bs-token-list { margin: 0; display: grid; gap: 0.55rem; }
  .bs-token-list div { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .bs-token-list dt {
    font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.74rem; color: rgba(245, 244, 241, 0.65);
  }
  .bs-token-list dd {
    margin: 0; font-family: var(--font-geist-mono), ui-monospace, monospace; font-size: 0.74rem;
    font-weight: 600; color: var(--paper); transition: color 0.2s ease;
  }
  .bs-tokens-foot {
    margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid rgba(245, 244, 241, 0.15);
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.74rem; color: rgba(245, 244, 241, 0.65); line-height: 1.5;
  }
  .bs-tokens-foot code {
    font-family: var(--font-geist-mono), ui-monospace, monospace; color: var(--paper); font-size: 0.92em;
  }

  /* ========== live sample card (all driven by --bs-* tokens) ========== */
  .bs-preview { display: flex; flex-direction: column; align-items: center; }
  .bs-card {
    width: 100%; max-width: 320px; background: var(--bs-surface);
    border: 1px solid color-mix(in srgb, var(--bs-ink) 12%, transparent);
    border-radius: var(--bs-radius); overflow: hidden;
    box-shadow: 0 20px 44px -26px color-mix(in srgb, var(--bs-ink) 60%, transparent);
    transition: background 0.3s ease, border-radius 0.3s ease, border-color 0.3s ease;
  }
  .bs-card.bs-reskin { animation: bs-reskin 0.5s ease-out; }
  @keyframes bs-reskin {
    0% { transform: scale(0.97); opacity: 0.55; }
    100% { transform: scale(1); opacity: 1; }
  }
  .bs-card-cover {
    position: relative; height: 110px;
    background: linear-gradient(135deg, var(--bs-primary), color-mix(in srgb, var(--bs-accent) 70%, var(--bs-primary)));
    display: flex; align-items: center; justify-content: center;
    transition: background 0.3s ease;
  }
  .bs-card-coveric { color: rgba(255, 255, 255, 0.85); }
  .bs-card-badge {
    position: absolute; top: 10px; left: 10px;
    background: rgba(255, 255, 255, 0.92); color: var(--bs-primary);
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.62rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em; padding: 3px 9px;
    border-radius: calc(var(--bs-radius) * 0.7 + 2px); transition: color 0.3s ease, border-radius 0.3s ease;
  }
  .bs-card-body { padding: 1rem 1.1rem 1.15rem; }
  .bs-card-kicker {
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.64rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--bs-accent); margin: 0 0 0.25rem;
    transition: color 0.3s ease;
  }
  .bs-card-title {
    font-family: var(--bs-font); font-weight: 700; font-size: 1.4rem; line-height: 1.15;
    color: var(--bs-ink); margin: 0 0 0.7rem; transition: font-family 0.3s ease, color 0.3s ease;
  }
  .bs-card-meta {
    display: flex; flex-wrap: wrap; gap: 0.85rem; margin-bottom: 1rem;
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.76rem; color: color-mix(in srgb, var(--bs-ink) 75%, transparent);
  }
  .bs-card-meta span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .bs-card-meta :global(svg) { color: var(--bs-accent); }
  .bs-card-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .bs-card-btn {
    flex: 1; min-width: 0;
    background: var(--bs-primary); color: #fff; border: 1.5px solid var(--bs-primary);
    border-radius: var(--bs-radius); padding: 0.5rem 0.9rem;
    font-family: var(--font-hanken), system-ui, sans-serif; font-weight: 600; font-size: 0.82rem;
    transition: background 0.3s ease, border-radius 0.3s ease, border-color 0.3s ease;
  }
  .bs-card-btn--ghost { background: transparent; color: var(--bs-ink); border-color: color-mix(in srgb, var(--bs-ink) 25%, transparent); }

  .bs-caption {
    margin-top: 1.1rem; text-align: center; max-width: 34ch;
    font-family: var(--font-hanken), system-ui, sans-serif; font-size: 0.9rem; color: var(--ink-muted); min-height: 1.5em;
  }

  @media (prefers-reduced-motion: reduce) {
    .bs-card, .bs-card-cover, .bs-card-title, .bs-card-btn, .bs-card-badge { transition: none; }
    .bs-card.bs-reskin { animation: none; }
  }
</style>
