---
import Container from '~/components/layout/Container.astro';
import Icon from '~/components/primitives/Icon.astro';
import Logo from '~/components/primitives/Logo.astro';
import { FOOTER_NAV } from '~/lib/nav';
import { cx } from '~/lib/cx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();
---

<footer class={cx('bg-ink text-paper/60 border-t border-paper/10', className)}>
  <Container width="wide" class="py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Logo variant="lockup" tone="inverse" size="lg" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-paper/55">
          UX engineer & design-systems consultant. I make product interfaces that
          look right, build right, and pull their weight.
        </p>
        <p class="mt-5 inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/60">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Available for Q3 · replies in one business day
        </p>
      </div>

      <div class="lg:col-span-6 grid grid-cols-2 gap-8 sm:gap-12">
        {FOOTER_NAV.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="mono-label !text-paper/60">{col.heading}</h2>
            <ul class="mt-4 flex flex-col gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.95rem] text-paper/70 transition-colors hover:text-paper"
                  >{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-paper/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-x-5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper/55 sm:flex-row sm:items-center">
        <span class="inline-flex items-center min-h-[24px]">© {year} Briley Creative</span>
        <a href="/privacy/" class="inline-flex items-center min-h-[24px] transition-colors hover:text-paper/70">Privacy</a>
        <a href="/terms/" class="inline-flex items-center min-h-[24px] transition-colors hover:text-paper/70">Terms</a>
      </div>
      <div class="flex items-center gap-5 font-mono text-[0.7rem] uppercase tracking-[0.12em]">
        <a
          href="https://www.linkedin.com/in/joshuabriley"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-1.5 text-paper/55 transition-colors hover:text-paper"
        >LinkedIn <Icon name="ph:arrow-up-right" size={12} /></a>
        <a
          href="https://github.com/somecallmejosh"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-1.5 text-paper/55 transition-colors hover:text-paper"
        >GitHub <Icon name="ph:arrow-up-right" size={12} /></a>
      </div>
    </div>

    {/* Colophon — a craft tell that quietly says "a person made this, not a kit." */}
    <p class="mt-8 font-mono text-[0.66rem] leading-relaxed tracking-[0.1em] text-paper/35">
      Hand-built with Astro · set in <span class="text-paper/55">Fraunces</span>,
      <span class="text-paper/55"> Hanken Grotesk</span> &amp;
      <span class="text-paper/55"> Geist Mono</span> · no templates were harmed.
    </p>
  </Container>
</footer>
