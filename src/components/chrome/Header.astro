---
import Container from '~/components/layout/Container.astro';
import Logo from '~/components/primitives/Logo.astro';
import Link from '~/components/primitives/Link.astro';
import MobileNav from '~/components/chrome/MobileNav.astro';
import { PRIMARY_NAV } from '~/lib/nav';
import { cx } from '~/lib/cx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header
  class={cx(
    'sticky top-0 z-40 bg-paper/80 backdrop-blur-md border-b border-line',
    className,
  )}
>
  <Container as="div" width="wide" class="flex items-center justify-between gap-6 py-3.5 relative">
    <Logo href="/" variant="lockup" size="md" />

    <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
      {PRIMARY_NAV.filter((l) => l.href !== '/contact/').map((link) => (
        <Link href={link.href} variant="nav">{link.label}</Link>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-5">
      <span class="mono-label inline-flex items-center gap-1.5">
        <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-accent/60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
        </span>
        Available Q3
      </span>
      <a
        href="/contact/"
        class="inline-flex items-center gap-2 rounded-[5px] bg-ink px-4 py-2 font-sans text-[0.85rem] font-medium tracking-tight text-paper transition-colors hover:bg-ink-soft"
      >Start a project</a>
    </div>

    <MobileNav links={PRIMARY_NAV} />
  </Container>
</header>
