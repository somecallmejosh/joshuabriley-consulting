---
import { cx } from '~/lib/cx';
import Icon from './Icon.astro';

/**
 * Button or button-styled link. Renders `<button>` by default; renders `<a>`
 * if `href` is provided — never the other way around. Icon-only buttons
 * MUST supply an `aria-label` (TS enforces this via discriminated union).
 */

type Variant = 'primary' | 'secondary' | 'ghost' | 'navy' | 'text';
type Size = 'sm' | 'md' | 'lg';

interface BaseProps {
  variant?: Variant;
  size?: Size;
  /** Icon shown before the label. */
  iconLeft?: string;
  /** Icon shown after the label (defaults to none; common for arrow CTAs). */
  iconRight?: string;
  /** Disabled state (button only). */
  disabled?: boolean;
  class?: string;
  id?: string;
  /** Form attribute — for submit buttons that live outside the form. */
  form?: string;
  /** When true, render as <a href> instead of <button>. */
  href?: string;
  /** type for <button>. */
  type?: 'button' | 'submit' | 'reset';
  /** External link target. */
  target?: string;
  rel?: string;
  /** Required if button has no visible text content. */
  'aria-label'?: string;
  /** aria-current for nav-style usage (rare on buttons). */
  'aria-current'?: 'page' | 'true' | 'false';
}

const {
  variant = 'primary',
  size = 'md',
  iconLeft,
  iconRight,
  disabled,
  class: className,
  id,
  form,
  href,
  type = 'button',
  target,
  rel,
  'aria-label': ariaLabel,
  'aria-current': ariaCurrent,
} = Astro.props as BaseProps;

const sizes: Record<Size, string> = {
  sm: 'px-3.5 py-2 text-[0.8rem] gap-1.5',
  md: 'px-5 py-2.5 text-[0.9rem] gap-2',
  lg: 'px-6 py-3 text-[0.95rem] gap-2',
};

const variants: Record<Variant, string> = {
  // Solid ink fill on paper — the single confident primary. No gradient, no glow.
  primary:
    'bg-ink text-paper hover:bg-ink-soft',
  // Quiet outlined action for ink (dark) surfaces.
  secondary:
    'bg-transparent text-paper border border-paper/25 hover:bg-paper/10',
  // Hairline-outlined action on paper.
  ghost:
    'bg-transparent text-ink border border-line-strong hover:border-ink/40 hover:bg-ink/[0.03]',
  // Inverse fill — paper button used on ink surfaces.
  navy:
    'bg-paper text-ink hover:bg-white',
  // Bare text action — accent underline reveals on hover.
  text:
    'bg-transparent text-ink px-0 hover:text-accent [&::after]:hidden',
};

const base =
  'group/btn inline-flex items-center justify-center rounded-[5px] font-sans font-medium tracking-tight transition-[background-color,border-color,color,transform] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-px active:scale-[0.97] active:translate-y-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0 disabled:active:scale-100';

const classes = cx(base, sizes[size], variants[variant], className);

const isLink = Boolean(href);
const externalAttrs = href && /^https?:/.test(href)
  ? { rel: rel ?? 'noopener noreferrer', target: target ?? '_blank' }
  : { rel, target };
---

{isLink ? (
  <a
    href={href}
    id={id}
    class={classes}
    data-source={`Button.${variant} · size=${size} · rendered as <a>`}
    aria-label={ariaLabel}
    aria-current={ariaCurrent}
    {...externalAttrs}
  >
    {iconLeft && <Icon name={iconLeft} size={size === 'sm' ? 15 : 17} />}
    <slot />
    {iconRight && <Icon name={iconRight} size={size === 'sm' ? 15 : 17} class="transition-transform duration-300 ease-out group-hover/btn:translate-x-1" />}
  </a>
) : (
  <button
    type={type}
    id={id}
    form={form}
    disabled={disabled}
    class={classes}
    data-source={`Button.${variant} · size=${size}`}
    aria-label={ariaLabel}
    aria-current={ariaCurrent}
  >
    {iconLeft && <Icon name={iconLeft} size={size === 'sm' ? 15 : 17} />}
    <slot />
    {iconRight && <Icon name={iconRight} size={size === 'sm' ? 15 : 17} class="transition-transform duration-300 ease-out group-hover/btn:translate-x-1" />}
  </button>
)}
