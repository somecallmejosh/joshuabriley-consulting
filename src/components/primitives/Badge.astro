---
import { cx } from '~/lib/cx';
import Icon from './Icon.astro';
import type { Tone } from '~/lib/tones';

/**
 * Monospace label chip — the eyebrow above headings, a category tag, a status.
 * Editorial-Technical: a hairline-bordered tile set in Geist Mono, uppercase,
 * with a small accent tick. Legacy `tone` is accepted but collapses to the
 * monochrome system (coral → accent, everything else → neutral).
 */

interface Props {
  tone?: Tone;
  icon?: string;
  /** Retained for API compatibility; the sticker treatment is retired. */
  sticker?: boolean;
  size?: 'sm' | 'md';
  /** Solid ink fill (for use on paper) vs. the default outlined chip. */
  solid?: boolean;
  class?: string;
}

const { tone = 'plum', icon, size = 'md', solid = false, class: className } = Astro.props;

const accented = tone === 'coral' || tone === 'sunset';

const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'px-2 py-0.5 text-[0.625rem] gap-1.5',
  md: 'px-2.5 py-1 text-[0.6875rem] gap-2',
};

const surface = solid
  ? 'bg-ink text-paper border-ink'
  : 'bg-transparent text-ink-muted border-line-strong';
---

<span
  class={cx(
    'inline-flex items-center rounded-[4px] border font-mono font-medium uppercase tracking-[0.14em] leading-none',
    surface,
    sizes[size],
    className,
  )}
>
  {!solid && (
    <span
      aria-hidden="true"
      class={cx('h-1 w-1 rounded-[1px]', accented ? 'bg-accent' : 'bg-ink-faint')}
    ></span>
  )}
  {icon && <Icon name={icon} size={size === 'sm' ? 12 : 13} />}
  <slot />
</span>
