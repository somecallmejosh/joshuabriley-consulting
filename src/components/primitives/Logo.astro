---
import { cx } from '~/lib/cx';

/**
 * Brand lockup — a precise typographic wordmark with a monospace monogram tile.
 * No cursive, no gradient. The monogram reads as a machined index plate; the
 * wordmark is set in the grotesk with tight tracking. Accessible text either way.
 */

interface Props {
  variant?: 'lockup' | 'wordmark' | 'monogram';
  size?: 'sm' | 'md' | 'lg';
  /** Color treatment — paper surfaces vs. ink (dark) surfaces. */
  tone?: 'default' | 'inverse';
  href?: string;
  label?: string;
  class?: string;
}

const {
  variant = 'lockup',
  size = 'md',
  tone = 'default',
  href,
  label = 'Joshua Briley',
  class: className,
} = Astro.props;

const monogramSize: Record<NonNullable<Props['size']>, string> = {
  sm: 'h-6 w-6 text-[10px]',
  md: 'h-7 w-7 text-[11px]',
  lg: 'h-9 w-9 text-sm',
};

const wordmarkSize: Record<NonNullable<Props['size']>, string> = {
  sm: 'text-[0.95rem]',
  md: 'text-base',
  lg: 'text-xl',
};

const monoTone: Record<NonNullable<Props['tone']>, string> = {
  default: 'bg-ink text-paper',
  inverse: 'bg-paper text-ink',
};
const wordmarkTone: Record<NonNullable<Props['tone']>, string> = {
  default: 'text-ink',
  inverse: 'text-paper',
};

const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  aria-label={label}
  role={href ? undefined : 'img'}
  class={cx('group inline-flex items-center gap-2.5', className)}
>
  {variant !== 'wordmark' && (
    <span
      aria-hidden="true"
      class={cx(
        'js-magnetic inline-flex items-center justify-center rounded-[3px] font-mono font-semibold tracking-tight transition-transform duration-300 ease-out group-hover:-translate-y-px',
        monogramSize[size],
        monoTone[tone],
      )}
    >JB</span>
  )}
  {variant !== 'monogram' && (
    <span
      class={cx(
        'font-sans font-semibold leading-none tracking-[-0.02em]',
        wordmarkSize[size],
        wordmarkTone[tone],
      )}
    >Joshua Briley<span class="brand-dot text-accent">.</span></span>
  )}
</Tag>
