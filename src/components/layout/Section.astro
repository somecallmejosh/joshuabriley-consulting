---
import { cx } from '~/lib/cx';

interface Props {
  tone?: 'cream' | 'navy' | 'white' | 'plum' | 'charcoal' | 'peach' | 'paper' | 'ink' | 'raised';
  padding?: 'tight' | 'default' | 'loose';
  id?: string;
  class?: string;
  /** Apply `relative overflow-hidden` so absolutely-positioned blobs clip safely. */
  decorated?: boolean;
}

const {
  tone = 'cream',
  padding = 'default',
  id,
  class: className,
  decorated = false,
} = Astro.props;

const tones: Record<NonNullable<Props['tone']>, string> = {
  cream: 'bg-paper text-ink',
  paper: 'bg-paper text-ink',
  navy: 'bg-ink text-paper',
  ink: 'bg-ink text-paper',
  white: 'bg-raised text-ink',
  raised: 'bg-raised text-ink',
  plum: 'bg-ink text-paper',
  charcoal: 'bg-ink text-paper',
  peach: 'bg-[#EFEDE6] text-ink',
};

const paddings: Record<NonNullable<Props['padding']>, string> = {
  tight: 'py-14 md:py-20',
  default: 'py-20 md:py-28',
  loose: 'py-24 md:py-36',
};
---

<section
  id={id}
  data-source={`Section · tone=${tone} · padding=${padding}${decorated ? ' · decorated' : ''}`}
  class={cx(
    tones[tone],
    paddings[padding],
    decorated && 'relative overflow-hidden',
    className,
  )}
>
  <slot />
</section>
