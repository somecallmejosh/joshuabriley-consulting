---
import { cx } from '~/lib/cx';

/**
 * ToolGlyph — the small technical diagram that stands in for a tool.
 *
 * One mark per tool, keyed to the island the tool runs (`tool` in the content
 * schema), so the home band, the /tools/ index and the tool's own page all
 * render the same drawing from one source. Each glyph draws the tool's
 * *mechanism*, not a category icon: the graded pentagon, the scraps summing to
 * a total, one primitive propagating, findings ranked by severity. That is why
 * these are hand-authored rather than pulled from Phosphor — no icon set has a
 * glyph for "a token change lands in every component at once".
 *
 * Colour contract: structure is drawn in `currentColor` at low opacity and the
 * one load-bearing element in `var(--accent)`. Both are surface-aware (see the
 * accent block in site.css), so the same markup reads correctly on paper and on
 * ink without a variant prop.
 *
 * Decorative by contract: every placement sits next to the tool's title, so the
 * glyph is aria-hidden and adds nothing for AT to read twice.
 */

type GlyphName = 'ScorecardEngine' | 'RoiCalculator' | 'TokenPlayground' | 'Diagnostic';

interface Props {
  /** Which island the tool runs. Matches `tool` in the tools collection. */
  tool: GlyphName;
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  class?: string;
}

const { tool, size = 'md', class: className } = Astro.props;

// Fixed 3:2 viewBox, so width alone sets the footprint and the four marks stay
// optically the same weight next to each other in a grid. Pass the base colour
// at full strength (`text-ink` / `text-paper`) and let the drawing's own
// opacity ramp do the work — dimming currentColor as well washes the structure
// out, badly on ink.
const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'w-[72px]',
  md: 'w-24',
  lg: 'w-36',
  xl: 'w-44',
  // Hero scale. Held back on small screens, where it stacks above the headline.
  '2xl': 'w-48 lg:w-64',
};
---

<svg
  viewBox="0 0 96 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={cx('tool-glyph h-auto', sizes[size], className)}
>
  {tool === 'ScorecardEngine' && (
    /* Five subjects, graded. The outer ring is a perfect score, the filled
       shape is a real one, and the accent dot marks the weakest subject —
       which is the whole output of the assessment. */
    <g>
      <polygon
        points="48,3 75.6,23 65,55.5 31,55.5 20.4,23"
        stroke="currentColor"
        stroke-opacity="0.3"
        stroke-width="1.25"
        stroke-linejoin="round"
      />
      <g stroke="currentColor" stroke-opacity="0.18" stroke-width="1">
        <line x1="48" y1="32" x2="48" y2="3" />
        <line x1="48" y1="32" x2="75.6" y2="23" />
        <line x1="48" y1="32" x2="65" y2="55.5" />
        <line x1="48" y1="32" x2="31" y2="55.5" />
        <line x1="48" y1="32" x2="20.4" y2="23" />
      </g>
      <polygon
        points="48,8.2 63.2,27.1 63.3,53.1 41.2,41.4 28.7,25.7"
        fill="var(--accent)"
        fill-opacity="0.16"
        stroke="var(--accent)"
        stroke-width="1.5"
        stroke-linejoin="round"
        data-glyph-accent
      />
      <circle cx="41.2" cy="41.4" r="2.6" fill="var(--accent)" />
    </g>
  )}

  {tool === 'RoiCalculator' && (
    /* The scraps of drift nobody bothers to log, and the single figure they add
       up to once you do. The size gap between them is the argument. */
    <g>
      <line x1="8" y1="54.5" x2="88" y2="54.5" stroke="currentColor" stroke-opacity="0.28" stroke-width="1" />
      <g fill="currentColor" fill-opacity="0.5">
        <rect x="8" y="50" width="5" height="4" rx="1" />
        <rect x="17" y="46" width="5" height="8" rx="1" />
        <rect x="26" y="49" width="5" height="5" rx="1" />
        <rect x="35" y="43" width="5" height="11" rx="1" />
        <rect x="44" y="47" width="5" height="7" rx="1" />
      </g>
      <rect
        x="62"
        y="16"
        width="20"
        height="38"
        rx="1.5"
        fill="var(--accent)"
        fill-opacity="0.16"
        stroke="var(--accent)"
        stroke-width="1.5"
        data-glyph-accent
      />
    </g>
  )}

  {tool === 'TokenPlayground' && (
    /* One primitive, an intent layer, and the components that inherit it. Edges
       stop short of every node so the drawing needs no opaque fill and can sit
       on either surface. */
    <g>
      <g stroke="var(--accent)" stroke-opacity="0.45" stroke-width="1.25" stroke-linecap="round">
        <line x1="17.7" y1="30.3" x2="43.3" y2="20.7" />
        <line x1="17.7" y1="33.7" x2="43.3" y2="43.3" />
        <line x1="52.9" y1="17.9" x2="76.7" y2="12.4" />
        <line x1="52.9" y1="19.9" x2="76.6" y2="24.0" />
        <line x1="52.9" y1="44.1" x2="76.6" y2="40.0" />
        <line x1="52.9" y1="46.1" x2="76.7" y2="51.6" />
      </g>
      <g fill="var(--accent)" fill-opacity="0.16" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.25">
        <rect x="79" y="7.5" width="7" height="7" rx="1" />
        <rect x="79" y="21.5" width="7" height="7" rx="1" />
        <rect x="79" y="35.5" width="7" height="7" rx="1" />
        <rect x="79" y="49.5" width="7" height="7" rx="1" />
      </g>
      <g stroke="var(--accent)" stroke-width="1.5">
        <circle cx="48" cy="19" r="3.5" />
        <circle cx="48" cy="45" r="3.5" />
      </g>
      <circle cx="13" cy="32" r="4.5" fill="var(--accent)" data-glyph-accent />
    </g>
  )}

  {tool === 'Diagnostic' && (
    /* Findings sorted by severity, each with a remediation attached under it.
       Line length falls with severity, which is how the report reads. */
    <g>
      <g stroke-linecap="round">
        <rect x="8" y="11" width="6" height="6" rx="1" fill="var(--accent)" data-glyph-accent />
        <line x1="21" y1="14" x2="88" y2="14" stroke="currentColor" stroke-opacity="0.55" stroke-width="2" />
        <line x1="21" y1="21" x2="60" y2="21" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" />

        <rect x="8" y="29" width="6" height="6" rx="1" fill="currentColor" fill-opacity="0.45" />
        <line x1="21" y1="32" x2="72" y2="32" stroke="currentColor" stroke-opacity="0.38" stroke-width="2" />
        <line x1="21" y1="39" x2="50" y2="39" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" />

        <rect x="8" y="47" width="6" height="6" rx="1" fill="currentColor" fill-opacity="0.25" />
        <line x1="21" y1="50" x2="56" y2="50" stroke="currentColor" stroke-opacity="0.22" stroke-width="2" />
        <line x1="21" y1="57" x2="42" y2="57" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" />
      </g>
    </g>
  )}
</svg>

<style is:global>
  /* One motion beat, and it has a job: hovering anywhere on a tool cell swells
     the accent element, which is the part of the diagram the tool is about.
     `fill-box` keeps the origin on the shape rather than the whole viewBox, so
     the polygon and the column both grow from their own centre. The global
     prefers-reduced-motion block in site.css collapses the transition. */
  .tool-glyph [data-glyph-accent] {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.45s var(--ease-out);
  }
  .group:hover .tool-glyph [data-glyph-accent] {
    transform: scale(1.07);
  }
</style>
