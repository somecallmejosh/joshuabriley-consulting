---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * Native <details>/<summary> accordion. Zero JS — works with keyboard, screen
 * readers, and progressive enhancement out of the box. Recomposed as a clean
 * hairline-divided editorial row.
 */

interface Props {
  question: string;
  /** Pre-open the item (e.g. for the first FAQ). */
  open?: boolean;
  class?: string;
}

const { question, open = false, class: className } = Astro.props;
---

<details class={cx('faq-item group', className)} open={open}>
  <summary
    class="flex items-start gap-4 py-5 cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
  >
    <span class="flex-1 font-display text-[1.05rem] font-medium tracking-tight text-ink leading-snug">{question}</span>
    <Icon
      name="ph:caret-down"
      size={18}
      class="flex-shrink-0 mt-1 text-ink-muted transition-transform duration-300 ease-out group-open:rotate-180"
    />
  </summary>
  <div class="pb-6 pr-8 text-ink-muted leading-relaxed">
    <slot />
  </div>
</details>
