---
import { cx } from '~/lib/cx';

/**
 * Technical-proof register — chrome that frames a digital artifact.
 *
 * Wrap a Storybook screenshot, a docs page, a component preview (`browser`), or
 * a terminal session / test run (`terminal`). It signals "this is real software"
 * the way the warm cards signal "this is crafted by a person".
 *
 * Body content is supplied via the default slot, so it composes with anything —
 * an <img>, a live component, or preformatted command output.
 */

interface Props {
  variant?: 'browser' | 'terminal' | 'window';
  /** URL for `browser`, prompt/title for `terminal` + `window`. */
  title?: string;
  class?: string;
  /** Tailwind classes for the body wrapper (padding, background). */
  bodyClass?: string;
}

const { variant = 'browser', title, class: className, bodyClass } = Astro.props;

const isDark = variant === 'terminal';
---

<div
  class={cx(
    'rounded-2xl overflow-hidden border shadow-[0_18px_40px_-24px_rgba(45,43,85,0.45)]',
    isDark ? 'border-charcoal/15 bg-navy' : 'border-charcoal/15 bg-white',
    className,
  )}
>
  <div
    class={cx(
      'flex items-center gap-3 px-4 py-2.5 border-b',
      isDark ? 'border-white/10 bg-white/[0.04]' : 'border-charcoal/10 bg-charcoal/[0.03]',
    )}
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class={cx('w-2.5 h-2.5 rounded-full', isDark ? 'bg-white/25' : 'bg-coral/70')}></span>
      <span class={cx('w-2.5 h-2.5 rounded-full', isDark ? 'bg-white/25' : 'bg-lemon')}></span>
      <span class={cx('w-2.5 h-2.5 rounded-full', isDark ? 'bg-white/25' : 'bg-sage/80')}></span>
    </span>

    {variant === 'browser' && (
      <span
        class="ml-1 flex-1 inline-flex items-center gap-1.5 font-mono text-[0.7rem] text-charcoal/70 bg-white border border-charcoal/10 rounded-md px-2.5 py-1 truncate"
      >
        <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="flex-shrink-0">
          <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3" />
          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.3" />
        </svg>
        <span class="truncate">{title}</span>
      </span>
    )}

    {variant !== 'browser' && title && (
      <span class={cx('font-mono text-xs truncate', isDark ? 'text-white/80' : 'text-charcoal/70')}>
        {title}
      </span>
    )}
  </div>

  <div class={cx(bodyClass ?? (isDark ? 'p-4 md:p-5' : 'p-0'))}>
    <slot />
  </div>
</div>
