---
import { Image, getImage } from 'astro:assets';
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';
import type { ImageMetadata } from 'astro';

/**
 * FidelityPlate — one screen shown across the three artifacts it passed through:
 * a crude sketch, a clean wireframe, and that same wireframe with the design
 * reasoning written onto it. Same mounted-specimen language as ScrollShot
 * (hairline paper mount, plate index, mono spec rail), with a tab rail that
 * swaps which artifact is on the stage.
 *
 * Two deliberate mechanics:
 *
 * 1. All three stages are pre-rendered into the DOM and toggled with [hidden].
 *    Nothing is injected at runtime, so Astro's scoped styles apply and the
 *    plate still reads (stuck on Annotated) with JS off.
 * 2. The stage is a fixed-height scroll window, not an aspect box. The three
 *    artifacts have genuinely different aspect ratios (the annotated render
 *    carries an extra callout gutter, so it is wider than the bare wireframe),
 *    and a height-following stage would jump the page on every toggle. Fixed
 *    height + internal scroll keeps the layout still and keeps full-page
 *    artwork legible at full column width.
 */

type Stage = 'sketch' | 'wire' | 'annotated';

interface Props {
  /** Plate index, e.g. "04". */
  index: string;
  /** Screen name, e.g. "New shipment". */
  title: string;
  /** Note under the spec rail. */
  caption?: string;
  /** Crude-sketch SVG (public URL). */
  sketch: string;
  /** Clean-wireframe SVG (public URL). */
  wire: string;
  /** Annotated wireframe render, imported so Astro can optimize it. */
  annotated: ImageMetadata;
  /** Real description of the annotated wireframe, for screen readers. */
  annotatedAlt: string;
  /** Max visible height of the scroll stage. */
  maxH?: string;
  class?: string;
}

const {
  index,
  title,
  caption,
  sketch,
  wire,
  annotated,
  annotatedAlt,
  maxH = '660px',
  class: className,
} = Astro.props;

const stages: { id: Stage; label: string; note: string }[] = [
  { id: 'sketch', label: 'Sketch', note: 'Crude sketch' },
  { id: 'wire', label: 'Wireframe', note: 'Clean wireframe' },
  { id: 'annotated', label: 'Annotated', note: 'Wireframe + reasoning' },
];

// Annotated is the default: it is the artifact carrying the actual decisions,
// and the rail reads right-to-left as "here is the thinking, rewind to see
// where it started".
const initial: Stage = 'annotated';
const uid = `plate-${index}`;

// A large raster for the zoom viewer — the inline stage tops out around the
// reading column, which is far too narrow for a 3200px annotated sheet. 2000px
// is plenty legible at actual-pixel zoom without shipping the full original.
const zoom = await getImage({ src: annotated, width: 2000, format: 'webp' });
const zoomLabel = `Plate ${index} · ${title}`;
---

<figure class={cx('fplate', className)} data-fidelity-plate>
  <p class="fplate-index">Plate <span aria-hidden="true">/</span> {index}</p>

  <div class="fplate-mount">
    <div class="fplate-rail" role="tablist" aria-label={`${title}: design stage`}>
      {stages.map((s) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-tab-${s.id}`}
          class="fplate-tab"
          data-stage={s.id}
          aria-controls={`${uid}-panel-${s.id}`}
          aria-selected={s.id === initial ? 'true' : 'false'}
          tabindex={s.id === initial ? 0 : -1}
        >{s.label}</button>
      ))}
    </div>

    <div class="fplate-window" data-stage={initial}>
      {stages.map((s) => (
        <div
          role="tabpanel"
          id={`${uid}-panel-${s.id}`}
          aria-labelledby={`${uid}-tab-${s.id}`}
          class="fplate-stage"
          data-panel={s.id}
          style={`max-height:${maxH}`}
          tabindex="0"
          hidden={s.id !== initial}
        >
          {s.id === 'annotated' ? (
            <Image
              src={annotated}
              alt={annotatedAlt}
              {/* Explicit width caps the non-srcset fallback: without it the
                  `src` resolves to the 3200px original. */}
              width={1440}
              widths={[720, 1080, 1440]}
              sizes="(min-width: 1024px) 720px, 100vw"
              format="webp"
              loading="lazy"
              decoding="async"
              data-zoom-src={zoom.src}
              data-zoom-alt={annotatedAlt}
              data-zoom-label={zoomLabel}
            />
          ) : (
            <img
              src={s.id === 'sketch' ? sketch : wire}
              alt={`${title}, ${
                s.id === 'sketch'
                  ? 'rough hand-drawn concept sketch'
                  : 'clean wireframe without annotations'
              }.`}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      ))}

      <span class="fplate-fade" aria-hidden="true"></span>
      <span class="fplate-cue" aria-hidden="true">
        scroll <Icon name="ph:arrows-down-up" size={12} />
      </span>
      <button
        type="button"
        class="fplate-zoom"
        data-zoom-src={zoom.src}
        data-zoom-alt={annotatedAlt}
        data-zoom-label={zoomLabel}
      >
        <Icon name="ph:arrows-out" size={13} /> Enlarge
      </button>
    </div>
  </div>

  <figcaption class="fplate-cap">
    <div class="fplate-spec">
      <span class="fplate-kind" data-stage-note>{stages.find((s) => s.id === initial)!.note}</span>
      <span class="fplate-name">{index} <span aria-hidden="true">/</span> {title}</span>
    </div>
    {caption && <p class="fplate-note">{caption}</p>}
  </figcaption>
</figure>

<style>
  .fplate { margin: 0; }

  .fplate-index {
    margin: 0 0 0.75rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
  }
  .fplate-index span { margin: 0 0.35em; opacity: 0.6; }

  .fplate-mount {
    padding: 8px;
    border-radius: 16px;
    background: var(--raised);
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgba(27, 26, 23, 0.04),
      0 18px 50px -28px rgba(27, 26, 23, 0.3);
  }

  /* Stage rail — reads left to right as fidelity climbs. */
  .fplate-rail {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem 0.25rem 0.6rem;
  }

  .fplate-tab {
    padding: 0.38rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    cursor: pointer;
    transition:
      color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }
  .fplate-tab:hover { color: var(--ink); }
  .fplate-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .fplate-tab[aria-selected='true'] {
    color: var(--ink);
    background: var(--paper);
    border-color: var(--line);
  }

  .fplate-window {
    position: relative;
    /* The artwork is fixed light-on-white line work, so the stage stays a
       lightbox in either theme rather than inverting underneath the drawing. */
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 9px;
  }

  .fplate-stage {
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    border-radius: 9px;
    scrollbar-width: thin;
  }
  .fplate-stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .fplate-stage :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  /* The annotated sheet is the one worth opening; cue it as zoomable. */
  .fplate-window[data-stage='annotated'] .fplate-stage :global(img) {
    cursor: zoom-in;
  }

  /* Enlarge — only meaningful on the annotated stage (the sketch and wireframe
     are low-detail SVG that already read as previews). */
  .fplate-zoom {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.34rem 0.65rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .fplate-zoom:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .fplate-zoom:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .fplate-window:not([data-stage='annotated']) .fplate-zoom { display: none; }

  /* The fade and the cue are claims that there is more artwork below. They only
     render when that is actually true: some stages fit the window outright, and
     a scroll cue on a fully-visible plate is just a lie. */
  .fplate-fade,
  .fplate-cue {
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
  }
  .fplate-window[data-overflow='true'] .fplate-fade,
  .fplate-window[data-overflow='true'] .fplate-cue {
    opacity: 1;
  }

  .fplate-fade {
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 1px;
    height: 64px;
    border-radius: 0 0 9px 9px;
    background: linear-gradient(to bottom, transparent, #ffffff);
    pointer-events: none;
  }

  .fplate-cue {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    pointer-events: none;
  }

  .fplate-cap { margin-top: 0.85rem; }
  .fplate-spec {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .fplate-kind {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .fplate-name { color: var(--ink-muted); }
  .fplate-name span { margin: 0 0.3em; opacity: 0.5; }

  .fplate-note {
    margin: 0.85rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>

<script>
  const NOTES: Record<string, string> = {
    sketch: 'Crude sketch',
    wire: 'Clean wireframe',
    annotated: 'Wireframe + reasoning',
  };

  document.querySelectorAll<HTMLElement>('[data-fidelity-plate]').forEach((plate) => {
    const tabs = [...plate.querySelectorAll<HTMLButtonElement>('.fplate-tab')];
    const panels = [...plate.querySelectorAll<HTMLElement>('[data-panel]')];
    const note = plate.querySelector<HTMLElement>('[data-stage-note]');
    const win = plate.querySelector<HTMLElement>('.fplate-window');

    // Only advertise scrolling when the visible stage genuinely overflows.
    const syncCue = () => {
      const open = panels.find((p) => !p.hidden);
      if (!win || !open) return;
      win.dataset.overflow = String(open.scrollHeight > open.clientHeight + 4);
    };

    const select = (stage: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.stage === stage;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== stage;
      });
      if (win) win.dataset.stage = stage;
      if (note && NOTES[stage]) note.textContent = NOTES[stage];
      syncCue();
    };

    // Artwork is lazy-loaded, so the first correct measurement is on load.
    plate.querySelectorAll('img').forEach((img) => {
      if (img.complete) syncCue();
      else img.addEventListener('load', syncCue, { once: true });
    });
    new ResizeObserver(syncCue).observe(plate);
    syncCue();

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.stage!));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        select(tabs[(i + dir + tabs.length) % tabs.length].dataset.stage!, true);
      });
    });
  });
</script>
