---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * LiveEmbed — a poster screenshot in the editorial browser-frame, that swaps to
 * a real interactive <iframe> on demand. The iframe is pre-rendered with NO src
 * (zero network until clicked) so it loads lazily AND keeps Astro's scoped
 * styles — runtime-injected nodes would miss them. Click "Load live demo" and
 * the poster fades out, the live story fades in.
 */

interface Props {
  /** Poster screenshot, root-relative. */
  posterSrc: string;
  posterAlt: string;
  /** The iframe (story canvas) URL — loaded only on activation. */
  embedSrc: string;
  /** Full URL for the "open" affordance (opens in a new tab). */
  href: string;
  /** Short title shown in the frame bar + used for the iframe a11y title. */
  title: string;
  /** CSS aspect-ratio for the stage, matching the poster. */
  ratio?: string;
  /** Small caps note under the load pill, e.g. "the real Storybook story". */
  ctaNote?: string;
  class?: string;
}

const {
  posterSrc,
  posterAlt,
  embedSrc,
  href,
  title,
  ratio = '1600 / 1039',
  ctaNote = 'the real Storybook story',
  class: className,
} = Astro.props;
---

<figure class={cx('live-embed', className)} data-live-embed data-view="desktop">
  <div class="live-embed-bar">
    <span class="live-embed-dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="live-embed-title">{title}: interactive</span>

    {/* Viewport switch — desktop default, mobile on demand. Hidden below md
        (Section 4: on a real phone the frame is already the mobile rendering). */}
    <div class="live-embed-views" role="group" aria-label="Preview size">
      <button type="button" class="live-embed-view" data-view-btn="desktop" aria-pressed="true">
        <Icon name="ph:monitor" size={13} /><span>Desktop</span>
      </button>
      <button type="button" class="live-embed-view" data-view-btn="mobile" aria-pressed="false">
        <Icon name="ph:device-mobile" size={13} /><span>Mobile</span>
      </button>
    </div>

    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="live-embed-open"
      aria-label={`Open ${title} (new tab)`}
    >open <Icon name="ph:arrow-up-right" size={12} /></a>
  </div>

  <div class="live-embed-stage" style={`--ratio:${ratio}`}>
    <div class="live-embed-viewport">
      <img class="live-embed-poster" src={posterSrc} alt={posterAlt} loading="lazy" decoding="async" />

      <button type="button" class="live-embed-cta" data-embed-trigger aria-label={`Load the interactive ${title} demo`}>
        <span class="live-embed-cta-pill">
          <Icon name="ph:play-fill" size={15} />
          Load live demo
        </span>
        <span class="live-embed-cta-note">{ctaNote}</span>
      </button>

      {/* Pre-rendered, src-less: no network until activated; scoped styles apply. */}
      <iframe
        class="live-embed-iframe"
        data-embed-frame
        data-src={embedSrc}
        title={`${title}: live interactive demo`}
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
        allow="fullscreen"
      ></iframe>
    </div>
  </div>
</figure>

<style>
  .live-embed { margin: 0; }

  .live-embed-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.95rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
  }
  .live-embed-dots { display: inline-flex; gap: 6px; }
  .live-embed-dots span {
    width: 8px; height: 8px; border-radius: 50%;
    border: 1px solid var(--line-strong);
  }
  .live-embed-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .live-embed-open {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    transition: color 0.2s var(--ease-out);
  }
  .live-embed-open:hover { color: var(--accent); }

  /* Viewport switch — a small mono-caps segmented control. Hidden below md. */
  .live-embed-views { display: none; }
  @media (min-width: 768px) {
    .live-embed-views {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      padding: 2px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--raised);
    }
  }
  .live-embed-view {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    transition: color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }
  .live-embed-view:hover { color: var(--ink); }
  .live-embed-view[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .live-embed-stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0 0 16px 16px;
    background: var(--raised);
    box-shadow:
      0 1px 2px rgba(27, 26, 23, 0.04),
      0 18px 50px -28px rgba(27, 26, 23, 0.3);
    aspect-ratio: var(--ratio, 1600 / 1039);
  }

  .live-embed-viewport {
    position: absolute;
    inset: 0;
  }

  .live-embed-poster,
  .live-embed-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .live-embed-poster {
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.5s var(--ease-out), filter 0.4s var(--ease-out);
  }
  .live-embed-iframe {
    border: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease-out);
  }

  /* Load affordance — a dark pill centered over a faint scrim. */
  .live-embed-cta {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    cursor: pointer;
    border: 0;
    background: radial-gradient(60% 60% at 50% 50%, rgba(27, 26, 23, 0.06), rgba(27, 26, 23, 0.02));
    transition: background 0.4s var(--ease-out);
  }
  .live-embed-cta:hover { background: radial-gradient(60% 60% at 50% 50%, rgba(27, 26, 23, 0.12), rgba(27, 26, 23, 0.04)); }

  .live-embed-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-hanken), system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 10px 30px -12px rgba(27, 26, 23, 0.5);
    transition: transform 0.35s var(--ease-out);
  }
  .live-embed-cta:hover .live-embed-cta-pill { transform: translateY(-2px) scale(1.02); }
  .live-embed-cta:active .live-embed-cta-pill { transform: scale(0.97); }
  .live-embed-cta-note {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-muted);
  }

  /* Activated: poster + CTA bow out, live story fades in. */
  .live-embed[data-loaded] .live-embed-poster { opacity: 0; pointer-events: none; }
  .live-embed[data-loaded] .live-embed-cta { display: none; }
  .live-embed[data-loaded] .live-embed-iframe { opacity: 1; pointer-events: auto; }

  /* Mobile preview — the stage becomes a device backdrop holding a centered
     phone. The iframe renders at ~phone width, so the live site shows its own
     mobile layout. Instant switch (no size tween) to avoid iframe reflow jank. */
  .live-embed[data-view='mobile'] .live-embed-stage {
    aspect-ratio: auto;
    height: clamp(560px, 78vh, 760px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.75rem 1rem;
    background:
      radial-gradient(120% 120% at 50% 0%, rgba(27, 26, 23, 0.05), transparent 60%),
      var(--raised);
  }
  .live-embed[data-view='mobile'] .live-embed-viewport {
    position: relative;
    inset: auto;
    height: 100%;
    aspect-ratio: 390 / 760;
    max-width: 100%;
    border-radius: 30px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 22px 60px -24px rgba(27, 26, 23, 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .live-embed-poster, .live-embed-iframe, .live-embed-cta-pill { transition: none; }
  }
</style>

<script>
  // Activate on click: set the iframe's real src (it was rendered src-less, so
  // nothing loaded until now), then flag the figure so CSS swaps poster → frame.
  document.querySelectorAll('[data-embed-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = btn.closest('[data-live-embed]') as HTMLElement | null;
      const frame = root?.querySelector('[data-embed-frame]') as HTMLIFrameElement | null;
      if (!root || !frame || root.dataset.loaded) return;
      if (frame.dataset.src) frame.src = frame.dataset.src;
      root.dataset.loaded = 'true';
    });
  });

  // Viewport switch: flip the figure's data-view (CSS reflows the frame). No
  // network — an already-loaded iframe just re-renders at the new width.
  document.querySelectorAll('[data-live-embed]').forEach((root) => {
    const host = root as HTMLElement;
    const btns = host.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        host.dataset.view = btn.dataset.viewBtn ?? 'desktop';
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      });
    });
  });
</script>
