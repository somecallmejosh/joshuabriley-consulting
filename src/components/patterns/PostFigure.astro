---
import { cx } from '~/lib/cx';
import type { FigureName } from '~/lib/figures';

/**
 * PostFigure — the technical drawing that stands in for an essay.
 *
 * Third member of the same family as ToolGlyph and PrincipleGlyph, and bound by
 * the same contract: structure in `currentColor` at low opacity, the one
 * load-bearing element in `var(--accent)`. Both are surface-aware (see the
 * accent block in site.css), so the same markup reads on paper and on ink
 * without a variant prop. What changes here is scale — a 240x160 viewBox rather
 * than 96x64, because a figure that runs 400-670px wide can carry structure a
 * 96px glyph cannot.
 *
 * The rule the glyphs set holds: each drawing is the essay's *argument*, not a
 * category icon. `drift` is one approved button and the six that shipped
 * instead. `trust-gap` is the essay's own two cited curves and the space
 * between them, which is where it says the role is being redefined. A stock
 * photograph of a laptop would say nothing any of these say.
 *
 * Two variants, and they differ in *detail*, not just size:
 *
 *   mark     — geometry only, no annotations, `aria-hidden`. Used on /blog/,
 *              where the essay title sits directly beside it and repeating the
 *              argument in 10px mono would be noise. Every drawing is built so
 *              its claim survives without a single character of text: the drift
 *              is visible as drift, the aligned column is visibly aligned.
 *   diagram  — the same geometry plus its Geist Mono annotations, wrapped in a
 *              <figure> with a real caption. Used once, at the head of the
 *              essay, where the reader has committed to reading.
 *
 * No hover motion. The index cells are already links carrying three hover beats
 * (background, title colour, arrow), and a fourth on the artwork would be
 * motion for its own sake.
 *
 * Width is the caller's job — pass it through `class`. The viewBox is fixed 3:2,
 * so width alone sets the footprint and every figure keeps the same optical
 * weight next to the others.
 *
 * TWO RULES EVERY DRAWING HERE HAS TO KEEP, and both are easy to break:
 *
 * 1. The drawing fills the viewBox. Ink touches all four edges (inset only by
 *    half a stroke width, so nothing is clipped). These sit in a grid of index
 *    cells and in a column above running prose; a figure carrying its own
 *    internal margin does not line up with the one beside it or with the text
 *    below it, and the whole grid reads as badly set. An earlier pass reserved
 *    a 40-unit left gutter on some figures for row labels and none on others,
 *    which is exactly the failure.
 * 2. Annotations live INSIDE the geometry's footprint, never in a margin around
 *    it. `mark` omits every label, so a label sitting outside the geometry
 *    would make the two variants bound differently and frame inconsistently at
 *    the same CSS width. Where a drawing needs a label gutter, the geometry has
 *    to reach the edge anyway: `namespace` runs its divider the full height,
 *    `trust-gap` uses the 0% and 100% rules as the frame.
 */

interface Props {
  name: FigureName;
  /** `mark` = decorative geometry. `diagram` = annotated + captioned content. */
  variant?: 'mark' | 'diagram';
  class?: string;
}

const { name, variant = 'mark', class: className } = Astro.props;
const annotated = variant === 'diagram';

/**
 * Accessible name and caption for the annotated variant. The caption states
 * what the drawing shows rather than restating the title, so it earns its line
 * under the figure; the label is the short form for assistive tech.
 */
const COPY: Record<FigureName, { label: string; caption: string }> = {
  drift: {
    label:
      'Diagram: one approved button branching into six divergent copies in production.',
    caption:
      'One approved button, six in production. Every divergence was reasonable on the day it was made, which is exactly why none of them belongs to anybody now.',
  },
  namespace: {
    label:
      'Diagram: an imported component renamed at each layer, beside a custom element whose tag name is identical at every layer.',
    caption:
      'An imported component arrives under a different name at every layer, so its identity has to be inferred. A custom element carries the same tag name in source, in server-rendered HTML, and in the live DOM, so it can simply be counted.',
  },
  ownership: {
    label:
      'Diagram: three eras of component libraries with the ownership boundary moving downward through them.',
    caption:
      'Three eras of the component library, and the ownership boundary migrating down through them: from code you install, to code you own.',
  },
  'trust-gap': {
    label:
      'Chart: AI tool adoption rising from 62 to 84 percent while trust falls from 40 to 29 percent, with the widening gap between the two curves.',
    caption:
      'Adoption of AI coding tools rose from 62% to 84% between 2023 and 2025 while trust in them fell from 40% to 29%. The role is being redefined inside that gap.',
  },
  'reading-list': {
    label:
      'Diagram: a shelf of resources with three lifted clear of the rest.',
    caption:
      'A shelf of things worth reading, and the only instruction that matters: take the two or three that map to whatever you are weakest at right now. Nobody finishes the shelf.',
  },
  'shared-floor': {
    label:
      'Diagram: three columns for native browser APIs, Lit and Stencil, each divided into the same six jobs, filled differently to show what the toolchain supplies and what the team builds, all standing on one continuous band of packaging, forms, server-rendering and release work.',
    caption:
      'The same six jobs in every column, from element definition at the top down to component metadata. Solid is supplied, dashed is generated and still yours to support, hollow is yours to build. The band underneath is identical whichever column you pick, and it is where the years go.',
  },
  altitude: {
    label:
      'Diagram: four stacked layers — component, API, platform and organization — crossed by three windows two layers tall, stepping upward and to the right for Senior, Staff and Principal scope, with the Staff window highlighted.',
    caption:
      'Four layers, and three windows two layers tall. Senior spans the component and its API, Staff the API and the platform, Principal the platform and the organization. The window never gets taller. It moves, which is why Staff is not Senior with more scope but Senior aimed one layer up.',
  },
};

const { label, caption } = COPY[name];
---

<figure class={cx('post-figure', className)}>
  <svg
    viewBox="0 0 240 160"
    fill="none"
    focusable="false"
    class="post-figure__svg"
    role={annotated ? 'img' : undefined}
    aria-label={annotated ? label : undefined}
    aria-hidden={annotated ? undefined : 'true'}
  >
    {name === 'drift' && (
      /* One approved component on the left, six that shipped stacked down the
         right, fanning out from it. The copies differ in radius, height, width
         and stroke weight — each one a defensible local decision — and the fan
         lines are the faintest thing in the drawing, because ownership is what
         actually thins out on the way across.

         Laid out on its side rather than as a top-down tree: stacking the six
         down the right edge is what lets the drawing touch all four sides, and
         it leaves the whole left column clear for the two annotations. */
      <g>
        {annotated && (
          <text x="4" y="57" class="pf-label pf-label--accent">ONE APPROVED</text>
        )}

        <rect
          x="0.7"
          y="64"
          width="66"
          height="32"
          rx="4"
          fill="var(--accent)"
          fill-opacity="0.14"
          stroke="var(--accent)"
          stroke-width="1.4"
        />

        <g stroke="currentColor" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round">
          <path d="M67 80 L163.3 12.7" />
          <path d="M67 80 L147.3 41" />
          <path d="M67 80 L171.3 68.8" />
          <path d="M67 80 L153.3 96.5" />
          <path d="M67 80 L167.3 124.3" />
          <path d="M67 80 L141.3 149.4" />
        </g>

        <g fill="none">
          <rect x="163.3" y="0.7" width="76" height="24" rx="2" stroke="currentColor" stroke-opacity="0.54" stroke-width="1.2" />
          <rect x="147.3" y="28.5" width="92" height="25" rx="6" stroke="currentColor" stroke-opacity="0.48" stroke-width="1" />
          <rect x="171.3" y="57.3" width="68" height="23" rx="1" stroke="currentColor" stroke-opacity="0.56" stroke-width="1.4" />
          <rect x="153.3" y="84" width="86" height="25" rx="9" stroke="currentColor" stroke-opacity="0.47" stroke-width="1" />
          <rect x="167.3" y="112.8" width="72" height="23" rx="3.5" stroke="currentColor" stroke-opacity="0.53" stroke-width="1.2" />
          <rect x="141.3" y="139.5" width="98" height="19.8" rx="7" stroke="currentColor" stroke-opacity="0.5" stroke-width="1" />
        </g>

        {annotated && (
          <text x="70" y="157" class="pf-label">SIX IN PRODUCTION</text>
        )}
      </g>
    )}

    {name === 'namespace' && (
      /* The essay's comparison, drawn. Left: a component whose name changes at
         every layer, joined by a kinked dashed path, which is the module graph a
         scanner has to walk before it can even guess. Right: the same three
         layers, one tag name, one straight accent spine. The right column is
         deliberately the only aligned thing in the drawing.

         The divider runs the full height rather than stopping short, so the
         geometry reaches the top and bottom edges without the annotations
         having to; the layer labels sit above their own boxes instead of in a
         left gutter, so the drawing frames identically in both variants. */
      <g>
        <line x1="113" y1="0" x2="113" y2="160" stroke="currentColor" stroke-opacity="0.14" stroke-width="1" />

        <g fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.2">
          <rect x="0.7" y="20" width="62" height="24" rx="2" />
          <rect x="16" y="76" width="84" height="24" rx="2" />
          <rect x="6" y="132" width="46" height="24" rx="2" />
        </g>
        <g
          fill="none"
          stroke="currentColor"
          stroke-opacity="0.42"
          stroke-width="1"
          stroke-dasharray="2 2.5"
        >
          <path d="M31 44 V60 H58 V76" />
          <path d="M58 100 V116 H29 V132" />
        </g>

        <g stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round">
          <path d="M183 44 V76" />
          <path d="M183 100 V132" />
        </g>
        <g fill="var(--accent)" fill-opacity="0.12" stroke="var(--accent)" stroke-width="1.3">
          <rect x="127" y="20" width="112" height="24" rx="2" />
          <rect x="127" y="76" width="112" height="24" rx="2" />
          <rect x="127" y="132" width="112" height="24" rx="2" />
        </g>

        {annotated && (
          <>
            <text x="4" y="17" class="pf-label">SOURCE</text>
            <text x="16" y="73" class="pf-label">SSR</text>
            <text x="6" y="129" class="pf-label">DOM</text>
            <text x="31.7" y="34" text-anchor="middle" class="pf-name">Button</text>
            <text x="58" y="90" text-anchor="middle" class="pf-name">PrimaryButton</text>
            <text x="29" y="146" text-anchor="middle" class="pf-name">Btn</text>
            <text x="183" y="34" text-anchor="middle" class="pf-name pf-name--accent">rudi-button</text>
            <text x="183" y="90" text-anchor="middle" class="pf-name pf-name--accent">rudi-button</text>
            <text x="183" y="146" text-anchor="middle" class="pf-name pf-name--accent">rudi-button</text>
          </>
        )}
      </g>
    )}

    {name === 'ownership' && (
      /* Three eras as three bands, each running the full width. The filled
         portion is the part somebody else owns; the accent rule is the
         ownership boundary, and it climbs band by band until almost the whole
         surface is yours. The essay's claim is that this migration is
         structural rather than fashionable, so the boundary moves in one
         direction only. Labels sit inside their own band for the same reason
         the layers do next door. */
      <g>
        <g fill="currentColor" fill-opacity="0.16">
          <rect x="0.5" y="0.5" width="239" height="40" />
          <rect x="0.5" y="55.5" width="239" height="24" />
          <rect x="0.5" y="110.5" width="239" height="9" />
        </g>

        <g fill="none" stroke="currentColor" stroke-opacity="0.32" stroke-width="1">
          <rect x="0.5" y="0.5" width="239" height="49" />
          <rect x="0.5" y="55.5" width="239" height="49" />
          <rect x="0.5" y="110.5" width="239" height="49" />
        </g>

        <g stroke="var(--accent)" stroke-width="1.6">
          <path d="M0.5 40.5 H239.5" />
          <path d="M0.5 79.5 H239.5" />
          <path d="M0.5 119.5 H239.5" />
        </g>

        {annotated && (
          <>
            <text x="5" y="13" class="pf-label">FRAMEWORK</text>
            <text x="5" y="68" class="pf-label">PLATFORM</text>
            <text x="5" y="132" class="pf-label">AGENT</text>
            <text x="235" y="13" text-anchor="end" class="pf-label">VENDOR</text>
            <text x="235" y="132" text-anchor="end" class="pf-label pf-label--accent">YOURS</text>
          </>
        )}
      </g>
    )}

    {name === 'trust-gap' && (
      /* The essay's two cited series, and the space between them. Adoption of AI
         coding tools 62% to 84%; trust in them 40% to 29%. Both numbers come
         from the Stack Overflow surveys the essay links, which is why this is a
         chart rather than a metaphor. The shaded wedge is the load-bearing
         element because the essay's thesis is that the new role lives in it.

         The plot is the frame: 100% sits on the top edge and 0% on the bottom,
         so one unit is one point, both series ride the same honest scale, and
         the headroom above the adoption curve is real distance left to 100%
         rather than slack in the layout. */
      <g>
        <g stroke="currentColor">
          <path d="M0 0.5 H240" stroke-opacity="0.12" stroke-width="1" />
          <path d="M0 159.5 H240" stroke-opacity="0.2" stroke-width="1" />
        </g>

        <path d="M0 60.9 L240 25.9 L240 113.4 L0 95.9 Z" fill="var(--accent)" fill-opacity="0.13" />

        <path d="M0 60.9 L240 25.9" stroke="currentColor" stroke-opacity="0.62" stroke-width="1.8" />
        <path
          d="M0 95.9 L240 113.4"
          stroke="currentColor"
          stroke-opacity="0.62"
          stroke-width="1.8"
          stroke-dasharray="3 3"
        />

        <g fill="currentColor" fill-opacity="0.5">
          <circle cx="4" cy="60.3" r="2.4" />
          <circle cx="4" cy="96.2" r="2.4" />
        </g>
        <g fill="var(--accent)">
          <circle cx="236" cy="26.4" r="2.8" />
          <circle cx="236" cy="113.1" r="2.8" />
        </g>

        {annotated && (
          <>
            <text x="4" y="9" class="pf-label">100%</text>
            <text x="56" y="46" class="pf-label">ADOPTION</text>
            <text x="56" y="113" class="pf-label">TRUST</text>
            <text x="120" y="76" text-anchor="middle" class="pf-label pf-label--accent">THE GAP</text>
            <text x="230" y="20" text-anchor="end" class="pf-label pf-label--accent">84%</text>
            <text x="230" y="127" text-anchor="end" class="pf-label pf-label--accent">29%</text>
            <text x="4" y="154" class="pf-label">2023</text>
            <text x="236" y="154" text-anchor="end" class="pf-label">2025</text>
          </>
        )}
      </g>
    )}

    {name === 'reading-list' && (
      /* A shelf, and the three you actually took. An earlier pass drew evenly
         spaced spines of varying height and read as a bar chart, which is the
         wrong argument entirely. Two things fix it: the spines are packed edge
         to edge like real books, and each carries a title band, so the
         silhouette cannot be mistaken for data. The three picks are lifted
         clear, tilted off-square, and their slots are left visibly empty, which
         is what says "taken" — the essay is explicit that this is a working set
         nobody finishes, so far more has to stay on the shelf than comes off. */
      <g>
        <g fill="var(--accent)" fill-opacity="0.14" stroke="var(--accent)" stroke-width="1.4">
          <g transform="rotate(-7 29 54)">
            <rect x="22" y="1" width="14" height="53" rx="1" />
            <path d="M24.5 12 H33.5" stroke-opacity="0.55" stroke-width="1" fill="none" />
          </g>
          <g transform="rotate(5 101 54)">
            <rect x="96" y="10" width="10" height="44" rx="1" />
            <path d="M98 21 H104" stroke-opacity="0.55" stroke-width="1" fill="none" />
          </g>
          <g transform="rotate(-4 173.5 54)">
            <rect x="166" y="6" width="15" height="48" rx="1" />
            <path d="M168.5 17 H178.5" stroke-opacity="0.55" stroke-width="1" fill="none" />
          </g>
        </g>

        <g fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.1">
          <rect x="0.6" y="88" width="11.4" height="68" rx="1" />
          <rect x="12" y="78" width="10" height="78" rx="1" />
          <rect x="36" y="98" width="11" height="58" rx="1" />
          <rect x="47" y="84" width="13" height="72" rx="1" />
          <rect x="60" y="93" width="9" height="63" rx="1" />
          <rect x="69" y="104" width="15" height="52" rx="1" />
          <rect x="84" y="81" width="12" height="75" rx="1" />
          <rect x="106" y="96" width="13" height="60" rx="1" />
          <rect x="119" y="86" width="11" height="70" rx="1" />
          <rect x="130" y="101" width="14" height="55" rx="1" />
          <rect x="144" y="80" width="10" height="76" rx="1" />
          <rect x="154" y="91" width="12" height="65" rx="1" />
          <rect x="181" y="87" width="11" height="69" rx="1" />
          <rect x="192" y="99" width="13" height="57" rx="1" />
          <rect x="205" y="83" width="9" height="73" rx="1" />
          <rect x="214" y="94" width="12" height="62" rx="1" />
          <rect x="226" y="105" width="13.4" height="51" rx="1" />
        </g>

        <g stroke="currentColor" stroke-opacity="0.34" stroke-width="1">
          <path d="M2.6 97 H10" />
          <path d="M14 87 H20" />
          <path d="M38 107 H45" />
          <path d="M49 93 H58" />
          <path d="M62 102 H67" />
          <path d="M71 113 H82" />
          <path d="M86 90 H94" />
          <path d="M108 105 H117" />
          <path d="M121 95 H128" />
          <path d="M132 110 H142" />
          <path d="M146 89 H152" />
          <path d="M156 100 H164" />
          <path d="M183 96 H190" />
          <path d="M194 108 H203" />
          <path d="M207 92 H212" />
          <path d="M216 103 H224" />
          <path d="M228 114 H237.4" />
        </g>

        <line x1="0" y1="157.6" x2="240" y2="157.6" stroke="currentColor" stroke-opacity="0.45" stroke-width="2.8" />

        {annotated && (
          <text x="4" y="70" class="pf-label">PICK THE TWO OR THREE YOU NEED</text>
        )}
      </g>
    )}

    {name === 'shared-floor' && (
      /* Three candidates as three columns, and the essay's actual claim as the
         band they all stand on. Each column is cut into the SAME six jobs, top
         to bottom: element definition, rendering, framework wrappers, build
         outputs, server rendering, component metadata. Only the fill changes —
         solid where the toolchain supplies it, dashed where it is generated and
         still yours to support, hollow where you build it yourself. Read across
         and the hollow count falls 5, 2, 0 while the dashed count climbs 0, 2,
         3, which is the honest shape of the trade rather than "Stencil gives you
         more".

         The accent goes on the floor, not on any column, because the floor is
         the argument: tag names, packaging, forms, SSR and releases cost the
         same no matter which column you picked, and they are what the comparison
         articles leave out.

         The rows carry no labels, and that is deliberate — a row-label gutter
         down the left is exactly the framing failure the file header warns
         about, and it would push the geometry off the left edge. The three
         in-block labels double as the legend: one sits on a solid block, one on
         a dashed block, one on a hollow one. The floor's own tick marks sit at
         48/96/144/192, clear of the column gutters at ~79 and ~161, so the band
         visibly does not partition the way the columns do. */
      <g>
        <g fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-opacity="0.28" stroke-width="1.2">
          <rect x="0.6" y="0.6" width="74.8" height="12" />
          <rect x="82.6" y="0.6" width="74.8" height="12" />
          <rect x="164.6" y="0.6" width="74.8" height="12" />
        </g>

        <g fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.2">
          <rect x="0.6" y="33.56" width="74.8" height="15" />
          <rect x="0.6" y="52.62" width="74.8" height="15" />
          <rect x="0.6" y="71.68" width="74.8" height="15" />
          <rect x="0.6" y="90.74" width="74.8" height="15" />
          <rect x="0.6" y="109.8" width="74.8" height="15" />
          <rect x="82.6" y="71.68" width="74.8" height="15" />
          <rect x="82.6" y="109.8" width="74.8" height="15" />
        </g>

        <g fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.2">
          <rect x="0.6" y="14.5" width="74.8" height="15" />
          <rect x="82.6" y="14.5" width="74.8" height="15" />
          <rect x="82.6" y="33.56" width="74.8" height="15" />
          <rect x="164.6" y="14.5" width="74.8" height="15" />
          <rect x="164.6" y="33.56" width="74.8" height="15" />
          <rect x="164.6" y="71.68" width="74.8" height="15" />
        </g>

        <g
          fill="currentColor"
          fill-opacity="0.15"
          stroke="currentColor"
          stroke-opacity="0.5"
          stroke-width="1.2"
          stroke-dasharray="3 2.5"
        >
          <rect x="82.6" y="52.62" width="74.8" height="15" />
          <rect x="82.6" y="90.74" width="74.8" height="15" />
          <rect x="164.6" y="52.62" width="74.8" height="15" />
          <rect x="164.6" y="90.74" width="74.8" height="15" />
          <rect x="164.6" y="109.8" width="74.8" height="15" />
        </g>

        <rect
          x="0.7"
          y="129.3"
          width="238.6"
          height="30"
          fill="var(--accent)"
          fill-opacity="0.13"
          stroke="var(--accent)"
          stroke-width="1.4"
        />
        <g stroke="var(--accent)" stroke-opacity="0.32" stroke-width="1">
          <path d="M48 129.3 V159.3" />
          <path d="M96 129.3 V159.3" />
          <path d="M144 129.3 V159.3" />
          <path d="M192 129.3 V159.3" />
        </g>

        {annotated && (
          <>
            <text x="4.6" y="8.6" class="pf-label">NATIVE</text>
            <text x="86.6" y="8.6" class="pf-label">LIT</text>
            <text x="168.6" y="8.6" class="pf-label">STENCIL</text>

            <text x="168.6" y="24.3" class="pf-label">SUPPLIED</text>
            <text x="168.6" y="100.5" class="pf-label">GENERATED</text>
            <text x="4.6" y="43.4" class="pf-label">YOU BUILD THIS</text>

            <text x="24.35" y="146" text-anchor="middle" class="pf-label pf-label--accent">TAG NAMES</text>
            <text x="72" y="146" text-anchor="middle" class="pf-label pf-label--accent">PACKAGING</text>
            <text x="120" y="146" text-anchor="middle" class="pf-label pf-label--accent">FORMS</text>
            <text x="168" y="146" text-anchor="middle" class="pf-label pf-label--accent">SSR</text>
            <text x="215.65" y="146" text-anchor="middle" class="pf-label pf-label--accent">RELEASES</text>
          </>
        )}
      </g>
    )}

    {name === 'altitude' && (
      /* The essay's own distillation (Part XXVI), drawn. Four layers, bottom to
         top: the component, its API, the platform, the organization. Three
         windows two layers tall: Senior on 1-2, Staff on 2-3, Principal on 3-4.
         The three windows tile the four layers exactly, which is what makes the
         geometry closed rather than decorative.

         The load-bearing fact is that every window is the SAME height. It does
         not grow on the way up, it slides — Staff picks up the platform at the
         moment it puts the component down, and shares a layer with the level on
         either side. That is the essay's opening claim ("Staff is not simply
         Senior, but better at coding") stated as a shape, and it is why this is
         a staircase and not a pyramid. A pyramid would say the opposite.

         Accent goes on the Staff window because Staff is what the essay is
         about; Senior and Principal are the two neighbours that give the middle
         one its position, and neither is the subject.

         Two details doing real work:

         - The windows are contiguous, sharing vertical edges at x=80 and x=160.
           An earlier pass separated them by a 4.2-unit gutter and bridged it
           with short risers; each riser landed a hair off a window edge at
           nearly the same weight and read as a doubled, broken edge. Butted
           together, the three top edges and the two shared edges close into one
           unbroken line from the bottom-left corner to the top-right one, and
           the staircase needs no ink that is not already a window.
         - The layer rules run the full width and pass straight THROUGH the
           windows, bisecting each one. That is what makes "two layers tall"
           countable rather than asserted, and it locks the windows and the field
           onto one grid so the offset reads as exactly one layer.

         No row-label gutter, per the rules at the head of this file: the outer
         rules are trimmed to stop where a window takes over the edge, so the
         frame is completed jointly by field and geometry.

         The type is keyed to the same grid. Each layer name sits on its band's
         TOP edge, each window name just inside its own top edge, so the pairs
         that land on a shared baseline — ORGANIZATION/PRINCIPAL, PLATFORM/STAFF,
         API/SENIOR — each state the same true thing: this is the layer that
         window reaches. COMPONENT is deliberately left without a partner,
         because it is the one layer nobody's window tops out in. */
      <g>
        <g stroke="currentColor" stroke-width="1">
          <path d="M0 0.6 H160" stroke-opacity="0.22" />
          <path d="M0 40 H240" stroke-opacity="0.16" />
          <path d="M0 80 H240" stroke-opacity="0.16" />
          <path d="M0 120 H240" stroke-opacity="0.16" />
          <path d="M80 159.4 H240" stroke-opacity="0.22" />
        </g>

        <rect
          x="0.6"
          y="80"
          width="79.4"
          height="79.4"
          fill="currentColor"
          fill-opacity="0.1"
          stroke="currentColor"
          stroke-opacity="0.5"
          stroke-width="1.2"
        />

        <rect
          x="160"
          y="0.6"
          width="79.4"
          height="79.4"
          fill="currentColor"
          fill-opacity="0.1"
          stroke="currentColor"
          stroke-opacity="0.5"
          stroke-width="1.2"
        />

        <rect
          x="80"
          y="40"
          width="80"
          height="80"
          fill="var(--accent)"
          fill-opacity="0.13"
          stroke="var(--accent)"
          stroke-width="1.4"
        />

        {annotated && (
          <>
            <text x="4.6" y="9.6" class="pf-label">ORGANIZATION</text>
            <text x="164.5" y="9.6" class="pf-label">PRINCIPAL</text>

            <text x="4.6" y="49" class="pf-label">PLATFORM</text>
            <text x="84.5" y="49" class="pf-label pf-label--accent">STAFF</text>

            <text x="5" y="89" class="pf-label">SENIOR</text>
            <text x="235.4" y="89" text-anchor="end" class="pf-label">API</text>

            <text x="235.4" y="129" text-anchor="end" class="pf-label">COMPONENT</text>
          </>
        )}
      </g>
    )}
  </svg>

  {annotated && (
    <figcaption class="post-figure__cap"><span>{caption}</span></figcaption>
  )}
</figure>


