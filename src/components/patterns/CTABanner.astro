---
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';

/**
 * Closing CTA band. The same shape every other closing CTA on the site uses:
 * full-bleed ink surface, left-aligned, no container card.
 *
 * It was previously a centered paper card with a rounded border, which made the
 * tools pages (its only consumers) end differently from every other page.
 *
 * Slot in <Button> calls. This is a dark surface, so use variant="navy" for the
 * primary and variant="secondary" for the outlined companion. variant="ghost"
 * is `text-ink` and would not be readable here.
 */

interface Props {
  title: string;
  lead?: string;
  /** Optional monospace eyebrow above the title. */
  eyebrow?: string;
  class?: string;
}

const { title, lead, eyebrow, class: className } = Astro.props;
---

<Section tone="ink" padding="loose" class={className}>
  <Container width="wide">
    {eyebrow && <p class="mono-label !text-paper/65 mb-6">{eyebrow}</p>}
    <Heading level={2} visual="display-lg" tone="paper" class="max-w-3xl">{title}</Heading>
    {lead && <Text size="lg" tone="whiteMuted" class="mt-5 max-w-2xl">{lead}</Text>}
    <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <slot />
    </div>
  </Container>
</Section>
