---
import Section from '~/components/layout/Section.astro';
import Container from '~/components/layout/Container.astro';
import Heading from '~/components/primitives/Heading.astro';
import Text from '~/components/primitives/Text.astro';
import { cx } from '~/lib/cx';

/**
 * Closing CTA band. Editorial-Technical: ink surface, no decorations. Slot in
 * <Button> calls (use variant="navy" for the paper-on-ink primary).
 */

interface Props {
  title: string;
  lead?: string;
  align?: 'center' | 'left';
  /** Optional monospace eyebrow above the title. */
  eyebrow?: string;
  class?: string;
}

const { title, lead, align = 'center', eyebrow, class: className } = Astro.props;
---

<Section tone="paper" padding="default" class={className}>
  <Container width="wide">
    <div class="rounded-xl border border-line bg-raised p-8 md:p-12">
      <div class={cx('max-w-3xl', align === 'center' && 'mx-auto text-center')}>
        {eyebrow && <p class="mono-label">{eyebrow}</p>}
        <Heading level={2} visual="display-md" tone="ink" align={align} balance class={cx(eyebrow && 'mt-4')}>{title}</Heading>
        {lead && (
          <Text size="lg" tone="muted" align={align} class={cx('mt-5', align === 'center' && 'max-w-xl mx-auto')}>
            {lead}
          </Text>
        )}
        <div class={cx('mt-8 flex flex-wrap items-center gap-4', align === 'center' && 'justify-center')}>
          <slot />
        </div>
      </div>
    </div>
  </Container>
</Section>
