---
import Icon from '~/components/primitives/Icon.astro';
import { cx } from '~/lib/cx';

/**
 * ScrollShot — a full-page capture shown as a tall *editorial plate* that scrolls
 * internally. Same mounted-specimen language as SiteShot (no browser chrome): a
 * hairline paper mount, an optional plate index above, and a mono spec rail
 * below. A soft bottom fade + a quiet "scroll" cue signal there's more page to
 * walk. Pass `href` to link the source domain out to the live site.
 */

interface Props {
  src: string;
  alt: string;
  /** Source label in the caption rail, e.g. "berxi.com" or "Buttons". */
  label: string;
  /** Optional caption under the plate. */
  caption?: string;
  /** Optional outbound link — turns the source label into a link to the live site. */
  href?: string;
  /** Optional plate index, e.g. "01" — renders a "Plate / 01" figure tag above. */
  index?: string;
  /** Kind label shown at the caption rail's left. */
  kind?: string;
  /** Max visible height of the scroll stage. */
  maxH?: string;
  class?: string;
}

const {
  src,
  alt,
  label,
  caption,
  href,
  index,
  kind = 'Full page',
  maxH = '620px',
  class: className,
} = Astro.props;
---

<figure class={cx('scroll-shot', className)}>
  {index && (
    <p class="scroll-shot-index">Plate <span aria-hidden="true">/</span> {index}</p>
  )}

  <div class="scroll-shot-mount">
    <div
      class="scroll-shot-stage"
      style={`max-height:${maxH}`}
      tabindex="0"
      role="group"
      aria-label={`${label}: full-page capture, scrollable`}
    >
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
    <span class="scroll-shot-fade" aria-hidden="true"></span>
    <span class="scroll-shot-cue" aria-hidden="true">
      scroll <Icon name="ph:arrows-down-up" size={12} />
    </span>
  </div>

  <figcaption class="scroll-shot-cap">
    <div class="scroll-shot-rail">
      <span class="scroll-shot-kind">{kind}</span>
      {href ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="scroll-shot-url scroll-shot-url--link"
          aria-label={`Open ${label} in a new tab`}
        >{label} <Icon name="ph:arrow-up-right" size={12} /></a>
      ) : (
        <span class="scroll-shot-url">{label}</span>
      )}
    </div>
    {caption && <p class="scroll-shot-note">{caption}</p>}
  </figcaption>
</figure>

<style>
  .scroll-shot { margin: 0; }

  .scroll-shot-index {
    margin: 0 0 0.75rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
  }
  .scroll-shot-index span { margin: 0 0.35em; opacity: 0.6; }

  /* Mount — the mounted specimen, holding a scroll stage. */
  .scroll-shot-mount {
    position: relative;
    padding: 8px;
    border-radius: 16px;
    background: var(--raised);
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgba(27, 26, 23, 0.04),
      0 18px 50px -28px rgba(27, 26, 23, 0.3);
  }

  .scroll-shot-stage {
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--raised);
    scrollbar-width: thin;
  }
  .scroll-shot-stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .scroll-shot-stage img { width: 100%; height: auto; display: block; }

  /* A soft fade at the mount's lower edge: signals more page below the fold. */
  .scroll-shot-fade {
    position: absolute;
    left: 9px;
    right: 9px;
    bottom: 9px;
    height: 64px;
    border-radius: 0 0 9px 9px;
    background: linear-gradient(to bottom, transparent, var(--raised));
    pointer-events: none;
  }

  .scroll-shot-cue {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    pointer-events: none;
  }

  /* Caption — spec rail (kind + source) then optional note. */
  .scroll-shot-cap { margin-top: 0.85rem; }
  .scroll-shot-rail {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .scroll-shot-kind {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .scroll-shot-url {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.scroll-shot-url--link { transition: color 0.25s var(--ease-out); }
  a.scroll-shot-url--link:hover { color: var(--accent); }

  .scroll-shot-note {
    margin: 0.85rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
