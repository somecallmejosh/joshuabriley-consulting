---
import { cx } from '~/lib/cx';

/** Wrapper for a list of FAQItem rows — clean hairline-divided rows. */

interface Props {
  class?: string;
  as?: 'div' | 'section';
}

const { class: className, as: Tag = 'div' } = Astro.props;
---

<Tag class={cx('divide-y divide-line border-y border-line', className)}>
  <slot />
</Tag>
