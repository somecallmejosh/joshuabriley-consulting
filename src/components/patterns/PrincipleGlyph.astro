---
import { cx } from '~/lib/cx';

/**
 * PrincipleGlyph — the small technical diagram that stands in for a principle
 * on the about page.
 *
 * Same contract as ToolGlyph, and deliberately so: fixed 3:2 viewBox, structure
 * drawn in `currentColor` at low opacity, and the one load-bearing element in
 * `var(--accent)`. Both are surface-aware (see the accent block in site.css),
 * so the same markup reads correctly on paper and on ink without a variant prop.
 *
 * Each mark draws the *claim*, not a category icon. The system glyph is a
 * component at somebody else's call site, because the principle is that the
 * consumer writes code. The accessibility glyph puts the focus ring inside the
 * component boundary, which is the whole argument. The directness glyph is two
 * routes between the same two points.
 *
 * No hover motion here, unlike ToolGlyph: these cells aren't links, and the
 * repo rule is that non-link elements get no hover effects.
 *
 * Decorative by contract: every placement sits directly above the principle's
 * title, so the glyph is aria-hidden and adds nothing for AT to read twice.
 */

type GlyphName = 'system' | 'accessibility' | 'directness';

interface Props {
  name: GlyphName;
  size?: 'md' | 'lg';
  class?: string;
}

const { name, size = 'md', class: className } = Astro.props;

// Width alone sets the footprint, so the three marks stay optically the same
// weight next to each other even when the featured cell draws its own larger.
const sizes: Record<NonNullable<Props['size']>, string> = {
  md: 'w-24',
  lg: 'w-32 md:w-36',
};
---

<svg
  viewBox="0 0 96 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={cx('h-auto', sizes[size], className)}
>
  {name === 'system' && (
    /* A component sitting in source somebody else wrote: two faint rules for
       the lines around it, angle brackets, and the component as the one solid
       thing on its line. The brackets are the point — what a consuming team
       touches is the tag, not the implementation. The rules are held well clear
       of the centre row so the drawing reads as three lines, not a tangle. */
    <g>
      <g stroke="currentColor" stroke-opacity="0.18" stroke-width="1" stroke-linecap="round">
        <line x1="19" y1="12" x2="58" y2="12" />
        <line x1="19" y1="52" x2="46" y2="52" />
      </g>
      <g
        stroke="currentColor"
        stroke-opacity="0.5"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="26,25 19,32 26,39" />
        <polyline points="70,25 77,32 70,39" />
      </g>
      <rect
        x="33"
        y="25"
        width="30"
        height="14"
        rx="2"
        fill="var(--accent)"
        fill-opacity="0.16"
        stroke="var(--accent)"
        stroke-width="1.5"
      />
    </g>
  )}

  {name === 'accessibility' && (
    /* The component boundary, a control inside it, and the focus ring drawn
       inside that boundary rather than bolted on around the outside. Three
       distinct treatments so the nesting reads at 96px: the boundary is dashed
       because it's conceptual, the control is filled, and the ring is the only
       solid accent stroke in the drawing. */
    <g>
      <rect
        x="8"
        y="8"
        width="80"
        height="48"
        rx="3"
        stroke="currentColor"
        stroke-opacity="0.32"
        stroke-width="1.25"
        stroke-dasharray="3 3.5"
      />
      <rect
        x="38"
        y="28"
        width="20"
        height="8"
        rx="1.5"
        fill="currentColor"
        fill-opacity="0.45"
      />
      <rect
        x="32.25"
        y="22.25"
        width="31.5"
        height="19.5"
        rx="4"
        stroke="var(--accent)"
        stroke-width="1.75"
      />
    </g>
  )}

  {name === 'directness' && (
    /* Two routes between the same two points. The long way round is the hedged
       answer; the straight one is the shortest honest path. The detour arcs
       clear of the accent line instead of weaving across it, so at this size
       the two routes stay legible as two routes. */
    <g>
      <path
        d="M12 46 C 18 17, 34 11, 50 15 C 66 19, 72 33, 84 46"
        stroke="currentColor"
        stroke-opacity="0.25"
        stroke-width="1.25"
        stroke-linecap="round"
      />
      <line
        x1="12"
        y1="46"
        x2="84"
        y2="46"
        stroke="var(--accent)"
        stroke-width="1.75"
        stroke-linecap="round"
      />
      <g fill="currentColor" fill-opacity="0.5">
        <circle cx="12" cy="46" r="3" />
        <circle cx="84" cy="46" r="3" />
      </g>
    </g>
  )}
</svg>
