---
import { cx } from '~/lib/cx';
import Icon from '~/components/primitives/Icon.astro';
import TechStack from '~/components/patterns/TechStack.astro';
import type { StackItem } from '~/components/patterns/TechStack.astro';
import type { Tone } from '~/lib/tones';

/**
 * Technical-proof register — the "receipts" panel for a case study.
 *
 * One scannable block answering what a hiring manager asks first: what skills did
 * this prove, what was the stack, how was it tested. Composes TechStack rows so
 * the chip styling stays single-sourced.
 */

interface Section {
  label: string;
  items: StackItem[];
  tone?: Tone;
}

interface Props {
  sections: Section[];
  /** Panel heading (default "Receipts"). */
  title?: string;
  /** Phosphor icon for the heading. */
  icon?: string;
  class?: string;
}

const { sections, title = 'Receipts', icon = 'ph:seal-check-duotone', class: className } = Astro.props;
---

<section
  class={cx(
    'rounded-2xl border border-dashed border-plum/30 bg-white/70 p-6 md:p-7',
    className,
  )}
  aria-label={title}
>
  <div class="flex items-center gap-2 mb-5">
    <Icon name={icon} size={22} class="text-plum" />
    <h3 class="font-heading text-sm font-semibold uppercase tracking-widest text-navy">{title}</h3>
  </div>
  <dl class="grid gap-5 sm:grid-cols-2">
    {sections.map((s) => (
      <div>
        <dt class="sr-only">{s.label}</dt>
        <dd>
          <TechStack label={s.label} items={s.items} tone={s.tone ?? 'navy'} />
        </dd>
      </div>
    ))}
  </dl>
</section>
